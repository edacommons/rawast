// SystemVerilog preprocessor grammar.
//
// First cut: `\`define NAME [(p1, p2, …)] BODY` with the body parsed
// as a segment array via scope. Each body segment is one of:
//
//   {type:"macro_use", name:"OTHER"}      // ``OTHER` — nested macro invocation
//   {type:"string",    value:"..."}       // "..." literal
//   {type:"ref",       value:"FOO"}       // bare identifier (potential
//                                          // parameter reference; resolution
//                                          // happens at expansion time)
//   StringValue                            // raw text run between segments
//
// Macro parameter list — when present — is `(p1, p2, …)` IMMEDIATELY
// after the macro name (no whitespace). Per SV LRM:
//
//   `define FOO(x) body     // parameterized: params=["x"], body=body
//   `define FOO (x) body    // no params, body=`(x) body`
//
// The boundary is preserved by NOT applying `ignore linespace` at
// rule level — explicit `linespace` items appear at positions where
// whitespace is allowed; between the macro name and `(`, whitespace
// fails the PARAMS optional and the bytes become part of the body.
//
// The body terminates at the next newline; scope bypasses ignore-set
// skipping so whitespace inside the body round-trips verbatim.

use: std

start: <PP_FILE>

// Top-level: a sequence of PP_ITEMs. Each PP_ITEM is either a
// preprocessor directive (currently just `\`define`; `\`undef`,
// `\`ifdef`, `\`include`, etc. land as follow-ups) or a TEXT_LINE
// (one line of non-directive text). PEG ordering tries DEFINE first
// — its `\`define` literal Key fails fast for any non-`\`define` line
// — then falls through to TEXT_LINE.
PP_FILE: sequence array {
  repeat <PP_ITEM>
}

PP_ITEM: choice {
  <DEFINE>,
  <UNDEF>,
  <INCLUDE>,
  <IFDEF>,
  <IFNDEF>,
  <IF>,
  <TEXT_LINE>
}

// `\`ifdef NAME` / `\`ifndef NAME` — conditional compilation. The body
// captures repeat <PP_ITEM> up to the matching `\`else` (optional) and
// `\`endif`. PP_ITEM's TEXT_LINE alternative has negative-lookaheads
// on the structural close tokens, so the body's repeat terminates at
// `\`else` / `\`endif` instead of consuming those lines as text.
//
// Both shapes hit the same walker handler (handle_ifdef) with an
// `invert` flag — `ifndef` is just `ifdef` with the take/skip
// decision flipped. Both emit `{type, cond, body, [else_branch]}`
// that the walker dispatches on.
IFDEF: sequence dict {
  "`ifdef":type="ifdef",
  linespace,
  identifier:cond=@,
  linespace,
  "\n",
  <BODY>:body=@,
  ?<ELSE_BRANCH>:else_branch=@,
  "`endif",
  linespace,
  "\n"
}

IFNDEF: sequence dict {
  "`ifndef":type="ifndef",
  linespace,
  identifier:cond=@,
  linespace,
  "\n",
  <BODY>:body=@,
  ?<ELSE_BRANCH>:else_branch=@,
  "`endif",
  linespace,
  "\n"
}

BODY: sequence array {
  repeat <PP_ITEM>
}

ELSE_BRANCH: sequence dict {
  "`else",
  linespace,
  "\n",
  <BODY>:body=@
}

// `\`if EXPR` / `\`elsif EXPR` — the expression form of conditional
// compilation. Each `\`if`/`\`elsif` is one entry in the `branches`
// list (first entry is the `\`if`, rest are `\`elsif`s); the walker
// evaluates each entry's `cond` via `PpOptions::expr_eval` and walks
// the first true branch's body. EXPR is captured as raw text — the
// host's expr_eval callback owns parsing it (composing sv_pp_expr +
// default_pp_expr_eval, or its own evaluator).
//
// Per SV LRM, `\`else` and `\`endif` close the chain; the optional
// ELSE_BRANCH is reused from `\`ifdef`. TEXT_LINE's negative
// lookahead on `\`elsif` keeps the BODY's repeat from swallowing
// the elsif keyword as text.
IF: sequence dict {
  <IF_HEAD>:branches[]=@,
  repeat <ELSIF>:branches[]=@,
  ?<ELSE_BRANCH>:else_branch=@,
  "`endif":type="if",
  linespace,
  "\n"
}

IF_HEAD: sequence dict {
  "`if",
  linespace,
  *:cond=@,
  "\n",
  <BODY>:body=@
}

ELSIF: sequence dict {
  "`elsif",
  linespace,
  *:cond=@,
  "\n",
  <BODY>:body=@
}

// `\`undef NAME` — remove `NAME` from the active macro table. No-op
// (silently) if `NAME` wasn't defined. handle_undef in the walker
// just calls `state_.macros.erase(name)`.
UNDEF: sequence dict {
  "`undef":type="undef",
  linespace,
  identifier:name=@,
  linespace,
  "\n"
}

// `\`include "path/to/file.svh"` — the host's `include_source`
// callback (or the built-in `include_paths` walk if unset) resolves
// the requested path to source content; handle_include parses and
// walks the included AST recursively with the current macro table.
//
// Per SV LRM the path can also be `<path>` (angle-bracketed system
// header form); for v1 we accept only the `"..."` form. The
// `<...>` form is a follow-up — its capture rule needs std.string
// equivalent for `<...>` delimited tokens.
INCLUDE: sequence dict {
  "`include":type="include",
  linespace,
  std.string:path=@,
  linespace,
  "\n"
}

// A single line of arbitrary text. The line's content is captured
// as a `scope array { <MACRO_USE> }` so embedded `\`NAME` (and
// `\`NAME(a, b)`) calls surface as MACRO_USE dicts inside the
// segments array; everything else stays as bare StringValue runs
// in between. The walker's "text_line" handler iterates segments
// in order: bare strings emit verbatim, macro_use dicts go through
// handle_macro_use which expands them through the macro table.
//
// The leading negative-lookaheads still keep TEXT_LINE from claiming
// lines that start with the structural close tokens of `\`ifdef` /
// `\`if` (`\`else`, `\`elsif`, `\`endif`) — those need to be left
// for the surrounding rule to match.
//
// MACRO_USE's `?<MACRO_ARGS>` (identifier-only args, no space before
// `(`) covers the parameterised invocation form. Argument expressions
// beyond bare identifiers will land once MACRO_ARGS itself grows up
// (see the comment on MACRO_ARGS below).
TEXT_LINE: sequence dict {
  !"`endif",
  !"`else",
  !"`elsif",
  scope array { <MACRO_USE> }:segments=@,
  "\n":type="text_line"
}

DEFINE: sequence dict {
  "`define":type="define",
  linespace,
  identifier:name=@,
  ?<PARAMS>:params=@,
  linespace,
  scope array { <MACRO_USE>, <STRING>, <PARAM_REF> }:body=@,
  "\n"
}

PARAMS: sequence array {
  "(",
  repeat identifier separator ",",
  ")"
}

MACRO_USE: sequence dict {
  "`":type="macro_use",
  identifier:name=@,
  ?<MACRO_ARGS>:args=@
}

// `\`OTHER(x, y)` — call-site argument list. Same SV-LRM adjacency
// rule as DEFINE's parameter list: the `(` must immediately follow
// the macro name (no whitespace) to be argument capture; with a
// space it stays as part of the surrounding body.
//
// v1: identifier-only args. Full expression arguments with nested
// parens, strings, and embedded macro calls land as a follow-up
// once the engine grows a multi-stop primitive (the comma-or-paren
// boundary isn't expressible with single-sibling scope today).
MACRO_ARGS: sequence array {
  "(",
  repeat identifier separator ",",
  ")"
}

STRING: sequence dict {
  std.string:type="string":value=@
}

PARAM_REF: sequence dict {
  identifier:type="ref":value=@
}
