// grammars/sv_preprocessor.rawast — SystemVerilog preprocessor.
//
// Phase 1.2 minimal: object-like `define / `undef / `ifdef / `ifndef
// (with optional `else and recursive nesting), plus pass-through
// for any other content. Function-like macros, `\`include`, `\`if`
// expressions, token paste, and stringification arrive in Phase 2.
//
// Rules with the `:#role="..."` engine annotation tell the
// Preprocessor walker what conceptual operation each rule plays.
// Convention: every role-bearing rule ALSO emits a `type` field via
// a const binding (`:type="define"`, etc.) so the walker can
// dispatch at parse time. The duplication is intentional —
// `#role` lives at grammar-load time (validation), `type:` lives
// at parse-output time (runtime dispatch).
//
// The `sv_pp_text_line` terminal is the catch-all: it consumes a
// single line of source (including the trailing newline) but fails
// on `\`endif` and `\`else` so PP_FILE's outer repeat stops cleanly
// at conditional-compilation boundaries.

use: std, sv

start: <PP_FILE>

// Horizontal whitespace (spaces/tabs) is ignored between sibling items
// in the directive rules. Newlines are NOT ignored — directives are
// line-terminated and the explicit `newline` keyword in each rule
// must match. The ignore policy propagates to every sub-rule because
// rule-local overrides only apply where explicitly attached.
//
// Inside terminal parsers (sv_pp_text_line, sv_line_text) the ignore
// list has no effect — those consume raw bytes — so PP_TEXT preserves
// source whitespace verbatim for round-tripping.
PP_FILE ignore linespace: sequence array { repeat <PP_ITEM> }

PP_ITEM: choice {
  <PP_DEFINE>,
  <PP_UNDEF>,
  <PP_IFDEF>,
  <PP_IFNDEF>,
  <PP_IF>,
  <PP_INCLUDE>,
  <PP_MACRO_USE>,
  <PP_TEXT>
}

// `define IDENT body\n
PP_DEFINE: sequence dict {
  "`define":type="define",
  sv_identifier:name=@,
  sv_line_text:body=@,
  sv_eol
}:#role="define"

// `undef IDENT\n
PP_UNDEF: sequence dict {
  "`undef":type="undef",
  sv_identifier:name=@,
  sv_eol
}:#role="undef"

// `ifdef COND
//   ...body...
// [`else
//   ...else_branch...]
// `endif
//
// body and else_branch are arrays of PP_ITEM. The body's repeat
// naturally stops at `\`else` or `\`endif` because sv_pp_text_line
// (the catch-all in PP_TEXT) fails on those tokens, no other PP_ITEM
// alternative matches them, and the repeat halts.
PP_IFDEF: sequence dict {
  "`ifdef":type="ifdef",
  sv_identifier:cond=@,
  sv_eol,
  <PP_BODY>:body=@,
  ?<PP_ELSE_CLAUSE>:else_branch=@,
  "`endif",
  sv_eol
}:#role="ifdef"

PP_IFNDEF: sequence dict {
  "`ifndef":type="ifndef",
  sv_identifier:cond=@,
  sv_eol,
  <PP_BODY>:body=@,
  ?<PP_ELSE_CLAUSE>:else_branch=@,
  "`endif",
  sv_eol
}:#role="ifndef"

// `if EXPR
//   ...body...
// [`elsif EXPR
//   ...body...]*
// [`else
//   ...else_branch...]
// `endif
//
// Generalised `ifdef`: the condition is an arbitrary expression that
// the host evaluator (PpOptions::expr_eval callback) reduces to a
// truthy / falsy value. The walker selects the first branch whose
// condition is true — the `if` body first, then each `elsif` body
// in order, then the `else` body if none of the above matched.
//
// `cond` is a `PP_EXPR` AST dict (see the EXPR section below); the
// walker passes it straight to the callback unchanged.
PP_IF: sequence dict {
  "`if":type="if",
  <PP_EXPR>:cond=@,
  sv_eol,
  <PP_BODY>:body=@,
  repeat <PP_ELSIF_CLAUSE>:elsif_branches[]=@,
  ?<PP_ELSE_CLAUSE>:else_branch=@,
  "`endif",
  sv_eol
}:#role="if"

PP_ELSIF_CLAUSE: sequence dict {
  "`elsif",
  <PP_EXPR>:cond=@,
  sv_eol,
  <PP_BODY>:body=@
}

PP_BODY: sequence array { repeat <PP_ITEM> }

PP_ELSE_CLAUSE: sequence array {
  "`else",
  sv_eol,
  repeat <PP_ITEM>
}

// `include "filename"  — file inclusion. The path is captured as a
// `std.string` (double-quoted, escapes preserved). The walker
// resolves the path against PpOptions::include_paths, reads the
// file, and either accumulates its side effects (default) or
// splices its processed text into the output (PpOptions::splice).
PP_INCLUDE: sequence dict {
  "`include":type="include",
  std.string:path=@,
  sv_eol
}:#role="include"

// Standalone macro use on its own source line: `\`MACRO_NAME` with
// optional `(arg1, arg2)` argument list. Inline macro uses (embedded
// mid-line) currently pass through PP_TEXT — token-level expansion
// is a later phase. `sv_pp_macro_name` rejects `\`endif`/`\`else` so
// those terminators flow through to the enclosing PP_IFDEF/PP_IFNDEF.
//
// Arguments are captured raw via `sv_balanced_arg`, which tracks
// nested parens; commas inside `f(x, y)` stay part of one arg.
PP_MACRO_USE: sequence dict {
  "`":type="macro_use",
  sv_pp_macro_name:name=@,
  ?<PP_MACRO_ARGS>:args=@,
  sv_eol
}:#role="macro_use"

PP_MACRO_ARGS: sequence array {
  "(",
  repeat sv_balanced_arg separator ",",
  ")"
}

// Pass-through line. Captures one source line including its trailing
// newline. sv_pp_text_line fails on `\`endif`/`\`else`/`\`elsif` so
// this rule (last in the PP_ITEM choice) does not eat conditional
// terminators.
PP_TEXT: sequence dict {
  sv_pp_text_line:type="text":text=@
}:#role="text"

// ─── PP_EXPR — `\`if` / `\`elsif` condition expressions ────────────────
//
// A small expression grammar restricted to what makes sense in
// preprocessor conditionals. Precedence ladder follows Verilog
// operator precedence (LRM §11.3.2), lowest to highest:
//
//   ||              PP_EXPR  (top — logical OR)
//   &&              PP_AND
//   ==  !=          PP_EQUALITY
//   <  <=  >  >=    PP_RELATIONAL
//   +  -            PP_ADD
//   *  /  %         PP_MUL
//   !  -            PP_UNARY  (prefix)
//   primary         PP_DEFINED, int, ident, (expr)
//
// Each binary level uses the head+tail-list idiom required by
// rawast's predictive (non-memoizing) PEG engine:
//
//   PP_X: sequence dict { <NEXT>:lhs=@, repeat <X_TAIL>:tail[]=@ }
//
// The level parses NEXT exactly once, then the `repeat` does an
// O(1) first-byte check at each iteration for the operator. No
// backtracking, no re-parsing of NEXT on the fallthrough path,
// linear total cost. The AST has a wrapper per level (`{lhs, tail}`)
// — that's the intrinsic trade-off for predictive parsing of an
// existing language with ungrouped chains like `a + b - c`.
//
// Why no internal evaluator: SV's `\`if` semantics — what `defined`
// queries, how a macro body coerces to integer, how `>` compares
// across bit-widths — are host-language concerns. The walker hands
// the AST to PpOptions::expr_eval and gets back a boolean. See
// `python/rawast/preprocessor.py` for the default Python evaluator
// (recursive walk, undefined-name → 0).

PP_EXPR: sequence dict { <PP_AND>:lhs=@, repeat <PP_OR_TAIL>:tail[]=@ }
PP_OR_TAIL: sequence dict { "||":op="||", <PP_AND>:rhs=@ }

PP_AND: sequence dict { <PP_EQUALITY>:lhs=@, repeat <PP_AND_TAIL>:tail[]=@ }
PP_AND_TAIL: sequence dict { "&&":op="&&", <PP_EQUALITY>:rhs=@ }

PP_EQUALITY: sequence dict { <PP_RELATIONAL>:lhs=@, repeat <PP_EQUALITY_TAIL>:tail[]=@ }
PP_EQUALITY_TAIL: sequence dict { <PP_EQUALITY_OP>:op=@, <PP_RELATIONAL>:rhs=@ }
PP_EQUALITY_OP: choice { "==":@, "!=":@ }

PP_RELATIONAL: sequence dict { <PP_ADD>:lhs=@, repeat <PP_RELATIONAL_TAIL>:tail[]=@ }
PP_RELATIONAL_TAIL: sequence dict { <PP_RELATIONAL_OP>:op=@, <PP_ADD>:rhs=@ }
// Longest-first so `<=`/`>=` win over `<`/`>`.
PP_RELATIONAL_OP: choice { "<=":@, ">=":@, "<":@, ">":@ }

PP_ADD: sequence dict { <PP_MUL>:lhs=@, repeat <PP_ADD_TAIL>:tail[]=@ }
PP_ADD_TAIL: sequence dict { <PP_ADD_OP>:op=@, <PP_MUL>:rhs=@ }
PP_ADD_OP: choice { "+":@, "-":@ }

PP_MUL: sequence dict { <PP_UNARY>:lhs=@, repeat <PP_MUL_TAIL>:tail[]=@ }
PP_MUL_TAIL: sequence dict { <PP_MUL_OP>:op=@, <PP_UNARY>:rhs=@ }
PP_MUL_OP: choice { "*":@, "/":@, "%":@ }

PP_UNARY: choice {
  <PP_NOT>,
  <PP_NEG>,
  <PP_PRIMARY>
}
PP_NOT: sequence dict { "!":type="not", <PP_UNARY>:operand=@ }
PP_NEG: sequence dict { "-":type="neg", <PP_UNARY>:operand=@ }

PP_PRIMARY: choice {
  <PP_DEFINED>,
  <PP_PAREN>,
  <PP_INT>,
  <PP_IDENT>
}

// `defined(NAME)` — the preprocessor's own predicate, not a host
// function. The walker / Python evaluator queries the macro table
// directly; the host doesn't need to provide any binding for
// `defined`.
PP_DEFINED: sequence dict {
  "defined":type="defined",
  "(", sv_identifier:name=@, ")"
}

// `(expr)` — grouping. Emits a `paren` node whose `inner` is the
// wrapped expression. The evaluator's `paren` handler just unwraps.
// Keeping the node visible in the AST means the round-trip
// (parse → host AST → re-save) preserves the user's parens for
// future surface-printing without inferring them from precedence.
PP_PAREN: sequence dict {
  "(":type="paren",
  <PP_EXPR>:inner=@,
  ")"
}

PP_INT: sequence dict { int:value=@:type="int" }

PP_IDENT: sequence dict { sv_identifier:name=@:type="ident" }
