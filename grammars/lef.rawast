// lef.rawast — LEF grammar (PoC subset)
//
// Top-level shape per the LEF/DEF 5.8 spec, §1 "Order of LEF
// Statements":
//
//   [VERSION statement]
//   [BUSBITCHARS statement]
//   [DIVIDERCHAR statement]
//   [UNITS statement]
//   [MANUFACTURINGGRID statement]
//   ...
//   [LAYER / VIA / VIARULE / NONDEFAULTRULE / SITE / MACRO] ...
//   [BEGINEXT] ...
//   [END LIBRARY]
//
// All three header statements are individually optional and, when
// present, must appear in this canonical order. LEF puts BUSBITCHARS
// before DIVIDERCHAR, opposite to DEF — see def.rawast.
//
// Body coverage: every LEF/DEF 5.8 base-spec block — UNITS (all 8
// sub-statements), MANUFACTURINGGRID, USEMINSPACING, FIXEDMASK,
// MAXVIASTACK, CLEARANCEMEASURE, PROPERTYDEFINITIONS, SPACING,
// SITE, LAYER (per-TYPE typed fields plus generic property
// fallback), VIA (geometry and VIARULE-based forms), VIARULE
// (LAYER-pair and GENERATE forms with typed sub-clauses),
// NONDEFAULTRULE, MACRO (full body: CLASS / FIXEDMASK / FOREIGN /
// EEQ / ORIGIN / SOURCE / SIZE / SYMMETRY / SITE / PIN list / OBS
// list / DENSITY / trailing PROPERTY list), PIN (every spec
// sub-statement plus multi-ANTENNA / multi-PROPERTY list capture),
// PORT/OBS layerGeometries (RECT/POLYGON/PATH/VIA-placement with
// MASK and ITERATE), BEGINEXT (raw vendor body via `*`).
//
// Out of scope here: LEF58_* PROPERTY content — captured opaquely
// as a string and meant to be re-parsed by a consumer-supplied
// `lef58.rawast` sub-grammar (rawast's `subparse=` primitive
// composes the two naturally).

use: std, lefdef

start: <LEF>

// === Top level ============================================================
//
// `LEF` (formerly `LIBRARY`) is the LEF file's top rule. The rename
// reserves `LIBRARY` for use as one of the PROPERTYDEFINITIONS
// object-kind keywords (line 230) and leaves room for a sibling
// `DEF` top rule to live in this same grammar later — `Grammar
// .parse_file(p, start="DEF")` would dispatch into DEF parsing
// from the same file, sharing the LEF/DEF common sub-rules
// (RECT_SHAPE, ANTENNA_KIND, NUMBER, identifier, …). Until DEF
// rules land, this is just a name change with no behaviour shift.
// The child rules (LIBRARY_ITEM, LIBRARY_ITEMS, END_LIBRARY) keep
// their names — they encode LEF spec terminology (the file's
// inner contents form the "library" of cells per the LEF/DEF 5.8
// reference; the file is closed by the spec literal `END LIBRARY`).
LEF ignore whitespace line_comment: sequence dict {
  <HDR>:hdr=@,
  <LIBRARY_ITEMS>:items=@,
  ?<END_LIBRARY>
}

// LEF spec puts BUSBITCHARS before DIVIDERCHAR; real files (e.g.
// sky130io_fill.lef) sometimes reverse them. `repeat <HDR_CMD>`
// accepts each line in any order. Pending NSEQ (M2), this is the
// pragmatic way to model "these statements, in any order."
HDR: sequence dict {
  ?<VERSION_CMD>,
  ?<NAMESCASESENSITIVE_CMD>,
  ?<NOWIREEXTENSIONATPIN_CMD>,
  repeat <HDR_CMD>
}
HDR_CMD: choice { <BUSBITCHARS_CMD>, <DIVIDERCHAR_CMD> }
// LEF/DEF 5.8 §"VERSION": `VERSION versionNumber ;` where
// versionNumber is a real number (5.8, 5.7, 5.6 …). Bound as
// <NUMBER> (not identifier) to match the spec's type and to give
// the parsed dict a numeric `version` field instead of a string.
VERSION_CMD:              sequence { "VERSION" space,              <NUMBER>:version=@ space,                    ";" newline }
NAMESCASESENSITIVE_CMD:   sequence { "NAMESCASESENSITIVE" space,   <ON_OFF>:names_case_sensitive=@ space,        ";" newline }
NOWIREEXTENSIONATPIN_CMD: sequence { "NOWIREEXTENSIONATPIN" space, <ON_OFF>:no_wire_extension_at_pin=@ space,    ";" newline }
BUSBITCHARS_CMD:          sequence { "BUSBITCHARS" space,          string:bus_bit_chars=@ space,                ";" newline }
DIVIDERCHAR_CMD:          sequence { "DIVIDERCHAR" space,          string:divider=@ space,                      ";" newline }

ON_OFF: choice {
  "ON":true,
  "OFF":false
}

END_LIBRARY: sequence { "END" space, "LIBRARY" newline }

LIBRARY_ITEMS: sequence array { repeat <LIBRARY_ITEM> }
LIBRARY_ITEM: choice {
  <UNITS_BLOCK>,
  <MANUFACTURINGGRID_CMD>,
  <CLEARANCEMEASURE_CMD>,
  <USEMINSPACING_CMD>,
  <FIXEDMASK_CMD>,
  <MAXVIASTACK_CMD>,
  <PROPERTYDEFINITIONS_BLOCK>,
  <LAYER_BLOCK>,
  <VIARULE_BLOCK>,
  <VIA_BLOCK>,
  <SPACING_BLOCK>,
  <SITE_BLOCK>,
  <NONDEFAULTRULE_BLOCK>,
  <MACRO_BLOCK>,
  <BEGINEXT_BLOCK>
}

// MAXVIASTACK maxStack [RANGE bottomLayer topLayer] ; — caps the
// number of VIAs that can stack vertically. Per LEF/DEF 5.8 spec.
MAXVIASTACK_CMD: sequence dict {
  "MAXVIASTACK":type="MaxViaStack" space,
  int:max_stack=@ space,
  ?<MAXVIASTACK_RANGE>,
  ";" newline
}

MAXVIASTACK_RANGE: sequence {
  "RANGE" space,
  identifier:range_bot=@ space,
  identifier:range_top=@ space
}

// BEGINEXT "extName" ... ENDEXT — vendor-extension wrapper. Inner
// content captured opaquely via the `*` raw-consume primitive
// (docs/rawast-format.md §4.5a); the literal `ENDEXT` keyword that
// follows is what tells the engine where to stop scanning. Round-
// trips byte-for-byte even when the inner content is in a vendor-
// specific language the grammar doesn't model.
BEGINEXT_BLOCK: sequence dict {
  "BEGINEXT":type="BeginExt" space,
  string:name=@,
  // The body's first byte is the newline after the name (since `*`
  // bypasses the ignore-set and starts at whatever raw cursor
  // position it inherits). No `newline` attr on the name above —
  // otherwise save would emit a doubled `\n` that re-parse would
  // capture as a leading newline in the body, breaking round-trip.
  *:body=@,
  "ENDEXT" newline
}

// FIXEDMASK ; — library-level marker per LEF/DEF 5.8 §"FixedMask".
// Single-keyword statement; emits `is_fixed_mask: true` for round-trip.
FIXEDMASK_CMD: sequence dict {
  "FIXEDMASK":type="FixedMask":is_fixed_mask=true space,
  ";" newline
}

// === Header-level statements ============================================

CLEARANCEMEASURE_CMD: sequence dict {
  "CLEARANCEMEASURE":type="ClearanceMeasure" space,
  identifier:value=@ space, ";" newline
}

USEMINSPACING_CMD: sequence dict {
  "USEMINSPACING":type="UseMinSpacing" space,
  identifier:object=@ space,
  identifier:value=@ space, ";" newline
}

// === SPACING block (tech LEF top-level inter-layer spacing) ============
//
// LEF/DEF 5.8 §"Spacing" — top-level SAMENET inter-layer spacing
// rules. Distinct from per-layer SPACING (inside a LAYER block).
//
//   SPACING
//     {SAMENET layerName1 layerName2 minSpacing [STACK] ;} ...
//   END SPACING

SPACING_BLOCK: sequence dict {
  "SPACING":type="Spacing" newline,
  <SAMENET_RULES>:items=@,
  "END" space, "SPACING" newline
}

SAMENET_RULES: sequence array { repeat <SAMENET_RULE> }

SAMENET_RULE: sequence dict {
  "SAMENET" space,
  identifier:layer1=@ space,
  identifier:layer2=@ space,
  <NUMBER>:min_spacing=@ space,
  ?<SAMENET_STACK_KW>,
  ";" newline
}

SAMENET_STACK_KW: sequence { "STACK":is_stack=true space }

// === PROPERTYDEFINITIONS block ==========================================
//
//   PROPERTYDEFINITIONS
//     {LAYER | LIBRARY | MACRO | VIA | VIARULE | NONDEFAULTRULE | PIN}
//       propName {INTEGER | REAL | STRING} [rangeOrValue] ;
//     ...
//   END PROPERTYDEFINITIONS

PROPERTYDEFINITIONS_BLOCK: sequence dict {
  "PROPERTYDEFINITIONS":type="PropertyDefinitions" newline,
  <PROPDEFS>:definitions=@,
  "END" space, "PROPERTYDEFINITIONS" newline
}

PROPDEFS: sequence array { repeat <PROPDEF> }

// Discriminate the object kind via a Choice so that "END" — also a
// valid lefdef identifier — fails the PROPDEF match immediately
// rather than greedily consuming "END PROPERTYDEFINITIONS MACRO"
// across three identifier slots before failing on the trailing `;`.
// Repeat's iteration-boundary backtracking is scheduled as M1
// follow-on work (§2.4); this grammar shape sidesteps the need.
PROPDEF: sequence dict {
  <PROPDEF_OBJECT>:object=@ space,
  identifier:prop_name=@ space,
  identifier:data_type=@ space,
  ?<PROPDEF_RANGE>,
  ?<PROPDEF_DEFAULT>,
  ";" newline
}

// Optional RANGE constraint per LEF/DEF 5.8 §"PropertyDefinitions":
// `RANGE min max` between the data-type and the optional default.
PROPDEF_RANGE: sequence {
  "RANGE" space,
  <NUMBER>:range_min=@ space,
  <NUMBER>:range_max=@ space
}

// Optional default value after the data-type. Real corpus files
// include a trailing default for STRING-typed properties:
//   LIBRARY LEF58_VOLTAGEMODE STRING "VOLTAGEMODE ABSOLUTE ; " ;
PROPDEF_DEFAULT: choice {
  string:default_value=@ space,
  <NUMBER>:default_value=@ space
}

// VIARULE must come before VIA — predictive PEG matches the first
// successful prefix, so "VIA" would greedily consume the "VIA" of
// "VIARULE" and the subsequent token-boundary check would fail.
// LEF/DEF 5.8 §"Property Definitions" scopes. The LEF reference
// covers LAYER / LIBRARY / MACRO / VIARULE / VIA / NONDEFAULTRULE
// / PIN; the DEF reference adds COMPONENTPIN / REGION / DESIGN /
// NET / SPECIALNET / ROW / GROUP. Real tool-emitted LEFs and
// DEFs use either set interchangeably for round-trip purposes
// (a LEF library shared with a DEF design block declares the
// DEF scopes here so the toolchain can validate properties end-
// to-end), so we accept the union.
//
// Order: longer-prefix-first to avoid Key prefix-matching
// hazards — NONDEFAULTRULE before NET (no overlap, just being
// careful); SPECIALNET before NET (clear prefix); COMPONENTPIN
// before COMPONENT (in case future scope is added); VIARULE
// before VIA (existing requirement).
PROPDEF_OBJECT: choice {
  "LAYER":@,
  "LIBRARY":@,
  "MACRO":@,
  "VIARULE":@,
  "VIA":@,
  "NONDEFAULTRULE":@,
  "SPECIALNET":@,
  "NET":@,
  "COMPONENTPIN":@,
  "PIN":@,
  "REGION":@,
  "DESIGN":@,
  "ROW":@,
  "GROUP":@
}

MANUFACTURINGGRID_CMD: sequence dict {
  "MANUFACTURINGGRID":type="ManufacturingGrid" space,
  <NUMBER>:value=@ space,
  ";" newline
}

// LEF coordinates and sizes are written either as integers (e.g.
// `ORIGIN 0 0 ;`) or as floats with a decimal point (e.g. `SIZE 0.56
// BY 3.92 ;`). The standard `float` terminal rejects bare integers
// (to avoid grammar ambiguity with `int`), so a choice rule covers
// both. Mirrors how CONSTANT in the .rawast meta-grammar handles
// numeric literals.
NUMBER: choice { float, int }

// === UNITS block ==========================================================
//
//   UNITS
//     [TIME NANOSECONDS factor ;]
//     [CAPACITANCE PICOFARADS factor ;]
//     [RESISTANCE OHMS factor ;]
//     [POWER MILLIWATTS factor ;]
//     [CURRENT MILLIAMPS factor ;]
//     [VOLTAGE VOLTS factor ;]
//     [DATABASE MICRONS dbu ;]
//     [FREQUENCY MEGAHERTZ factor ;]
//   END UNITS
//
// Per LEF/DEF 5.8 spec §"Units", each sub-statement is independently
// optional. Real files use varying orderings (Sky130 tech LEF opens
// with TIME, not DATABASE), so we accept them in any order via the
// permissive `repeat <UNITS_SUB>` form. Values are NUMBER (int | float).
// Spec doesn't require any particular sub-statement, so a bare
// `UNITS\nEND UNITS` would parse.

UNITS_BLOCK: sequence dict {
  "UNITS":type="Units" newline,
  repeat <UNITS_SUB>,
  "END" space, "UNITS" newline
}

UNITS_SUB: choice {
  <DATABASE_CMD>,
  <CAPACITANCE_CMD>,
  <CURRENT_CMD>,
  <RESISTANCE_CMD>,
  <TIME_CMD>,
  <POWER_CMD>,
  <VOLTAGE_CMD>,
  <FREQUENCY_CMD>
}

DATABASE_CMD:    sequence { "DATABASE"    space, "MICRONS"     space, int:database_microns=@ space, ";" newline }
CAPACITANCE_CMD: sequence { "CAPACITANCE" space, "PICOFARADS"  space, <NUMBER>:capacitance_pf=@  space, ";" newline }
CURRENT_CMD:     sequence { "CURRENT"     space, "MILLIAMPS"   space, <NUMBER>:current_ma=@      space, ";" newline }
RESISTANCE_CMD:  sequence { "RESISTANCE"  space, "OHMS"        space, <NUMBER>:resistance_ohms=@ space, ";" newline }
TIME_CMD:        sequence { "TIME"        space, "NANOSECONDS" space, <NUMBER>:time_ns=@         space, ";" newline }
POWER_CMD:       sequence { "POWER"       space, "MILLIWATTS"  space, <NUMBER>:power_mw=@        space, ";" newline }
VOLTAGE_CMD:     sequence { "VOLTAGE"     space, "VOLTS"       space, <NUMBER>:voltage_v=@       space, ";" newline }
FREQUENCY_CMD:   sequence { "FREQUENCY"   space, "MEGAHERTZ"   space, <NUMBER>:frequency_mhz=@   space, ";" newline }

// === SITE block ===========================================================
//
//   SITE siteName
//     [CLASS {PAD | CORE} ;]
//     [SYMMETRY {X | Y | R90} ... ;]
//     [ROWPATTERN siteName orient ... ;]
//     [SIZE width BY height ;]
//   END siteName
//
// Spec deviation, knowingly tolerated:
//   - LEF/DEF 5.8 §"Site" marks `CLASS` and `SIZE` as REQUIRED (no
//     brackets in the spec BNF), and orders sub-statements
//     canonically as CLASS → SYMMETRY → ROWPATTERN → SIZE. The
//     current `repeat <SITE_PROPERTY>` formulation makes both
//     required clauses optional and accepts them in any order.
//   - This is deliberate: real corpora diverge from canonical order
//     (hybrid_sites.lef opens with SYMMETRY; yod_V2.1.0.beta.2.lef
//     uses CLASS → SYMMETRY → SIZE), and a SITE missing CLASS or
//     SIZE is malformed but the grammar can't enforce "at least one
//     of each, in any order" without the NSEQ primitive (M2 scope).
//   - Spec-strict tightening — CLASS-required-first, SIZE-required-
//     last — is deferred until NSEQ lands (M2). Until then the
//     downstream Pydantic model has `class`, `width`, `height` as
//     Optional even though the spec says required.
SITE_BLOCK: sequence dict {
  "SITE":type="Site" space,
  identifier:name=@ newline,
  repeat <SITE_PROPERTY>,
  "END" space, identifier:end_name=@ newline
}

// LEF/DEF 5.8 §"Site" body sub-statements. SITE_PROPERTY_KV
// captures the trailing `PROPERTY name value ;` clauses the spec
// permits — emitted as a discriminated dict that catcher-flattens
// into the parent SITE dict via list-append, alongside the typed
// fields CLASS / SYMMETRY / SIZE / ROWPATTERN.
SITE_PROPERTY: choice {
  <SITE_SYMMETRY>,
  <SITE_CLASS>,
  <SITE_SIZE>,
  <SITE_ROWPATTERN>,
  <SITE_PROPERTY_KV>:properties[]=@
}

SITE_PROPERTY_KV: sequence dict {
  "PROPERTY":type="Property" space,
  identifier:prop_name=@ space,
  <PROPERTY_VALUE>:prop_value=@ space,
  ";" newline
}

SITE_SYMMETRY: sequence {
  "SYMMETRY" space,
  <SYMMETRY_LIST>:symmetry=@,
  ";" newline
}
SYMMETRY_LIST: sequence array { repeat identifier space }

SITE_CLASS: sequence {
  "CLASS" space,
  identifier:class=@ space,
  ";" newline
}

SITE_SIZE: sequence {
  "SIZE" space,
  <NUMBER>:width=@ space,
  "BY" space,
  <NUMBER>:height=@ space,
  ";" newline
}

SITE_ROWPATTERN: sequence {
  "ROWPATTERN" space,
  <ROWPATTERN_LIST>:rowpattern=@,
  ";" newline
}
ROWPATTERN_LIST: sequence array { repeat <ROWPATTERN_PAIR> }
ROWPATTERN_PAIR: sequence dict {
  identifier:site=@ space,
  <SITE_ORIENT>:orient=@ space
}

SITE_ORIENT: choice {
  "N":"North",
  "S":"South",
  "E":"East",
  "W":"West",
  "FN":"FlipNorth",
  "FS":"FlipSouth",
  "FE":"FlipEast",
  "FW":"FlipWest"
}

// === MACRO block =========================================================
//
//   MACRO macroName
//     [CLASS class [subclass] ;]
//     [ORIGIN x y ;]
//     [FOREIGN cellName x y ;]
//     [SIZE width BY height ;]
//     [SYMMETRY {X | Y | R90} ... ;]
//     [SITE siteName ;]
//     [PIN ...] ...
//     [OBS ...]
//   END macroName
//
// PoC subset of the LEF/DEF 5.8 §6 MACRO definition. Optional
// sub-statements appear in spec-canonical order; the strict-order
// limitation awaits NSEQ (M2).

// MACRO body structure per LEF/DEF 5.8 §"Macro":
//   MACRO name
//     [<sub-properties: CLASS / ORIGIN / FOREIGN / SIZE /
//                       SYMMETRY / SITE>] ...
//     [PIN ...] ...
//     [OBS]
//     [DENSITY]
//     [PROPERTY ...] ...
//   END name
// PROPERTY clauses can appear at the START of the MACRO body
// (asap7 fakeram, NanGate older variants), interleaved with the
// typed sub-statements, OR at the END (LEF/DEF 5.8 §"Macro"
// canonical position). Both positions land in the same
// `properties` list via `:properties[]=@` list-append bindings:
// the inline form is one alternative of the MACRO_PROPERTY Choice
// (caught by the leading `repeat <MACRO_PROPERTY>`); the trailing
// form is the trailing `repeat <MACRO_PROPERTY_KV>:properties[]=@`
// after PIN/OBS/DENSITY. Both append to the same `properties`
// slot.
MACRO_BLOCK: sequence dict {
  "MACRO":type="Macro" space,
  identifier:name=@ newline,
  repeat <MACRO_PROPERTY>,
  <MACRO_PINS>:pins=@,
  <MACRO_OBSES>:obses=@,
  ?<MACRO_DENSITY>:density=@,
  // Trailing PROPERTY clauses (after PIN/OBS/DENSITY) per LEF/DEF
  // 5.8 §"Macro". LEF58 form tried first so it routes to `lef58`
  // alongside any LEF58 clauses caught by the leading inline
  // `repeat <MACRO_PROPERTY>`; non-LEF58 PROPERTY clauses fall
  // through to the generic KV form and land in `properties`.
  repeat <MACRO_TRAILING_PROPERTY>,
  "END" space, identifier:end_name=@ newline
}

MACRO_TRAILING_PROPERTY: choice {
  <MACRO_LEF58_PROPERTY>:lef58[]=@,
  <MACRO_PROPERTY_KV>:properties[]=@
}

// LEF/DEF 5.8 §"Macro" allows zero-or-more OBS sections per MACRO.
// Earlier `?<MACRO_OBS>:obs=@` only captured one. Real PDKs do
// emit multi-OBS in fill cells and IO pads where different metal
// layers carry different obstruction shapes that the designer
// wants kept structurally separate.
MACRO_OBSES: sequence array { repeat <MACRO_OBS> }

// MACRO sub-statements in any order — same pattern as HDR_CMD.
// Pending NSEQ (M2), this is the pragmatic way to accept real LEFs
// that don't follow the spec's CLASS → ORIGIN → FOREIGN → SIZE →
// SYMMETRY → SITE canonical ordering.
MACRO_PROPERTY: choice {
  <MACRO_CLASS>,
  <MACRO_FIXEDMASK>,
  <MACRO_FOREIGN>:foreigns[]=@,
  <MACRO_EEQ>,
  <ORIGIN_CMD>:origin=@,
  <MACRO_SIZE>,
  <MACRO_SYMMETRY>,
  <MACRO_SITE_REF>:sites[]=@,
  <MACRO_SOURCE>,
  <MACRO_LEF58_PROPERTY>:lef58[]=@,
  <MACRO_PROPERTY_KV>:properties[]=@
}

// EEQ macroName ; — equivalent-macro reference per LEF/DEF 5.8
// §"Macro". Container-less; emits `eeq` field on parent MACRO.
MACRO_EEQ: sequence {
  "EEQ" space, identifier:eeq=@ space, ";" newline
}

// FIXEDMASK at MACRO level — distinct from library-level
// FIXEDMASK_CMD; marks the macro as having a fixed mask shift.
MACRO_FIXEDMASK: sequence {
  "FIXEDMASK":is_fixed_mask=true space, ";" newline
}

// DENSITY block: LAYER name followed by one-or-more `RECT pt pt
// density ;` clauses, per LEF/DEF 5.8 §"Density". Used in fill cells.
MACRO_DENSITY: sequence dict {
  "DENSITY":type="Density" newline,
  <MACRO_DENSITY_LAYERS>:layers=@,
  "END" newline
}

MACRO_DENSITY_LAYERS: sequence array { repeat <MACRO_DENSITY_LAYER> }

MACRO_DENSITY_LAYER: sequence dict {
  "LAYER" space, identifier:layer=@ space, ";" newline,
  <MACRO_DENSITY_RECTS>:rects=@
}

MACRO_DENSITY_RECTS: sequence array { repeat+ <MACRO_DENSITY_RECT> }

// DENSITY-block RECT carries a trailing `density` number that
// distinguishes it from the bare RECT_SHAPE used everywhere else.
// The `type` discriminator is `DensityRect` (not `Rect`) so that
// downstream Pydantic discriminated unions can dispatch on `type`
// alone — otherwise a `RectShape | DensityRect` union would be
// ambiguous on the shared discriminator.
MACRO_DENSITY_RECT: sequence dict {
  "RECT":type="DensityRect" space,
  <NUMBER>:x1=@ space, <NUMBER>:y1=@ space,
  <NUMBER>:x2=@ space, <NUMBER>:y2=@ space,
  <NUMBER>:density=@ space,
  ";" newline
}

// SOURCE was a MACRO sub-statement in LEF 5.6 and earlier; the spec
// dropped it post-5.6 but real PDKs still emit it (Sky130 5.5 IO
// pads use `SOURCE USER ;`). Accepted as a permissive deprecated-
// form pass-through so we can parse real corpus files.
MACRO_SOURCE: sequence {
  "SOURCE" space,
  identifier:source=@ space,
  ";" newline
}

// MACRO-scope LEF58_* PROPERTY — same shape as LAYER and PIN
// LEF58 rules. `name` is the LEF58 sub-property (e.g. PWRPLUS,
// VOLTAGE), the LEF58_ prefix is implicit in the Lef58Property
// type discriminator.
MACRO_LEF58_PROPERTY: sequence dict {
  "PROPERTY" space,
  "LEF58_":type="Lef58Property",
  identifier:name=@ space,
  string:content=@ space,
  ";" newline
}

// User-defined PROPERTY clauses — names declared in
// PROPERTYDEFINITIONS, values typed per the declaration. Per LEF
// spec, the value can be INTEGER, REAL, or STRING.
MACRO_PROPERTY_KV: sequence dict {
  "PROPERTY" space,
  identifier:prop_name=@ space,
  <PROPERTY_VALUE>:prop_value=@ space,
  ";" newline
}

PROPERTY_VALUE: choice {
  <NUMBER>,
  string
}

MACRO_CLASS: sequence {
  "CLASS" space,
  <CLASS_LIST>:class=@,
  ";" newline
}
// `space` postfix on the identifier — the engine auto-skips
// whitespace between tokens on parse but needs an explicit
// separator on save. Without it `["PAD", "POWER"]` (from
// `CLASS PAD POWER ;`) round-trips as `CLASS PADPOWER ;` and
// reparses as a single one-word class.
CLASS_LIST: sequence array { repeat identifier space }

// Dict-container so callers bind it as `:origin=@`, landing on the
// parent dict as `origin: {x, y}`. Shared between MACRO ORIGIN and
// VIA-VIARULE-form ORIGIN — the spec body is identical.
ORIGIN_CMD: sequence dict {
  "ORIGIN" space,
  <NUMBER>:x=@ space, <NUMBER>:y=@ space,
  ";" newline
}

// FOREIGN — cell name plus optional (x,y) offset. Real LEFs use both
// forms: `FOREIGN cellName ;` and `FOREIGN cellName 0 0 ;`. Spec
// allows multiple FOREIGN clauses per MACRO; bound via `:foreigns[]=@`
// in MACRO_PROPERTY so all of them land in a list of {cell, x?, y?}.
MACRO_FOREIGN: sequence dict {
  "FOREIGN" space,
  identifier:cell=@ space,
  ?<MACRO_FOREIGN_XY>,
  ";" newline
}
// LEF/DEF 5.8 §"Macro" FOREIGN syntax:
//   FOREIGN cellName [( x y ) [orient]] [STRUCTURE] ;
// The xy pair is bare numbers (not parenthesised); orient is one
// of N / S / E / W / FN / FS / FE / FW. STRUCTURE is a rarely-
// used legacy keyword pending real-corpus exposure. Captured as
// optional `orient` field — absent when not present.
MACRO_FOREIGN_XY: sequence {
  <NUMBER>:x=@ space, <NUMBER>:y=@ space,
  ?<MACRO_FOREIGN_ORIENT>
}
MACRO_FOREIGN_ORIENT: sequence {
  identifier:orient=@ space
}

MACRO_SIZE: sequence {
  "SIZE" space,
  <NUMBER>:width=@ space,
  "BY" space,
  <NUMBER>:height=@ space,
  ";" newline
}

MACRO_SYMMETRY: sequence {
  "SYMMETRY" space,
  <SYMMETRY_LIST>:symmetry=@,
  ";" newline
}

// SITE reference inside a MACRO (not a SITE block definition).
// Spec allows multiple `SITE` clauses per MACRO; bound via
// `:sites[]=@` in MACRO_PROPERTY so all of them land in a list.
MACRO_SITE_REF: sequence dict {
  "SITE" space, identifier:name=@ space, ";" newline
}

// === PIN inside MACRO ====================================================

MACRO_PINS: sequence array { repeat <PIN_BLOCK> }

// PIN block — per LEF/DEF 5.8 spec carries DIRECTION / USE plus
// zero-or-more ANTENNA* clauses (model-specific antenna properties
// per layer) before its PORTs. PIN_PROPERTY is the open-ended
// repeat over these optional sub-statements; PORTs follow.
PIN_BLOCK: sequence dict {
  "PIN":type="Pin" space,
  identifier:name=@ newline,
  repeat <PIN_PROPERTY>,
  <PIN_PORTS>:ports=@,
  "END" space, identifier:end_name=@ newline
}

// LEF58_-prefixed PROPERTY clauses inside a PIN get the typed
// Lef58Property shape via the dedicated <PIN_LEF58_PROPERTY>
// alt — same pattern as LAYER_LEF58_PROPERTY. Listed BEFORE
// PIN_PROPERTY_KV so the prefix wins under predictive PEG; non-
// LEF58 PROPERTY clauses fall through to the generic alt.
PIN_PROPERTY: choice {
  <PIN_DIRECTION>,
  <PIN_USE>,
  <PIN_SHAPE>,
  <PIN_TAPERRULE>,
  <PIN_NETEXPR>,
  <PIN_SUPPLYSENSITIVITY>,
  <PIN_GROUNDSENSITIVITY>,
  <PIN_MUSTJOIN>,
  <PIN_LEF58_PROPERTY>:lef58[]=@,
  <PIN_PROPERTY_KV>:properties[]=@,
  <PIN_ANTENNA_PROP>:antennas[]=@
}

// PIN-scope LEF58_* PROPERTY clauses. Distinct from
// PIN_PROPERTY_KV: the `LEF58_` Key literal is the discriminator
// (no separate terminal parser); `name` captures only the suffix
// (e.g. `VOLTAGE`, `PWRPLUS`), the prefix is encoded in the
// `type="Lef58Property"` field. Inner content opaque per design.
PIN_LEF58_PROPERTY: sequence dict {
  "PROPERTY" space,
  "LEF58_":type="Lef58Property",
  identifier:name=@ space,
  string:content=@ space,
  ";" newline
}

// SUPPLYSENSITIVITY / GROUNDSENSITIVITY per LEF/DEF 5.8 §"Pin" —
// name a power/ground pin this signal pin is sensitive to.
// Container-less, catcher-flatten.
PIN_SUPPLYSENSITIVITY: sequence {
  "SUPPLYSENSITIVITY" space,
  identifier:supply_sensitivity=@ space,
  ";" newline
}
PIN_GROUNDSENSITIVITY: sequence {
  "GROUNDSENSITIVITY" space,
  identifier:ground_sensitivity=@ space,
  ";" newline
}

// MUSTJOIN pinName ; — declares the pin must be joined with another.
PIN_MUSTJOIN: sequence {
  "MUSTJOIN" space,
  identifier:must_join=@ space,
  ";" newline
}

// PIN-level PROPERTY clauses (declared in PROPERTYDEFINITIONS).
// Dict-container so PIN_PROPERTY's `:properties[]=@` binding appends
// each `{name, value}` dict to the PIN's `properties` list — multiple
// PROPERTY clauses per PIN round-trip losslessly.
PIN_PROPERTY_KV: sequence dict {
  "PROPERTY" space,
  identifier:name=@ space,
  <PROPERTY_VALUE>:value=@ space,
  ";" newline
}

// DIRECTION per LEF spec:
//   {INPUT | OUTPUT [TRISTATE] | INOUT | FEEDTHRU}
// The TRISTATE qualifier after OUTPUT is optional.
PIN_DIRECTION: sequence {
  "DIRECTION" space, identifier:direction=@ space,
  ?identifier:direction_modifier=@ space,
  ";" newline
}

PIN_USE: sequence {
  "USE" space, identifier:use=@ space, ";" newline
}

PIN_SHAPE: sequence {
  "SHAPE" space, identifier:shape=@ space, ";" newline
}

PIN_TAPERRULE: sequence {
  "TAPERRULE" space, identifier:taper_rule=@ space, ";" newline
}

PIN_NETEXPR: sequence {
  "NETEXPR" space, string:net_expr=@ space, ";" newline
}

// ANTENNA* properties — the LEF spec defines ~10 variants
// (ANTENNADIFFAREA, ANTENNAGATEAREA, ANTENNAPARTIALMETALAREA,
// ANTENNAPARTIALMETALSIDEAREA, ANTENNAMAXAREACAR,
// ANTENNAMAXSIDEAREACAR, ANTENNAMAXCUTCAR, ANTENNAPARTIALCUTAREA,
// ANTENNAMODEL, ANTENNAANYDIFFAREA). All share the same
// `KEYWORD value [LAYER layerName] ;` shape, so a single generic
// rule captures the keyword as `antenna_kind`.
// ANTENNA value is usually a number (area or factor) but for
// ANTENNAMODEL it's an identifier (OXIDE1 / OXIDE2 / OXIDE3 /
// OXIDE4). Choice keeps both forms.
//
// Dict-container — each match emits a {antenna_kind, value,
// antenna_layer?} dict. PIN_PROPERTY's `:antennas[]=@` binding
// (engine list-append, see meta-grammar `[]` suffix) appends each
// dict to a `antennas` list on the parent PIN. So a PIN with
// multiple ANTENNA clauses of any kind round-trips losslessly.
PIN_ANTENNA_PROP: sequence dict {
  <PIN_ANTENNA_KIND>:kind=@ space,
  <PIN_ANTENNA_VALUE>:value=@ space,
  ?<PIN_ANTENNA_LAYER>,
  ";" newline
}

PIN_ANTENNA_VALUE: choice {
  <NUMBER>,
  identifier
}

// Discriminator longer-prefix-first: PARTIALMETALSIDEAREA must come
// before PARTIALMETALAREA, MAXSIDEAREACAR before MAXAREACAR, and
// ANYDIFFAREA before DIFFAREA, or predictive PEG will match the
// shorter prefix and fail at the next token.
//
// The trailing block holds the LEF 5.4-era deprecated forms.
// LEF/DEF 5.8 §"Pin" lists them as DEPRECATED (replaced by
// ANTENNAGATEAREA / ANTENNADIFFAREA), but they still appear in
// older PDK LEFs that were never re-emitted by a modern tool.
// Each maps to its own discriminator so downstream consumers can
// distinguish deprecated from current forms.
PIN_ANTENNA_KIND: choice {
  "ANTENNAPARTIALMETALSIDEAREA":"PartialMetalSideArea",
  "ANTENNAPARTIALMETALAREA":"PartialMetalArea",
  "ANTENNAPARTIALCUTAREA":"PartialCutArea",
  "ANTENNAMAXSIDEAREACAR":"MaxSideAreaCar",
  "ANTENNAMAXAREACAR":"MaxAreaCar",
  "ANTENNAMAXCUTCAR":"MaxCutCar",
  "ANTENNAANYDIFFAREA":"AnyDiffArea",
  "ANTENNADIFFAREA":"DiffArea",
  "ANTENNAGATEAREA":"GateArea",
  "ANTENNAINPUTGATEAREA":"InputGateAreaLegacy",
  "ANTENNAINPUTDIFFAREA":"InputDiffAreaLegacy",
  "ANTENNAOUTPUTDIFFAREA":"OutputDiffAreaLegacy",
  "ANTENNAINOUTDIFFAREA":"InOutDiffAreaLegacy",
  "ANTENNAMODEL":"Model"
}

PIN_ANTENNA_LAYER: sequence {
  "LAYER" space, identifier:layer=@ space
}

PIN_PORTS: sequence array { repeat <PORT_BLOCK> }

// PORT is a sequence of layer groups: each group is a LAYER statement
// followed by one-or-more shapes on that layer.

// PORT carries an optional CLASS clause before its LAYER groups per
// LEF/DEF 5.8 spec: `PORT [CLASS {NONE | CORE | BUMP} ;] {LAYER ...} ... END`.
PORT_BLOCK: sequence dict {
  "PORT":type="Port" newline,
  ?<PORT_CLASS>,
  <LAYER_GROUPS>:layer_groups=@,
  "END" newline
}

PORT_CLASS: sequence {
  "CLASS" space, identifier:port_class=@ space, ";" newline
}

LAYER_GROUPS: sequence array { repeat <LAYER_GROUP> }

// LAYER declaration inside a PORT or OBS block. Can carry optional
// EXCEPTPGNET / SPACING / DESIGNRULEWIDTH / MASK modifiers per LEF/DEF
// 5.8 spec before the `;`, then optional WIDTH statement, then 1+
// shape clauses (RECT / POLYGON / PATH / VIA placement).
LAYER_GROUP: sequence dict {
  "LAYER" space, identifier:layer=@ space,
  repeat <LAYER_GROUP_MOD>,
  ";" newline,
  ?<LAYER_WIDTH_CMD>,
  <SHAPES>:shapes=@
}

LAYER_GROUP_MOD: choice {
  <LAYER_GROUP_EXCEPTPGNET>,
  <LAYER_GROUP_SPACING>,
  <LAYER_GROUP_DESIGNRULEWIDTH>,
  <MASK_MOD>
}

LAYER_GROUP_EXCEPTPGNET:     sequence { "EXCEPTPGNET":except_pg_net=true space }
LAYER_GROUP_SPACING:         sequence { "SPACING"         space, <NUMBER>:spacing=@           space }
LAYER_GROUP_DESIGNRULEWIDTH: sequence { "DESIGNRULEWIDTH" space, <NUMBER>:design_rule_width=@ space }
// LAYER-level MASK uses the same MASK_MOD rule as per-shape MASK
// (both emit `mask_num` to the parent — LAYER_GROUP dict in this
// context, shape dict in the RECT/POLYGON/PATH/VIA contexts).

// Per-LAYER-group WIDTH statement — sets the default wire width for
// subsequent shapes (separate from LAYER's MASK / SPACING modifiers).
LAYER_WIDTH_CMD: sequence {
  "WIDTH" space, <NUMBER>:width=@ space, ";" newline
}

SHAPES: sequence array { repeat <SHAPE> }
SHAPE: choice {
  <RECT_SHAPE>,
  <POLYGON_SHAPE>,
  <PATH_SHAPE>,
  <VIA_PLACEMENT>
}

// MASK modifier (per-shape mask number, separate from layer-level MASK).
MASK_MOD: sequence {
  "MASK" space, int:mask_num=@ space
}

// ITERATE prefix marker. When present, the shape becomes a step-
// repeated array of itself; the step pattern follows the geometry.
ITERATE_PREFIX: sequence {
  "ITERATE":is_iterate=true space,
  ?<MASK_MOD>
}

// stepPattern per LEF/DEF 5.8 — `numX numY xStep yStep` trailing
// the geometry when ITERATE was declared.
STEP_PATTERN: sequence dict {
  int:step_num_x=@ space, int:step_num_y=@ space,
  <NUMBER>:step_x=@ space, <NUMBER>:step_y=@ space
}

RECT_SHAPE: sequence dict {
  "RECT":type="Rect" space,
  ?<MASK_MOD>,
  ?<ITERATE_PREFIX>,
  <NUMBER>:x1=@ space, <NUMBER>:y1=@ space,
  <NUMBER>:x2=@ space, <NUMBER>:y2=@ space,
  ?<STEP_PATTERN>:step_pattern=@,
  ";" newline
}

POLYGON_SHAPE: sequence dict {
  "POLYGON":type="Polygon" space,
  ?<MASK_MOD>,
  ?<ITERATE_PREFIX>,
  <POLYGON_POINTS>:points=@,
  ?<STEP_PATTERN>:step_pattern=@,
  ";" newline
}
// POLYGON_POINTS' `repeat <NUMBER>` is greedy with no delimiter,
// so for the spec's `POLYGON [MASK n] ITERATE … x1 y1 … xn yn
// numX numY xStep yStep ;` form, the trailing four step-pattern
// numbers get swept into `points` and `step_pattern` ends up
// absent. Same limitation on PATH ITERATE. `is_iterate=true` is
// still set so consumers know to split the last four numbers
// themselves. VIA placement ITERATE is unaffected because the
// `viaName` identifier between coords and step pattern acts as
// the delimiter the grammar can lock onto.
POLYGON_POINTS: sequence array { repeat <NUMBER> space }

// PATH — segmented line with point list per LEF/DEF 5.8 §"Path".
//
// NOTE: same ITERATE step-pattern collision as POLYGON_SHAPE
// (above) — PATH_POINTS' `repeat+ <NUMBER>` is greedy with no
// delimiter, so for the `PATH [MASK n] ITERATE … numX numY xStep
// yStep ;` form, the trailing four step-pattern numbers get
// swept into `points` and `step_pattern` ends up absent.
// `is_iterate=true` is still set so consumers can split the
// last four numbers themselves.
PATH_SHAPE: sequence dict {
  "PATH":type="Path" space,
  ?<MASK_MOD>,
  ?<ITERATE_PREFIX>,
  <PATH_POINTS>:points=@,
  ?<STEP_PATTERN>:step_pattern=@,
  ";" newline
}
PATH_POINTS: sequence array { repeat+ <NUMBER> space }

// VIA placement inside a port / obs layer group: `VIA [MASK n] pt
// viaName ;` per LEF/DEF 5.8. Distinct from VIA_BLOCK definitions
// and VIA_LAYER_GROUP at VIA-definition level.
VIA_PLACEMENT: sequence dict {
  "VIA":type="ViaPlacement" space,
  ?<MASK_MOD>,
  ?<ITERATE_PREFIX>,
  <NUMBER>:x=@ space, <NUMBER>:y=@ space,
  identifier:via_name=@ space,
  ?<STEP_PATTERN>:step_pattern=@,
  ";" newline
}

// === OBS (obstructions) — MACRO-level; same layer-group structure ========

MACRO_OBS: sequence dict {
  "OBS":type="Obs" newline,
  <LAYER_GROUPS>:layer_groups=@,
  "END" newline
}

// === LAYER block (tech LEF) ==============================================
//
// LEF/DEF 5.8 §"Layer" definitions — opener + TYPE + many optional
// property clauses + closer. Real tech LEFs have dozens of clauses
// per layer covering routing/cut/via/masterslice/implant/overlap
// types, design-rule constraints, electrical properties, and
// LEF58_* property assignments.
//
// PoC approach: enumerate the common property keywords as a Choice;
// each clause captures the keyword as `kind` and the trailing
// `<values>` (numbers, identifiers, or quoted strings) until `;`.
// Stop-condition is the closing `END <name>`: the keyword Choice
// excludes "END", so the repeat exits cleanly when it sees the
// closing.
//
// PoC omission: LEF58 spec extensions (PROPERTY name "..."
// embedded clauses are captured but their internal grammar isn't
// re-parsed; full LEF58 support is M4 work).

// Per-TYPE structured properties — the ~10 most common LAYER
// keywords across real PDKs (Sky130, NanGate, IHP130) are
// extracted as typed fields catcher-flattened onto the LAYER dict;
// everything else (RESISTANCE / CAPACITANCE qualifiers,
// ANTENNA*RATIO, SPACINGTABLE, MINSTEP, PWL variants, LEF58_*
// PROPERTY, …) falls into the generic `properties: list[{kind,
// values}]` pass-through. Downstream Pydantic consumers can read
// `layer.width` / `layer.pitch.x` / `layer.direction` etc.
// directly without walking a flat property list.
LAYER_BLOCK: sequence dict {
  "LAYER":type="Layer" space,
  identifier:name=@ newline,
  repeat <LAYER_BODY_ITEM>,
  "END" space, identifier:end_name=@ newline
}

LAYER_BODY_ITEM: choice {
  <LAYER_TYPE_CMD>,
  <DIRECTION_CMD>,
  <LAYER_PITCH_CMD>:pitch=@,
  <LAYER_OFFSET_CMD>:offset=@,
  <LAYER_WIDTH_CLAUSE>,
  <LAYER_AREA_CMD>,
  <LAYER_THICKNESS_CMD>,
  <LAYER_EDGECAPACITANCE_CMD>,
  <LAYER_MAXIMUMDENSITY_CMD>,
  <LAYER_MINIMUMDENSITY_CMD>,
  <LAYER_DENSITYCHECKWINDOW_CMD>:density_check_window=@,
  <LAYER_DENSITYCHECKSTEP_CMD>,
  <LAYER_LEF58_PROPERTY>:lef58[]=@,
  <LAYER_PROPERTY>:properties[]=@
}

// PROPERTY clauses whose name starts with `LEF58_` get their own
// typed sub-rule so downstream consumers can iterate `layer.lef58`
// directly instead of filtering `layer.properties` by name. The
// `LEF58_` Key literal IS the discriminator — predictive PEG
// tries this alt first; if the input PROPERTY name doesn't start
// with `LEF58_`, the Key fails and the engine falls through to
// the generic LAYER_PROPERTY rule with no input lost (Choice alt
// mark/rewind).
//
// Shape choice: `name` is the LEF58 sub-property (e.g. `TYPE`,
// `SPACING`, `VOLTAGEMODE`), NOT the full `LEF58_TYPE` string —
// the `LEF58_` prefix is implicit in the `type="Lef58Property"`
// discriminator (set by the `:type="..."` binding on the Key) so
// duplicating it in `name` would just be redundant. Downstream
// reconstructs the full original token as `f"LEF58_{name}"` if
// needed.
//
// The inner content string remains opaque per the existing scope
// decision ([[feedback-rawast-design-lef58-out-of-scope]]).
LAYER_LEF58_PROPERTY: sequence dict {
  "PROPERTY" space,
  "LEF58_":type="Lef58Property",
  identifier:name=@ space,
  string:content=@ space,
  ";" newline
}

LAYER_TYPE_CMD:                  sequence { "TYPE"                  space, identifier:layer_type=@        space, ";" newline }
// DIRECTION applies to LAYER (HORIZONTAL/VERTICAL) and to
// VIARULE GENERATE routing-layer sections — same grammar.
DIRECTION_CMD:                   sequence { "DIRECTION"             space, identifier:direction=@         space, ";" newline }
LAYER_AREA_CMD:                  sequence { "AREA"                  space, <NUMBER>:area=@                space, ";" newline }
LAYER_THICKNESS_CMD:             sequence { "THICKNESS"             space, <NUMBER>:thickness=@           space, ";" newline }
LAYER_EDGECAPACITANCE_CMD:       sequence { "EDGECAPACITANCE"       space, <NUMBER>:edge_capacitance=@    space, ";" newline }
LAYER_MAXIMUMDENSITY_CMD:        sequence { "MAXIMUMDENSITY"        space, <NUMBER>:maximum_density=@     space, ";" newline }
LAYER_MINIMUMDENSITY_CMD:        sequence { "MINIMUMDENSITY"        space, <NUMBER>:minimum_density=@     space, ";" newline }
LAYER_DENSITYCHECKSTEP_CMD:      sequence { "DENSITYCHECKSTEP"      space, <NUMBER>:density_check_step=@  space, ";" newline }

// PITCH and OFFSET have either 1 or 2 numbers per spec. Bound as
// nested dicts so the parsed shape reads `pitch: {x, y?}` /
// `offset: {x, y?}` instead of `pitch_x` / `pitch_y` flat.
LAYER_PITCH_CMD: sequence dict {
  "PITCH" space, <NUMBER>:x=@ space, ?<NUMBER>:y=@ space, ";" newline
}
LAYER_OFFSET_CMD: sequence dict {
  "OFFSET" space, <NUMBER>:x=@ space, ?<NUMBER>:y=@ space, ";" newline
}

// DENSITYCHECKWINDOW has two numbers — nested for consistency.
LAYER_DENSITYCHECKWINDOW_CMD: sequence dict {
  "DENSITYCHECKWINDOW" space, <NUMBER>:x=@ space, <NUMBER>:y=@ space, ";" newline
}

// WIDTH inside LAYER_BLOCK is a single-number sub-clause (not the
// same as the per-PORT WIDTH statement bound to `default_width`).
// Distinct name to avoid the LAYER-WIDTH / LAYER_GROUP-WIDTH overlap.
LAYER_WIDTH_CLAUSE: sequence { "WIDTH" space, <NUMBER>:width=@ space, ";" newline }

// Everything else — SPACING / SPACINGTABLE / RESISTANCE w/qualifier /
// CAPACITANCE w/qualifier / ANTENNA* / PROPERTY (LEF58_*) / etc. —
// falls into the generic property list. `properties[]=@` appends one
// per match, so multiples round-trip losslessly.
LAYER_PROPERTY: sequence dict {
  <LAYER_KEYWORD>:kind=@ space,
  <LAYER_VALUES>:values=@,
  ";" newline
}

// LAYER value tokens: each can be a number, an identifier (TYPE
// values like ROUTING / CUT / IMPLANT, sub-keywords like RPERSQ /
// CPERSQDIST), a quoted string (PROPERTY values), or a
// parenthesized list of values (PWL piecewise-linear functions,
// nested coordinate groups). Repeats until `;`.
LAYER_VALUES: sequence array { repeat <LAYER_VALUE> space }
// On parse, the predictive PEG tries each alt in order; `string`
// after `identifier` is safe because the parsers reject each other's
// input shapes (identifier stops at `"`, string requires `"` start).
// On save, identifier-before-string makes the canonical emit prefer
// the unquoted form (`RPERSQ`) when the value would re-parse as an
// identifier, falling back to `string` for values that contain
// spaces / semicolons / quotes the identifier parser can't handle.
LAYER_VALUE: choice {
  <NUMBER>,
  identifier,
  string,
  <LAYER_PAREN_GROUP>
}

// Parenthesized value group: `( <values> )` — used for PWL
// piecewise-linear functions like
//   ANTENNACUMDIFFAREARATIO PWL ( ( 0 200 ) ( 0.159 200 ) ... ) ;
// Recursive — inner parens are themselves parenthesized groups.
// `space` postfix on the repeat item: the engine auto-skips
// whitespace between tokens on parse but needs an explicit
// separator on save. Without it `(0 75)` round-trips as `(075)`
// and reparses as the single number `75`, then `(0.0125 75)`
// becomes `(0.012575)` etc. — every PWL point collapses.
LAYER_PAREN_GROUP: sequence array {
  "(" space, repeat <LAYER_VALUE> space, ")" space
}

// Enumeration of LAYER property keywords used by the generic
// `LAYER_PROPERTY` fallback in `LAYER_BODY_ITEM`. Closed list so
// that `END` (the block closer) doesn't get mistaken for a
// property. New LEF58_* and vendor-specific keywords can be added
// as needed.
//
// Keywords already handled by typed `LAYER_BODY_ITEM` entries
// (TYPE / DIRECTION / WIDTH / AREA / THICKNESS / EDGECAPACITANCE /
// MAXIMUMDENSITY / MINIMUMDENSITY / DENSITYCHECKWINDOW /
// DENSITYCHECKSTEP / PITCH / OFFSET) are intentionally OMITTED
// here — leaving them in would create dead alternatives the
// typed entries always shadow first.
// Ordering note: predictive PEG tries alternatives top-to-bottom
// and commits on the first whose terminal matches. KeyParser uses
// mark/reject so partial matches rewind cleanly (no prefix
// constraint), but iteration order still drives wall-clock cost.
// This list is sorted approximately by real-world frequency in
// Sky130 / NanGate / IHP130 tech LEFs — keywords every routing
// LAYER carries (SPACING, RESISTANCE, CAPACITANCE, ANTENNAMODEL)
// come first; LEF58 extension keywords (CUTCLASS, EOLKEEPOUT,
// etc.) come last. Re-profile (rawast parse --profile) when
// real-corpus measurements change the distribution.
// IMPORTANT: order matters under predictive PEG. `KeyParser` does
// NOT enforce word boundaries — it accepts any input whose first
// N bytes match the literal, even if byte N+1 is identifier-
// continuation. So a SHORTER keyword that's a strict prefix of a
// LONGER one (e.g. `SPACING` ⊂ `SPACINGTABLE`,
// `ANTENNACUMSIDEAREARATIO` ⊂ `ANTENNACUMDIFFSIDEAREARATIO` —
// they share `ANTENNACUM`, then a 3rd-char difference, but the
// rule applies for ANY pair where one is a strict prefix) MUST
// appear AFTER its longer form, otherwise the shorter alt commits
// first and the rest gets swept into the generic `values` list
// with the wrong `kind`. Current modelled prefix pairs:
//
//   SPACINGTABLE before SPACING
//
// New keywords must be audited against the rest of this list for
// the same hazard. (Word-boundary checking inside KeyParser would
// remove this footgun — pending engine change.)
LAYER_KEYWORD: choice {
  // High-frequency (every routing LAYER hits these on Sky130 / NanGate).
  "SPACINGTABLE":@,       // MUST precede SPACING — prefix hazard
  "SPACING":@,
  "RESISTANCE":@,
  "CAPACITANCE":@,
  "ANTENNAMODEL":@,
  "ENCLOSURE":@,
  "DCCURRENTDENSITY":@,
  "ANTENNADIFFSIDEAREARATIO":@,
  "ANTENNADIFFAREARATIO":@,
  "ACCURRENTDENSITY":@,
  "MINENCLOSEDAREA":@,
  "ANTENNACUMAREARATIO":@,
  "ANTENNAAREARATIO":@,
  "PROPERTY":@,
  // Medium-frequency.
  "MINWIDTH":@,
  "MAXWIDTH":@,
  "MINSTEP":@,
  "MINCUTS":@,
  "MASK":@,
  "ANTENNACUMDIFFAREARATIO":@,
  // Spec-completeness antenna keywords — surfaced by the
  // spec_coverage audit; not seen in the local PDK corpus but
  // defined in LEF/DEF 5.8 §"Layer (Routing)".
  "ANTENNACUMDIFFSIDEAREARATIO":@,
  "ANTENNACUMSIDEAREARATIO":@,
  "ANTENNACUMROUTINGPLUSCUT":@,
  "ANTENNAAREAMINUSDIFF":@,
  "ANTENNAAREADIFFREDUCEPWL":@,
  "ANTENNAAREAFACTOR":@,
  "ANTENNAGATEPLUSDIFF":@,
  "ANTENNASIDEAREARATIO":@,
  "ANTENNASIDEAREAFACTOR":@,
  "PREFERENCLOSURE":@,
  "STACK":@,
  "HEIGHT":@,
  "CURRENTDEN":@,
  // Rare / LEF58 extension keywords (only appears on a few
  // PDKs / tech LEFs).
  "SLOTWIRELENGTH":@,
  "SLOTWIREWIDTH":@,
  "FILLACTIVESPACING":@,
  "MINIMUMCUT":@,
  "ARRAYSPACING":@,
  "EOLENCLOSURE":@,
  "PARALLELRUNLENGTH":@,
  "MINSIZE":@,
  "WIDTHTABLE":@,
  "WIREEXTENSION":@,
  "CORNERONLY":@,
  "CORNERSPACING":@,
  "CUTCLASS":@,
  "EOLKEEPOUT":@,
  "PARALLELEDGE":@,
  "RECTONLY":@,
  "RIGHTWAYONGRIDONLY":@
}

// === VIA block (tech LEF) ================================================
//
// LEF/DEF 5.8 §"Via" — two forms: geometry-based (LAYER + shape
// patches per layer) and VIARULE-based. The geometry form is what
// shows up in the open-PDK corpus. The block is closed with
// `END viaName`.
//
//   VIA viaName [DEFAULT]
//     [RESISTANCE value ;]
//     {LAYER layerName ;
//        {RECT (x1 y1) (x2 y2) | POLYGON pts ...} ...
//     } ...
//   END viaName

VIA_BLOCK: sequence dict {
  <VIA_KW>:type=@ space,
  identifier:name=@ space,
  ?<VIA_DEFAULT_KW>,
  <VIA_BODY>,
  "END" space, identifier:end_name=@ newline
}

// Two body forms per LEF/DEF 5.8 §"Via":
//   1. Geometry form: `LAYER ... shapes ...` + optional RESISTANCE.
//      Captured as a `properties` list (existing behaviour).
//   2. VIARULE-based form: `VIARULE viaRuleName ;` followed by
//      typed sub-clauses (CUTSIZE / LAYERS / CUTSPACING / ENCLOSURE
//      required; ROWCOL / ORIGIN / OFFSET / PATTERN optional).
//      All sub-clauses catcher-flatten into the VIA dict as typed
//      fields (cut_size_x, layers, enclosure_*, etc.).
// VIARULE-form is tried first because its `VIARULE` discriminator
// is more specific than the geometry form's LAYER/RESISTANCE openers.
VIA_BODY: choice {
  <VIA_VIARULE_BODY>,
  <VIA_GEOMETRY_BODY>
}

VIA_GEOMETRY_BODY: sequence {
  <VIA_PROPERTIES>:properties=@
}

VIA_VIARULE_BODY: sequence {
  "VIARULE" space, identifier:via_rule=@ space, ";" newline,
  <VIA_CUTSIZE>:cut_size=@,
  <VIA_LAYERS>:layers=@,
  <VIA_CUTSPACING>:cut_spacing=@,
  <VIA_ENCLOSURE>:enclosure=@,
  ?<VIA_ROWCOL>:rowcol=@,
  ?<ORIGIN_CMD>:origin=@,
  ?<VIA_OFFSET>:offset=@,
  ?<VIA_PATTERN_CMD>
}

// Each VIA-VIARULE sub-clause is its own dict-container; the body
// binds the whole sub-dict as a field, so the parsed shape reads:
//   {cut_size: {x: 0.17, y: 0.17},
//    layers:   {bot: "li1", cut: "mcon", top: "met1"},
//    cut_spacing: {x: 0.19, y: 0.19},
//    enclosure: {bot_x: 0.04, bot_y: 0.06, top_x: 0.06, top_y: 0.06},
//    rowcol: {rows: 2, cols: 3}, origin: {x, y}, offset: {…}, pattern: "…"}
VIA_CUTSIZE: sequence dict {
  "CUTSIZE" space, <NUMBER>:x=@ space, <NUMBER>:y=@ space, ";" newline
}
VIA_LAYERS: sequence dict {
  "LAYERS" space, identifier:bot=@ space, identifier:cut=@ space, identifier:top=@ space, ";" newline
}
VIA_CUTSPACING: sequence dict {
  "CUTSPACING" space, <NUMBER>:x=@ space, <NUMBER>:y=@ space, ";" newline
}
VIA_ENCLOSURE: sequence dict {
  "ENCLOSURE" space,
  <NUMBER>:bot_x=@ space, <NUMBER>:bot_y=@ space,
  <NUMBER>:top_x=@ space, <NUMBER>:top_y=@ space, ";" newline
}
VIA_ROWCOL: sequence dict {
  "ROWCOL" space, int:rows=@ space, int:cols=@ space, ";" newline
}
VIA_OFFSET: sequence dict {
  "OFFSET" space,
  <NUMBER>:bot_x=@ space, <NUMBER>:bot_y=@ space,
  <NUMBER>:top_x=@ space, <NUMBER>:top_y=@ space, ";" newline
}
// PATTERN is a single string — keep container-less so `pattern` lands
// directly on the VIA dict (no `{pattern: {pattern: ...}}` redundancy).
VIA_PATTERN_CMD: sequence { "PATTERN" space, identifier:pattern=@ space, ";" newline }

VIA_PROPERTIES: sequence array { repeat <VIA_PROPERTY> }

// LEF keyword spec-uppercase ("VIA") but some real tools emit
// mixed-case ("Via"). Accept both.
VIA_KW: choice {
  "VIA":@,
  "Via":@
}

// LEF keywords are spec-uppercase ("DEFAULT") but some real tools
// emit mixed-case ("Default"). Accept both.
VIA_DEFAULT_KW: sequence {
  <VIA_DEFAULT_LITERAL>:is_default=true newline
}
VIA_DEFAULT_LITERAL: choice {
  "DEFAULT":@,
  "Default":@
}

// LEF/DEF 5.8 §"Via" — geometry-form VIA body items. RESISTANCE
// once (optional), LAYER groups (one or more), plus per-spec
// PROPERTY clauses that round-trip into the same `properties`
// array alongside the layer groups. Order preserved by the
// parent VIA_PROPERTIES sequence array.
//
// Save dispatch: discriminator-keyed alts (Resistance / Property)
// listed BEFORE the LayerGroup alt so save_v2's value-shape
// matching tries the typed forms first and falls through to the
// LayerGroup catch-all only when neither discriminator matches.
VIA_PROPERTY: choice {
  <VIA_RESISTANCE>,
  <VIA_PROPERTY_KV>,
  <VIA_LAYER_GROUP>
}

VIA_PROPERTY_KV: sequence dict {
  "PROPERTY":type="Property" space,
  identifier:prop_name=@ space,
  <PROPERTY_VALUE>:prop_value=@ space,
  ";" newline
}

VIA_RESISTANCE: sequence dict {
  "RESISTANCE":type="Resistance" space,
  <NUMBER>:value=@ space, ";" newline
}

// Each LAYER + shape group in a VIA: layer name followed by shapes.
VIA_LAYER_GROUP: sequence dict {
  "LAYER" space, identifier:layer=@ space, ";" newline,
  <VIA_SHAPES>:shapes=@
}

VIA_SHAPES: sequence array { repeat+ <VIA_SHAPE> }
// VIA layer-group shapes reuse the same RECT_SHAPE / POLYGON_SHAPE
// rules used by PORT/OBS layerGeometries. The optional MASK /
// ITERATE / STEP_PATTERN modifiers don't fire on bare VIA shapes;
// they're just dormant in this context.
VIA_SHAPE: choice {
  <RECT_SHAPE>,
  <POLYGON_SHAPE>
}

// === VIARULE block (tech LEF) ============================================
//
// LEF/DEF 5.8 §"Via Rule" — defines a parameterized via rule
// referenced from VIAs and from routing tools. Two forms:
// generate-rules (with CUTSIZE / LAYERS / etc.) and layer-pair
// rules (just LAYER properties). Corpus form is mostly the
// LAYER-pair variant with simple property clauses.
//
// Permissive structure: opener + body of generic LAYER /
// keyword-value clauses (reuses LAYER_PROPERTY structure since the
// allowed keywords overlap heavily) + closer.

// LEF/DEF 5.8 §"Via Rule" — non-GENERATE form allows a list of
// trailing `VIA viaName ;` references after the LAYER sections,
// naming the specific VIAs the rule produces (which the placer/
// router selects from). Captured as `vias[]` via the engine's
// list-append binding. GENERATE form doesn't use this — it
// generates VIAs by construction from the LAYER sections.
VIARULE_BLOCK: sequence dict {
  <VIARULE_KW>:type=@ space,
  identifier:name=@ space,
  ?<VIARULE_GENERATE_KW>,
  ?<VIA_DEFAULT_KW>,
  <VIARULE_LAYER_SECTIONS>:layers=@,
  repeat <VIARULE_VIA_REF>:vias[]=@,
  "END" space, identifier:end_name=@ newline
}

// Trailing `VIA viaName ;` line inside a non-GENERATE VIARULE.
// Bound by the parent VIARULE_BLOCK's repeat as `vias[]`.
VIARULE_VIA_REF: sequence dict {
  "VIA":type="Via" space, identifier:name=@ space, ";" newline
}

VIARULE_LAYER_SECTIONS: sequence array { repeat <VIARULE_LAYER_SECTION> }

// LEF keyword spec-uppercase ("VIARULE") but some real tools emit
// mixed-case ("ViaRULE"). Accept both.
VIARULE_KW: choice {
  "VIARULE":@,
  "ViaRULE":@
}

VIARULE_GENERATE_KW: sequence { "GENERATE":is_generate=true space }

// VIARULE body: one or more LAYER sections, each grouping the LAYER
// name with its specific sub-clauses (ENCLOSURE / RECT / SPACING /
// WIDTH-range / etc.). Sub-clauses catcher-flatten into the section
// dict, so the parsed shape reads:
//   layers: [
//     {name: "li1",  enclosure: {overhang1: 0,    overhang2: 0}},
//     {name: "met1", enclosure: {overhang1: 0.06, overhang2: 0.03}},
//     {name: "mcon", rect: {x1, y1, x2, y2}, spacing: {x, y}},
//   ]
// Works for both the LAYER-pair form and the GENERATE form because
// they share the same LAYER + sub-clause shape.
VIARULE_LAYER_SECTION: sequence dict {
  "LAYER" space, identifier:name=@ space, ";" newline,
  repeat <VIARULE_LAYER_SUB>
}

VIARULE_LAYER_SUB: choice {
  <VIARULE_ENCLOSURE_CMD>:enclosure=@,
  <RECT_SHAPE>:rect=@,
  <POLYGON_SHAPE>:polygon=@,
  <VIARULE_SPACING_CMD>:spacing=@,
  <VIARULE_WIDTH_RANGE_CMD>:width_range=@,
  <DIRECTION_CMD>,
  <VIARULE_RESISTANCE_CMD>,
  <LAYER_PROPERTY>:properties[]=@
}

// `ENCLOSURE overhang1 overhang2` per LEF/DEF 5.8 §"Via Rule Generate"
// — the two values are spec-positional (bottom-layer overhang then
// top-layer overhang); the engine surface stays close to the spec
// names rather than renaming to `bot`/`top`.
VIARULE_ENCLOSURE_CMD: sequence dict {
  "ENCLOSURE" space, <NUMBER>:overhang1=@ space, <NUMBER>:overhang2=@ space, ";" newline
}

// SPACING in VIARULE GENERATE is `SPACING x BY y` per spec; the
// `BY` keyword is a structural separator.
VIARULE_SPACING_CMD: sequence dict {
  "SPACING" space, <NUMBER>:x=@ space, "BY" space, <NUMBER>:y=@ space, ";" newline
}

// `WIDTH minWidth TO maxWidth ;` — only valid for the GENERATE
// form's routing-layer sections (spec §"Via Rule Generate"). Per
// LEF/DEF 5.8 the form is exactly `WIDTH min TO max ;` with the
// `TO` keyword between the two numbers — real PDKs (gf130bcd,
// older NanGate variants) ship this form. The `TO` is a
// structural separator the engine matches and discards.
VIARULE_WIDTH_RANGE_CMD: sequence dict {
  "WIDTH" space, <NUMBER>:min=@ space, "TO" space, <NUMBER>:max=@ space, ";" newline
}

VIARULE_RESISTANCE_CMD: sequence {
  "RESISTANCE" space, <NUMBER>:resistance=@ space, ";" newline
}

// === NONDEFAULTRULE block (tech LEF) =====================================
//
// LEF/DEF 5.8 §"NonDefault Rule" — per-net rules overriding default
// LAYER widths/spacings, with optional HARDSPACING marker, per-LAYER
// width/spacing/diagspacing/wireext properties, VIA / VIARULE
// references, and MINCUTS overrides. Spec shape:
//
//   NONDEFAULTRULE ruleName
//     [+ HARDSPACING]
//     {+ LAYER layerName WIDTH minWidth
//        [DIAGSPACING diagSpacing]
//        [SPACING minSpacing]
//        [WIREEXT wireExt] ;} ...
//     [+ VIA viaName] ...
//     [+ VIARULE viaRuleName] ...
//     [+ MINCUTS cutLayerName numCuts] ...
//   END ruleName
//
// (The `+`-prefix syntax is DEF NDR; LEF NDR uses plain keywords
// without `+`.)
NONDEFAULTRULE_BLOCK: sequence dict {
  "NONDEFAULTRULE":type="NonDefaultRule" space,
  identifier:name=@ newline,
  <NDR_PROPERTIES>:properties=@,
  "END" space, identifier:end_name=@ newline
}

NDR_PROPERTIES: sequence array { repeat <NDR_PROPERTY> }

// Choice ordering: USEVIARULE before USEVIA (no prefix overlap
// but kept consistent), VIARULE before VIA, MINCUTS before any
// other M-prefix. NDR_VIA_INLINE before NDR_VIA_REF — both start
// with `VIA viaName` but the inline form has a body + END, the
// ref form ends with `;`; predictive PEG tries inline first
// (longer prefix), falls through to ref when inline can't find
// a body. NDR_PROPERTY_KV is the trailing-PROPERTY form per
// LEF/DEF 5.8 §"Non-Default Rule" — emits a `{type: "Property",
// prop_name, prop_value}` dict that gets appended to the same
// `ndr.properties` array as the other body items.
NDR_PROPERTY: choice {
  <NDR_HARDSPACING>,
  <NDR_LAYER>,
  <NDR_USEVIARULE>,
  <NDR_USEVIA>,
  <NDR_VIARULE_REF>,
  <NDR_VIA_INLINE>,
  <NDR_VIA_REF>,
  <NDR_MINCUTS>,
  <NDR_PROPERTY_KV>
}

NDR_HARDSPACING: sequence dict {
  "HARDSPACING":type="HardSpacing":is_hard_spacing=true space, ";" newline
}

// LAYER sub-block: name then a free-order list of WIDTH/SPACING/
// DIAGSPACING/WIREEXT properties (spec mandates WIDTH first; we're
// permissive here too).
// NDR LAYER comes in two shapes per LEF/DEF 5.8:
//   Block form (spec-canonical, gf130bcd / 74hc_pcb / older PDKs):
//     LAYER name
//       WIDTH minWidth ;
//       [SPACING minSpacing ;] ...
//     END name
//   Inline form (tool-extension; Sky130 / asap7 / NanGate / Cadence
//   tools accept it; widely shipped):
//     LAYER name WIDTH x SPACING y ... ;
// Distinct `type` discriminators (`Layer` / `LayerBlock`) so the
// generated Pydantic models keep their discriminated-union
// dispatch unambiguous. Downstream consumers can pattern-match
// on type or treat them uniformly (the prop fields are the same).
// Block form first: its requirement that each prop end in `;`
// makes it strictly stricter than inline. For inline input
// (`LAYER name WIDTH 500 SPACING 300 ;`), BLOCK matches "WIDTH
// 500" then fails on the missing `;` between props — the engine
// rewinds and falls through to INLINE. For block input (`LAYER
// name \n WIDTH 500 ; ...`), BLOCK commits cleanly. If INLINE
// were tried first it would greedily consume the first
// `WIDTH 500 ;` as a complete LAYER and then leave the rest of
// the block-form props orphaned outside the NDR.
NDR_LAYER: choice {
  <NDR_LAYER_BLOCK>,
  <NDR_LAYER_INLINE>
}

NDR_LAYER_INLINE: sequence dict {
  "LAYER":type="Layer" space, identifier:layer=@ space,
  repeat <NDR_LAYER_PROP>,
  ";" newline
}

NDR_LAYER_BLOCK: sequence dict {
  "LAYER":type="LayerBlock" space, identifier:layer=@ newline,
  repeat <NDR_LAYER_PROP_BLOCK>,
  "END" space, identifier:end_name=@ newline
}

NDR_LAYER_PROP_BLOCK: sequence {
  <NDR_LAYER_PROP>, ";" newline
}

NDR_LAYER_PROP: choice {
  <NDR_LAYER_WIDTH>,
  <NDR_LAYER_SPACING>,
  <NDR_LAYER_DIAGSPACING>,
  <NDR_LAYER_WIREEXT>
}

NDR_LAYER_WIDTH:       sequence { "WIDTH"       space, <NUMBER>:width=@ space }
NDR_LAYER_SPACING:     sequence { "SPACING"     space, <NUMBER>:spacing=@ space }
NDR_LAYER_DIAGSPACING: sequence { "DIAGSPACING" space, <NUMBER>:diag_spacing=@ space }
NDR_LAYER_WIREEXT:     sequence { "WIREEXT"     space, <NUMBER>:wire_ext=@ space }

NDR_VIA_REF: sequence dict {
  "VIA":type="Via" space, identifier:via=@ space, ";" newline
}

// LEF/DEF 5.8 §"Non-Default Rule" also permits inline VIA
// definitions inside the NDR body — full `VIA viaName [DEFAULT]
// body END viaName`, structurally identical to a top-level VIA
// block. Reuses the existing VIA_BODY Choice (VIARULE-form vs
// geometry-form). Emits `type: "ViaInline"` to distinguish from
// NDR_VIA_REF (`type: "Via"`); same `ndr.properties` array.
NDR_VIA_INLINE: sequence dict {
  "VIA":type="ViaInline" space,
  identifier:name=@ space,
  ?<VIA_DEFAULT_KW>,
  <VIA_BODY>,
  "END" space, identifier:end_name=@ newline
}

NDR_VIARULE_REF: sequence dict {
  "VIARULE":type="ViaRule" space, identifier:viarule=@ space, ";" newline
}

NDR_MINCUTS: sequence dict {
  "MINCUTS":type="MinCuts" space,
  identifier:cut_layer=@ space,
  int:num_cuts=@ space, ";" newline
}

// LEF/DEF 5.8 §"Non-Default Rule" allows USEVIA / USEVIARULE
// inside the NDR body — they reference VIAs / VIARULEs defined
// elsewhere in the LEF or in a companion DEF, used to constrain
// which existing entries the rule may emit. Distinct from
// NDR_VIA_REF / NDR_VIARULE_REF (`VIA name ;`) which list the
// VIAs the rule itself defines or selects from a pool.
NDR_USEVIA: sequence dict {
  "USEVIA":type="UseVia" space, identifier:via=@ space, ";" newline
}

NDR_USEVIARULE: sequence dict {
  "USEVIARULE":type="UseViaRule" space, identifier:viarule=@ space, ";" newline
}

// Trailing PROPERTY clauses inside NDR — same shape as
// MACRO_PROPERTY_KV / PIN_PROPERTY_KV but emitting `type:
// "Property"` so it slots into `ndr.properties` as a discriminated
// dict alongside the other NDR body items (Layer / Via / ViaRule /
// UseVia / UseViaRule / MinCuts / HardSpacing). LEF/DEF 5.8 §"Non-
// Default Rule" permits PROPERTY clauses anywhere in the body;
// source order is preserved by the parent NDR_PROPERTIES array.
NDR_PROPERTY_KV: sequence dict {
  "PROPERTY":type="Property" space,
  identifier:prop_name=@ space,
  <PROPERTY_VALUE>:prop_value=@ space,
  ";" newline
}

// ===========================================================================
// === DEF top rule + initial body items =====================================
// ===========================================================================
//
// DEF (Design Exchange Format) shares HDR (VERSION / BUSBITCHARS /
// DIVIDERCHAR) with LEF; everything else is its own rule set,
// kept namespaced under `DEF_*` so the two top rules can coexist
// in one grammar file. Future shared sub-rules (RECT_SHAPE,
// ANTENNA_KIND, NUMBER, identifier, …) will be pulled out of
// their current LEF homes when DEF starts reusing them; for now
// each side stays self-contained.
//
// Coverage scope of this initial cut (validated against
// serv/openroad_pcb/serv_rf_top.def):
//
//   DESIGN name ;
//   UNITS DISTANCE MICRONS dbu ;
//   DIEAREA ( x1 y1 ) ( x2 y2 ) ;
//   ROW name site x y orient DO numX BY numY STEP stepX stepY ;
//   END DESIGN
//
// Pending and tracked as TODO at the bottom: TRACKS, GCELLGRID,
// VIAS, NONDEFAULTRULES, COMPONENTS, PINS, NETS, SPECIALNETS,
// BLOCKAGES, FILLS, PROPERTYDEFINITIONS, HISTORY, REGIONS,
// SCANCHAINS, GROUPS, BEGINEXT/ENDEXT, plus the trailing
// PROPERTY/SOURCE/etc. clauses inside each.
//
// Reachable via `Grammar.parse_file(p, start="DEF")` /
// `Grammar.parse_string(...)`. Default start (`<LEF>` in the
// header) is unchanged — DEF is opt-in.
DEF ignore whitespace line_comment: sequence dict {
  <HDR>:hdr=@,
  <DEF_DESIGN>:design=@,
  <DEF_ITEMS>:items=@,
  ?<END_DESIGN>
}

// `DESIGN name ;` — the DEF spec's required first statement after
// the optional header block. Emitted as a dict so the design name
// lands on a `name` field alongside any future DESIGN-attached
// attributes (TECHNOLOGY, PROPERTY trailers per LEF/DEF 5.8).
DEF_DESIGN: sequence dict {
  "DESIGN":type="Design" space, identifier:name=@ space, ";" newline
}

DEF_ITEMS: sequence array { repeat <DEF_ITEM> }

// Body item Choice — order matters under the predictive PEG: longer
// or more-distinctive keyword prefixes go first only when needed to
// disambiguate. UNITS / DIEAREA / ROW have non-overlapping first
// keywords here.
// COMPONENTMASKSHIFT must precede COMPONENTS in this Choice —
// KeyParser doesn't word-boundary check, so the shorter prefix
// `"COMPONENTS"` would otherwise prefix-match `COMPONENTMASKSHIFT`
// at the leading edge of the input line. Same hazard pattern as
// SPACING ⊂ SPACINGTABLE in LAYER_KEYWORD.
// PINPROPERTIES before PINS — same KeyParser-no-word-boundary
// hazard: `PINS` would otherwise prefix-match the first 4 chars
// of `PINPROPERTIES`.
DEF_ITEM: choice {
  <DEF_TECHNOLOGY_CMD>,
  <DEF_HISTORY_CMD>,
  <PROPERTYDEFINITIONS_BLOCK>,
  <DEF_UNITS_CMD>,
  <DEF_DIEAREA_CMD>,
  <DEF_ROW_CMD>,
  <DEF_TRACKS_CMD>,
  <DEF_GCELLGRID_CMD>,
  <DEF_VIAS_BLOCK>,
  <DEF_NDRS_BLOCK>,
  <DEF_REGIONS_BLOCK>,
  <DEF_COMPONENTMASKSHIFT_CMD>,
  <DEF_COMPONENTS_BLOCK>,
  <DEF_PINPROPERTIES_BLOCK>,
  <DEF_PINS_BLOCK>,
  <DEF_BLOCKAGES_BLOCK>,
  <DEF_SLOTS_BLOCK>,
  <DEF_FILLS_BLOCK>
}

// `TECHNOLOGY techName ;` — per LEF/DEF 5.8 §"DEF File", the
// optional reference to a companion LEF library identified by
// `techName`. Single line, dict-emitted so downstream consumers
// see `{type: "Technology", name: "techName"}`.
DEF_TECHNOLOGY_CMD: sequence dict {
  "TECHNOLOGY":type="Technology" space,
  identifier:name=@ space, ";" newline
}

// `HISTORY anyText ;` — per LEF/DEF 5.8 §"DEF File", a free-form
// historical-comment line that the design can carry forward.
// `anyText` is anything except `;`, so captured via the `*`
// raw-consume primitive scanning bytes until the literal `;`.
// Repeatable in DEF; each HISTORY lands in `items[]` as a typed
// `History` dict in source order, mirroring how every other DEF
// body section (UNITS / DIEAREA / ROW / COMPONENTS) is captured.
// No `space` postfix on the HISTORY keyword: the `*` raw-consume
// bypasses ignore-set whitespace skipping and captures the byte
// immediately after `HISTORY`, including the leading space. On
// save the captured text starts with that space, so a postfix
// would emit a doubled space. The trailing `;` consumes the
// terminator; everything between lands in `text` verbatim.
DEF_HISTORY_CMD: sequence dict {
  "HISTORY":type="History",
  *:text=@,
  ";" newline
}

// `UNITS DISTANCE MICRONS n ;` — DEF's UNITS is a single one-line
// statement, NOT the LEF UNITS block. They share the keyword but
// nothing else, hence the separate rule.
DEF_UNITS_CMD: sequence dict {
  "UNITS":type="Units" space, "DISTANCE" space, "MICRONS" space,
  <NUMBER>:database_microns=@ space, ";" newline
}

// `DIEAREA ( x1 y1 ) ( x2 y2 [ x3 y3 …] ) ;` — for an axis-aligned
// rectangular die, two points. The spec also allows additional
// points to describe a non-rectangular die polygon; this cut
// captures the two-point common case. Polygon-die handling lands
// once a real polygon-die DEF appears in the corpus.
DEF_DIEAREA_CMD: sequence dict {
  "DIEAREA":type="DieArea" space,
  "(" space, <NUMBER>:x1=@ space, <NUMBER>:y1=@ space, ")" space,
  "(" space, <NUMBER>:x2=@ space, <NUMBER>:y2=@ space, ")" space,
  ";" newline
}

// `ROW rowName siteName x y orient DO numX BY numY STEP stepX stepY ;`
// — the LEF/DEF 5.8 §"Row" canonical form. `orient` is one of
// `N | S | E | W | FN | FS | FE | FW`; captured as an identifier
// for now (downstream consumers / Pydantic can constrain via Enum
// if they need it).
DEF_ROW_CMD: sequence dict {
  "ROW":type="Row" space,
  identifier:name=@ space, identifier:site=@ space,
  <NUMBER>:x=@ space, <NUMBER>:y=@ space,
  identifier:orient=@ space,
  "DO" space, <NUMBER>:num_x=@ space,
  "BY" space, <NUMBER>:num_y=@ space,
  "STEP" space, <NUMBER>:step_x=@ space, <NUMBER>:step_y=@ space,
  ";" newline
}

// `TRACKS X|Y start DO numTracks STEP space [MASK n [SAMEMASK]]
//  LAYER layerName1 [layerName2 ...] ;`
// per LEF/DEF 5.8 §"Tracks". One TRACKS line per layer set;
// repeatable as many times as the design has layer-track
// declarations. Direction is one of `X` / `Y` (captured as
// identifier — downstream consumers can constrain via Enum).
DEF_TRACKS_CMD: sequence dict {
  "TRACKS":type="Tracks" space,
  identifier:direction=@ space,
  <NUMBER>:start=@ space,
  "DO" space, <NUMBER>:num_tracks=@ space,
  "STEP" space, <NUMBER>:step=@ space,
  ?<DEF_TRACKS_MASK>,
  "LAYER" space, <DEF_TRACKS_LAYER_LIST>:layers=@,
  ";" newline
}

// Optional `MASK n [SAMEMASK]` qualifier between STEP and LAYER.
DEF_TRACKS_MASK: sequence {
  "MASK" space, int:mask=@ space, ?<DEF_TRACKS_SAMEMASK>
}
DEF_TRACKS_SAMEMASK: sequence {
  "SAMEMASK":same_mask=true space
}

// Layer names — one or more identifiers, space-separated. `space`
// postfix on the repeat item so save emits a separator between
// names (matches the CLASS_LIST / SYMMETRY_LIST pattern).
DEF_TRACKS_LAYER_LIST: sequence array { repeat identifier space }

// `GCELLGRID X|Y start DO numGCells+1 STEP space ;` per LEF/DEF
// 5.8 §"GCellGrid". Each declaration defines one row of grid
// lines along the named direction; repeatable.
DEF_GCELLGRID_CMD: sequence dict {
  "GCELLGRID":type="GCellGrid" space,
  identifier:direction=@ space,
  <NUMBER>:start=@ space,
  "DO" space, <NUMBER>:num_gcells=@ space,
  "STEP" space, <NUMBER>:step=@ space,
  ";" newline
}

// `VIAS num ; - viaName ... ; ... END VIAS` per LEF/DEF 5.8
// §"Vias" — a list of VIA definitions used by the design.
// Each entry has either VIARULE-form clauses (+ VIARULE / +
// CUTSIZE / + LAYERS / + CUTSPACING / + ENCLOSURE / + ROWCOL /
// + ORIGIN / + OFFSET / + PATTERN) or geometry-form clauses
// (+ RECT / + POLYGON). `+`-prefixed clauses are captured as a
// list of typed dicts in source order — same pattern as
// LAYER_PROPERTY uses for unknown LAYER clauses.
DEF_VIAS_BLOCK: sequence dict {
  "VIAS":type="Vias" space,
  int:count=@ space, ";" newline,
  <DEF_VIAS_LIST>:vias=@,
  "END" space, "VIAS" newline
}

DEF_VIAS_LIST: sequence array { repeat <DEF_VIA_ENTRY> }

// One VIA entry: `- viaName + clause + clause … ;`. Per-alt
// `:clauses[]=@` list-append binding routes every clause type
// into the same `clauses` list on the entry dict. Same pattern
// as MACRO_TRAILING_PROPERTY uses to split LEF58 and generic
// PROPERTY into `lef58` vs `properties` lists — except here all
// 11 alts share one list since they're all "VIA clauses".
DEF_VIA_ENTRY: sequence dict {
  "-" space, identifier:name=@ space,
  repeat <DEF_VIA_CLAUSE>,
  ";" newline
}

DEF_VIA_CLAUSE: choice {
  <DEF_VIA_VIARULE_CLAUSE>:clauses[]=@,
  <DEF_VIA_CUTSIZE_CLAUSE>:clauses[]=@,
  <DEF_VIA_LAYERS_CLAUSE>:clauses[]=@,
  <DEF_VIA_CUTSPACING_CLAUSE>:clauses[]=@,
  <DEF_VIA_ENCLOSURE_CLAUSE>:clauses[]=@,
  <DEF_VIA_ROWCOL_CLAUSE>:clauses[]=@,
  <DEF_VIA_ORIGIN_CLAUSE>:clauses[]=@,
  <DEF_VIA_OFFSET_CLAUSE>:clauses[]=@,
  <DEF_VIA_PATTERN_CLAUSE>:clauses[]=@,
  <DEF_VIA_RECT_CLAUSE>:clauses[]=@,
  <DEF_VIA_POLYGON_CLAUSE>:clauses[]=@
}

// VIARULE-form clauses. The `+` prefix lives inside each clause
// dict so save emits it before the typed keyword. Discriminator
// is the typed keyword (VIARULE / CUTSIZE / …) via the
// `:type="..."` binding on the Key.
DEF_VIA_VIARULE_CLAUSE: sequence dict {
  "+" space, "VIARULE":type="ViaRule" space,
  identifier:name=@ space
}
DEF_VIA_CUTSIZE_CLAUSE: sequence dict {
  "+" space, "CUTSIZE":type="CutSize" space,
  <NUMBER>:x=@ space, <NUMBER>:y=@ space
}
DEF_VIA_LAYERS_CLAUSE: sequence dict {
  "+" space, "LAYERS":type="Layers" space,
  identifier:bot=@ space,
  identifier:cut=@ space,
  identifier:top=@ space
}
DEF_VIA_CUTSPACING_CLAUSE: sequence dict {
  "+" space, "CUTSPACING":type="CutSpacing" space,
  <NUMBER>:x=@ space, <NUMBER>:y=@ space
}
DEF_VIA_ENCLOSURE_CLAUSE: sequence dict {
  "+" space, "ENCLOSURE":type="Enclosure" space,
  <NUMBER>:bot_x=@ space, <NUMBER>:bot_y=@ space,
  <NUMBER>:top_x=@ space, <NUMBER>:top_y=@ space
}
DEF_VIA_ROWCOL_CLAUSE: sequence dict {
  "+" space, "ROWCOL":type="RowCol" space,
  int:rows=@ space, int:cols=@ space
}
DEF_VIA_ORIGIN_CLAUSE: sequence dict {
  "+" space, "ORIGIN":type="Origin" space,
  <NUMBER>:x=@ space, <NUMBER>:y=@ space
}
DEF_VIA_OFFSET_CLAUSE: sequence dict {
  "+" space, "OFFSET":type="Offset" space,
  <NUMBER>:bot_x=@ space, <NUMBER>:bot_y=@ space,
  <NUMBER>:top_x=@ space, <NUMBER>:top_y=@ space
}
DEF_VIA_PATTERN_CLAUSE: sequence dict {
  "+" space, "PATTERN":type="Pattern" space,
  identifier:name=@ space
}

// Geometry-form clauses — `+`-prefixed RECT and POLYGON with
// parenthesised coordinate pairs (distinct from LEF's bare
// form). Optional MASK qualifier as a separate optional sub-
// clause.
DEF_VIA_RECT_CLAUSE: sequence dict {
  "+" space, "RECT":type="Rect" space,
  identifier:layer=@ space,
  ?<DEF_VIA_MASK_QUAL>,
  "(" space, <NUMBER>:x1=@ space, <NUMBER>:y1=@ space, ")" space,
  "(" space, <NUMBER>:x2=@ space, <NUMBER>:y2=@ space, ")" space
}
DEF_VIA_POLYGON_CLAUSE: sequence dict {
  "+" space, "POLYGON":type="Polygon" space,
  identifier:layer=@ space,
  ?<DEF_VIA_MASK_QUAL>,
  <DEF_VIA_POLYGON_POINTS>:points=@
}
DEF_VIA_MASK_QUAL: sequence {
  "+" space, "MASK" space, int:mask=@ space
}
// Polygon points — one or more `( x y )` pairs, no separator.
DEF_VIA_POLYGON_POINTS: sequence array {
  repeat <DEF_VIA_POLYGON_POINT>
}
DEF_VIA_POLYGON_POINT: sequence dict {
  "(" space, <NUMBER>:x=@ space, <NUMBER>:y=@ space, ")" space
}

// `NONDEFAULTRULES num ; - ruleName clause+ ; ... END
//  NONDEFAULTRULES` per LEF/DEF 5.8 §"NonDefaultRules". A list
// of NDR definitions used by the design — conceptually the
// same construct as LEF's NONDEFAULTRULE_BLOCK but in DEF's
// `-`-entry + `+`-clause syntax. Each entry's clauses include
// HARDSPACING (flag), LAYER (with WIDTH / DIAGWIDTH / SPACING /
// WIREEXT qualifiers), VIA references, VIARULE references,
// MINCUTS per-layer, and PROPERTY trailers.
DEF_NDRS_BLOCK: sequence dict {
  "NONDEFAULTRULES":type="NonDefaultRules" space,
  int:count=@ space, ";" newline,
  <DEF_NDRS_LIST>:rules=@,
  "END" space, "NONDEFAULTRULES" newline
}

DEF_NDRS_LIST: sequence array { repeat <DEF_NDR_ENTRY> }

DEF_NDR_ENTRY: sequence dict {
  "-" space, identifier:name=@ space,
  repeat <DEF_NDR_CLAUSE>,
  ";" newline
}

// `+`-prefixed clause Choice — every alt list-appends to the
// same `clauses` field on the entry dict, same pattern as
// DEF_VIA_CLAUSE. VIARULE before VIA because KeyParser doesn't
// word-boundary check: `"VIA"` would otherwise prefix-match the
// first 3 chars of `VIARULE` and commit to the wrong alt.
DEF_NDR_CLAUSE: choice {
  <DEF_NDR_HARDSPACING_CLAUSE>:clauses[]=@,
  <DEF_NDR_LAYER_CLAUSE>:clauses[]=@,
  <DEF_NDR_VIARULE_CLAUSE>:clauses[]=@,
  <DEF_NDR_VIA_CLAUSE>:clauses[]=@,
  <DEF_NDR_MINCUTS_CLAUSE>:clauses[]=@,
  <DEF_NDR_PROPERTY_CLAUSE>:clauses[]=@
}

DEF_NDR_HARDSPACING_CLAUSE: sequence dict {
  "+" space, "HARDSPACING":type="HardSpacing":is_hard_spacing=true space
}

// `+ LAYER name WIDTH x [DIAGWIDTH x] [SPACING x] [WIREEXT x]`
// — qualifiers are positional after the LAYER name; WIDTH is
// required by spec but the others are optional in any order.
DEF_NDR_LAYER_CLAUSE: sequence dict {
  "+" space, "LAYER":type="Layer" space,
  identifier:layer=@ space,
  "WIDTH" space, <NUMBER>:width=@ space,
  ?<DEF_NDR_LAYER_DIAGWIDTH>,
  ?<DEF_NDR_LAYER_SPACING>,
  ?<DEF_NDR_LAYER_WIREEXT>
}
DEF_NDR_LAYER_DIAGWIDTH: sequence {
  "DIAGWIDTH" space, <NUMBER>:diag_width=@ space
}
DEF_NDR_LAYER_SPACING: sequence {
  "SPACING" space, <NUMBER>:spacing=@ space
}
DEF_NDR_LAYER_WIREEXT: sequence {
  "WIREEXT" space, <NUMBER>:wire_ext=@ space
}

DEF_NDR_VIA_CLAUSE: sequence dict {
  "+" space, "VIA":type="Via" space, identifier:via=@ space
}
DEF_NDR_VIARULE_CLAUSE: sequence dict {
  "+" space, "VIARULE":type="ViaRule" space,
  identifier:viarule=@ space
}
DEF_NDR_MINCUTS_CLAUSE: sequence dict {
  "+" space, "MINCUTS":type="MinCuts" space,
  identifier:cut_layer=@ space, int:num_cuts=@ space
}
DEF_NDR_PROPERTY_CLAUSE: sequence dict {
  "+" space, "PROPERTY":type="Property" space,
  identifier:prop_name=@ space,
  <PROPERTY_VALUE>:prop_value=@ space
}

// `REGIONS num ; - regionName ( pt pt ) [( pt pt )...]
//  [+ TYPE FENCE|GUIDE] [+ PROPERTY ...] ; ... END REGIONS`
// per LEF/DEF 5.8 §"Regions". Each region is one or more
// rectangular box areas plus optional TYPE and PROPERTY
// metadata.
DEF_REGIONS_BLOCK: sequence dict {
  "REGIONS":type="Regions" space,
  int:count=@ space, ";" newline,
  <DEF_REGIONS_LIST>:regions=@,
  "END" space, "REGIONS" newline
}

DEF_REGIONS_LIST: sequence array { repeat <DEF_REGION_ENTRY> }

DEF_REGION_ENTRY: sequence dict {
  "-" space, identifier:name=@ space,
  <DEF_REGION_BOXES>:boxes=@,
  repeat <DEF_REGION_CLAUSE>,
  ";" newline
}

// One or more `( pt pt )` box pairs at the start of the region
// body — defines the rectangular shapes the region covers.
DEF_REGION_BOXES: sequence array {
  repeat+ <DEF_REGION_BOX>
}
DEF_REGION_BOX: sequence dict {
  "(" space, <NUMBER>:x1=@ space, <NUMBER>:y1=@ space, ")" space,
  "(" space, <NUMBER>:x2=@ space, <NUMBER>:y2=@ space, ")" space
}

// `+`-prefixed clauses after the boxes: TYPE qualifier and
// trailing PROPERTY entries.
DEF_REGION_CLAUSE: choice {
  <DEF_REGION_TYPE_CLAUSE>:clauses[]=@,
  <DEF_REGION_PROPERTY_CLAUSE>:clauses[]=@
}

// `+ TYPE { FENCE | GUIDE }` — region semantic per LEF/DEF 5.8.
DEF_REGION_TYPE_CLAUSE: sequence dict {
  "+" space, "TYPE":type="Type" space,
  identifier:region_type=@ space
}
DEF_REGION_PROPERTY_CLAUSE: sequence dict {
  "+" space, "PROPERTY":type="Property" space,
  identifier:prop_name=@ space,
  <PROPERTY_VALUE>:prop_value=@ space
}

// `COMPONENTMASKSHIFT layerName1 [layerName2 ...] ;` per
// LEF/DEF 5.8 §"ComponentMaskShift" — single-line directive
// declaring which mask layers a downstream COMPONENT's
// MASKSHIFT property may reference.
DEF_COMPONENTMASKSHIFT_CMD: sequence dict {
  "COMPONENTMASKSHIFT":type="ComponentMaskShift" space,
  <DEF_COMPONENTMASKSHIFT_LAYERS>:layers=@,
  ";" newline
}
DEF_COMPONENTMASKSHIFT_LAYERS: sequence array {
  repeat identifier space
}

// `COMPONENTS num ; - compName modelName + clause+ ;
//  ... END COMPONENTS` per LEF/DEF 5.8 §"Components".
// The largest single section of a typical DEF file (one entry
// per design instance — modern designs have millions). Each
// entry instantiates a LEF MACRO (`modelName`) under a unique
// `compName`, then carries placement + metadata via `+`-clauses.
DEF_COMPONENTS_BLOCK: sequence dict {
  "COMPONENTS":type="Components" space,
  int:count=@ space, ";" newline,
  <DEF_COMPONENTS_LIST>:components=@,
  "END" space, "COMPONENTS" newline
}

DEF_COMPONENTS_LIST: sequence array { repeat <DEF_COMPONENT_ENTRY> }

// `- compName modelName [+ clause]... ;` — entry starts with the
// instance + master name pair, then `+`-prefixed clauses for
// placement, metadata, and properties.
DEF_COMPONENT_ENTRY: sequence dict {
  "-" space,
  identifier:name=@ space,
  identifier:model=@ space,
  repeat <DEF_COMPONENT_CLAUSE>,
  ";" newline
}

// 12-alt Choice covering every spec-permitted COMPONENT clause.
// Per-alt `:clauses[]=@` list-append routes all clause types
// into the same `clauses` list — same pattern as DEF_VIA_CLAUSE
// and DEF_NDR_CLAUSE. Ordering longer-prefix-first where the
// keywords might collide: ROUTEHALO is the only such case
// (HALO is NOT a prefix of ROUTEHALO — different leading char —
// but they share the trailing `HALO` substring, harmless under
// PEG anchoring).
DEF_COMPONENT_CLAUSE: choice {
  <DEF_COMP_EEQMASTER_CLAUSE>:clauses[]=@,
  <DEF_COMP_SOURCE_CLAUSE>:clauses[]=@,
  <DEF_COMP_FIXED_CLAUSE>:clauses[]=@,
  <DEF_COMP_COVER_CLAUSE>:clauses[]=@,
  <DEF_COMP_PLACED_CLAUSE>:clauses[]=@,
  <DEF_COMP_UNPLACED_CLAUSE>:clauses[]=@,
  <DEF_COMP_ROUTEHALO_CLAUSE>:clauses[]=@,
  <DEF_COMP_HALO_CLAUSE>:clauses[]=@,
  <DEF_COMP_WEIGHT_CLAUSE>:clauses[]=@,
  <DEF_COMP_REGION_CLAUSE>:clauses[]=@,
  <DEF_COMP_MASKSHIFT_CLAUSE>:clauses[]=@,
  <DEF_COMP_PROPERTY_CLAUSE>:clauses[]=@
}

DEF_COMP_EEQMASTER_CLAUSE: sequence dict {
  "+" space, "EEQMASTER":type="EeqMaster" space,
  identifier:macro=@ space
}

// `+ SOURCE { NETLIST | DIST | USER | TIMING }` — instance
// origin per LEF/DEF 5.8. Captured as identifier; downstream
// consumers can constrain via Enum.
DEF_COMP_SOURCE_CLAUSE: sequence dict {
  "+" space, "SOURCE":type="Source" space,
  identifier:source_type=@ space
}

// Placement variants: four distinct clauses. FIXED / COVER /
// PLACED share the `( x y ) orient` shape; UNPLACED takes no
// arguments. Modeled as 4 separate alts so each has its own
// type discriminator (downstream code branches on
// `clause["type"]` to know the placement state).
DEF_COMP_FIXED_CLAUSE: sequence dict {
  "+" space, "FIXED":type="Fixed" space,
  "(" space, <NUMBER>:x=@ space, <NUMBER>:y=@ space, ")" space,
  identifier:orient=@ space
}
DEF_COMP_COVER_CLAUSE: sequence dict {
  "+" space, "COVER":type="Cover" space,
  "(" space, <NUMBER>:x=@ space, <NUMBER>:y=@ space, ")" space,
  identifier:orient=@ space
}
DEF_COMP_PLACED_CLAUSE: sequence dict {
  "+" space, "PLACED":type="Placed" space,
  "(" space, <NUMBER>:x=@ space, <NUMBER>:y=@ space, ")" space,
  identifier:orient=@ space
}
DEF_COMP_UNPLACED_CLAUSE: sequence dict {
  "+" space, "UNPLACED":type="Unplaced" space
}

// `+ HALO [SOFT] left bottom right top` — placement halo
// margins (per LEF/DEF 5.8). Optional SOFT flag captured as a
// boolean field. The 4 numbers are bare, no parentheses.
DEF_COMP_HALO_CLAUSE: sequence dict {
  "+" space, "HALO":type="Halo" space,
  ?<DEF_COMP_HALO_SOFT>,
  <NUMBER>:left=@ space, <NUMBER>:bottom=@ space,
  <NUMBER>:right=@ space, <NUMBER>:top=@ space
}
DEF_COMP_HALO_SOFT: sequence { "SOFT":is_soft=true space }

DEF_COMP_ROUTEHALO_CLAUSE: sequence dict {
  "+" space, "ROUTEHALO":type="RouteHalo" space,
  <NUMBER>:halo_dist=@ space,
  identifier:min_layer=@ space,
  identifier:max_layer=@ space
}

DEF_COMP_WEIGHT_CLAUSE: sequence dict {
  "+" space, "WEIGHT":type="Weight" space,
  <NUMBER>:weight=@ space
}

DEF_COMP_REGION_CLAUSE: sequence dict {
  "+" space, "REGION":type="Region" space,
  identifier:region=@ space
}

// `+ MASKSHIFT shiftLayerMasks` — opaque mask-shift value per
// spec (typically a hex string). Captured as a single
// identifier; downstream tools that care about the
// per-bit-layer interpretation can subparse.
DEF_COMP_MASKSHIFT_CLAUSE: sequence dict {
  "+" space, "MASKSHIFT":type="MaskShift" space,
  identifier:layer_masks=@ space
}

DEF_COMP_PROPERTY_CLAUSE: sequence dict {
  "+" space, "PROPERTY":type="Property" space,
  identifier:prop_name=@ space,
  <PROPERTY_VALUE>:prop_value=@ space
}

// `PINS num ; - pinName + NET netName + clause+ ; ...
//  END PINS` per LEF/DEF 5.8 §"Pins". The design's port list,
// one entry per external pin. Each entry carries direction +
// usage metadata, antenna properties, geometry shapes (LAYER /
// POLYGON / VIA), and an optional placement.
DEF_PINS_BLOCK: sequence dict {
  "PINS":type="Pins" space,
  int:count=@ space, ";" newline,
  <DEF_PINS_LIST>:pins=@,
  "END" space, "PINS" newline
}

DEF_PINS_LIST: sequence array { repeat <DEF_PIN_ENTRY> }

// `- pinName [+ clause]... ;` — the pin name is bare, then
// `+`-prefixed clauses. NET is the only spec-required clause
// but real DEFs vary; we accept any clause order.
DEF_PIN_ENTRY: sequence dict {
  "-" space, identifier:name=@ space,
  repeat <DEF_PIN_CLAUSE>,
  ";" newline
}

// All `+`-prefixed PIN clauses. Per-alt `:clauses[]=@` list-
// append routes every clause type into one `clauses` field on
// the entry dict — same heterogeneous-typed-list pattern as
// DEF_COMPONENT_CLAUSE.
//
// Choice ordering hazards (longer-prefix-first):
//   - NETEXPR before NET (`"NET"` would otherwise prefix-match
//     `NETEXPR` under KeyParser's no-word-boundary semantics).
//   - ANTENNAPIN* keywords have multiple prefix-collision
//     pairs (PARTIALMETALSIDEAREA / PARTIALMETALAREA;
//     MAXSIDEAREACAR / MAXAREACAR). Longer-prefix-first
//     ordering applied in DEF_PIN_ANTENNA_KIND below.
DEF_PIN_CLAUSE: choice {
  <DEF_PIN_NETEXPR_CLAUSE>:clauses[]=@,
  <DEF_PIN_NET_CLAUSE>:clauses[]=@,
  <DEF_PIN_SPECIAL_CLAUSE>:clauses[]=@,
  <DEF_PIN_DIRECTION_CLAUSE>:clauses[]=@,
  <DEF_PIN_SUPPLYSENS_CLAUSE>:clauses[]=@,
  <DEF_PIN_GROUNDSENS_CLAUSE>:clauses[]=@,
  <DEF_PIN_USE_CLAUSE>:clauses[]=@,
  <DEF_PIN_ANTENNA_CLAUSE>:clauses[]=@,
  <DEF_PIN_LAYER_CLAUSE>:clauses[]=@,
  <DEF_PIN_POLYGON_CLAUSE>:clauses[]=@,
  <DEF_PIN_VIA_CLAUSE>:clauses[]=@,
  <DEF_PIN_FIXED_CLAUSE>:clauses[]=@,
  <DEF_PIN_COVER_CLAUSE>:clauses[]=@,
  <DEF_PIN_PLACED_CLAUSE>:clauses[]=@,
  <DEF_PIN_UNPLACED_CLAUSE>:clauses[]=@
}

// Metadata clauses.
DEF_PIN_NET_CLAUSE: sequence dict {
  "+" space, "NET":type="Net" space, identifier:net=@ space
}
DEF_PIN_SPECIAL_CLAUSE: sequence dict {
  "+" space, "SPECIAL":type="Special":is_special=true space
}
DEF_PIN_DIRECTION_CLAUSE: sequence dict {
  "+" space, "DIRECTION":type="Direction" space,
  identifier:direction=@ space
}
DEF_PIN_NETEXPR_CLAUSE: sequence dict {
  "+" space, "NETEXPR":type="NetExpr" space,
  string:expr=@ space
}
DEF_PIN_SUPPLYSENS_CLAUSE: sequence dict {
  "+" space, "SUPPLYSENSITIVITY":type="SupplySensitivity" space,
  identifier:supply_pin=@ space
}
DEF_PIN_GROUNDSENS_CLAUSE: sequence dict {
  "+" space, "GROUNDSENSITIVITY":type="GroundSensitivity" space,
  identifier:ground_pin=@ space
}
DEF_PIN_USE_CLAUSE: sequence dict {
  "+" space, "USE":type="Use" space, identifier:use=@ space
}

// ANTENNA family — single Choice covering all 9 spec variants
// (plus ANTENNAMODEL). Captured as a typed dict with the
// antenna kind in `type` and the bare value in `value`, plus
// optional LAYER qualifier. Same shape as LEF PIN_ANTENNA_PROP
// — different keyword vocabulary (DEF uses `ANTENNAPIN*` infix,
// LEF uses `ANTENNA*`).
DEF_PIN_ANTENNA_CLAUSE: sequence dict {
  "+" space,
  <DEF_PIN_ANTENNA_KIND>:type=@ space,
  <DEF_PIN_ANTENNA_VALUE>:value=@ space,
  ?<DEF_PIN_ANTENNA_LAYER>
}

// Closed-list discriminator — longer-prefix-first within each
// PARTIAL/MAX prefix group. ANTENNAMODEL last (no value with
// LAYER — it's just the model name).
DEF_PIN_ANTENNA_KIND: choice {
  "ANTENNAPINPARTIALMETALSIDEAREA":"AntennaPinPartialMetalSideArea",
  "ANTENNAPINPARTIALMETALAREA":"AntennaPinPartialMetalArea",
  "ANTENNAPINPARTIALCUTAREA":"AntennaPinPartialCutArea",
  "ANTENNAPINDIFFAREA":"AntennaPinDiffArea",
  "ANTENNAPINGATEAREA":"AntennaPinGateArea",
  "ANTENNAPINMAXSIDEAREACAR":"AntennaPinMaxSideAreaCar",
  "ANTENNAPINMAXAREACAR":"AntennaPinMaxAreaCar",
  "ANTENNAPINMAXCUTCAR":"AntennaPinMaxCutCar",
  "ANTENNAMODEL":"AntennaModel"
}
DEF_PIN_ANTENNA_VALUE: choice {
  <NUMBER>,
  identifier
}
DEF_PIN_ANTENNA_LAYER: sequence {
  "LAYER" space, identifier:layer=@ space
}

// Geometry clauses — LAYER, POLYGON, VIA. The LAYER form takes
// a rectangle (`( pt pt )`) plus optional MASK / SPACING /
// DESIGNRULEWIDTH qualifiers. POLYGON takes 3+ coordinate
// pairs. VIA takes a single point.
DEF_PIN_LAYER_CLAUSE: sequence dict {
  "+" space, "LAYER":type="Layer" space,
  identifier:layer=@ space,
  ?<DEF_PIN_MASK_QUAL>,
  ?<DEF_PIN_LAYER_QUALIFIER>,
  "(" space, <NUMBER>:x1=@ space, <NUMBER>:y1=@ space, ")" space,
  "(" space, <NUMBER>:x2=@ space, <NUMBER>:y2=@ space, ")" space
}

// LAYER / POLYGON optional qualifier — SPACING or DESIGNRULEWIDTH
// (mutually exclusive per spec). Captured as a tiny sub-choice
// that catcher-flattens into the parent clause dict.
DEF_PIN_LAYER_QUALIFIER: choice {
  <DEF_PIN_LAYER_SPACING>,
  <DEF_PIN_LAYER_DRW>
}
DEF_PIN_LAYER_SPACING: sequence {
  "SPACING" space, <NUMBER>:spacing=@ space
}
DEF_PIN_LAYER_DRW: sequence {
  "DESIGNRULEWIDTH" space, <NUMBER>:design_rule_width=@ space
}

DEF_PIN_POLYGON_CLAUSE: sequence dict {
  "+" space, "POLYGON":type="Polygon" space,
  identifier:layer=@ space,
  ?<DEF_PIN_MASK_QUAL>,
  ?<DEF_PIN_LAYER_QUALIFIER>,
  <DEF_PIN_POLYGON_POINTS>:points=@
}
DEF_PIN_POLYGON_POINTS: sequence array {
  repeat+ <DEF_PIN_POLYGON_POINT>
}
DEF_PIN_POLYGON_POINT: sequence dict {
  "(" space, <NUMBER>:x=@ space, <NUMBER>:y=@ space, ")" space
}

DEF_PIN_VIA_CLAUSE: sequence dict {
  "+" space, "VIA":type="Via" space,
  identifier:via=@ space,
  ?<DEF_PIN_MASK_QUAL>,
  "(" space, <NUMBER>:x=@ space, <NUMBER>:y=@ space, ")" space
}

DEF_PIN_MASK_QUAL: sequence {
  "+" space, "MASK" space, int:mask=@ space
}

// Placement clauses — same shape as COMPONENT placement
// (FIXED / COVER / PLACED with `( x y ) orient`; UNPLACED with
// no args). Modeled as 4 separate alts so each has its own
// type discriminator.
DEF_PIN_FIXED_CLAUSE: sequence dict {
  "+" space, "FIXED":type="Fixed" space,
  "(" space, <NUMBER>:x=@ space, <NUMBER>:y=@ space, ")" space,
  identifier:orient=@ space
}
DEF_PIN_COVER_CLAUSE: sequence dict {
  "+" space, "COVER":type="Cover" space,
  "(" space, <NUMBER>:x=@ space, <NUMBER>:y=@ space, ")" space,
  identifier:orient=@ space
}
DEF_PIN_PLACED_CLAUSE: sequence dict {
  "+" space, "PLACED":type="Placed" space,
  "(" space, <NUMBER>:x=@ space, <NUMBER>:y=@ space, ")" space,
  identifier:orient=@ space
}
DEF_PIN_UNPLACED_CLAUSE: sequence dict {
  "+" space, "UNPLACED":type="Unplaced" space
}

// (Deferred: PORT sub-block. LEF/DEF 5.8 §"Pins" allows one or
// more `+ PORT … + LAYER/POLYGON/VIA … + PLACED ( x y ) orient`
// physical-placement sub-blocks per pin, used when one logical
// pin has multiple disjoint physical locations. Not modeled in
// this initial cut — the most common case is a single set of
// pin-level shapes, which the LAYER / POLYGON / VIA clauses
// above cover directly. Multi-PORT pins will land in a follow-
// up commit when a real DEF in the corpus uses the form.)

// ===========================================================================
// === DEF Phase 7 — PINPROPERTIES + BLOCKAGES + SLOTS =======================
// ===========================================================================

// `PINPROPERTIES num ; - {COMPONENT compName pinName | PIN pinName}
//  + PROPERTY name value ; ... END PINPROPERTIES` per LEF/DEF 5.8
// §"Pin Properties". Per-pin metadata; two entry forms.
DEF_PINPROPERTIES_BLOCK: sequence dict {
  "PINPROPERTIES":type="PinProperties" space,
  int:count=@ space, ";" newline,
  <DEF_PINPROPERTIES_LIST>:entries=@,
  "END" space, "PINPROPERTIES" newline
}

DEF_PINPROPERTIES_LIST: sequence array { repeat <DEF_PINPROPERTY_ENTRY> }

// Two entry forms: `COMPONENT compName pinName` or `PIN pinName`.
// Distinct `type` discriminator per form for save dispatch.
DEF_PINPROPERTY_ENTRY: choice {
  <DEF_PINPROPERTY_COMPONENT_ENTRY>,
  <DEF_PINPROPERTY_PIN_ENTRY>
}

DEF_PINPROPERTY_COMPONENT_ENTRY: sequence dict {
  "-" space, "COMPONENT":type="ComponentPin" space,
  identifier:component=@ space, identifier:pin=@ space,
  repeat <DEF_PINPROPERTY_CLAUSE>:properties[]=@,
  ";" newline
}

DEF_PINPROPERTY_PIN_ENTRY: sequence dict {
  "-" space, "PIN":type="Pin" space,
  identifier:pin=@ space,
  repeat <DEF_PINPROPERTY_CLAUSE>:properties[]=@,
  ";" newline
}

DEF_PINPROPERTY_CLAUSE: sequence dict {
  "+" space, "PROPERTY":type="Property" space,
  identifier:prop_name=@ space,
  <PROPERTY_VALUE>:prop_value=@ space
}

// `BLOCKAGES num ; - {LAYER name | PLACEMENT} clause+ ;
//  ... END BLOCKAGES` per LEF/DEF 5.8 §"Blockages". Two entry
// types: LAYER blockages (per-layer routing-blockage shapes
// with qualifier clauses for SLOTS/FILLS/PUSHDOWN/etc.) and
// PLACEMENT blockages (cell-placement exclusion zones, simpler
// qualifier set).
DEF_BLOCKAGES_BLOCK: sequence dict {
  "BLOCKAGES":type="Blockages" space,
  int:count=@ space, ";" newline,
  <DEF_BLOCKAGES_LIST>:blockages=@,
  "END" space, "BLOCKAGES" newline
}

DEF_BLOCKAGES_LIST: sequence array { repeat <DEF_BLOCKAGE_ENTRY> }

DEF_BLOCKAGE_ENTRY: choice {
  <DEF_BLOCKAGE_LAYER_ENTRY>,
  <DEF_BLOCKAGE_PLACEMENT_ENTRY>
}

// `- LAYER layerName { + qualifier | + RECT/POLYGON shape }+ ;`
// — qualifier clauses and shape clauses interleave freely in
// real DEFs; both kinds catcher-flatten into a single
// `clauses` list on the entry dict, with distinct type
// discriminators per kind.
DEF_BLOCKAGE_LAYER_ENTRY: sequence dict {
  "-" space, "LAYER":type="LayerBlockage" space,
  identifier:layer=@ space,
  repeat <DEF_BLOCKAGE_LAYER_CLAUSE>,
  ";" newline
}

DEF_BLOCKAGE_LAYER_CLAUSE: choice {
  // Qualifier flags (boolean) and qualifier values.
  <DEF_BLOCKAGE_SLOTS_FLAG>:clauses[]=@,
  <DEF_BLOCKAGE_FILLS_FLAG>:clauses[]=@,
  <DEF_BLOCKAGE_PUSHDOWN_FLAG>:clauses[]=@,
  <DEF_BLOCKAGE_EXCEPTPGNET_FLAG>:clauses[]=@,
  <DEF_BLOCKAGE_COMPONENT>:clauses[]=@,
  <DEF_BLOCKAGE_SPACING>:clauses[]=@,
  <DEF_BLOCKAGE_DRW>:clauses[]=@,
  <DEF_BLOCKAGE_MASK>:clauses[]=@,
  // Shape clauses.
  <DEF_BLOCKAGE_RECT>:clauses[]=@,
  <DEF_BLOCKAGE_POLYGON>:clauses[]=@
}

DEF_BLOCKAGE_SLOTS_FLAG: sequence dict {
  "+" space, "SLOTS":type="SlotsFlag":is_slots=true space
}
DEF_BLOCKAGE_FILLS_FLAG: sequence dict {
  "+" space, "FILLS":type="FillsFlag":is_fills=true space
}
DEF_BLOCKAGE_PUSHDOWN_FLAG: sequence dict {
  "+" space, "PUSHDOWN":type="PushdownFlag":is_pushdown=true space
}
DEF_BLOCKAGE_EXCEPTPGNET_FLAG: sequence dict {
  "+" space, "EXCEPTPGNET":type="ExceptPgNetFlag":is_except_pgnet=true space
}
DEF_BLOCKAGE_COMPONENT: sequence dict {
  "+" space, "COMPONENT":type="Component" space,
  identifier:component=@ space
}
DEF_BLOCKAGE_SPACING: sequence dict {
  "+" space, "SPACING":type="Spacing" space,
  <NUMBER>:spacing=@ space
}
DEF_BLOCKAGE_DRW: sequence dict {
  "+" space, "DESIGNRULEWIDTH":type="DesignRuleWidth" space,
  <NUMBER>:design_rule_width=@ space
}
DEF_BLOCKAGE_MASK: sequence dict {
  "+" space, "MASK":type="Mask" space, int:mask=@ space
}

DEF_BLOCKAGE_RECT: sequence dict {
  "RECT":type="Rect" space,
  "(" space, <NUMBER>:x1=@ space, <NUMBER>:y1=@ space, ")" space,
  "(" space, <NUMBER>:x2=@ space, <NUMBER>:y2=@ space, ")" space
}

DEF_BLOCKAGE_POLYGON: sequence dict {
  "POLYGON":type="Polygon" space,
  <DEF_BLOCKAGE_POLYGON_POINTS>:points=@
}
DEF_BLOCKAGE_POLYGON_POINTS: sequence array {
  repeat+ <DEF_BLOCKAGE_POLYGON_POINT>
}
DEF_BLOCKAGE_POLYGON_POINT: sequence dict {
  "(" space, <NUMBER>:x=@ space, <NUMBER>:y=@ space, ")" space
}

// `- PLACEMENT [+ SOFT | + PARTIAL maxDensity | + PUSHDOWN |
//   + COMPONENT name] RECT ( pt pt )+ ;` — placement-blockage
// entry. Simpler qualifier set than LAYER blockage; only RECT
// shapes (no POLYGON per spec).
DEF_BLOCKAGE_PLACEMENT_ENTRY: sequence dict {
  "-" space, "PLACEMENT":type="PlacementBlockage" space,
  repeat <DEF_BLOCKAGE_PLACEMENT_CLAUSE>,
  ";" newline
}

DEF_BLOCKAGE_PLACEMENT_CLAUSE: choice {
  <DEF_BLOCKAGE_PLACEMENT_SOFT>:clauses[]=@,
  <DEF_BLOCKAGE_PLACEMENT_PARTIAL>:clauses[]=@,
  <DEF_BLOCKAGE_PUSHDOWN_FLAG>:clauses[]=@,
  <DEF_BLOCKAGE_COMPONENT>:clauses[]=@,
  <DEF_BLOCKAGE_RECT>:clauses[]=@
}

DEF_BLOCKAGE_PLACEMENT_SOFT: sequence dict {
  "+" space, "SOFT":type="SoftFlag":is_soft=true space
}
DEF_BLOCKAGE_PLACEMENT_PARTIAL: sequence dict {
  "+" space, "PARTIAL":type="Partial" space,
  <NUMBER>:max_density=@ space
}

// `SLOTS num ; - LAYER name shape+ ; ... END SLOTS` per
// LEF/DEF 5.8 §"Slots". Per-layer slot shapes (gaps in metal
// fills, used by some PDKs for density control). Simpler than
// BLOCKAGES — no qualifier clauses, just RECT/POLYGON shapes.
DEF_SLOTS_BLOCK: sequence dict {
  "SLOTS":type="Slots" space,
  int:count=@ space, ";" newline,
  <DEF_SLOTS_LIST>:slots=@,
  "END" space, "SLOTS" newline
}

DEF_SLOTS_LIST: sequence array { repeat <DEF_SLOT_ENTRY> }

DEF_SLOT_ENTRY: sequence dict {
  "-" space, "LAYER":type="Slot" space, identifier:layer=@ space,
  repeat <DEF_SLOT_SHAPE>,
  ";" newline
}

DEF_SLOT_SHAPE: choice {
  <DEF_SLOT_RECT>:shapes[]=@,
  <DEF_SLOT_POLYGON>:shapes[]=@
}

DEF_SLOT_RECT: sequence dict {
  "RECT":type="Rect" space,
  "(" space, <NUMBER>:x1=@ space, <NUMBER>:y1=@ space, ")" space,
  "(" space, <NUMBER>:x2=@ space, <NUMBER>:y2=@ space, ")" space
}

DEF_SLOT_POLYGON: sequence dict {
  "POLYGON":type="Polygon" space,
  <DEF_SLOT_POLYGON_POINTS>:points=@
}
DEF_SLOT_POLYGON_POINTS: sequence array {
  repeat+ <DEF_SLOT_POLYGON_POINT>
}
DEF_SLOT_POLYGON_POINT: sequence dict {
  "(" space, <NUMBER>:x=@ space, <NUMBER>:y=@ space, ")" space
}

// ===========================================================================
// === DEF Phase 8 — FILLS ===================================================
// ===========================================================================

// `FILLS num ; - {LAYER name | VIA name} [+ MASK n] [+ OPC]
//  shape+ ; ... END FILLS` per LEF/DEF 5.8 §"Fills". Two entry
// forms: LAYER fills (RECT/POLYGON shapes for metal-density
// filler), VIA fills (point placements for via-array fills).
DEF_FILLS_BLOCK: sequence dict {
  "FILLS":type="Fills" space,
  int:count=@ space, ";" newline,
  <DEF_FILLS_LIST>:fills=@,
  "END" space, "FILLS" newline
}

DEF_FILLS_LIST: sequence array { repeat <DEF_FILL_ENTRY> }

DEF_FILL_ENTRY: choice {
  <DEF_FILL_LAYER_ENTRY>,
  <DEF_FILL_VIA_ENTRY>
}

// `- LAYER name [+ MASK n] [+ OPC] { RECT | POLYGON shape }+ ;`
// — qualifier clauses and shape clauses unified into one
// `clauses[]` list with per-alt type discriminators, same
// pattern as DEF_BLOCKAGE_LAYER_CLAUSE.
DEF_FILL_LAYER_ENTRY: sequence dict {
  "-" space, "LAYER":type="LayerFill" space,
  identifier:layer=@ space,
  repeat <DEF_FILL_LAYER_CLAUSE>,
  ";" newline
}

DEF_FILL_LAYER_CLAUSE: choice {
  <DEF_FILL_MASK>:clauses[]=@,
  <DEF_FILL_OPC_FLAG>:clauses[]=@,
  <DEF_FILL_RECT>:clauses[]=@,
  <DEF_FILL_POLYGON>:clauses[]=@
}

// `- VIA name [+ MASK shiftLayerMasks] [+ OPC] (pt) (pt) ... ;`
// — VIA fill is a list of point placements (one VIA shape per
// point). MASK here is the shift-layer-masks string (different
// from LAYER fills' integer MASK).
DEF_FILL_VIA_ENTRY: sequence dict {
  "-" space, "VIA":type="ViaFill" space,
  identifier:via=@ space,
  repeat <DEF_FILL_VIA_CLAUSE>,
  ";" newline
}

DEF_FILL_VIA_CLAUSE: choice {
  <DEF_FILL_VIA_MASK>:clauses[]=@,
  <DEF_FILL_OPC_FLAG>:clauses[]=@,
  <DEF_FILL_VIA_POINT>:clauses[]=@
}

DEF_FILL_MASK: sequence dict {
  "+" space, "MASK":type="Mask" space, int:mask=@ space
}
// VIA's MASK is a shiftLayerMasks string (per spec), not an
// integer — opaque identifier captured verbatim.
DEF_FILL_VIA_MASK: sequence dict {
  "+" space, "MASK":type="MaskShift" space,
  identifier:mask_shift=@ space
}
DEF_FILL_OPC_FLAG: sequence dict {
  "+" space, "OPC":type="OpcFlag":is_opc=true space
}

DEF_FILL_RECT: sequence dict {
  "RECT":type="Rect" space,
  "(" space, <NUMBER>:x1=@ space, <NUMBER>:y1=@ space, ")" space,
  "(" space, <NUMBER>:x2=@ space, <NUMBER>:y2=@ space, ")" space
}

DEF_FILL_POLYGON: sequence dict {
  "POLYGON":type="Polygon" space,
  <DEF_FILL_POLYGON_POINTS>:points=@
}
DEF_FILL_POLYGON_POINTS: sequence array {
  repeat+ <DEF_FILL_POLYGON_POINT>
}
DEF_FILL_POLYGON_POINT: sequence dict {
  "(" space, <NUMBER>:x=@ space, <NUMBER>:y=@ space, ")" space
}

// One via-fill placement point: `( x y )`.
DEF_FILL_VIA_POINT: sequence dict {
  "(":type="Point" space,
  <NUMBER>:x=@ space, <NUMBER>:y=@ space, ")" space
}

END_DESIGN: sequence { "END" space, "DESIGN" newline }
