// lef.rawast — LEF grammar (PoC subset)
//
// Top-level shape per the LEF/DEF 5.8 spec, §1 "Order of LEF
// Statements":
//
//   [VERSION statement]
//   [BUSBITCHARS statement]
//   [DIVIDERCHAR statement]
//   [UNITS statement]
//   [MANUFACTURINGGRID statement]
//   ...
//   [LAYER / VIA / VIARULE / NONDEFAULTRULE / SITE / MACRO] ...
//   [BEGINEXT] ...
//   [END LIBRARY]
//
// All three header statements are individually optional and, when
// present, must appear in this canonical order. LEF puts BUSBITCHARS
// before DIVIDERCHAR, opposite to DEF — see def.rawast.
//
// PoC body coverage: UNITS block and SITE blocks. The smallest real
// LEFs in the ChipFlow corpus (hybrid_sites.lef, 28 lines) fully
// parse end-to-end through this grammar. LAYER, VIA, VIARULE,
// NONDEFAULTRULE, MACRO blocks remain M2/M4 scope.

use: std, lefdef

start: <LIBRARY>

// === Top level ============================================================

LIBRARY ignore whitespace line_comment: sequence dict {
  <HDR>:hdr=@,
  <LIBRARY_ITEMS>:items=@,
  ?<END_LIBRARY>
}

// LEF spec puts BUSBITCHARS before DIVIDERCHAR; real files (e.g.
// sky130io_fill.lef) sometimes reverse them. `repeat <HDR_CMD>`
// accepts each line in any order. Pending NSEQ (M2), this is the
// pragmatic way to model "these statements, in any order."
HDR: sequence dict {
  ?<VERSION_CMD>,
  ?<NAMESCASESENSITIVE_CMD>,
  ?<NOWIREEXTENSIONATPIN_CMD>,
  repeat <HDR_CMD>
}
HDR_CMD: choice { <BUSBITCHARS_CMD>, <DIVIDERCHAR_CMD> }
VERSION_CMD:              sequence { "VERSION" space,              identifier:version=@ space,                  ";" newline }
NAMESCASESENSITIVE_CMD:   sequence { "NAMESCASESENSITIVE" space,   <ON_OFF>:names_case_sensitive=@ space,        ";" newline }
NOWIREEXTENSIONATPIN_CMD: sequence { "NOWIREEXTENSIONATPIN" space, <ON_OFF>:no_wire_extension_at_pin=@ space,    ";" newline }
BUSBITCHARS_CMD:          sequence { "BUSBITCHARS" space,          string:bus_bit_chars=@ space,                ";" newline }
DIVIDERCHAR_CMD:          sequence { "DIVIDERCHAR" space,          string:divider=@ space,                      ";" newline }

ON_OFF: choice {
  "ON":true,
  "OFF":false
}

END_LIBRARY: sequence { "END" space, "LIBRARY" newline }

LIBRARY_ITEMS: sequence array { repeat <LIBRARY_ITEM> }
LIBRARY_ITEM: choice {
  <UNITS_BLOCK>,
  <MANUFACTURINGGRID_CMD>,
  <CLEARANCEMEASURE_CMD>,
  <USEMINSPACING_CMD>,
  <FIXEDMASK_CMD>,
  <MAXVIASTACK_CMD>,
  <PROPERTYDEFINITIONS_BLOCK>,
  <LAYER_BLOCK>,
  <VIARULE_BLOCK>,
  <VIA_BLOCK>,
  <SPACING_BLOCK>,
  <SITE_BLOCK>,
  <NONDEFAULTRULE_BLOCK>,
  <MACRO_BLOCK>,
  <BEGINEXT_BLOCK>
}

// MAXVIASTACK maxStack [RANGE bottomLayer topLayer] ; — caps the
// number of VIAs that can stack vertically. Per LEF/DEF 5.8 spec.
MAXVIASTACK_CMD: sequence dict {
  "MAXVIASTACK":type="MaxViaStack" space,
  int:max_stack=@ space,
  ?<MAXVIASTACK_RANGE>,
  ";" newline
}

MAXVIASTACK_RANGE: sequence {
  "RANGE" space,
  identifier:max_via_stack_bot=@ space,
  identifier:max_via_stack_top=@ space
}

// BEGINEXT "extName" ... ENDEXT — vendor-extension wrapper. Inner
// content is captured opaquely (as a raw string) via the
// `lefdef.until_endext` terminal parser, so the block round-trips
// even when the inner content is in a vendor-specific language
// the grammar doesn't model.
BEGINEXT_BLOCK: sequence dict {
  "BEGINEXT":type="BeginExt" space,
  string:name=@ newline,
  lefdef.until_endext:body=@,
  "ENDEXT" newline
}

// FIXEDMASK ; — library-level marker per LEF/DEF 5.8 §"FixedMask".
// Single-keyword statement; emits `is_fixed_mask: true` for round-trip.
FIXEDMASK_CMD: sequence dict {
  "FIXEDMASK":type="FixedMask":is_fixed_mask=true space,
  ";" newline
}

// === Header-level statements ============================================

CLEARANCEMEASURE_CMD: sequence dict {
  "CLEARANCEMEASURE":type="ClearanceMeasure" space,
  identifier:value=@ space, ";" newline
}

USEMINSPACING_CMD: sequence dict {
  "USEMINSPACING":type="UseMinSpacing" space,
  identifier:object=@ space,
  identifier:value=@ space, ";" newline
}

// === SPACING block (tech LEF top-level inter-layer spacing) ============
//
// LEF/DEF 5.8 §"Spacing" — top-level SAMENET inter-layer spacing
// rules. Distinct from per-layer SPACING (inside a LAYER block).
//
//   SPACING
//     {SAMENET layerName1 layerName2 minSpacing [STACK] ;} ...
//   END SPACING

SPACING_BLOCK: sequence dict {
  "SPACING":type="Spacing" newline,
  <SAMENET_RULES>:items=@,
  "END" space, "SPACING" newline
}

SAMENET_RULES: sequence array { repeat <SAMENET_RULE> }

SAMENET_RULE: sequence dict {
  "SAMENET" space,
  identifier:layer1=@ space,
  identifier:layer2=@ space,
  <NUMBER>:min_spacing=@ space,
  ?<SAMENET_STACK_KW>,
  ";" newline
}

SAMENET_STACK_KW: sequence { "STACK":is_stack=true space }

// === PROPERTYDEFINITIONS block ==========================================
//
//   PROPERTYDEFINITIONS
//     {LAYER | LIBRARY | MACRO | VIA | VIARULE | NONDEFAULTRULE | PIN}
//       propName {INTEGER | REAL | STRING} [rangeOrValue] ;
//     ...
//   END PROPERTYDEFINITIONS

PROPERTYDEFINITIONS_BLOCK: sequence dict {
  "PROPERTYDEFINITIONS":type="PropertyDefinitions" newline,
  <PROPDEFS>:definitions=@,
  "END" space, "PROPERTYDEFINITIONS" newline
}

PROPDEFS: sequence array { repeat <PROPDEF> }

// Discriminate the object kind via a Choice so that "END" — also a
// valid lefdef identifier — fails the PROPDEF match immediately
// rather than greedily consuming "END PROPERTYDEFINITIONS MACRO"
// across three identifier slots before failing on the trailing `;`.
// Repeat's iteration-boundary backtracking is scheduled as M1
// follow-on work (§2.4); this grammar shape sidesteps the need.
PROPDEF: sequence dict {
  <PROPDEF_OBJECT>:object=@ space,
  identifier:prop_name=@ space,
  identifier:data_type=@ space,
  ?<PROPDEF_RANGE>,
  ?<PROPDEF_DEFAULT>,
  ";" newline
}

// Optional RANGE constraint per LEF/DEF 5.8 §"PropertyDefinitions":
// `RANGE min max` between the data-type and the optional default.
PROPDEF_RANGE: sequence {
  "RANGE" space,
  <NUMBER>:range_min=@ space,
  <NUMBER>:range_max=@ space
}

// Optional default value after the data-type. Real corpus files
// include a trailing default for STRING-typed properties:
//   LIBRARY LEF58_VOLTAGEMODE STRING "VOLTAGEMODE ABSOLUTE ; " ;
PROPDEF_DEFAULT: choice {
  string:default_value=@ space,
  <NUMBER>:default_value=@ space
}

// VIARULE must come before VIA — predictive PEG matches the first
// successful prefix, so "VIA" would greedily consume the "VIA" of
// "VIARULE" and the subsequent token-boundary check would fail.
PROPDEF_OBJECT: choice {
  "LAYER":@,
  "LIBRARY":@,
  "MACRO":@,
  "VIARULE":@,
  "VIA":@,
  "NONDEFAULTRULE":@,
  "PIN":@
}

MANUFACTURINGGRID_CMD: sequence dict {
  "MANUFACTURINGGRID":type="ManufacturingGrid" space,
  <NUMBER>:value=@ space,
  ";" newline
}

// LEF coordinates and sizes are written either as integers (e.g.
// `ORIGIN 0 0 ;`) or as floats with a decimal point (e.g. `SIZE 0.56
// BY 3.92 ;`). The standard `float` terminal rejects bare integers
// (to avoid grammar ambiguity with `int`), so a choice rule covers
// both. Mirrors how CONSTANT in the .rawast meta-grammar handles
// numeric literals.
NUMBER: choice { float, int }

// === UNITS block ==========================================================
//
//   UNITS
//     [TIME NANOSECONDS factor ;]
//     [CAPACITANCE PICOFARADS factor ;]
//     [RESISTANCE OHMS factor ;]
//     [POWER MILLIWATTS factor ;]
//     [CURRENT MILLIAMPS factor ;]
//     [VOLTAGE VOLTS factor ;]
//     [DATABASE MICRONS dbu ;]
//     [FREQUENCY MEGAHERTZ factor ;]
//   END UNITS
//
// Per LEF/DEF 5.8 spec §"Units", each sub-statement is independently
// optional. Real files use varying orderings (Sky130 tech LEF opens
// with TIME, not DATABASE), so we accept them in any order via the
// permissive `repeat <UNITS_SUB>` form. Values are NUMBER (int | float).
// Spec doesn't require any particular sub-statement, so a bare
// `UNITS\nEND UNITS` would parse.

UNITS_BLOCK: sequence dict {
  "UNITS":type="Units" newline,
  repeat <UNITS_SUB>,
  "END" space, "UNITS" newline
}

UNITS_SUB: choice {
  <DATABASE_CMD>,
  <CAPACITANCE_CMD>,
  <CURRENT_CMD>,
  <RESISTANCE_CMD>,
  <TIME_CMD>,
  <POWER_CMD>,
  <VOLTAGE_CMD>,
  <FREQUENCY_CMD>
}

DATABASE_CMD:    sequence { "DATABASE"    space, "MICRONS"     space, int:database_microns=@ space, ";" newline }
CAPACITANCE_CMD: sequence { "CAPACITANCE" space, "PICOFARADS"  space, <NUMBER>:capacitance_pf=@  space, ";" newline }
CURRENT_CMD:     sequence { "CURRENT"     space, "MILLIAMPS"   space, <NUMBER>:current_ma=@      space, ";" newline }
RESISTANCE_CMD:  sequence { "RESISTANCE"  space, "OHMS"        space, <NUMBER>:resistance_ohms=@ space, ";" newline }
TIME_CMD:        sequence { "TIME"        space, "NANOSECONDS" space, <NUMBER>:time_ns=@         space, ";" newline }
POWER_CMD:       sequence { "POWER"       space, "MILLIWATTS"  space, <NUMBER>:power_mw=@        space, ";" newline }
VOLTAGE_CMD:     sequence { "VOLTAGE"     space, "VOLTS"       space, <NUMBER>:voltage_v=@       space, ";" newline }
FREQUENCY_CMD:   sequence { "FREQUENCY"   space, "MEGAHERTZ"   space, <NUMBER>:frequency_mhz=@   space, ";" newline }

// === SITE block ===========================================================
//
//   SITE siteName
//     [CLASS {PAD | CORE} ;]
//     [SYMMETRY {X | Y | R90} ... ;]
//     [ROWPATTERN siteName orient ... ;]
//     [SIZE width BY height ;]
//   END siteName
//
// Spec deviation, knowingly tolerated:
//   - LEF/DEF 5.8 §"Site" marks `CLASS` and `SIZE` as REQUIRED (no
//     brackets in the spec BNF), and orders sub-statements
//     canonically as CLASS → SYMMETRY → ROWPATTERN → SIZE. The
//     current `repeat <SITE_PROPERTY>` formulation makes both
//     required clauses optional and accepts them in any order.
//   - This is deliberate: real corpora diverge from canonical order
//     (hybrid_sites.lef opens with SYMMETRY; yod_V2.1.0.beta.2.lef
//     uses CLASS → SYMMETRY → SIZE), and a SITE missing CLASS or
//     SIZE is malformed but the grammar can't enforce "at least one
//     of each, in any order" without the NSEQ primitive (M2 scope).
//   - Spec-strict tightening — CLASS-required-first, SIZE-required-
//     last — is deferred until NSEQ lands (M2). Until then the
//     downstream Pydantic model has `class`, `width`, `height` as
//     Optional even though the spec says required.
SITE_BLOCK: sequence dict {
  "SITE":type="Site" space,
  identifier:name=@ newline,
  repeat <SITE_PROPERTY>,
  "END" space, identifier:end_name=@ newline
}

SITE_PROPERTY: choice {
  <SITE_SYMMETRY>,
  <SITE_CLASS>,
  <SITE_SIZE>,
  <SITE_ROWPATTERN>
}

SITE_SYMMETRY: sequence {
  "SYMMETRY" space,
  <SYMMETRY_LIST>:symmetry=@,
  ";" newline
}
SYMMETRY_LIST: sequence array { repeat identifier }

SITE_CLASS: sequence {
  "CLASS" space,
  identifier:class=@ space,
  ";" newline
}

SITE_SIZE: sequence {
  "SIZE" space,
  <NUMBER>:width=@ space,
  "BY" space,
  <NUMBER>:height=@ space,
  ";" newline
}

SITE_ROWPATTERN: sequence {
  "ROWPATTERN" space,
  <ROWPATTERN_LIST>:rowpattern=@,
  ";" newline
}
ROWPATTERN_LIST: sequence array { repeat <ROWPATTERN_PAIR> }
ROWPATTERN_PAIR: sequence dict {
  identifier:site=@ space,
  <SITE_ORIENT>:orient=@ space
}

SITE_ORIENT: choice {
  "N":"North",
  "S":"South",
  "E":"East",
  "W":"West",
  "FN":"FlipNorth",
  "FS":"FlipSouth",
  "FE":"FlipEast",
  "FW":"FlipWest"
}

// === MACRO block =========================================================
//
//   MACRO macroName
//     [CLASS class [subclass] ;]
//     [ORIGIN x y ;]
//     [FOREIGN cellName x y ;]
//     [SIZE width BY height ;]
//     [SYMMETRY {X | Y | R90} ... ;]
//     [SITE siteName ;]
//     [PIN ...] ...
//     [OBS ...]
//   END macroName
//
// PoC subset of the LEF/DEF 5.8 §6 MACRO definition. Optional
// sub-statements appear in spec-canonical order; the strict-order
// limitation awaits NSEQ (M2).

// MACRO body structure per LEF/DEF 5.8 §"Macro":
//   MACRO name
//     [<sub-properties: CLASS / ORIGIN / FOREIGN / SIZE /
//                       SYMMETRY / SITE>] ...
//     [PIN ...] ...
//     [OBS]
//     [DENSITY]
//     [PROPERTY ...] ...
//   END name
// PROPERTY clauses appear AT THE END (after PINs and OBS). To keep
// both pre-PIN and post-PIN PROPERTY positions accepted (real files
// vary), the pre-PIN repeat already includes MACRO_PROPERTY_KV, and
// a second repeat picks up trailing PROPERTY clauses.
MACRO_BLOCK: sequence dict {
  "MACRO":type="Macro" space,
  identifier:name=@ newline,
  repeat <MACRO_PROPERTY>,
  <MACRO_PINS>:pins=@,
  ?<MACRO_OBS>:obs=@,
  ?<MACRO_DENSITY>:density=@,
  <MACRO_PROPERTIES_TRAIL>:properties=@,
  "END" space, identifier:end_name=@ newline
}

// Trailing `PROPERTY name value ;` clauses per LEF/DEF 5.8 §"Macro"
// — captured as a list under `properties` (the unbound `repeat`
// formerly discarded them because PROPERTY_KV is dict-container).
MACRO_PROPERTIES_TRAIL: sequence array {
  repeat <MACRO_PROPERTY_KV>
}

// MACRO sub-statements in any order — same pattern as HDR_CMD.
// Pending NSEQ (M2), this is the pragmatic way to accept real LEFs
// that don't follow the spec's CLASS → ORIGIN → FOREIGN → SIZE →
// SYMMETRY → SITE canonical ordering.
MACRO_PROPERTY: choice {
  <MACRO_CLASS>,
  <MACRO_FIXEDMASK>,
  <MACRO_FOREIGN>,
  <MACRO_EEQ>,
  <MACRO_ORIGIN>,
  <MACRO_SIZE>,
  <MACRO_SYMMETRY>,
  <MACRO_SITE_REF>,
  <MACRO_SOURCE>
}

// EEQ macroName ; — equivalent-macro reference per LEF/DEF 5.8
// §"Macro". Container-less; emits `eeq` field on parent MACRO.
MACRO_EEQ: sequence {
  "EEQ" space, identifier:eeq=@ space, ";" newline
}

// FIXEDMASK at MACRO level — distinct from library-level
// FIXEDMASK_CMD; marks the macro as having a fixed mask shift.
MACRO_FIXEDMASK: sequence {
  "FIXEDMASK":fixed_mask=true space, ";" newline
}

// DENSITY block: LAYER name followed by one-or-more `RECT pt pt
// density ;` clauses, per LEF/DEF 5.8 §"Density". Used in fill cells.
MACRO_DENSITY: sequence dict {
  "DENSITY":type="Density" newline,
  <MACRO_DENSITY_LAYERS>:layers=@,
  "END" newline
}

MACRO_DENSITY_LAYERS: sequence array { repeat <MACRO_DENSITY_LAYER> }

MACRO_DENSITY_LAYER: sequence dict {
  "LAYER" space, identifier:layer=@ space, ";" newline,
  <MACRO_DENSITY_RECTS>:rects=@
}

MACRO_DENSITY_RECTS: sequence array { repeat+ <MACRO_DENSITY_RECT> }

MACRO_DENSITY_RECT: sequence dict {
  "RECT":type="Rect" space,
  <NUMBER>:x1=@ space, <NUMBER>:y1=@ space,
  <NUMBER>:x2=@ space, <NUMBER>:y2=@ space,
  <NUMBER>:density=@ space,
  ";" newline
}

// SOURCE was a MACRO sub-statement in LEF 5.6 and earlier; the spec
// dropped it post-5.6 but real PDKs still emit it (Sky130 5.5 IO
// pads use `SOURCE USER ;`). Accepted as a permissive deprecated-
// form pass-through so we can parse real corpus files.
MACRO_SOURCE: sequence {
  "SOURCE" space,
  identifier:source=@ space,
  ";" newline
}

// User-defined PROPERTY clauses — names declared in
// PROPERTYDEFINITIONS, values typed per the declaration. Per LEF
// spec, the value can be INTEGER, REAL, or STRING.
MACRO_PROPERTY_KV: sequence dict {
  "PROPERTY" space,
  identifier:prop_name=@ space,
  <PROPERTY_VALUE>:prop_value=@ space,
  ";" newline
}

PROPERTY_VALUE: choice {
  <NUMBER>,
  string
}

MACRO_CLASS: sequence {
  "CLASS" space,
  <CLASS_LIST>:class=@,
  ";" newline
}
CLASS_LIST: sequence array { repeat identifier }

MACRO_ORIGIN: sequence {
  "ORIGIN" space,
  <NUMBER>:origin_x=@ space, <NUMBER>:origin_y=@ space,
  ";" newline
}

// FOREIGN — cell name plus optional (x,y) offset. Real LEFs use both
// forms: `FOREIGN cellName ;` and `FOREIGN cellName 0 0 ;`.
MACRO_FOREIGN: sequence {
  "FOREIGN" space,
  identifier:foreign_cell=@ space,
  ?<MACRO_FOREIGN_XY>,
  ";" newline
}
MACRO_FOREIGN_XY: sequence {
  <NUMBER>:foreign_x=@ space, <NUMBER>:foreign_y=@ space
}

MACRO_SIZE: sequence {
  "SIZE" space,
  <NUMBER>:width=@ space,
  "BY" space,
  <NUMBER>:height=@ space,
  ";" newline
}

MACRO_SYMMETRY: sequence {
  "SYMMETRY" space,
  <SYMMETRY_LIST>:symmetry=@,
  ";" newline
}

// SITE reference inside a MACRO (not a SITE block definition).
MACRO_SITE_REF: sequence {
  "SITE" space, identifier:site=@ space, ";" newline
}

// === PIN inside MACRO ====================================================

MACRO_PINS: sequence array { repeat <PIN_BLOCK> }

// PIN block — per LEF/DEF 5.8 spec carries DIRECTION / USE plus
// zero-or-more ANTENNA* clauses (model-specific antenna properties
// per layer) before its PORTs. PIN_PROPERTY is the open-ended
// repeat over these optional sub-statements; PORTs follow.
PIN_BLOCK: sequence dict {
  "PIN":type="Pin" space,
  identifier:name=@ newline,
  repeat <PIN_PROPERTY>,
  <PIN_PORTS>:ports=@,
  "END" space, identifier:end_name=@ newline
}

PIN_PROPERTY: choice {
  <PIN_DIRECTION>,
  <PIN_USE>,
  <PIN_SHAPE>,
  <PIN_TAPERRULE>,
  <PIN_NETEXPR>,
  <PIN_SUPPLYSENSITIVITY>,
  <PIN_GROUNDSENSITIVITY>,
  <PIN_MUSTJOIN>,
  <PIN_PROPERTY_KV>,
  <PIN_ANTENNA_PROP>
}

// SUPPLYSENSITIVITY / GROUNDSENSITIVITY per LEF/DEF 5.8 §"Pin" —
// name a power/ground pin this signal pin is sensitive to.
// Container-less, catcher-flatten.
PIN_SUPPLYSENSITIVITY: sequence {
  "SUPPLYSENSITIVITY" space,
  identifier:supply_sensitivity=@ space,
  ";" newline
}
PIN_GROUNDSENSITIVITY: sequence {
  "GROUNDSENSITIVITY" space,
  identifier:ground_sensitivity=@ space,
  ";" newline
}

// MUSTJOIN pinName ; — declares the pin must be joined with another.
PIN_MUSTJOIN: sequence {
  "MUSTJOIN" space,
  identifier:must_join=@ space,
  ";" newline
}

// PIN-level PROPERTY clauses (declared in PROPERTYDEFINITIONS).
// Container-less; single-PROPERTY-per-PIN survives via catcher (last
// write wins for multiples). Proper list capture is M2 work.
PIN_PROPERTY_KV: sequence {
  "PROPERTY" space,
  identifier:pin_prop_name=@ space,
  <PROPERTY_VALUE>:pin_prop_value=@ space,
  ";" newline
}

// DIRECTION per LEF spec:
//   {INPUT | OUTPUT [TRISTATE] | INOUT | FEEDTHRU}
// The TRISTATE qualifier after OUTPUT is optional.
PIN_DIRECTION: sequence {
  "DIRECTION" space, identifier:direction=@ space,
  ?identifier:direction_modifier=@ space,
  ";" newline
}

PIN_USE: sequence {
  "USE" space, identifier:use=@ space, ";" newline
}

PIN_SHAPE: sequence {
  "SHAPE" space, identifier:shape=@ space, ";" newline
}

PIN_TAPERRULE: sequence {
  "TAPERRULE" space, identifier:taper_rule=@ space, ";" newline
}

PIN_NETEXPR: sequence {
  "NETEXPR" space, string:net_expr=@ space, ";" newline
}

// ANTENNA* properties — the LEF spec defines ~10 variants
// (ANTENNADIFFAREA, ANTENNAGATEAREA, ANTENNAPARTIALMETALAREA,
// ANTENNAPARTIALMETALSIDEAREA, ANTENNAMAXAREACAR,
// ANTENNAMAXSIDEAREACAR, ANTENNAMAXCUTCAR, ANTENNAPARTIALCUTAREA,
// ANTENNAMODEL, ANTENNAANYDIFFAREA, ...). They all share the same
// `KEYWORD value [LAYER layerName] ;` shape, so a single generic
// rule captures the keyword as `antenna_kind`.
// ANTENNA value is usually a number (area or factor) but for
// ANTENNAMODEL it's an identifier (OXIDE1 / OXIDE2 / OXIDE3 /
// OXIDE4). Choice keeps both forms.
//
// Container-less (no `dict`) so `antenna_kind`, `value`, and
// `antenna_layer` catcher-flatten into the enclosing PIN dict.
// Limitation: a PIN with multiple ANTENNA clauses of different
// kinds collapses to last-write-wins (only the final kind/value
// survives). Real-corpus check (Sky130 IO) shows each PIN has at
// most one ANTENNA clause, so this is acceptable for now;
// proper list-of-antennas capture is M2 work.
PIN_ANTENNA_PROP: sequence {
  <PIN_ANTENNA_KIND>:antenna_kind=@ space,
  <PIN_ANTENNA_VALUE>:value=@ space,
  ?<PIN_ANTENNA_LAYER>,
  ";" newline
}

PIN_ANTENNA_VALUE: choice {
  <NUMBER>,
  identifier
}

PIN_ANTENNA_KIND: choice {
  "ANTENNADIFFAREA":"AntennaDiffArea",
  "ANTENNAGATEAREA":"AntennaGateArea",
  "ANTENNAPARTIALMETALAREA":"AntennaPartialMetalArea",
  "ANTENNAPARTIALMETALSIDEAREA":"AntennaPartialMetalSideArea",
  "ANTENNAMAXAREACAR":"AntennaMaxAreaCar",
  "ANTENNAMAXSIDEAREACAR":"AntennaMaxSideAreaCar",
  "ANTENNAMAXCUTCAR":"AntennaMaxCutCar",
  "ANTENNAPARTIALCUTAREA":"AntennaPartialCutArea",
  "ANTENNAANYDIFFAREA":"AntennaAnyDiffArea",
  "ANTENNAMODEL":"AntennaModel"
}

PIN_ANTENNA_LAYER: sequence {
  "LAYER" space, identifier:antenna_layer=@ space
}

PIN_PORTS: sequence array { repeat <PORT_BLOCK> }

// PORT is a sequence of layer groups: each group is a LAYER statement
// followed by one-or-more shapes on that layer.

// PORT carries an optional CLASS clause before its LAYER groups per
// LEF/DEF 5.8 spec: `PORT [CLASS {NONE | CORE | BUMP} ;] {LAYER ...} ... END`.
PORT_BLOCK: sequence dict {
  "PORT":type="Port" newline,
  ?<PORT_CLASS>,
  <LAYER_GROUPS>:layer_groups=@,
  "END" newline
}

PORT_CLASS: sequence {
  "CLASS" space, identifier:port_class=@ space, ";" newline
}

LAYER_GROUPS: sequence array { repeat <LAYER_GROUP> }

// LAYER declaration inside a PORT or OBS block. Can carry optional
// EXCEPTPGNET / SPACING / DESIGNRULEWIDTH / MASK modifiers per LEF/DEF
// 5.8 spec before the `;`, then optional WIDTH statement, then 1+
// shape clauses (RECT / POLYGON / PATH / VIA placement).
LAYER_GROUP: sequence dict {
  "LAYER" space, identifier:layer=@ space,
  repeat <LAYER_GROUP_MOD>,
  ";" newline,
  ?<LAYER_WIDTH_CMD>,
  <SHAPES>:shapes=@
}

LAYER_GROUP_MOD: choice {
  <LAYER_GROUP_EXCEPTPGNET>,
  <LAYER_GROUP_SPACING>,
  <LAYER_GROUP_DESIGNRULEWIDTH>,
  <LAYER_GROUP_MASK>
}

LAYER_GROUP_EXCEPTPGNET:     sequence { "EXCEPTPGNET":except_pg_net=true space }
LAYER_GROUP_SPACING:         sequence { "SPACING"         space, <NUMBER>:layer_spacing=@           space }
LAYER_GROUP_DESIGNRULEWIDTH: sequence { "DESIGNRULEWIDTH" space, <NUMBER>:layer_design_rule_width=@ space }
LAYER_GROUP_MASK:            sequence { "MASK"            space, int:layer_mask_num=@               space }

// Per-LAYER-group WIDTH statement — sets the default wire width for
// subsequent shapes (separate from LAYER's MASK / SPACING modifiers).
LAYER_WIDTH_CMD: sequence {
  "WIDTH" space, <NUMBER>:layer_default_width=@ space, ";" newline
}

SHAPES: sequence array { repeat <SHAPE> }
SHAPE: choice {
  <RECT_SHAPE>,
  <POLYGON_SHAPE>,
  <PATH_SHAPE>,
  <VIA_PLACEMENT>
}

// MASK modifier (per-shape mask number, separate from layer-level MASK).
MASK_MOD: sequence {
  "MASK" space, int:mask_num=@ space
}

// ITERATE prefix marker. When present, the shape becomes a step-
// repeated array of itself; the step pattern follows the geometry.
ITERATE_PREFIX: sequence {
  "ITERATE":is_iterate=true space,
  ?<MASK_MOD>
}

// stepPattern per LEF/DEF 5.8 — `numX numY xStep yStep` trailing
// the geometry when ITERATE was declared.
STEP_PATTERN: sequence dict {
  int:step_num_x=@ space, int:step_num_y=@ space,
  <NUMBER>:step_x=@ space, <NUMBER>:step_y=@ space
}

RECT_SHAPE: sequence dict {
  "RECT":type="Rect" space,
  ?<MASK_MOD>,
  ?<ITERATE_PREFIX>,
  <NUMBER>:x1=@ space, <NUMBER>:y1=@ space,
  <NUMBER>:x2=@ space, <NUMBER>:y2=@ space,
  ?<STEP_PATTERN>:step_pattern=@,
  ";" newline
}

POLYGON_SHAPE: sequence dict {
  "POLYGON":type="Polygon" space,
  ?<MASK_MOD>,
  ?<ITERATE_PREFIX>,
  <POLYGON_POINTS>:points=@,
  ?<STEP_PATTERN>:step_pattern=@,
  ";" newline
}
POLYGON_POINTS: sequence array { repeat <NUMBER> }

// PATH — segmented line with point list per LEF/DEF 5.8 §"Path".
PATH_SHAPE: sequence dict {
  "PATH":type="Path" space,
  ?<MASK_MOD>,
  ?<ITERATE_PREFIX>,
  <PATH_POINTS>:points=@,
  ?<STEP_PATTERN>:step_pattern=@,
  ";" newline
}
PATH_POINTS: sequence array { repeat+ <NUMBER> }

// VIA placement inside a port / obs layer group: `VIA [MASK n] pt
// viaName ;` per LEF/DEF 5.8. Distinct from VIA_BLOCK definitions
// and VIA_LAYER_GROUP at VIA-definition level.
VIA_PLACEMENT: sequence dict {
  "VIA":type="ViaPlacement" space,
  ?<MASK_MOD>,
  ?<ITERATE_PREFIX>,
  <NUMBER>:x=@ space, <NUMBER>:y=@ space,
  identifier:via_name=@ space,
  ?<STEP_PATTERN>:step_pattern=@,
  ";" newline
}

// === OBS (obstructions) — MACRO-level; same layer-group structure ========

MACRO_OBS: sequence dict {
  "OBS":type="Obs" newline,
  <LAYER_GROUPS>:layer_groups=@,
  "END" newline
}

// === LAYER block (tech LEF) ==============================================
//
// LEF/DEF 5.8 §"Layer" definitions — opener + TYPE + many optional
// property clauses + closer. Real tech LEFs have dozens of clauses
// per layer covering routing/cut/via/masterslice/implant/overlap
// types, design-rule constraints, electrical properties, and
// LEF58_* property assignments.
//
// PoC approach: enumerate the common property keywords as a Choice;
// each clause captures the keyword as `kind` and the trailing
// `<values>` (numbers, identifiers, or quoted strings) until `;`.
// Stop-condition is the closing `END <name>`: the keyword Choice
// excludes "END", so the repeat exits cleanly when it sees the
// closing.
//
// PoC omission: LEF58 spec extensions (PROPERTY name "..."
// embedded clauses are captured but their internal grammar isn't
// re-parsed; full LEF58 support is M4 work).

LAYER_BLOCK: sequence dict {
  "LAYER":type="Layer" space,
  identifier:name=@ newline,
  <LAYER_PROPERTIES>:properties=@,
  "END" space, identifier:end_name=@ newline
}

LAYER_PROPERTIES: sequence array { repeat <LAYER_PROPERTY> }

LAYER_PROPERTY: sequence dict {
  <LAYER_KEYWORD>:kind=@ space,
  <LAYER_VALUES>:values=@,
  ";" newline
}

// LAYER value tokens: each can be a number, an identifier (TYPE
// values like ROUTING / CUT / IMPLANT, sub-keywords like RPERSQ /
// CPERSQDIST), a quoted string (PROPERTY values), or a
// parenthesized list of values (PWL piecewise-linear functions,
// nested coordinate groups). Repeats until `;`.
LAYER_VALUES: sequence array { repeat <LAYER_VALUE> }
LAYER_VALUE: choice {
  <NUMBER>,
  string,
  identifier,
  <LAYER_PAREN_GROUP>
}

// Parenthesized value group: `( <values> )` — used for PWL
// piecewise-linear functions like
//   ANTENNACUMDIFFAREARATIO PWL ( ( 0 200 ) ( 0.159 200 ) ... ) ;
// Recursive — inner parens are themselves parenthesized groups.
LAYER_PAREN_GROUP: sequence array {
  "(" space, repeat <LAYER_VALUE>, ")" space
}

// Enumeration of LAYER property keywords. Closed list so that
// `END` (the block closer) is not mistaken for a property. New
// LEF58_* and other vendor-specific keywords can be added as
// needed; this is the PoC subset covering the ChipFlow open-PDK
// corpus.
LAYER_KEYWORD: choice {
  "TYPE":@,
  "MASK":@,
  "PITCH":@,
  "OFFSET":@,
  "DIRECTION":@,
  "WIDTH":@,
  "MINWIDTH":@,
  "MAXWIDTH":@,
  "AREA":@,
  "SPACING":@,
  "SPACINGTABLE":@,
  "MINENCLOSEDAREA":@,
  "MINSTEP":@,
  "MINCUTS":@,
  "RESISTANCE":@,
  "CAPACITANCE":@,
  "EDGECAPACITANCE":@,
  "HEIGHT":@,
  "THICKNESS":@,
  "ACCURRENTDENSITY":@,
  "DCCURRENTDENSITY":@,
  "CURRENTDEN":@,
  "ANTENNAAREARATIO":@,
  "ANTENNADIFFAREARATIO":@,
  "ANTENNACUMAREARATIO":@,
  "ANTENNACUMDIFFAREARATIO":@,
  "ANTENNAAREAFACTOR":@,
  "ANTENNAGATEPLUSDIFF":@,
  "ANTENNASIDEAREARATIO":@,
  "ANTENNASIDEAREAFACTOR":@,
  "ANTENNAMODEL":@,
  "ENCLOSURE":@,
  "PREFERENCLOSURE":@,
  "PROPERTY":@,
  "STACK":@,
  "SLOTWIRELENGTH":@,
  "SLOTWIREWIDTH":@,
  "MAXIMUMDENSITY":@,
  "MINIMUMDENSITY":@,
  "DENSITYCHECKWINDOW":@,
  "DENSITYCHECKSTEP":@,
  "FILLACTIVESPACING":@,
  "MINIMUMCUT":@,
  "ARRAYSPACING":@,
  "ANTENNADIFFSIDEAREARATIO":@,
  "EOLENCLOSURE":@,
  "PARALLELRUNLENGTH":@,
  "MINSIZE":@,
  "WIDTHTABLE":@,
  "WIREEXTENSION":@,
  "CORNERONLY":@,
  "CORNERSPACING":@,
  "CUTCLASS":@,
  "EOLKEEPOUT":@,
  "PARALLELEDGE":@,
  "RECTONLY":@,
  "RIGHTWAYONGRIDONLY":@
}

// === VIA block (tech LEF) ================================================
//
// LEF/DEF 5.8 §"Via" — two forms: geometry-based (LAYER + shape
// patches per layer) and VIARULE-based. The geometry form is what
// shows up in the open-PDK corpus. The block is closed with
// `END viaName`.
//
//   VIA viaName [DEFAULT]
//     [RESISTANCE value ;]
//     {LAYER layerName ;
//        {RECT (x1 y1) (x2 y2) | POLYGON pts ...} ...
//     } ...
//   END viaName

VIA_BLOCK: sequence dict {
  <VIA_KW>:type=@ space,
  identifier:name=@ space,
  ?<VIA_DEFAULT_KW>,
  <VIA_PROPERTIES>:properties=@,
  "END" space, identifier:end_name=@ newline
}

VIA_PROPERTIES: sequence array { repeat <VIA_PROPERTY> }

// LEF keyword spec-uppercase ("VIA") but some real tools emit
// mixed-case ("Via"). Accept both.
VIA_KW: choice {
  "VIA":@,
  "Via":@
}

// LEF keywords are spec-uppercase ("DEFAULT") but some real tools
// emit mixed-case ("Default"). Accept both.
VIA_DEFAULT_KW: sequence {
  <VIA_DEFAULT_LITERAL>:is_default=true newline
}
VIA_DEFAULT_LITERAL: choice {
  "DEFAULT":@,
  "Default":@
}

VIA_PROPERTY: choice {
  <VIA_RESISTANCE>,
  <VIA_LAYER_GROUP>
}

VIA_RESISTANCE: sequence dict {
  "RESISTANCE":type="Resistance" space,
  <NUMBER>:value=@ space, ";" newline
}

// Each LAYER + shape group in a VIA: layer name followed by shapes.
VIA_LAYER_GROUP: sequence dict {
  "LAYER" space, identifier:layer=@ space, ";" newline,
  <VIA_SHAPES>:shapes=@
}

VIA_SHAPES: sequence array { repeat+ <VIA_SHAPE> }
VIA_SHAPE: choice {
  <VIA_RECT>,
  <VIA_POLYGON>
}

VIA_RECT: sequence dict {
  "RECT":type="Rect" space,
  <NUMBER>:x1=@ space, <NUMBER>:y1=@ space,
  <NUMBER>:x2=@ space, <NUMBER>:y2=@ space,
  ";" newline
}

VIA_POLYGON: sequence dict {
  "POLYGON":type="Polygon" space,
  <POLYGON_POINTS>:points=@,
  ";" newline
}

// === VIARULE block (tech LEF) ============================================
//
// LEF/DEF 5.8 §"Via Rule" — defines a parameterized via rule
// referenced from VIAs and from routing tools. Two forms:
// generate-rules (with CUTSIZE / LAYERS / etc.) and layer-pair
// rules (just LAYER properties). Corpus form is mostly the
// LAYER-pair variant with simple property clauses.
//
// Permissive structure: opener + body of generic LAYER /
// keyword-value clauses (reuses LAYER_PROPERTY structure since the
// allowed keywords overlap heavily) + closer.

VIARULE_BLOCK: sequence dict {
  <VIARULE_KW>:type=@ space,
  identifier:name=@ space,
  ?<VIARULE_GENERATE_KW>,
  ?<VIA_DEFAULT_KW>,
  <VIARULE_PROPERTIES>:properties=@,
  "END" space, identifier:end_name=@ newline
}

VIARULE_PROPERTIES: sequence array { repeat <VIARULE_PROPERTY> }

// LEF keyword spec-uppercase ("VIARULE") but some real tools emit
// mixed-case ("ViaRULE"). Accept both.
VIARULE_KW: choice {
  "VIARULE":@,
  "ViaRULE":@
}

VIARULE_GENERATE_KW: sequence { "GENERATE":is_generate=true space }

// VIARULE body items are a flat sequence of: LAYER declarations,
// LAYER properties (ENCLOSURE / SPACING / etc), and shapes
// (RECT / POLYGON). Spec-wise the LAYER properties apply to the
// most recent LAYER declaration; the grammar keeps them flat and
// leaves grouping to the consumer.
VIARULE_PROPERTY: choice {
  <VIARULE_LAYER_DECL>,
  <VIA_RECT>,
  <VIA_POLYGON>,
  <LAYER_PROPERTY>
}

VIARULE_LAYER_DECL: sequence dict {
  "LAYER":type="Layer" space, identifier:layer=@ space, ";" newline
}

// === NONDEFAULTRULE block (tech LEF) =====================================
//
// LEF/DEF 5.8 §"NonDefault Rule" — per-net rules overriding default
// LAYER widths/spacings, with optional HARDSPACING marker, per-LAYER
// width/spacing/diagspacing/wireext properties, VIA / VIARULE
// references, and MINCUTS overrides. Spec shape:
//
//   NONDEFAULTRULE ruleName
//     [+ HARDSPACING]
//     {+ LAYER layerName WIDTH minWidth
//        [DIAGSPACING diagSpacing]
//        [SPACING minSpacing]
//        [WIREEXT wireExt] ;} ...
//     [+ VIA viaName] ...
//     [+ VIARULE viaRuleName] ...
//     [+ MINCUTS cutLayerName numCuts] ...
//   END ruleName
//
// (The `+`-prefix syntax is DEF NDR; LEF NDR uses plain keywords
// without `+`.)
NONDEFAULTRULE_BLOCK: sequence dict {
  "NONDEFAULTRULE":type="NonDefaultRule" space,
  identifier:name=@ newline,
  <NDR_PROPERTIES>:properties=@,
  "END" space, identifier:end_name=@ newline
}

NDR_PROPERTIES: sequence array { repeat <NDR_PROPERTY> }

// Choice ordering: VIARULE before VIA, MINCUTS before any other M-prefix.
NDR_PROPERTY: choice {
  <NDR_HARDSPACING>,
  <NDR_LAYER>,
  <NDR_VIARULE_REF>,
  <NDR_VIA_REF>,
  <NDR_MINCUTS>
}

NDR_HARDSPACING: sequence dict {
  "HARDSPACING":type="HardSpacing":is_hard_spacing=true space, ";" newline
}

// LAYER sub-block: name then a free-order list of WIDTH/SPACING/
// DIAGSPACING/WIREEXT properties (spec mandates WIDTH first; we're
// permissive here too).
NDR_LAYER: sequence dict {
  "LAYER":type="Layer" space, identifier:layer=@ space,
  repeat <NDR_LAYER_PROP>,
  ";" newline
}

NDR_LAYER_PROP: choice {
  <NDR_LAYER_WIDTH>,
  <NDR_LAYER_SPACING>,
  <NDR_LAYER_DIAGSPACING>,
  <NDR_LAYER_WIREEXT>
}

NDR_LAYER_WIDTH:       sequence { "WIDTH"       space, <NUMBER>:width=@ space }
NDR_LAYER_SPACING:     sequence { "SPACING"     space, <NUMBER>:spacing=@ space }
NDR_LAYER_DIAGSPACING: sequence { "DIAGSPACING" space, <NUMBER>:diag_spacing=@ space }
NDR_LAYER_WIREEXT:     sequence { "WIREEXT"     space, <NUMBER>:wire_ext=@ space }

NDR_VIA_REF: sequence dict {
  "VIA":type="Via" space, identifier:via=@ space, ";" newline
}

NDR_VIARULE_REF: sequence dict {
  "VIARULE":type="ViaRule" space, identifier:viarule=@ space, ";" newline
}

NDR_MINCUTS: sequence dict {
  "MINCUTS":type="MinCuts" space,
  identifier:cut_layer=@ space,
  int:num_cuts=@ space, ";" newline
}
