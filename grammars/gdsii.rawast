// =========================================================================
// grammars/gdsii.rawast
//
// GDSII binary stream format — full structural grammar.
//
// The 47 record-type terminals (gdsii.header, gdsii.bgnlib, ..., gdsii.endmasks)
// are provided by C++ `register_gdsii_parsers(grammar)` — see
// include/rawast/parsers_gdsii.hpp. Each is a binary-record parser that
// matches its specific record-type byte and decodes the payload by data
// type (INT16, INT32, REAL64, STR, NO_DATA, BIT_ARRAY).
//
// Structural patterns used below:
//   `?` prefix                    optional rule / token
//   `repeat <X>` inside `array`   array of X
//   `choice { ... }`              record-type dispatch (predictive PEG;
//                                 each branch starts with a unique
//                                 discriminator record)
//   `sequence` (no container)     fields flow into the surrounding
//                                 dict catcher (§3.4 of the proposal —
//                                 used for STRANS_GROUP, TEXTBODY,
//                                 MASKS that act as field groups
//                                 inlined into their parent)
//   `<NAME>` reference            non-terminal reference
//   `tag:field=@`                 emit (field, parsed value) into dict
//   `tag:field="literal"`         emit (field, constant) — discriminator
//                                 records use this to label the parent
//
// Example output for a minimal library with one boundary:
//   {
//     "version": 5,
//     "timestamp": [...],
//     "name": "MYLIB",
//     "units": [0.001, 1e-9],
//     "structures": [
//       {
//         "timestamp": [...],
//         "name": "TOP",
//         "elements": [
//           {
//             "element": "boundary",
//             "layer": 1,
//             "datatype": 0,
//             "xy": [0, 0, 100, 0, 100, 100, 0, 100, 0, 0]
//           }
//         ]
//       }
//     ]
//   }
// =========================================================================

use: gdsii

start: <LIBRARY>

// ---------------------------------------------------------------------
// LIBRARY — the top-level GDSII container.
// ---------------------------------------------------------------------

LIBRARY: sequence dict {
  gdsii.header:version=@,
  gdsii.bgnlib:timestamp=@,
  gdsii.libname:name=@,
  ?gdsii.reflibs:reflibs=@,
  ?gdsii.fonts:fonts=@,
  ?gdsii.attrtable:attributes=@,
  ?gdsii.generations:gens=@,
  ?<FORMATTYPE>:format_type=@,
  gdsii.units:units=@,
  ?<STRUCTURES>:structures=@,
  gdsii.endlib,
  ?gdsii.padding:padding_bytes=@
}

STRUCTURES: sequence array {
  repeat <STRUCTURE>
}

// ---------------------------------------------------------------------
// FORMATTYPE / MASKS — optional file-format declaration.
// ---------------------------------------------------------------------

FORMATTYPE: sequence dict {
  gdsii.format:format=@,
  ?<MASKS>
}

// MASKS is container-less: its `masks` field flows into FORMATTYPE's
// dict via the catcher mechanism.
MASKS: sequence {
  ?<MASK_ARRAY>:masks=@,
  gdsii.endmasks
}

MASK_ARRAY: sequence array {
  repeat gdsii.mask
}

// ---------------------------------------------------------------------
// STRUCTURE — one cell definition.
// ---------------------------------------------------------------------

STRUCTURE: sequence dict {
  gdsii.bgnstr:timestamp=@,
  gdsii.strname:name=@,
  ?gdsii.strclass:class=@,
  ?<ELEMENTS>:elements=@,
  gdsii.endstr
}

ELEMENTS: sequence array {
  repeat <ELEMENT>
}

// ---------------------------------------------------------------------
// ELEMENT — one geometric / hierarchical entity. The seven kinds are
// distinguished by their leading discriminator record; each carries
// the "element" label as a constant in its dict.
// ---------------------------------------------------------------------

ELEMENT: sequence dict {
  choice {
    <BOUNDARY_ELEM>,
    <PATH_ELEM>,
    <SREF_ELEM>,
    <AREF_ELEM>,
    <TEXT_ELEM>,
    <NODE_ELEM>,
    <BOX_ELEM>
  },
  ?<PROPERTIES>:properties=@,
  gdsii.endel
}

PROPERTIES: sequence array {
  repeat <PROPERTY>
}

PROPERTY: sequence dict {
  gdsii.propattr:name=@,
  gdsii.propvalue:value=@
}

// All *_ELEM rules are container-less sequences — their fields flow
// into the surrounding ELEMENT dict via the catcher mechanism.

BOUNDARY_ELEM: sequence {
  gdsii.boundary:element="boundary",
  ?gdsii.elflags:flags=@,
  ?gdsii.plex:plex=@,
  gdsii.layer:layer=@,
  gdsii.datatype:datatype=@,
  gdsii.xy:xy=@
}

PATH_ELEM: sequence {
  gdsii.path:element="path",
  ?gdsii.elflags:flags=@,
  ?gdsii.plex:plex=@,
  gdsii.layer:layer=@,
  gdsii.datatype:datatype=@,
  ?gdsii.pathtype:pathtype=@,
  ?gdsii.width:width=@,
  ?gdsii.bgnextn:begin_ext=@,
  ?gdsii.endextn:end_ext=@,
  gdsii.xy:xy=@
}

SREF_ELEM: sequence {
  gdsii.sref:element="sref",
  ?gdsii.elflags:flags=@,
  ?gdsii.plex:plex=@,
  gdsii.sname:name=@,
  ?<STRANS_GROUP>,
  gdsii.xy:xy=@
}

AREF_ELEM: sequence {
  gdsii.aref:element="aref",
  ?gdsii.elflags:flags=@,
  ?gdsii.plex:plex=@,
  gdsii.sname:name=@,
  ?<STRANS_GROUP>,
  gdsii.colrow:colrow=@,
  gdsii.xy:xy=@
}

TEXT_ELEM: sequence {
  gdsii.text:element="text",
  ?gdsii.elflags:flags=@,
  ?gdsii.plex:plex=@,
  gdsii.layer:layer=@,
  <TEXTBODY>
}

NODE_ELEM: sequence {
  gdsii.node:element="node",
  ?gdsii.elflags:flags=@,
  ?gdsii.plex:plex=@,
  gdsii.layer:layer=@,
  gdsii.nodetype:datatype=@,
  gdsii.xy:xy=@
}

BOX_ELEM: sequence {
  gdsii.box:element="box",
  ?gdsii.elflags:flags=@,
  ?gdsii.plex:plex=@,
  gdsii.layer:layer=@,
  gdsii.boxtype:datatype=@,
  gdsii.xy:xy=@
}

// ---------------------------------------------------------------------
// STRANS_GROUP / TEXTBODY — container-less. Their fields flow into
// the surrounding SREF/AREF/TEXT_ELEM dict via the catcher mechanism.
// ---------------------------------------------------------------------

STRANS_GROUP: sequence {
  gdsii.strans:strans=@,
  ?gdsii.mag:mag=@,
  ?gdsii.angle:angle=@
}

TEXTBODY: sequence {
  gdsii.texttype:datatype=@,
  ?gdsii.presentation:presentation=@,
  ?gdsii.pathtype:pathtype=@,
  ?gdsii.width:width=@,
  ?<STRANS_GROUP>,
  gdsii.xy:xy=@,
  gdsii.string:text=@
}
