{
  "start": "VALUE",

  // Pull in standard text terminal parsers (int, float, string,
  // identifier, whitespace, line_comment, block_comment). Each is
  // addressable bare (`int`) or qualified (`std.int`).
  "use": ["std"],

  // Items use the multi-binding wrapper form ({expr, bindings?}). The
  // `bindings` field is OMITTED when empty — bare items collapse to
  // just `{"expr": <X>}`. This matches what the .rawast meta-grammar
  // produces, letting JSON and .rawast forms round-trip cleanly.
  // Bindings is an ordered array of {name, value} entries. Var binding
  // (parsed value becomes dict key) is `{"bindings": [{"name": "", "value": "@"}]}`.

  // Strict JSON (RFC 8259): only whitespace is skipped between tokens.
  // For JSONC tolerance, add "line_comment" and "block_comment" to
  // VALUE's rule_ignore. The ignore policy lives on the start rule and
  // propagates to all callees until something overrides it.
  "VALUE": {
    "type": "choice",
    "rule_ignore": ["whitespace"],
    "items": [
      {"expr": "STRUCT"},
      {"expr": "LIST"},
      {"expr": {"type": "string"}},
      {"expr": {"type": "float"}},
      {"expr": {"type": "int"}},
      {"expr": {"type": "key", "key": "null",  "value": null}},
      {"expr": {"type": "key", "key": "true",  "value": true}},
      {"expr": {"type": "key", "key": "false", "value": false}}
    ]
  },

  // Pretty-print (save with pretty=true): `[`/`{` open with a newline,
  // each element indents one level (`tab indent` on the repeat item),
  // elements are comma+newline separated, an empty-key newline drops
  // the closer onto its own line, and `]`/`}` re-tab at the outer
  // depth. pretty=false skips tab/indent/newline and emits compact
  // JSON. The attrs are save-only — parse ignores them (whitespace is
  // already skipped via VALUE's rule_ignore).
  "LIST": {
    "type": "sequence",
    "container": "array",
    "items": [
      {"expr": {"type": "key", "key": "["}, "newline": true},
      {"expr": {
        "type": "repeat",
        "separator": {"expr": {"type": "key", "key": ","}, "newline": true},
        "item":      {"expr": "VALUE", "tab": true, "indent": true}
      }},
      {"expr": {"type": "key", "key": ""}, "newline": true},
      {"expr": {"type": "key", "key": "]"}, "tab": true}
    ]
  },

  "PAIR": {
    "type": "sequence",
    "items": [
      {"expr": {"type": "string"}, "bindings": [{"name": "", "value": "@"}]},
      {"expr": {"type": "key", "key": ":"}},
      {"expr": "VALUE"}
    ]
  },

  "STRUCT": {
    "type": "sequence",
    "container": "dict",
    "items": [
      {"expr": {"type": "key", "key": "{"}, "newline": true},
      {"expr": {
        "type": "repeat",
        "separator": {"expr": {"type": "key", "key": ","}, "newline": true},
        "item":      {"expr": "PAIR", "tab": true, "indent": true}
      }},
      {"expr": {"type": "key", "key": ""}, "newline": true},
      {"expr": {"type": "key", "key": "}"}, "tab": true}
    ]
  }
}
