{
  "start": "VALUE",

  // Pull in standard text terminal parsers (int, float, string,
  // identifier, whitespace, line_comment, block_comment). Each is
  // addressable bare (`int`) or qualified (`std.int`).
  "use": ["std"],

  // Strict JSON (RFC 8259): only whitespace is skipped between tokens.
  // For JSONC tolerance, add "line_comment" and "block_comment" here
  // (or qualify as "std.line_comment" / "std.block_comment").
  "ignore": ["whitespace"],

  // The items arrays use the wrapper form (ITEM-style dicts with
  // "expr" / "type" / optional "name" / "value"). This is the same
  // shape the .rawast meta-grammar produces when parsing equivalent
  // .rawast source — letting JSON-form and .rawast-form grammars
  // round-trip through each other via parse-and-save.

  "VALUE": {
    "type": "choice",
    "items": [
      {"expr": "STRUCT", "type": "bare"},
      {"expr": "LIST",   "type": "bare"},
      {"expr": {"type": "string"}, "type": "bare"},
      {"expr": {"type": "float"},  "type": "bare"},
      {"expr": {"type": "int"},    "type": "bare"},
      {"expr": {"type": "key", "key": "null",  "value": null},  "type": "bare"},
      {"expr": {"type": "key", "key": "true",  "value": true},  "type": "bare"},
      {"expr": {"type": "key", "key": "false", "value": false}, "type": "bare"}
    ]
  },

  "LIST": {
    "type": "sequence",
    "container": "array",
    "items": [
      {"expr": {"type": "key", "key": "["}, "type": "bare"},
      {"expr": {
        "type": "repeat",
        "separator": {"expr": {"type": "key", "key": ","}, "type": "bare"},
        "item":      {"expr": "VALUE", "type": "bare"}
      }, "type": "bare"},
      {"expr": {"type": "key", "key": "]"}, "type": "bare"}
    ]
  },

  "PAIR": {
    "type": "sequence",
    "items": [
      {"expr": {"type": "string"}, "type": "var"},
      {"expr": {"type": "key", "key": ":"}, "type": "bare"},
      {"expr": "VALUE", "type": "bare"}
    ]
  },

  "STRUCT": {
    "type": "sequence",
    "container": "dict",
    "items": [
      {"expr": {"type": "key", "key": "{"}, "type": "bare"},
      {"expr": {
        "type": "repeat",
        "separator": {"expr": {"type": "key", "key": ","}, "type": "bare"},
        "item":      {"expr": "PAIR", "type": "bare"}
      }, "type": "bare"},
      {"expr": {"type": "key", "key": "}"}, "type": "bare"}
    ]
  }
}
