{
  "start": "VALUE",

  // Pull in standard text terminal parsers (int, float, string,
  // identifier, whitespace, line_comment, block_comment). Each is
  // addressable bare (`int`) or qualified (`std.int`).
  "use": ["std"],

  // Strict JSON (RFC 8259): only whitespace is skipped between tokens.
  // For JSONC tolerance, add "line_comment" and "block_comment" here
  // (or qualify as "std.line_comment" / "std.block_comment").
  "ignore": ["whitespace"],

  // Items use the multi-binding wrapper form ({expr, bindings?}). The
  // `bindings` field is OMITTED when empty — bare items collapse to
  // just `{"expr": <X>}`. This matches what the .rawast meta-grammar
  // produces, letting JSON and .rawast forms round-trip cleanly.
  // Var binding (parsed value becomes dict key) is `{"bindings": {"": "@"}}`.

  "VALUE": {
    "type": "choice",
    "items": [
      {"expr": "STRUCT"},
      {"expr": "LIST"},
      {"expr": {"type": "string"}},
      {"expr": {"type": "float"}},
      {"expr": {"type": "int"}},
      {"expr": {"type": "key", "key": "null",  "value": null}},
      {"expr": {"type": "key", "key": "true",  "value": true}},
      {"expr": {"type": "key", "key": "false", "value": false}}
    ]
  },

  "LIST": {
    "type": "sequence",
    "container": "array",
    "items": [
      {"expr": {"type": "key", "key": "["}},
      {"expr": {
        "type": "repeat",
        "separator": {"expr": {"type": "key", "key": ","}},
        "item":      {"expr": "VALUE"}
      }},
      {"expr": {"type": "key", "key": "]"}}
    ]
  },

  "PAIR": {
    "type": "sequence",
    "items": [
      {"expr": {"type": "string"}, "bindings": {"": "@"}},
      {"expr": {"type": "key", "key": ":"}},
      {"expr": "VALUE"}
    ]
  },

  "STRUCT": {
    "type": "sequence",
    "container": "dict",
    "items": [
      {"expr": {"type": "key", "key": "{"}},
      {"expr": {
        "type": "repeat",
        "separator": {"expr": {"type": "key", "key": ","}},
        "item":      {"expr": "PAIR"}
      }},
      {"expr": {"type": "key", "key": "}"}}
    ]
  }
}
