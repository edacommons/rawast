// grammars/tcl.rawast — Tier-1 Tcl parser.
//
// Two logical contexts handled within one grammar via #subparse:
//   SCRIPT         — main grammar body; ignore tcl.hspace
//   WORD_SEGMENTS  — word internals; no ignore (whitespace is literal)
//
// Tcl is parsed structurally per the Dodekalogue: a script is a list
// of commands separated by `;` or newline; each command is a list of
// words; each word is one of {brace, quoted, bracket, bare}. Bare and
// quoted words are sub-parsed through WORD_SEGMENTS to split out
// variable references ($x / ${x} / $arr(idx)), command substitutions
// ([cmd]), and backslash escapes from literal text. Brace words are
// opaque per Dodekalogue rule 6; bracket words are nested Tcl
// scripts (#subparse=SCRIPT for command substitution).
//
// Command-level semantics — recognising `if` / `while` / `proc` / etc.
// and dispatching to per-command argument schemas — is downstream
// (application-layer) concern. The grammar produces a flat
// `(command, words)` tree; consumers walk it, dispatch on first-word
// value, and re-invoke `Grammar.parse_string` on relevant args with
// whichever sub-grammar they need (expr, list, etc.). Keeping command
// semantics out of the grammar matches the "parse, don't validate"
// principle the LEF/DEF grammars also follow.
//
// Per-rule `ignore <RULE>: …` directives override the grammar-level
// ignore list when the parse driver enters that rule. A `:#subparse=
// "<RULE>"` binding on an item names a rule to use as the start when
// re-parsing the item's captured string. Same grammar, same engine,
// different entry point with the rule's own ignore context.

use: std, tcl

start: <SCRIPT>

// ═══════════════════════════════════════════════════════════════════
// 1. SCRIPT context — top-level Tcl script
// ═══════════════════════════════════════════════════════════════════

// List-binding pattern: `repeat <X>:commands[]=@ separator <SEP_RUN>`
// puts COMMAND values into `commands[]` while SEP_RUN stays
// structural-only (consumed on parse, emitted on save, never in the
// AST). Same shape as systemverilog.rawast's `repeat+ <X>:names[]=@
// separator ","` pattern. The intermediate COMMANDS rule is dropped —
// it added an array layer that captured separator values into the
// array, breaking save dispatch.
SCRIPT ignore tcl.hspace: sequence dict {
  ?<SEP_RUN>,
  repeat <COMMAND>:commands[]=@ separator <SEP_RUN> newline,
  ?<SEP_RUN>
}

// SEP_RUN: one or more command separators (`\n` or `;`) between
// commands. Parse accepts both forms via tcl.command_sep; save emits
// canonical `\n`. The form distinction (whether the original used `;`
// or `\n`) is dropped — re-parse of saved output preserves AST
// equivalence (each emitted `\n` is one command_sep).
SEP_RUN: sequence { repeat+ tcl.command_sep }

COMMAND: choice {
  <COMMENT>,
  <GENERIC_CMD>
}

COMMENT: sequence dict {
  tcl.comment:type="comment":body=@
}

GENERIC_CMD: sequence dict {
  <WORDS>:type="command":words=@
}

// `space` postfix is a save-direction pretty-print hint: emit ` ` after
// each WORD. Parse ignores the postfix and uses the inherited
// `ignore tcl.hspace` from SCRIPT to consume runs of inter-word
// whitespace. A trailing space before the structural `\n` or `;` is
// re-parse-safe because hspace is ignored at every WORDS entry point.
// Pattern lifted from grammars/lefdef.rawast (CLASS_LIST etc.).
WORDS: sequence array { repeat+ <WORD> space }

// ─── Word flavours ─────────────────────────────────────────────────

WORD: choice {
  <EXPAND_WORD>,
  <BRACE_WORD>,
  <QUOTED_WORD>,
  <BRACKET_WORD>,
  <BARE_WORD>
}

// `{*}word` argument expansion (Dodekalogue rule 5).
EXPAND_WORD: sequence dict {
  tcl.expand_marker:expand=true,
  <WORD>:word=@
}

// Brace word: opaque text, no substitutions (rule 6).
BRACE_WORD: sequence dict {
  tcl.brace_group:type="brace":value=@
}

// Bracket word: nested Tcl script (command substitution).
BRACKET_WORD: sequence dict {
  tcl.bracket_sub:type="bracket":value=@:#subparse="SCRIPT"
}

// Quoted/bare words: substitutions DO apply — re-parse via
// WORD_SEGMENTS (rule-local ignore: none, so whitespace is literal).
QUOTED_WORD: sequence dict {
  tcl.quoted_string:type="quoted":value=@:#subparse="WORD_SEGMENTS"
}

BARE_WORD: sequence dict {
  tcl.bare_word:type="bare":value=@:#subparse="WORD_SEGMENTS"
}

// ═══════════════════════════════════════════════════════════════════
// 2. WORD_SEGMENTS context — word internals
// ═══════════════════════════════════════════════════════════════════
//
// Re-parses a bare or quoted word's raw text into a list of segments:
// literal text, variable references, command substitutions, escapes.
// Per `ignore WORD_SEGMENTS:` (empty) below, whitespace is literal —
// nothing is skipped between tokens.

WORD_SEGMENTS ignore: sequence dict {
  <SEGMENTS>:segments=@
}

SEGMENTS: sequence array {
  repeat <SEGMENT>
}

SEGMENT: choice {
  <VAR_SEG>,
  <BRACKET_SEG>,
  <ESCAPE_SEG>,
  <LITERAL_SEG>,
  <DOLLAR_LITERAL>
}

// Catch-all: a `$` not followed by a valid variable name (rare —
// regex anchors like `$` at end of string, or `$` followed by a
// digit-only token before Tcl 8.6). VAR_SEG is tried first; this
// alternative fires only after bounded-rewind on VAR_SEG failure.
DOLLAR_LITERAL: sequence dict { "$":type="literal":value="$" }

// Two forms keyed by `form` field — keeps round-trip exact.
//
//   `$name`        → {type:"var", form:"bare",   name:"name"}
//   `$arr(idx)`    → {type:"var", form:"bare",   name:"arr", index:{...}}
//   `${name}`      → {type:"var", form:"braced", raw:"name"}
//   `${a b c}`     → {type:"var", form:"braced", raw:"a b c"}
//
// Per Tcl semantics: braced form is opaque to the primary parse — its
// content is captured verbatim and not re-parsed. Consumers wanting
// the bare-equivalent name from a braced form run their own second
// pass (or subparse via tcl.var_name's braced branch).
//
// `?<VAR_INDEX>` only applies to bare form. `${name}(idx)` per the
// Tcl spec is `${name}` followed by literal `(idx)`, not array
// indexing — the braced form terminates at the `}` and what follows
// is a separate segment.
//
// BRACED is tried first because the bare-form parser (tcl.var_name)
// accepts both forms; without ordering it would shadow the braced
// alt and we'd lose the form distinction.
VAR_SEG: choice {
  <VAR_SEG_BRACED>,
  <VAR_SEG_BARE>
}

VAR_SEG_BARE: sequence dict {
  "$",
  tcl.var_name:type="var":form="bare":name=@,
  ?<VAR_INDEX>
}

VAR_SEG_BRACED: sequence dict {
  "$":type="var":form="braced",
  "{",
  *:raw=@,
  "}"
}

// Non-container sequence: VAR_INDEX exists for structural scaffolding
// (the `(...)` parens) around exactly one meaningful payload (the
// index expression). Its `:index=@` binding flows up into the caller's
// dict — VAR_SEG gets `{type, name, index}` directly rather than
// `{type, name, var_index: {index: ...}}`. Same pattern as
// systemverilog.rawast's NET_INIT.
VAR_INDEX: sequence {
  "(",
  *:index=@:#subparse="WORD_SEGMENTS",
  ")"
}

BRACKET_SEG: sequence dict {
  tcl.bracket_sub:type="bracket":value=@:#subparse="SCRIPT"
}

ESCAPE_SEG: sequence dict {
  tcl.escape:type="escape":value=@
}

LITERAL_SEG: sequence dict {
  tcl.literal_run:type="literal":value=@
}
