// def.rawast — DEF grammar (PoC subset)
//
// Covers HDR, DESIGN_CMD, UNITS, DIEAREA, ORIENT, ROW_CMD — enough to
// exercise the patterns that matter for EDA grammars:
//   - keyword-tagged dicts on a statement boundary
//   - conditional bindings on optional sub-blocks
//   - delimited coordinate arrays
//   - shared-prefix Choice (handled by default backtracking)
//
// Intentionally omitted (large nested rules): TRACKS, VIAS,
// COMPONENTS, PINS, BLOCKAGES, SPECNETS, NETS. Adding any of them is
// mechanical once the patterns here are accepted.
//
// Header order follows the DEF 5.8 spec, §4 "Order of DEF Statements":
//
//   [VERSION statement]
//   [DIVIDERCHAR statement]
//   [BUSBITCHARS statement]
//   DESIGN statement
//   ...
//   END DESIGN
//
// All three header statements are individually optional. DEF puts
// DIVIDERCHAR before BUSBITCHARS (LEF has them the other way round —
// see lef.rawast).

use: std, lefdef
ignore: whitespace, line_comment

start: <FILE>

// === Top level ============================================================

FILE: sequence dict {
  <HDR>:hdr=@,
  <DESIGN>:design=@
}

HDR: sequence dict {
  ?<VERSION_CMD>,
  ?<NAMESCASESENSITIVE_CMD>,
  ?<DIVIDERCHAR_CMD>,
  ?<BUSBITCHARS_CMD>
}
VERSION_CMD:            sequence { "VERSION" space,            identifier:version=@ space,            ";" newline }
NAMESCASESENSITIVE_CMD: sequence { "NAMESCASESENSITIVE" space, <ON_OFF>:names_case_sensitive=@ space, ";" newline }
DIVIDERCHAR_CMD:        sequence { "DIVIDERCHAR" space,        string:divider=@ space,                ";" newline }
BUSBITCHARS_CMD:        sequence { "BUSBITCHARS" space,        string:bus_bit_chars=@ space,          ";" newline }

ON_OFF: choice {
  "ON":true,
  "OFF":false
}

// === DESIGN block ========================================================

DESIGN: sequence dict {
  <DESIGN_CMD>,
  <DESIGN_INFO>,
  <DESIGN_ITEMS>:items=@,
  <ENDDESIGN_CMD>
}

DESIGN_CMD:    sequence { "DESIGN" space, identifier:name=@ space, ";" newline }
ENDDESIGN_CMD: sequence { "END" space, "DESIGN" newline }

// DESIGN_INFO — optional TECHNOLOGY, then required UNITS and DIEAREA in
// canonical order per DEF 5.8 §4.
DESIGN_INFO: sequence {
  ?<TECHNOLOGY_CMD>,
  <UNITS_CMD>,
  <DIEAREA_CMD>
}

TECHNOLOGY_CMD: sequence {
  "TECHNOLOGY" space, identifier:technology=@ space, ";" newline
}

UNITS_CMD: sequence {
  "UNITS" space, "DISTANCE" space, "MICRONS" space, int:dbu=@ space, ";" newline
}

DIEAREA_CMD: sequence {
  "DIEAREA" space, <DIEAREA_POINTS>:die_area=@, ";" newline
}
DIEAREA_POINTS: sequence array { repeat <XY> }

// XY — coordinate pair `( x y )`. Per design, the parser doesn't enforce
// exactly-2 ints; if input is malformed (`( 1 2 3 )`), it parses as
// [1,2,3] and the app layer rejects.
XY: sequence array { "(" space, int space, int space, ")" space }

// BBOX — `( x1 y1 ) ( x2 y2 )`, two XY corners. Used wherever a
// rectangular bounding box is named by two opposite corners (e.g.,
// BLOCKAGE_RECT, PIN_LAYER_PROP). The `low` / `high` bindings flow
// into the surrounding dict.
BBOX: sequence { <XY>:low=@, <XY>:high=@ }

// === Orientation keywords =================================================

// Each alternative matches a one-or two-letter token and emits the
// canonical name as the choice's value (LEF/DEF spec orientation set).
ORIENT: choice {
  "N":"North",
  "S":"South",
  "E":"East",
  "W":"West",
  "FN":"FlipNorth",
  "FS":"FlipSouth",
  "FE":"FlipEast",
  "FW":"FlipWest"
}

// === Items inside DESIGN =================================================

DESIGN_ITEMS: sequence array { repeat <DESIGN_ITEM> }
DESIGN_ITEM: choice {
  <ROW_CMD>,
  <TRACKS_CMD>,
  <GCELLGRID_CMD>,
  <PINS_SECTION>,
  <BLOCKAGES_SECTION>,
  <FILLS_SECTION>,
  <VIAS_SECTION>,
  <COMPONENTS_SECTION>,
  <NONDEFAULTRULES_SECTION>,
  <SPECIALNETS_SECTION>,
  <NETS_SECTION>
}

// GCELLGRID — single-line statement, same X/Y direction shape as TRACKS.
GCELLGRID_CMD: sequence dict {
  "GCELLGRID":type="GCellGrid" space,
  <TRACKS_DIRECTION>:direction=@ space,
  int:start=@ space,
  "DO" space, int:count=@ space,
  "STEP" space, int:step=@ space,
  ";" newline
}

// === Section stubs =======================================================
//
// PoC scope: these sections currently accept only the empty form
// (`SECTION 0 ; END SECTION`). Real placement-and-route output often
// declares sections as zero-count when the design has none of that
// kind, so the empty stubs already unblock several real DEFs.
// Modelling non-empty bodies (VIA_DEF, COMPONENT_DEF, NET_DEF,
// SPECIALNET_DEF) is future grammar work; the Python prototype
// `lefdefschema.py` has working schemas for each as a design source.
//
// The five rules below have identical shape but differ in their
// opening keyword and matching END keyword — rawast does not have
// rule parameterization or context-sensitive matching, so the
// keyword pair must be inlined per section.

// === VIAS section ========================================================
//
// DEF 5.8 §"Vias" syntax (PoC subset — VIARULE-generated form only):
//
//   VIAS numVias ;
//     [- viaName
//        + VIARULE viaRuleName
//        + CUTSIZE xSize ySize
//        + LAYERS botMetalLayer cutLayer topMetalLayer
//        + CUTSPACING xCutSpacing yCutSpacing
//        + ENCLOSURE xBotEnc yBotEnc xTopEnc yTopEnc
//        [+ ROWCOL numCutRows numCutCols]
//        [+ ORIGIN xOffset yOffset]
//        [+ OFFSET xBotOffset yBotOffset xTopOffset yTopOffset]
//        [+ PATTERN cutPattern]
//      ;] ...
//   END VIAS
//
// PoC omission: the alternative geometry-defined form
// `{+ RECT layerName (pt pt) | + POLYGON layerName (pt pt pt ...)}`
// is M4 work. No file in the corpus uses it.

VIAS_SECTION: sequence dict {
  "VIAS":type="Vias" space, int:count=@ space, ";" newline,
  <VIA_DEFS>:items=@,
  "END" space, "VIAS" newline
}

VIA_DEFS: sequence array { repeat <VIA_DEF> }

VIA_DEF: sequence dict {
  "-" space, identifier:name=@ space,
  "+" space, "VIARULE" space, identifier:via_rule=@ space,
  "+" space, "CUTSIZE" space, int:cut_size_x=@ space, int:cut_size_y=@ space,
  "+" space, "LAYERS" space, identifier:bot_layer=@ space, identifier:cut_layer=@ space, identifier:top_layer=@ space,
  "+" space, "CUTSPACING" space, int:cut_spacing_x=@ space, int:cut_spacing_y=@ space,
  "+" space, "ENCLOSURE" space, int:bot_enc_x=@ space, int:bot_enc_y=@ space, int:top_enc_x=@ space, int:top_enc_y=@ space,
  repeat <VIA_OPT_PROP>,
  ";" newline
}

VIA_OPT_PROP: choice {
  <VIA_ROWCOL_PROP>,
  <VIA_ORIGIN_PROP>,
  <VIA_OFFSET_PROP>,
  <VIA_PATTERN_PROP>
}

VIA_ROWCOL_PROP:  sequence { "+" space, "ROWCOL"  space, int:rowcol_rows=@ space, int:rowcol_cols=@ space }
VIA_ORIGIN_PROP:  sequence { "+" space, "ORIGIN"  space, int:via_origin_x=@ space, int:via_origin_y=@ space }
VIA_OFFSET_PROP:  sequence { "+" space, "OFFSET"  space, int:bot_off_x=@ space, int:bot_off_y=@ space, int:top_off_x=@ space, int:top_off_y=@ space }
VIA_PATTERN_PROP: sequence { "+" space, "PATTERN" space, identifier:via_pattern=@ space }
// === COMPONENTS section ==================================================
//
// DEF 5.8 §"Components" syntax (PoC subset):
//
//   COMPONENTS numComps ;
//     [- compName modelName
//        [+ EEQMASTER macroName]
//        [+ SOURCE {NETLIST | DIST | USER | TIMING}]
//        [+ {FIXED pt orient | COVER pt orient | PLACED pt orient |
//            UNPLACED}]
//        [+ WEIGHT weight]
//        [+ REGION regionName]
//      ;] ...
//   END COMPONENTS
//
// PoC omissions (M4): HALO, ROUTEHALO, MASKSHIFT, PROPERTY clauses.

COMPONENTS_SECTION: sequence dict {
  "COMPONENTS":type="Components" space, int:count=@ space, ";" newline,
  <COMPONENT_DEFS>:items=@,
  "END" space, "COMPONENTS" newline
}

COMPONENT_DEFS: sequence array { repeat <COMPONENT_DEF> }

COMPONENT_DEF: sequence dict {
  "-" space, identifier:name=@ space,
  identifier:model=@ space,
  repeat <COMPONENT_PROP>,
  ";" newline
}

COMPONENT_PROP: choice {
  <COMPONENT_SOURCE_PROP>,
  <COMPONENT_EEQMASTER_PROP>,
  <COMPONENT_WEIGHT_PROP>,
  <COMPONENT_REGION_PROP>,
  <COMPONENT_UNPLACED_KW>,
  <PIN_PLACEMENT_PROP>:placement=@
}

COMPONENT_SOURCE_PROP: sequence { "+" space, "SOURCE" space, <COMPONENT_SOURCE_VAL>:source=@ space }
COMPONENT_SOURCE_VAL: choice {
  "NETLIST":"Netlist",
  "DIST":"Dist",
  "USER":"User",
  "TIMING":"Timing"
}

COMPONENT_EEQMASTER_PROP: sequence { "+" space, "EEQMASTER" space, identifier:eeq_master=@ space }
COMPONENT_WEIGHT_PROP:    sequence { "+" space, "WEIGHT"    space, int:weight=@ space }
COMPONENT_REGION_PROP:    sequence { "+" space, "REGION"    space, identifier:region=@ space }
COMPONENT_UNPLACED_KW:    sequence { "+" space, "UNPLACED":is_unplaced=true space }
// === NONDEFAULTRULES section =============================================
//
// DEF 5.8 §"Non-Default Rules" syntax (PoC subset — LAYER-only):
//
//   NONDEFAULTRULES numRules ;
//     [- ruleName
//        [+ HARDSPACING]
//        {+ LAYER layerName WIDTH minWidth
//           [DIRESPACING diagSpacing]
//           [SPACING minSpacing]
//           [WIREEXT wireExt]} ...
//        [+ VIA viaName] ...
//        [+ VIARULE viaRuleName] ...
//        [+ MINCUTS cutLayerName numCuts] ...
//      ;] ...
//   END NONDEFAULTRULES

NONDEFAULTRULES_SECTION: sequence dict {
  "NONDEFAULTRULES":type="NonDefaultRules" space, int:count=@ space, ";" newline,
  <NDR_DEFS>:items=@,
  "END" space, "NONDEFAULTRULES" newline
}

NDR_DEFS: sequence array { repeat <NDR_DEF> }

NDR_DEF: sequence dict {
  "-" space, identifier:name=@ space,
  repeat <NDR_PROP>,
  ";" newline
}

NDR_PROP: choice {
  <NDR_HARDSPACING_KW>,
  <NDR_LAYER_PROP>:ndr_layer=@,
  <NDR_VIA_PROP>,
  <NDR_VIARULE_PROP>
}

NDR_HARDSPACING_KW: sequence { "+" space, "HARDSPACING":hard_spacing=true space }

NDR_LAYER_PROP: sequence dict {
  "+" space, "LAYER" space, identifier:layer=@ space,
  "WIDTH" space, int:width=@ space,
  repeat <NDR_LAYER_OPT>
}

NDR_LAYER_OPT: choice {
  <NDR_LAYER_SPACING>,
  <NDR_LAYER_DIAGSPACING>,
  <NDR_LAYER_WIREEXT>
}

NDR_LAYER_SPACING:     sequence { "SPACING"     space, int:spacing=@      space }
NDR_LAYER_DIAGSPACING: sequence { "DIAGSPACING" space, int:diag_spacing=@ space }
NDR_LAYER_WIREEXT:     sequence { "WIREEXT"     space, int:wire_ext=@     space }

NDR_VIA_PROP:     sequence { "+" space, "VIA"     space, identifier:via_name=@     space }
NDR_VIARULE_PROP: sequence { "+" space, "VIARULE" space, identifier:viarule_name=@ space }
// === SPECIALNETS section =================================================
//
// DEF 5.8 §"Special Nets" syntax (PoC subset):
//
//   SPECIALNETS numSpecNets ;
//     [- netName
//        [{ ( compName | PIN | * ) pinName }] ...
//        [+ VOLTAGE volts]
//        [+ USE { SIGNAL | POWER | GROUND | CLOCK | TIEOFF |
//                 ANALOG | SCAN | RESET }]
//        { + ROUTED layerName width [+ SHAPE shape] {(x y) (x y) [viaName] | (x y) viaName} ...
//          { NEW layerName width [+ SHAPE shape] {(x y) (x y) [viaName] | (x y) viaName} } ...
//        } ...
//      ;] ...
//   END SPECIALNETS
//
// PoC omissions (M4):
//   - FIXEDBUMP / ORIGINAL / PATTERN / ESTCAP / WEIGHT clauses
//   - SHIELD / FIXED / COVER routing variants (only ROUTED modelled)
//   - PROPERTY clauses

SPECIALNETS_SECTION: sequence dict {
  "SPECIALNETS":type="SpecialNets" space, int:count=@ space, ";" newline,
  <SPECNET_DEFS>:items=@,
  "END" space, "SPECIALNETS" newline
}

SPECNET_DEFS: sequence array { repeat <SPECNET_DEF> }

SPECNET_DEF: sequence dict {
  "-" space, identifier:name=@ space,
  <SPECNET_CONNECTIONS>:connections=@,
  repeat <SPECNET_PROP>,
  ";" newline
}

SPECNET_CONNECTIONS: sequence array { repeat <SPECNET_CONNECTION> }

// Connection: `( {compName | PIN | *} pinName )`.
// `PIN` and `*` flow through as identifier values (lefdef identifier
// parser accepts `*` as a one-char name); the consumer reads
// `component` literally.
SPECNET_CONNECTION: sequence dict {
  "(" space, identifier:component=@ space, identifier:pin=@ space, ")" space
}

SPECNET_PROP: choice {
  <SPECNET_VOLTAGE_PROP>,
  <SPECNET_USE_PROP>,
  <SPECNET_ROUTED>
}

SPECNET_VOLTAGE_PROP: sequence { "+" space, "VOLTAGE" space, int:voltage=@ space }
SPECNET_USE_PROP:     sequence { "+" space, "USE" space, <PIN_USE_VAL>:use=@ space }

// + ROUTED + NEW continuations as a single segments array.
SPECNET_ROUTED: sequence dict {
  "+" space, "ROUTED":routed=true space,
  <SPECNET_SEGMENTS>:segments=@
}

SPECNET_SEGMENTS: sequence array {
  <SPECNET_SEGMENT>,
  repeat <SPECNET_NEW_SEGMENT>
}

// A segment's geometry is either:
//   (a) ( x y ) viaName    — single point at via
//   (b) ( x y ) ( x y ) ...— two or more points (a wire path)
// per the spec's `{ ( x y val ) ... | ( x y val ) viaName }`. A naïve
// `<POINTS> ?identifier:via=@` greedily consumes the next segment's
// `NEW` keyword as a via name; the Choice approach lets bounded
// backtracking pick the correct form. Tried in order, so VIA form
// wins if a single-point + identifier sequence is seen.
SPECNET_SEGMENT: sequence dict {
  identifier:layer=@ space,
  int:width=@ space,
  ?<SPECNET_SHAPE_PROP>,
  <SPECNET_GEOMETRY>:geometry=@
}

SPECNET_NEW_SEGMENT: sequence dict {
  "NEW" space,
  identifier:layer=@ space,
  int:width=@ space,
  ?<SPECNET_SHAPE_PROP>,
  <SPECNET_GEOMETRY>:geometry=@
}

SPECNET_GEOMETRY: choice {
  <SPECNET_VIA_AT_PT>,
  <SPECNET_WIRE_PATH>
}

SPECNET_VIA_AT_PT: sequence dict {
  <XY>:at=@,
  identifier:via=@ space
}

SPECNET_WIRE_PATH: sequence dict {
  <SPECNET_POINTS>:points=@
}

SPECNET_SHAPE_PROP: sequence { "+" space, "SHAPE" space, identifier:shape=@ space }
SPECNET_POINTS: sequence array { repeat+ <XY> }
// === NETS section ========================================================
//
// DEF 5.8 §"Nets" syntax (PoC subset — connection + USE only,
// no regular-net routing):
//
//   NETS numNets ;
//     [- netName
//        [{ ( compName | PIN | * ) pinName }] ...
//        [+ USE { SIGNAL | POWER | GROUND | ... }]
//      ;] ...
//   END NETS
//
// Regular NETs in production DEFs can also carry + ROUTED routing
// segments (same grammar as SPECIALNETS). Adding ROUTED here is M4
// work — the corpus DEFs that need full NET routing are the largest
// (multi-million-line); the simpler form covers caravel c4m sky130.

NETS_SECTION: sequence dict {
  "NETS":type="Nets" space, int:count=@ space, ";" newline,
  <NET_DEFS>:items=@,
  "END" space, "NETS" newline
}

NET_DEFS: sequence array { repeat <NET_DEF> }

NET_DEF: sequence dict {
  "-" space, identifier:name=@ space,
  <NET_CONNECTIONS>:connections=@,
  repeat <NET_PROP>,
  ";" newline
}

NET_CONNECTIONS: sequence array { repeat <SPECNET_CONNECTION> }

NET_PROP: choice {
  <NET_USE_PROP>,
  <NET_NONDEFAULTRULE_PROP>,
  <NET_ROUTED>
}

NET_USE_PROP: sequence { "+" space, "USE" space, <PIN_USE_VAL>:use=@ space }

NET_NONDEFAULTRULE_PROP: sequence {
  "+" space, "NONDEFAULTRULE" space,
  identifier:non_default_rule=@ space
}

// NETS routing differs from SPECIALNETS routing in two ways per DEF 5.8:
//   1. No `width` field after layer name (regular nets use the LEF
//      wire-width default; only SPECIALNETS have an explicit width).
//   2. Coordinates may use `*` as a placeholder meaning "same as
//      previous coordinate value" — enables compact axis-aligned
//      wire encoding.
NET_ROUTED: sequence dict {
  "+" space, "ROUTED":routed=true space,
  <NET_SEGMENTS>:segments=@
}

NET_SEGMENTS: sequence array {
  <NET_SEGMENT>,
  repeat <NET_NEW_SEGMENT>
}

NET_SEGMENT: sequence dict {
  identifier:layer=@ space,
  ?<NET_TAPER>,
  ?<SPECNET_SHAPE_PROP>,
  <NET_GEOMETRY>:geometry=@
}

NET_NEW_SEGMENT: sequence dict {
  "NEW" space,
  identifier:layer=@ space,
  ?<NET_TAPER>,
  ?<SPECNET_SHAPE_PROP>,
  <NET_GEOMETRY>:geometry=@
}

// Per DEF 5.8 spec, a route segment can carry an optional TAPER
// (bare keyword — use default-rule width from here) or
// TAPERRULE ruleName (use the named non-default rule from here).
// They appear between the layer name and the first coordinate.
NET_TAPER: choice {
  <NET_TAPER_KW>,
  <NET_TAPERRULE_PROP>
}

NET_TAPER_KW:       sequence { "TAPER":is_taper=true space }
NET_TAPERRULE_PROP: sequence { "TAPERRULE" space, identifier:taper_rule=@ space }

// Geometry alternatives, tried in order:
//   (a) ( pt ) RECT ( dx1 dy1 dx2 dy2 )  — point with virtual-rect patch
//   (b) ( pt ) viaName                    — point with via
//   (c) ( pt ) ( pt ) ...                 — wire path (2+ points)
// (a) is checked first because the `RECT` literal can also be
// matched by the lefdef identifier parser; bounded backtracking
// would otherwise greedily consume `RECT` as a via name.
NET_GEOMETRY: choice {
  <NET_PT_WITH_RECT>,
  <NET_VIA_AT_PT>,
  <NET_WIRE_PATH>
}

NET_PT_WITH_RECT: sequence dict {
  <NET_XY>:at=@,
  "RECT":has_rect=true space,
  <NET_RECT_DELTAS>:rect_deltas=@
}

NET_RECT_DELTAS: sequence array {
  "(" space,
  int space, int space, int space, int space,
  ")" space
}

NET_VIA_AT_PT: sequence dict {
  <NET_XY>:at=@,
  identifier:via=@ space
}

NET_WIRE_PATH: sequence dict {
  <NET_POINTS>:points=@
}

NET_POINTS: sequence array { repeat+ <NET_XY> }

// NET_XY accepts `*` (carry-over) in either coordinate slot, plus
// an optional third value (extension distance) per DEF 5.8 spec
// routing-point syntax `( x y ext )`.
NET_XY: sequence array {
  "(" space,
  <NET_COORD> space, <NET_COORD> space,
  ?<NET_COORD> space,
  ")" space
}

NET_COORD: choice {
  int,
  "*":"*"
}

// === ROW command =========================================================
//
//   ROW <name> <site> <x> <y> <orient>
//       [ DO <nx> BY <ny> [ STEP <dx> <dy> ] ] ;
//
// Exercises the conditional binding semantics: the inner DO/BY/STEP
// chain emits its `nx`/`ny`/`dx`/`dy` fields only when the optional
// block actually matched.

ROW_CMD: sequence dict {
  "ROW":type="Row" space,
  identifier:name=@ space,
  identifier:site=@ space,
  <ROW_ORIGIN>:origin=@,
  <ORIENT>:orient=@ space,
  ?<ROW_DO_OPT>,
  ";" newline
}

// ROW origin: two ints. Same "no enforced count" stance as XY.
ROW_ORIGIN: sequence array { int space, int space }

// DO/BY clause: optional, may itself contain an optional STEP. No
// container on the sub-rule — bindings flow up into ROW_CMD's dict.
ROW_DO_OPT: sequence {
  "DO" space, int:nx=@ space, "BY" space, int:ny=@ space,
  ?<ROW_STEP_OPT>
}
ROW_STEP_OPT: sequence {
  "STEP" space, int:dx=@ space, int:dy=@ space
}

// === TRACKS command ======================================================
//
//   TRACKS [X | Y] <coord> DO <count> STEP <step> [LAYER <layer>] ;
//
// Direct translation of lefdefschema.py:62-73 from the Python prototype.
// Simplification: the spec allows multiple layer names per LAYER clause;
// in practice every real TRACKS line in the corpus has exactly one,
// so this PoC subset takes one identifier. Extending to a layer array
// is a one-rule change when needed.

TRACKS_CMD: sequence dict {
  "TRACKS":type="Tracks" space,
  <TRACKS_DIRECTION>:direction=@ space,
  int:start=@ space,
  "DO" space, int:count=@ space,
  "STEP" space, int:step=@ space,
  ?<TRACKS_LAYER>,
  ";" newline
}

TRACKS_DIRECTION: choice {
  "X":"Vertical",
  "Y":"Horizontal"
}

TRACKS_LAYER: sequence {
  "LAYER" space,
  identifier:layer=@ space
}

// === PINS section ========================================================
//
// DEF 5.8 §"Pins" syntax (PoC subset):
//
//   PINS numPins ;
//     [- pinName + NET netName
//         [+ SPECIAL]
//         [+ DIRECTION {INPUT | OUTPUT | INOUT | FEEDTHRU}]
//         [+ NETEXPR "netExprPropName defaultNetName"]
//         [+ SUPPLYSENSITIVITY powerPinName]
//         [+ GROUNDSENSITIVITY groundPinName]
//         [+ USE {SIGNAL | POWER | GROUND | CLOCK | TIEOFF |
//                 ANALOG | SCAN | RESET}]
//         {[+ PORT]
//          {+ LAYER layerName [...] (x1 y1) (x2 y2)} ...
//          [+ COVER (x y) orient | + FIXED (x y) orient |
//           + PLACED (x y) orient]} ...
//       ;] ...
//   END PINS
//
// Notes on spec faithfulness:
//   - NET is required (spec-mandatory).
//   - DIRECTION and USE values are closed enums per spec.
//   - PORTs are a true list — multi-port pins preserve every port's
//     layer + placement as a separate dict in the `ports` array (no
//     dict-overwrite data loss).
//   - All three placement keywords COVER / FIXED / PLACED supported.
// PoC omissions (M4 work, not blocking any corpus DEF):
//   - ANTENNA* clauses (~10 variants).
//   - POLYGON and VIA shapes inside PORT (only LAYER bbox today).
//   - The full DEF spec lists pre-PORT clauses in a canonical order.
//     `repeat <PIN_PROP>` is order-agnostic — more permissive than
//     spec, won't reject spec-conformant files, but also won't catch
//     out-of-order ones. Strict-order enforcement is M4.

PINS_SECTION: sequence dict {
  "PINS":type="Pins" space,
  int:count=@ space,
  ";" newline,
  <PIN_DEFS>:items=@,
  "END" space, "PINS" newline
}

PIN_DEFS: sequence array { repeat <PIN_DEF> }

// NET is required; everything else is pre-PORT optional then a
// repeating PORT list. The grammar accepts pre-PORT clauses in any
// order (spec strict-orders them).
PIN_DEF: sequence dict {
  "-" space,
  identifier:name=@ space,
  "+" space, "NET" space, identifier:net=@ space,
  repeat <PIN_PROP>,
  <PIN_PORTS>:ports=@,
  ";" newline
}

// Per DEF 5.8 spec, `[ + PORT ]` is optional — a PIN can carry
// LAYER shapes and a placement directly without the PORT wrapper
// (older / simpler DEF style, common in OpenROAD output). To
// support both styles, LAYER and PLACEMENT are accepted both as
// PIN_PROPs (direct on PIN) and as PIN_PORT_ELEMs (inside an
// explicit `+ PORT` block). Files with `+ PORT` get multi-port
// structure; files without get direct PIN-level fields.
PIN_PROP: choice {
  <PIN_SPECIAL_KW>,
  <PIN_DIRECTION_PROP>,
  <PIN_NETEXPR_PROP>,
  <PIN_SUPPLYSENS_PROP>,
  <PIN_GROUNDSENS_PROP>,
  <PIN_USE_PROP>,
  <PIN_PORT_LAYER>:layer=@,
  <PIN_PLACEMENT_PROP>:placement=@
}

PIN_SPECIAL_KW:       sequence { "+" space, "SPECIAL":is_special=true space }
PIN_NETEXPR_PROP:     sequence { "+" space, "NETEXPR"             space, string:netexpr=@ space }
PIN_SUPPLYSENS_PROP:  sequence { "+" space, "SUPPLYSENSITIVITY"   space, identifier:supply_sensitivity=@ space }
PIN_GROUNDSENS_PROP:  sequence { "+" space, "GROUNDSENSITIVITY"   space, identifier:ground_sensitivity=@ space }

// DIRECTION — closed enum per DEF 5.8 spec.
PIN_DIRECTION_PROP: sequence {
  "+" space, "DIRECTION" space,
  <PIN_DIRECTION_VAL>:direction=@ space
}
PIN_DIRECTION_VAL: choice {
  "INPUT":"Input",
  "OUTPUT":"Output",
  "INOUT":"InOut",
  "FEEDTHRU":"FeedThru"
}

// USE — closed enum per DEF 5.8 spec.
PIN_USE_PROP: sequence {
  "+" space, "USE" space,
  <PIN_USE_VAL>:use=@ space
}
PIN_USE_VAL: choice {
  "SIGNAL":"Signal",
  "POWER":"Power",
  "GROUND":"Ground",
  "CLOCK":"Clock",
  "TIEOFF":"TieOff",
  "ANALOG":"Analog",
  "SCAN":"Scan",
  "RESET":"Reset"
}

// PORT — one or more per PIN. Per DEF 5.8 spec, each PORT carries
// zero-or-more shape clauses (LAYER / POLYGON / VIA — only LAYER
// modelled in this PoC) plus at-most-one placement clause
// (COVER / FIXED / PLACED). Implemented as `repeat <PIN_PORT_ELEM>`
// over a choice that produces either a LAYER (bound to `layer`)
// or a PLACEMENT (bound to `placement`).
//
// PoC limitations (M4 fixes):
//   1. Multiple LAYERs per PORT collapse: subsequent LAYER fields
//      overwrite the previous (dict-overwrite). Real corpus PORTs
//      typically have one LAYER each, so this isn't hit in
//      practice. Proper `shapes[]` array support needs an engine
//      pattern for "repeat element-of-named-class as array-field
//      while sibling optional contributes named field" — pursued
//      as M4 grammar work alongside POLYGON / VIA shape support.
//   2. Spec says at-most-one placement per PORT; grammar accepts
//      multiple (last one wins on dict-overwrite). Spec-tightening
//      to exactly-one is an M4 linter / engine extension.
PIN_PORTS: sequence array { repeat <PIN_PORT> }

PIN_PORT: sequence dict {
  "+" space, "PORT":has_port=true space,
  repeat <PIN_PORT_ELEM>
}

PIN_PORT_ELEM: choice {
  <PIN_PORT_LAYER>:layer=@,
  <PIN_PLACEMENT_PROP>:placement=@
}

PIN_PORT_LAYER: sequence dict {
  "+" space, "LAYER" space,
  identifier:layer=@ space,
  <BBOX>
}

// Placement is one of COVER / FIXED / PLACED per DEF 5.8 spec
// (`{COVER pt orient | FIXED pt orient | PLACED pt orient}`). The
// three differ only in the leading keyword, so they collapse to one
// rule with a `kind` discriminator in the AST.
PIN_PLACEMENT_PROP: sequence dict {
  "+" space,
  <PIN_PLACEMENT_KIND>:kind=@ space,
  <XY>:at=@,
  <ORIENT>:orient=@ space
}
PIN_PLACEMENT_KIND: choice {
  "PLACED":"Placed",
  "FIXED":"Fixed",
  "COVER":"Cover"
}

// === BLOCKAGES section ===================================================
//
// DEF 5.8 §"Blockages" syntax (PoC subset — LAYER-blockage variant only):
//
//   BLOCKAGES numBlockages ;
//     [- LAYER layerName
//        [+ SLOTS | + FILLS]
//        [+ PUSHDOWN]
//        [+ EXCEPTPGNET]
//        [+ COMPONENT compName]
//        [+ SPACING minSpacing | + DESIGNRULEWIDTH effectiveWidth]
//        [+ MASK maskNum]
//        {RECT (x1 y1) (x2 y2) | POLYGON (x1 y1) (x2 y2) ...} ...
//      ;] ...
//     [- PLACEMENT ...]  // PoC: not modelled
//   END BLOCKAGES

BLOCKAGES_SECTION: sequence dict {
  "BLOCKAGES":type="Blockages" space,
  int:count=@ space,
  ";" newline,
  <BLOCKAGE_DEFS>:items=@,
  "END" space, "BLOCKAGES" newline
}

BLOCKAGE_DEFS: sequence array { repeat <BLOCKAGE_DEF> }

BLOCKAGE_DEF: choice {
  <BLOCKAGE_LAYER_DEF>,
  <BLOCKAGE_PLACEMENT_DEF>
}

BLOCKAGE_LAYER_DEF: sequence dict {
  "-" space, "LAYER" space,
  identifier:layer=@ space,
  repeat <BLOCKAGE_MOD>,
  <BLOCKAGE_SHAPES>:shapes=@,
  ";" newline
}

// PLACEMENT-variant blockage per DEF 5.8 §"Blockages":
//   - PLACEMENT
//     [+ SOFT | + PARTIAL maxDensity]
//     [+ PUSHDOWN]
//     [+ COMPONENT compName]
//     { RECT (x1 y1) (x2 y2) } ...
//   ;
BLOCKAGE_PLACEMENT_DEF: sequence dict {
  "-" space, "PLACEMENT":type="PlacementBlockage" space,
  repeat <BLOCKAGE_PLACEMENT_MOD>,
  <BLOCKAGE_PLACEMENT_RECTS>:rects=@,
  ";" newline
}

BLOCKAGE_PLACEMENT_MOD: choice {
  <BLOCKAGE_SOFT_KW>,
  <BLOCKAGE_PARTIAL_PROP>,
  <BLOCKAGE_PUSHDOWN_KW>,
  <BLOCKAGE_COMPONENT_PROP>
}

BLOCKAGE_SOFT_KW:     sequence { "+" space, "SOFT":is_soft=true space }
BLOCKAGE_PARTIAL_PROP: sequence { "+" space, "PARTIAL" space, <NUMBER>:max_density=@ space }

BLOCKAGE_PLACEMENT_RECTS: sequence array { repeat+ <BLOCKAGE_RECT> }

// LAYER-blockage modifier flags (each independently optional).
BLOCKAGE_MOD: choice {
  <BLOCKAGE_SLOTS_KW>,
  <BLOCKAGE_FILLS_KW>,
  <BLOCKAGE_PUSHDOWN_KW>,
  <BLOCKAGE_EXCEPTPGNET_KW>,
  <BLOCKAGE_COMPONENT_PROP>,
  <BLOCKAGE_SPACING_PROP>,
  <BLOCKAGE_DESIGNRULEWIDTH_PROP>,
  <BLOCKAGE_MASK_PROP>
}

BLOCKAGE_SLOTS_KW:               sequence { "+" space, "SLOTS":is_slots=true space }
BLOCKAGE_FILLS_KW:               sequence { "+" space, "FILLS":is_fills=true space }
BLOCKAGE_PUSHDOWN_KW:            sequence { "+" space, "PUSHDOWN":is_pushdown=true space }
BLOCKAGE_EXCEPTPGNET_KW:         sequence { "+" space, "EXCEPTPGNET":is_exceptpgnet=true space }
BLOCKAGE_COMPONENT_PROP:         sequence { "+" space, "COMPONENT"       space, identifier:component=@ space }
BLOCKAGE_SPACING_PROP:           sequence { "+" space, "SPACING"         space, int:min_spacing=@ space }
BLOCKAGE_DESIGNRULEWIDTH_PROP:   sequence { "+" space, "DESIGNRULEWIDTH" space, int:design_rule_width=@ space }
BLOCKAGE_MASK_PROP:              sequence { "+" space, "MASK"            space, int:mask_num=@ space }

BLOCKAGE_SHAPES: sequence array { repeat+ <BLOCKAGE_SHAPE> }
BLOCKAGE_SHAPE: choice {
  <BLOCKAGE_RECT>,
  <BLOCKAGE_POLYGON>
}

BLOCKAGE_RECT: sequence dict {
  "RECT":type="Rect" space,
  <BBOX>
}

BLOCKAGE_POLYGON: sequence dict {
  "POLYGON":type="Polygon" space,
  <POLYGON_POINTS>:points=@
}
POLYGON_POINTS: sequence array { repeat+ <XY> }

// === FILLS section =======================================================
//
// DEF 5.8 §"Fills" syntax (PoC subset — LAYER fills with RECT/POLYGON):
//
//   FILLS numFills ;
//     [- LAYER layerName [+ MASK n] [+ OPC]
//        {RECT (x1 y1) (x2 y2) | POLYGON (x y) (x y) (x y) ...} ...
//      ;] ...
//     [- VIA viaName ...] ...   // M4 work
//   END FILLS
//
// Corpus files (output/6_final.def, ihp130_sram/6_final.def) carry
// millions of single-RECT fill items; the parser must scale to that
// volume.

FILLS_SECTION: sequence dict {
  "FILLS":type="Fills" space, int:count=@ space, ";" newline,
  <FILL_DEFS>:items=@,
  "END" space, "FILLS" newline
}

FILL_DEFS: sequence array { repeat <FILL_DEF> }

FILL_DEF: sequence dict {
  "-" space, "LAYER" space,
  identifier:layer=@ space,
  ?<FILL_MASK_PROP>,
  ?<FILL_OPC_KW>,
  <FILL_SHAPES>:shapes=@,
  ";" newline
}

FILL_MASK_PROP: sequence { "+" space, "MASK" space, int:mask_num=@ space }
FILL_OPC_KW:    sequence { "+" space, "OPC":is_opc=true space }

FILL_SHAPES: sequence array { repeat+ <BLOCKAGE_SHAPE> }
