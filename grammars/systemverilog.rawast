// systemverilog.rawast — SystemVerilog grammar (Verilog 2001 synthesizable
// subset as the foundation; SV-1800 extensions added incrementally).
//
// Scope of this first pass:
//
//   • Module declarations: header, parameter port list, port list
//     (both ANSI and non-ANSI styles), module items, endmodule.
//   • Module items: net/reg/logic/integer declarations, parameter
//     declarations, continuous assigns (`assign`), procedural blocks
//     (`always`, `always_ff`, `always_comb`, `always_latch`, `initial`),
//     module instantiations, generate blocks (loop/if/case),
//     task and function declarations.
//   • Statements: blocking and non-blocking assignment, if/else,
//     case/casex/casez, begin/end blocks (with labels), for/while/
//     repeat/forever loops, disable, wait, system task calls.
//   • Event control: `@(posedge clk or negedge rst_n)`, `@*`, named
//     events, delay control `#5`.
//   • Expressions: full ~13-level precedence chain — conditional →
//     logical-or → logical-and → bitwise-or → bitwise-xor → bitwise-and
//     → equality → relational → shift → add/sub → mul/div/mod → power →
//     unary → primary.
//   • Primaries: numbers (every SV literal form via sv_number),
//     identifiers, hierarchical references, bit/part selects,
//     concatenation, replication, parens, function calls, system
//     task/function calls.
//
// NOT in this first pass (separate issues / future grammar files):
//
//   • Preprocessor (`define, `ifdef, `include) — separate phase.
//   • Classes, interfaces, modports, packages — SystemVerilog OOP.
//   • SVA assertions and properties — via subparse from SV grammar.
//   • Constraints, randomization, covergroups — testbench features.
//   • Specify blocks, UDP declarations, `defparam`.
//   • Typedef and user-defined types — needs symbol-table tracking;
//     today, declarations must use built-in keywords (wire/reg/logic).
//
// Design choices:
//
//   • Strict keywords (single-quote `'token'`) throughout — prevents
//     keyword/identifier collisions like `always` matching `always_inst`.
//   • Direct `{type, ...}` IR emission via bindings; no post-parse
//     lowering step.
//   • Math operator chains (`a + b - c + d`) require parentheses for
//     3+ operands. PEG can't left-fold; this design choice trades
//     ergonomic source for grammar simplicity. Real SV code rarely
//     hits this — comparisons and arithmetic almost always bracket.
//   • Both ANSI-style and Verilog-95-style port lists supported. The
//     Choice between them triggers an informational LL(k) warning;
//     accept (it's intentional fall-through).

use: std, sv

start: <SOURCE_TEXT>

// ─── File level ─────────────────────────────────────────────────────────

// Top-level ignore: whitespace + both comment styles. SV LRM §5.4
// permits both `//` and `/* */`; the std parsers handle both.
SOURCE_TEXT ignore whitespace line_comment block_comment: sequence dict {
  <DESCRIPTIONS>:descriptions=@
}

// Wrap the repeat in its own `sequence array` rule so save-side
// dispatch can iterate the array cleanly. Putting the repeat
// directly in SOURCE_TEXT (`repeat <DESCRIPTION>:descriptions[]=@`)
// breaks Choice dispatch because the pending-name path can't find
// the top dict scope at the moment alt-selection runs — peek_value
// ends up empty/wrong-typed and every alt's can_consume returns
// false. The extra rule resolves cleanly per the tcl.SCRIPT pattern.
DESCRIPTIONS: sequence array {
  repeat <DESCRIPTION> newline
}

// Flat Choice. Preprocessor directives (`define / `undef / `include /
// `ifdef / `ifndef) are NOT part of this list — the SV grammar is
// designed for input that's already been through the preprocessor
// pipeline. Load the `sv_preprocessor` grammar separately and run
// the source through it before handing the result to this parser.
DESCRIPTION: choice {
  <SV_ATTRIBUTE>,
  <SV_COMPILER_DIRECTIVE>,
  <DPI_IMPORT>,
  <DPI_EXPORT>,
  <PACKAGE_DECL>,
  <INTERFACE_DECL>,
  <CLASS_DECL_VIRTUAL>,
  <CLASS_DECL_PLAIN>,
  <UDP_DECL>,
  <CONFIG_DECL>,
  <PROGRAM_DECL>,
  <INTERFACE_CLASS_DECL>,
  <TYPEDEF_FORWARD_CLASS>,
  <TYPEDEF_REGULAR>,
  <INLINE_AGG_DECL>,
  <PARAM_DECL_STMT>,
  <LOCALPARAM_DECL_TYPE_STMT>,
  <LOCALPARAM_DECL_USERTYPE_STMT>,
  <LOCALPARAM_DECL_STMT>,
  <IMPORT_STMT>,
  <EXPORT_STMT>,
  <MACRO_STMT>,
  <FUNCTION_DECL>,
  <TASK_DECL>,
  <MODULE_DECL>,
  <NET_DECL>,
  <NET_DECL_USERTYPE>,
  <REG_DECL>,
  <INTEGER_DECL>,
  <CONT_ASSIGN>,
  <ALWAYS_BLOCK>,
  <INITIAL_BLOCK>,
  <CONCURRENT_ASSERT>,
  <BIND_STMT>,
  <CHECKER_DECL>,
  <SYSTEM_TASK_CALL>,
  <USER_TYPED_DECL>,
  <EMPTY_ITEM>
}

// IEEE 1800-2017 §22 "other" compiler directives appearing in source.
// The preprocessor passes these through verbatim (a consumer may want the
// timescale/nettype info), so the SV grammar structures them as top-level
// items instead of choking. `timescale`'s two time literals are <NUMBER>
// (a TIME_LIT) per operand — NOT <EXPR>, which would eat the `/` as
// division.
SV_COMPILER_DIRECTIVE: choice {
  <CD_TIMESCALE>,
  <CD_NETTYPE>,
  <CD_NOARG>
}
CD_TIMESCALE: sequence dict {
  "`timescale":@:type="timescale" space,
  <SV_TIMESCALE_VALUE>:time_unit=@ space, "/" space,
  <SV_TIMESCALE_VALUE>:time_prec=@
}
// `1ns` (glued — NUMBER parses it as one TIME_LIT) OR `1 ns` (a plain
// number then a separate unit keyword, as Forencich's cores write it).
SV_TIMESCALE_VALUE: sequence dict {
  <NUMBER>:value=@ space, ?<TIME_UNIT_KW>:unit=@
}
TIME_UNIT_KW: choice {
  'ms':@, 'us':@, 'ns':@, 'ps':@, 'fs':@, 's':@
}
CD_NETTYPE: sequence dict {
  "`default_nettype":@:type="default_nettype" space,
  <NETTYPE_VALUE>:nettype=@
}
NETTYPE_VALUE: choice {
  'none':@, 'wire':@, 'tri0':@, 'tri1':@, 'trireg':@, 'tri':@,
  'wand':@, 'wor':@, 'uwire':@
}
CD_NOARG: sequence dict {
  <CD_NOARG_KW>:directive=@:type="compiler_directive"
}
CD_NOARG_KW: choice {
  "`resetall":@, "`celldefine":@, "`endcelldefine":@,
  "`nounconnected_drive":@, "`end_keywords":@
}

// SV-1800 attribute syntax: `(* attr_name = value, attr_name2 = value, ... *)`.
// Attributes can appear before nearly any declaration to provide
// tool-specific hints. Pure parse — body captured raw.
SV_ATTRIBUTE: sequence dict {
  "(*":type="attribute",
  *:body=@,
  "*)"
}

// `(* attr *) <statement>` — an attribute instance prefixing a statement
// (IEEE 1800-2017 §5.12 — attributes may precede statements).
ATTRIBUTED_STMT: sequence dict {
  <SV_ATTRIBUTE>:attribute=@:type="attributed_stmt" space,
  <STATEMENT>:stmt=@
}

// `import "DPI-C" [pure | context] [c_name =] function|task NAME (args);`
// Foreign function interface declaration. Body captured raw to the
// trailing `;` so the full signature (return type, args with default
// values, modifiers like `pure`/`context`) parses uniformly.
DPI_IMPORT: sequence dict {
  'import':@:type="dpi_import",
  string:dpi_spec=@,
  *:body=@,
  ";"
}

// `export "DPI-C" [c_name =] function|task NAME;` — DPI export.
DPI_EXPORT: sequence dict {
  'export':@:type="dpi_export",
  string:dpi_spec=@,
  *:body=@,
  ";"
}

// ─── Module declaration ─────────────────────────────────────────────────

MODULE_DECL: sequence dict {
  <MODULE_KEYWORD>:keyword=@:type="module" space,
  <IDENT_OR_MACRO>:name=@,
  repeat <MODULE_HEADER_IMPORT>:header_imports[]=@,
  ?<PARAM_PORT_LIST>:param_ports=@,
  ?<PORT_LIST>:ports=@,
  ";" newline,
  <MODULE_ITEMS>:items=@,
  'endmodule',
  ?<END_LABEL>:end_label=@
}

// `module foo import pkg::*; #(...) (...)` — SV-1800 §23.2.1
// allows package imports immediately after the module name.
// Captures the import declarations as raw text up to the next
// non-import token (`#`, `(`, or `;`).
MODULE_HEADER_IMPORT: sequence dict {
  "" space,
  'import':@:type="module_header_import",
  *:body=@,
  ";"
}

// SV adds `program` and `macromodule` as module-equivalent keywords;
// keep them under one rule so the same item grammar applies.
MODULE_KEYWORD: choice {
  'module':@, 'macromodule':@, 'program':@
}

// `#(parameter A = 4, parameter B = 8)`. `localparam` may also appear
// inside the port list for derived parameters that can't be
// overridden by the instantiator. Each entry is `<PARAM_DECL_OR_LOCAL>`.
PARAM_PORT_LIST: sequence dict {
  "#", "(" newline,
  repeat+ <PARAM_DECL_OR_LOCAL>:params[]=@ indent tab separator "," newline,
  "" newline, ")"
}

// Order matters: PARAM_DECL_VALUE before PARAM_DECL_USERTYPE so the
// built-in TYPE_SPEC keywords (`int`, `bit`, `logic`, …) take priority
// over USERTYPE's `sv_identifier:type_spec=@` which would otherwise
// happily consume them. PARAM_DECL_VALUE additionally REQUIRES
// `<TYPE_SPEC>` (not optional) so it doesn't gobble `parameter
// MyType x` — that needs to fall through to USERTYPE.
PARAM_DECL_OR_LOCAL: choice {
  <PARAM_DECL_LOCALPARAM_TYPE>,
  <PARAM_DECL_LOCALPARAM_USERTYPE>,
  <PARAM_DECL_LOCALPARAM>,
  <PARAM_DECL_TYPE>,
  <PARAM_DECL_TYPE_IMPLICIT>,
  <PARAM_DECL_VALUE>,
  <PARAM_DECL_UNTYPED>,
  <PARAM_DECL_USERTYPE>,
  <PARAM_DECL_USERTYPE_BARE>,
  <PARAM_DECL_IMPLICIT>
}

// Inside a `#(...)` parameter port list the `parameter` keyword is
// optional — per IEEE 1800-2017 §8.10 the parser treats subsequent
// entries as parameters by context. Common in parameterised class
// declarations:
//
//   class riscv_page_table #(satp_mode_t MODE = SV39) extends uvm_object;
//                            ^^^^^^^^^^^^ no `parameter` keyword
//
// PARAM_DECL_USERTYPE_BARE catches the bare `usertype name = default`
// form. Tried AFTER the explicit-`parameter`-keyword USERTYPE so it
// doesn't shadow when the keyword IS present, and BEFORE
// PARAM_DECL_IMPLICIT so the two-identifier "type name" pattern is
// preferred over the one-identifier "name = expr" pattern.
//
// Reference: Verilator verilog.y `paramPortDecl` shape.
PARAM_DECL_USERTYPE_BARE: sequence dict {
  sv_qualified_type:type_spec=@:type="param_usertype",
  ?<PACKED_DIMENSIONS>:range=@,
  sv_identifier:name=@,
  ?<UNPACKED_DIMENSIONS>:unpacked=@,
  ?<PARAM_VALUE_DEFAULT>:default=@
}

// `localparam [type] NAME = expr` — non-overridable derived parameter.
PARAM_DECL_LOCALPARAM: sequence dict {
  'localparam':@:type="localparam_port" space,
  ?<TYPE_SPEC>:type_spec=@ space,
  ?<SIGNING_KW>:signing=@ space,
  ?<PACKED_DIMENSIONS>:range=@ space,
  sv_identifier:name=@ space,
  ?<PARAM_VALUE_DEFAULT>:default=@
}

// `localparam <usertype> NAME = expr` — same shape as PARAM_DECL_LOCALPARAM
// but with a user-defined / package-qualified type instead of a
// built-in keyword. Tried BEFORE the built-in form so a user type
// like `sha_word64_t` isn't dropped (PARAM_DECL_LOCALPARAM's
// `?<TYPE_SPEC>` is optional and would consume just `localparam`,
// then claim `sha_word64_t` as the name, leaving `ZeroWord` dangling).
//
// `!<TYPE_SPEC>` head guard: backs off when the next token is a
// built-in keyword (`int`, `bit`, …) so this rule doesn't shadow the
// built-in PARAM_DECL_LOCALPARAM form on `localparam int x = 1`.
// `sv_qualified_type` here is REQUIRED so the rule fails fast on
// `localparam x = 1` (no type) and the parser falls through.
PARAM_DECL_LOCALPARAM_USERTYPE: sequence dict {
  'localparam':@:type="localparam_port_usertype",
  !<TYPE_SPEC>,
  sv_qualified_type:type_spec=@,
  ?<PACKED_DIMENSIONS>:range=@,
  sv_identifier:name=@,
  ?<PARAM_VALUE_DEFAULT>:default=@
}

// Non-container sequence: its emitted bindings flow into the
// surrounding rule's dict (PARAM_DECL_STMT wraps it with a trailing
// `;`; PARAM_PORT_LIST uses it directly). Save-side dispatch can't
// handle a container=Dict Ref referenced without an outer binding —
// non-container sidesteps that.
// Same ordering note as PARAM_DECL_OR_LOCAL — VALUE before USERTYPE
// so built-in type keywords win.
PARAM_DECL: choice {
  <PARAM_DECL_TYPE>,
  <PARAM_DECL_TYPE_IMPLICIT>,
  <PARAM_DECL_VALUE>,
  <PARAM_DECL_UNTYPED>,
  <PARAM_DECL_USERTYPE>,
  <PARAM_DECL_IMPLICIT>
}

// `parameter NAME = expr` — untyped parameter, default type is int
// per SV LRM. Must precede USERTYPE in the choice since USERTYPE's
// `sv_qualified_type:type_spec=@` would happily eat NAME and then
// fail when the trailing `=` isn't followed by another identifier
// for the actual parameter name. Requires `=` to commit the match.
PARAM_DECL_UNTYPED: sequence dict {
  'parameter':@:type="param_untyped" space,
  sv_identifier:name=@ space,
  "=" space, <EXPR>:value=@
}

// `parameter [<pkg>::]<type_name> <NAME> [= <expr>]` — user-typed
// parameter. The `sv_qualified_type` terminal handles both bare
// identifiers and package-qualified forms (`pkg::TypeName`) in one
// match, collapsing what previously needed two parallel grammar
// rules.
PARAM_DECL_USERTYPE: sequence dict {
  'parameter':@:type="param_usertype" space,
  sv_qualified_type:type_spec=@ space,
  ?<PARAM_OVERRIDE>:type_params=@ space,
  ?<PACKED_DIMENSIONS>:range=@ space,
  sv_identifier:name=@ space,
  ?<UNPACKED_DIMENSIONS>:unpacked=@,
  ?<PARAM_VALUE_DEFAULT>:default=@
}

PARAM_DECL_TYPE: sequence dict {
  'parameter':@:type="param_type" space,
  'type' space,
  sv_identifier:name=@,
  ?<PARAM_TYPE_DEFAULT>:default=@
}

// `localparam type NAME = <type>` inside a `#(...)` param-port list — the
// localparam counterpart of PARAM_DECL_TYPE. Tried before
// PARAM_DECL_LOCALPARAM_USERTYPE (which would mis-read `type` as a user
// type name and then reject an inline-aggregate default). CVA6 config
// structs: `#(localparam type sbe_t = struct packed {…}, …)`.
PARAM_DECL_LOCALPARAM_TYPE: sequence dict {
  'localparam':@:type="localparam_type" space,
  'type' space,
  sv_identifier:name=@,
  ?<PARAM_TYPE_DEFAULT>:default=@
}

// Implicit-`parameter` form for class type parameters:
// `class C #(type T = int);`. The `parameter` keyword is omitted.
PARAM_DECL_TYPE_IMPLICIT: sequence dict {
  'type':@:type="param_type_implicit" space,
  sv_identifier:name=@,
  ?<PARAM_TYPE_DEFAULT>:default=@
}

// A type parameter's default is a TYPE — which can be an inline
// aggregate (`localparam type pte_t = struct packed {…}`, CVA6/Ariane)
// as well as a type name / built-in. Try the aggregate forms first, then
// fall back to EXPR (covers type names and built-in keywords).
PARAM_TYPE_DEFAULT: sequence dict {
  "" space, "=" space, <PARAM_TYPE_VALUE>:value=@
}
PARAM_TYPE_VALUE: choice {
  <INLINE_AGG_TYPE>,
  <PARAM_TYPE_BUILTIN>,
  <EXPR>
}
// A built-in type with optional signing + packed range as a type-param
// default: `localparam type in_t = logic unsigned [N-1:0]` (HPDcache).
// TYPE_SPEC required (a keyword), so a user-type name falls through to EXPR.
PARAM_TYPE_BUILTIN: sequence dict {
  <TYPE_SPEC>:type_spec=@:type="param_type_builtin" space,
  ?<SIGNING_KW>:signing=@ space,
  ?<PACKED_DIMENSIONS>:range=@
}

// TYPE_SPEC is REQUIRED here (not optional) so this rule only matches
// when the parameter type is a built-in keyword. `parameter MyType x`
// falls through to PARAM_DECL_USERTYPE which reads the type via
// sv_qualified_type.
PARAM_DECL_VALUE: sequence dict {
  'parameter':@:type="param" space,
  <TYPE_SPEC>:type_spec=@ space,
  ?<SIGNING_KW>:signing=@ space,
  ?<PACKED_DIMENSIONS>:range=@ space,
  sv_identifier:name=@ space,
  ?<UNPACKED_DIMENSIONS>:unpacked=@,
  ?<PARAM_VALUE_DEFAULT>:default=@
}

// Integer-atom signing. SV LRM §6.11 allows `signed`/`unsigned`
// after an integer atom type (`int unsigned`, `byte signed`, etc.).
SIGNING_KW: choice { 'signed':@, 'unsigned':@ }

// SV reserved keywords that close a structural scope (`begin … end`,
// `case … endcase`, `function … endfunction`, …) or terminate a
// branch (`else`). These MUST NOT be matched as plain identifiers
// at the head of a declaration-shaped rule — without the guard,
// `LOCAL_VAR_DECL_USER` (and any other `<sv_id> <sv_id> …` rule)
// would happily consume `end p = q;` as `type=end, name=p, init=q;`
// and the enclosing `begin … end` block would never see its closer.
//
// All entries are strict (single-quote) keys so they only match at
// word boundaries — `endure` matches none of them, `endcase` matches
// `'endcase'` and not the prefix `'end'`.
//
// Used via `!<SV_RESERVED>` at the start of rules whose first token
// is a bare `sv_identifier` / `sv_qualified_type`. The negative
// lookahead consumes nothing on success, so the inner rule sees the
// original cursor.
SV_RESERVED: choice {
  'endcase':@,    'endclass':@,   'endclocking':@, 'endconfig':@,
  'endfunction':@, 'endgenerate':@, 'endgroup':@,  'endinterface':@,
  'endmodule':@,  'endpackage':@, 'endprimitive':@, 'endprogram':@,
  'endproperty':@, 'endsequence':@, 'endspecify':@, 'endtask':@,
  'endchecker':@,
  'join_none':@, 'join_any':@, 'join':@,
  'return':@,    'force':@,   'release':@,   'assign':@,
  'end':@,    'else':@,    'begin':@
}

PARAM_VALUE_DEFAULT: sequence dict { "=" space, <EXPR>:value=@ }

// Implicit-`parameter` form for class parameter port lists:
// `class C #(int N = 8); ...endclass`. The `parameter` keyword is
// implied. Same fields as PARAM_DECL_VALUE but without the
// `'parameter'` prefix.
PARAM_DECL_IMPLICIT: sequence dict {
  <TYPE_SPEC>:type_spec=@:type="param_implicit" space,
  ?<SIGNING_KW>:signing=@ space,
  ?<PACKED_DIMENSIONS>:range=@ space,
  sv_identifier:name=@ space,
  ?<UNPACKED_DIMENSIONS>:unpacked=@,
  ?<PARAM_VALUE_DEFAULT>:default=@
}

// Port list — Choice between ANSI-style and Verilog-95-style. The
// LL(k) lint flags this as informational; accept as intentional.
PORT_LIST: choice {
  <PORT_LIST_ANSI>,
  <PORT_LIST_NONANSI>
}

// ANSI port list. The FIRST port must be direction-headed (so the
// ANSI/non-ANSI disambiguation works correctly — `(a, b, c)` falls
// through to PORT_LIST_NONANSI). Subsequent ports can be either
// direction-headed (new direction) or name-only continuations
// (inherit the preceding direction, like SV's `input a, b, c`
// shorthand). PORT_BODY_NEXT wraps the leading `,` so we can put
// the Choice over direction-vs-cont forms in one place.
PORT_LIST_ANSI: sequence dict {
  "(":style="ansi" newline,
  <PORT_BODY_FIRST>:ports[]=@ indent tab,
  repeat <PORT_BODY_NEXT>:ports[]=@,
  "" newline, ")"
}

// First port — must have a direction keyword. The pkg-qualified
// usertype variant is tried first so `input pkg::Type name` doesn't
// mismatch against PORT_DECL_ANSI_USERTYPE's bare-identifier type
// (which would consume `pkg` then expect a `name`, leaving `::`
// unmatched). PORT_DECL_ANSI_USERTYPE then handles the bare
// usertype form, and PORT_DECL_ANSI is the catchall.
PORT_BODY_FIRST: choice {
  <ATTRIBUTED_PORT_FIRST>,
  <PORT_DECL_ANSI_USERTYPE>,
  <PORT_DECL_ANSI>,
  <PORT_DECL_NODIR_TYPED>,
  <PORT_DECL_INTERFACE>,
  <PORT_MACRO>
}

// A port declaration preceded by an attribute instance — IEEE 1800-2017
// §23.2.2.1 allows `{ attribute_instance } ansi_port_declaration`. Common
// in synthesis/PDK libraries: `(* iopad_external_pin *) input a`,
// `(* init = 1'b0 *) output q`. Recurses on the port-body choice so the
// attribute prefixes any port form (and stacks for `(* a *) (* b *) port`).
ATTRIBUTED_PORT_FIRST: sequence dict {
  <SV_ATTRIBUTE>:attribute=@:type="attributed_port" space,
  <PORT_BODY_FIRST>:port=@
}
ATTRIBUTED_PORT_ANY: sequence dict {
  <SV_ATTRIBUTE>:attribute=@:type="attributed_port" space,
  <PORT_BODY_ANY>:port=@
}

// Subsequent ports: comma + port-body. The port-body Choice
// includes the name-only continuation form (PORT_NAME_CONT) for
// inherited-direction ports. The non-container Sequence passes
// PORT_BODY_ANY's emitted port-dict up through PORT_LIST_ANSI's
// `:ports[]=@` binding.
PORT_BODY_NEXT: sequence { ",", "" newline, <PORT_BODY_ANY> indent tab }

PORT_BODY_ANY: choice {
  <ATTRIBUTED_PORT_ANY>,
  <PORT_DECL_ANSI_USERTYPE>,
  <PORT_DECL_ANSI>,
  <PORT_DECL_NODIR_TYPED>,
  <PORT_DECL_INTERFACE>,
  <PORT_MACRO>,
  <PORT_NAME_CONT>
}

// Macro use as a whole port slot. UVM/lowRISC heavily use
// `\`UVM_DRIVER_PORTS` / `\`PORTS_DECL` etc. inside port lists to
// emit multiple ports from one call site. The grammar can't expand
// the macro — capture it opaquely so the surrounding port-list
// repeat continues unbroken. Tried after the structured forms so
// it doesn't shadow real declarations.
PORT_MACRO: sequence dict {
  <MACRO_USE>:macro=@:type="port_macro"
}

// Port with an explicit type but no direction — per IEEE 1800-2017
// §23.2.2.1, in an ANSI port list a port may omit its direction;
// the direction defaults to the most-recent one specified in the
// list. Common in interface declarations:
//
//   interface my_if (
//     input  logic clk,
//     input  logic [7:0] addr,    // direction "input" inherited
//     logic [7:0] data            // <-- no direction, just a type
//   );
//
// Tried AFTER the direction-headed forms so it doesn't shadow them.
// Reference: Verilator verilog.y `ansi_port_declaration` shape.
PORT_DECL_NODIR_TYPED: sequence dict {
  <TYPE_SPEC>:type_spec=@:type="port_decl_nodir" space,
  ?<SIGNING_KW>:signing=@ space,
  ?<PACKED_DIMENSIONS>:range=@ space,
  <IDENT_OR_MACRO>:name=@,
  ?<UNPACKED_DIMENSIONS>:unpacked=@
}

// Interface port — `interface_name[.modport_name] port_name`.
// Per IEEE 1800-2017 §25.5, a module / interface port may name
// an interface instance and optionally a modport view:
//
//   module m(bus_if.master m_if);   // modport-qualified
//   module m(bus_if a);             // bare interface
//
// Placed BEFORE PORT_NAME_CONT so the two-identifier form wins.
// Built-in types are excluded because TYPE_SPEC (built-in keyword
// set) and PORT_DECL_NODIR_TYPED already cover those; here both
// the interface name and the port name are user identifiers.
PORT_DECL_INTERFACE: sequence dict {
  sv_identifier:interface=@:type="port_decl_interface",
  ?<MODPORT_SUFFIX>:modport=@,
  "" space,
  <IDENT_OR_MACRO>:name=@,
  ?<UNPACKED_DIMENSIONS>:unpacked=@
}

MODPORT_SUFFIX: sequence { ".", sv_identifier }

// Continuation form: `input a, b, c` is shorthand for
// `input a, input b, input c`. The first port carries the
// direction; subsequent ports inherit it. Pure parse — host
// re-applies the inherited direction by walking the port array
// left-to-right.
PORT_NAME_CONT: sequence dict {
  ?<PACKED_DIMENSIONS>:range=@,
  <IDENT_OR_MACRO>:name=@:type="port_name_cont",
  ?<UNPACKED_DIMENSIONS>:unpacked=@
}

// `input <typedef'd_name> [range] <name>` — two identifiers in a row,
// with the first being the user type and the second the port name.
// The sv_identifier here matches the type name; the IDENT_OR_MACRO
// matches the port name. Range and unpacked dimensions are the same
// as PORT_DECL_ANSI.
// User-typed port. `sv_qualified_type` matches both bare type names
// and `pkg::TypeName` qualified forms in one step — collapsing the
// previous PORT_DECL_ANSI_PKG_USERTYPE variant into this one.
PORT_DECL_ANSI_USERTYPE: sequence dict {
  <PORT_DIRECTION>:direction=@ space,
  sv_qualified_type:type_spec=@:type="port_decl_usertype" space,
  ?<SIGNING_KW>:signing=@ space,
  ?<PACKED_DIMENSIONS>:range=@ space,
  <IDENT_OR_MACRO>:name=@,
  ?<UNPACKED_DIMENSIONS>:unpacked=@
}

PORT_LIST_NONANSI: sequence dict {
  "(":style="nonansi",
  repeat sv_identifier:port_names[]=@ separator ",",
  ")"
}

// ANSI-style port: direction + optional type + optional range + name.
PORT_DECL_ANSI: sequence dict {
  <PORT_DIRECTION>:direction=@ space,
  ?<TYPE_SPEC>:type_spec=@ space,
  ?<SIGNING_KW>:signing=@ space,
  ?<PACKED_DIMENSIONS>:range=@ space,
  <IDENT_OR_MACRO>:name=@,
  ?<UNPACKED_DIMENSIONS>:unpacked=@
}

// `const ref` (IEEE 1800-2017 §13.5.2) is the read-only-pass-by-reference
// direction for function/task ports — taken atomically so the leading
// `const` doesn't get claimed as a type modifier elsewhere. Tried before
// bare `ref` so the longer match wins.
PORT_DIRECTION: choice {
  <CONST_REF_DIR>,
  'input':@, 'output':@, 'inout':@, 'ref':@
}

CONST_REF_DIR: sequence dict {
  'const':@:type="const_ref" space,
  'ref'
}

// `[7:0]` — packed dimension (in bit position).
RANGE: sequence dict {
  "[", <EXPR>:msb=@, ":", <EXPR>:lsb=@, "]"
}

// Multiple packed dimensions: `[7:0][3:0][1:0]`. Used in NET_DECL,
// REG_DECL, INTEGER_DECL, USER_TYPED_DECL — anywhere a single
// `?<RANGE>` field is currently used, the alternative form
// `?<PACKED_DIMENSIONS>` lets the host accept multi-dim packed
// arrays. Kept as a separate rule (not just `repeat <RANGE>`) so
// existing single-range usage isn't disturbed.
PACKED_DIMENSIONS: sequence array {
  repeat+ <RANGE>
}

// SV-1800 dynamic/associative/queue bracket forms attached to a
// declaration's variable name:
//
//   * `int q[$];`      — queue (unbounded)
//   * `int q[$:10];`   — queue (bounded)
//   * `int aa[string];` — associative array keyed by string
//   * `int da[];`      — dynamic array (resizable, empty brackets)
//   * `int arr[16];`   — fixed-size unpacked array
//
// All forms use square brackets but with distinct internals. We
// capture them as raw text via `sv_balanced_braces` (which tracks
// `()`/`{}`/`[]` depth) so any of the four cases parse uniformly.
// Bracket content is captured by `sv_balanced_brackets` which
// tracks `[]`/`()`/`{}` depth so nested-bracket cases like
// `[bit[31:0]]` (associative array keyed by a sized type) parse
// uniformly. Covers all variants: `[$]`, `[$:10]`, `[string]`,
// `[]`, `[16]`, and the nested forms.
ARRAY_KIND_SUFFIX: sequence dict {
  "[", sv_balanced_brackets:kind=@, "]"
}

// `[0:15] [0:7]` or `[3]` — unpacked dimensions for arrays. Each
// dimension is either an `[msb:lsb]` range OR a single `[size]`
// fixed-size expression OR a typed bracket (`[type]`, `[$]`, `[]`).
// Captured via ARRAY_KIND_SUFFIX which uses raw-capture between
// brackets — covers all variants uniformly.
UNPACKED_DIMENSIONS: sequence array {
  repeat+ <ARRAY_KIND_SUFFIX>
}

// Built-in net/variable types. Used in OPTIONAL slots where adding
// an identifier-fallback would cause greedy mis-matching of the
// name as a type. User-defined type names in these positions reach
// the AST via the separate `USER_TYPED_DECL` and `USER_TYPED_PORT`
// rules (tried after the built-in-keyword variants in their
// respective Choices). Host disambiguates "built-in vs typedef'd"
// by matching against the keyword set — no symbol-table resolution
// at parse time.
TYPE_SPEC: choice {
  'wire':@,  'reg':@,    'logic':@,   'bit':@,
  'integer':@, 'int':@,  'real':@,    'time':@,
  'shortint':@, 'longint':@, 'byte':@,
  'tri':@,   'tri0':@,   'tri1':@,    'wand':@, 'wor':@,
  'supply0':@, 'supply1':@,
  'string':@, 'chandle':@, 'event':@, 'void':@,
  'realtime':@, 'shortreal':@
}

// ─── Module items ───────────────────────────────────────────────────────

// Array-wrapper rule for the items list in MODULE_DECL — same
// pattern as DESCRIPTIONS (see SOURCE_TEXT). Wrapping the repeat
// in its own `sequence array` rule lets save-side dispatch iterate
// the array cleanly; embedding `repeat <X>:items[]=@` directly in
// MODULE_DECL breaks Choice dispatch at save time.
MODULE_ITEMS: sequence array {
  repeat <MODULE_ITEM> indent tab newline
}

// Flat Choice — directives inlined for save-dispatch reasons (see
// DESCRIPTION). MACRO_STMT comes LAST: a `MACRO at module-item
// position is tried as a regular item first (instantiation, decl,
// etc.), and only falls through to MACRO_STMT if nothing else
// matches. This is what makes `MOD_TYPE `U0(.clk(clk)); parse as
// an instance (with macro module-type and macro instance-name)
// instead of gobbling just `MOD_TYPE as a statement.
MODULE_ITEM: choice {
  <DEFINE>,
  <UNDEF>,
  <INCLUDE>,
  <IFDEF>,
  <IFNDEF>,
  <SV_ATTRIBUTE>,
  <DPI_IMPORT>,
  <DPI_EXPORT>,
  <PORT_DECL_STMT>,
  <PORT_DECL_STMT_USERTYPE>,
  <NET_DECL>,
  <NET_DECL_USERTYPE>,
  <REG_DECL>,
  <INTEGER_DECL>,
  <GENVAR_DECL>,
  <NETTYPE_DECL>,
  <PARAM_DECL_STMT>,
  <LOCALPARAM_DECL_TYPE_STMT>,
  <LOCALPARAM_DECL_USERTYPE_STMT>,
  <LOCALPARAM_DECL_STMT>,
  <CONT_ASSIGN>,
  <ALWAYS_BLOCK>,
  <INITIAL_BLOCK>,
  <FINAL_BLOCK>,
  <GENERATE_BLOCK>,
  <GEN_IF>,
  <GEN_FOR>,
  <GEN_CASE>,
  <TASK_DECL>,
  <FUNCTION_DECL>,
  <EXTERN_DECL>,
  <SPECIFY_BLOCK>,
  <DEFPARAM_STMT>,
  <BIND_STMT>,
  <LET_DECL>,
  <CLOCKING_BLOCK>,
  <COVERGROUP_DECL>,
  <CHECKER_DECL>,
  <PROPERTY_DECL>,
  <SEQUENCE_DECL>,
  <DEFAULT_DISABLE_IFF>,
  <CONCURRENT_ASSERT>,
  <IMMEDIATE_ASSERT>,
  <MODPORT_DECL>,
  <CLASS_DECL_VIRTUAL>,
  <CLASS_DECL_PLAIN>,
  <MODULE_DECL>,
  <INTERFACE_DECL>,
  <IMPORT_STMT>,
  <EXPORT_STMT>,
  <GATE_INSTANTIATION>,
  <MODULE_INSTANTIATION>,
  <VIRTUAL_INTERFACE_DECL>,
  <TYPEDEF_FORWARD_CLASS>,
  <TYPEDEF_REGULAR>,
  <INLINE_AGG_DECL>,
  <SYSTEM_TASK_CALL>,
  <USER_TYPED_DECL>,
  <EMPTY_ITEM>,
  <MACRO_STMT>
}

// A bare `;` — a null item/statement. SV tolerates stray/empty semicolons
// (`typedef logic t;;`, a `;` on its own line). Captured so it round-trips.
EMPTY_ITEM: sequence dict { ";":type="empty_item" }

// Verilog-95 / non-ANSI port declaration: a port direction followed by
// optional type/range and one or more port names — used as a module
// item to fill in the declaration for ports listed by name in the
// header. Example:
//   module foo (a, b);
//     input wire a;
//     output reg b;
//   endmodule
PORT_DECL_STMT: sequence dict {
  <PORT_DIRECTION>:direction=@:type="port_decl" space,
  ?<TYPE_SPEC>:type_spec=@ space,
  ?<SIGNING_KW>:signing=@ space,
  ?<PACKED_DIMENSIONS>:range=@ space,
  repeat+ sv_identifier:names[]=@ separator "," space,
  ";"
}

// `input <user_type> name;` — a non-ANSI port whose type is a user-defined
// or pkg-qualified type (`input p::p_t p;`). Tried after PORT_DECL_STMT,
// which fails on the two-identifier `<dir> <type> <name>` shape (it reads
// `p::p_t` as a single name and chokes). The required name keeps it from
// claiming a plain `input x;`.
PORT_DECL_STMT_USERTYPE: sequence dict {
  <PORT_DIRECTION>:direction=@:type="port_decl_user" space,
  sv_qualified_type:type_spec=@ space,
  ?<PACKED_DIMENSIONS>:range=@ space,
  repeat+ sv_identifier:names[]=@ separator "," space,
  ";"
}

NET_DECL: sequence dict {
  <NET_KIND>:kind=@:type="net_decl" space,
  ?<TYPE_SPEC>:data_type=@ space,
  ?<NET_SIGNING>:signing=@ space,
  ?<PACKED_DIMENSIONS>:range=@ space,
  ?<DELAY>:delay=@ space,
  repeat+ <NET_NAME>:names[]=@ separator "," space,
  ";"
}

// `wire <user_type> name;` — a net with a user-defined data type
// (`wire my_t w;`). Tried AFTER NET_DECL: the plain form fails on the
// two-identifier `<kind> <type> <name>` shape (it reads `my_t` as the
// name and then chokes on `w`), so this catches it. The required second
// name keeps it from claiming a plain `wire w;`.
NET_DECL_USERTYPE: sequence dict {
  <NET_KIND>:kind=@:type="net_decl_usertype" space,
  sv_qualified_type:data_type=@ space,
  ?<PACKED_DIMENSIONS>:range=@ space,
  repeat+ <NET_NAME>:names[]=@ separator "," space,
  ";"
}

NET_KIND: choice {
  'wire':@,    'logic':@,   'tri':@,    'tri0':@, 'tri1':@,
  'wand':@,    'wor':@,     'supply0':@,'supply1':@
}

NET_SIGNING: choice { 'signed':@, 'unsigned':@ }

NET_NAME: sequence dict {
  <IDENT_OR_MACRO>:name=@,
  repeat <ARRAY_KIND_SUFFIX>:array_kind[]=@,
  ?<NET_INIT>
}

// Optional initializer on a net (e.g. `wire x = a & b;`). Non-
// container sequence: its `initial` binding flows up into the
// caller's dict.
NET_INIT: sequence { "" space, "=" space, <EXPR>:initial=@ }

REG_DECL: sequence dict {
  <REG_KIND>:kind=@:type="reg_decl" space,
  ?<NET_SIGNING>:signing=@ space,
  ?<PACKED_DIMENSIONS>:range=@ space,
  repeat+ <REG_NAME>:names[]=@ separator "," space,
  ";"
}

REG_KIND: choice {
  'reg':@, 'logic':@, 'bit':@
}

REG_NAME: sequence dict {
  <IDENT_OR_MACRO>:name=@,
  ?<ARRAY_KIND_SUFFIX>:array_kind=@,
  ?<UNPACKED_DIMENSIONS>:packed=@,
  ?<NET_INIT>
}

INTEGER_DECL: sequence dict {
  ?'const':is_const=true space,
  ?'var':is_var=true space,
  <INTEGER_KIND>:kind=@:type="integer_decl" space,
  ?<NET_SIGNING>:signing=@ space,
  ?<PACKED_DIMENSIONS>:range=@ space,
  repeat+ <REG_NAME>:names[]=@ separator "," space,
  ";"
}

INTEGER_KIND: choice {
  'integer':@,  'int':@,     'shortint':@,
  'longint':@,  'byte':@,    'real':@,
  'time':@,     'realtime':@
}

// `typedef <TYPE> <NAME>;` — user-defined type alias. Pure parse:
// the AST captures both the source type and the new name; the host
// (or a downstream pass) builds the symbol table that lets later
// declarations like `byte_t data;` resolve to the typedef.
//
// Also recognizes the `typedef class NAME;` forward declaration
// form used to break circular class references.
TYPEDEF_DECL: choice {
  <TYPEDEF_FORWARD_CLASS>,
  <TYPEDEF_REGULAR>
}

TYPEDEF_FORWARD_CLASS: sequence dict {
  'typedef':@:type="typedef_forward_class" space,
  'class' space,
  sv_identifier:name=@,
  ";"
}

TYPEDEF_REGULAR: sequence dict {
  'typedef':@:type="typedef" space,
  <TYPEDEF_BASE>:base=@ space,
  ?<SIGNING_KW>:signing=@ space,
  ?<PACKED_DIMENSIONS>:range=@ space,
  sv_identifier:name=@,
  ?<UNPACKED_DIMENSIONS>:unpacked=@,
  ";"
}

// What can follow `typedef`: a built-in TYPE_SPEC keyword (logic,
// integer, etc.) or any identifier (another typedef'd name being
// re-aliased). The Choice tries TYPE_SPEC's keyword set first, then
// falls through to sv_identifier so user-defined names work too.
TYPEDEF_BASE: choice {
  <ENUM_TYPE>,
  <STRUCT_TYPE>,
  <UNION_TYPE>,
  <VIRTUAL_IF_TYPEDEF>,
  <PARAMETERIZED_TYPE_REF>,
  <TYPE_SPEC>,
  sv_qualified_type
}

// `typedef virtual [interface] NAME [#(...)]` — virtual interface
// type alias used to declare a handle to an interface instance in
// class properties / sequence args. Per SV-1800 §6.18 and §25.9.
// `interface` keyword is optional (UVM usually omits it). The
// parameterised form (`virtual push_pull_if#(...)`) reuses
// PARAM_BINDING for the named-or-positional bindings.
VIRTUAL_IF_TYPEDEF: sequence dict {
  'virtual':@:type="virtual_if_type" space,
  ?'interface':is_interface_kw=true space,
  sv_identifier:name=@,
  ?<PARAM_OVERRIDE>:params=@
}

// `enum [base_type] { label [= value], ... }` — enumerated type.
// Body parsed DIRECTLY (no subparse) as a comma-separated list of
// labels. Cleaner than capture-then-subparse: the grammar engine
// handles structure naturally and save round-trips for free.
ENUM_TYPE: sequence dict {
  'enum':@:type="enum_type" space,
  ?<TYPE_SPEC>:base_type=@ space,
  ?<SIGNING_KW>:base_signing=@ space,
  ?<PACKED_DIMENSIONS>:base_range=@ space,
  "{",
  repeat+ <ENUM_LABEL>:labels[]=@ separator "," space,
  "}"
}

ENUM_LABEL: sequence dict {
  sv_identifier:name=@,
  ?<ENUM_LABEL_VALUE>:value=@
}

ENUM_LABEL_VALUE: sequence dict { "" space, "=" space, <EXPR>:value=@ }

// `[packed] struct [signing] { <fields> }` — struct/union types.
// Body parsed directly as a sequence of field declarations.
STRUCT_TYPE: sequence dict {
  'struct':@:type="struct_type" space,
  ?'packed':is_packed=true space,
  ?<SIGNING_KW>:signing=@ space,
  "{",
  repeat+ <STRUCT_FIELD>:fields[]=@,
  "}"
}

UNION_TYPE: sequence dict {
  'union':@:type="union_type" space,
  ?'packed':is_packed=true space,
  ?<SIGNING_KW>:signing=@ space,
  "{",
  repeat+ <STRUCT_FIELD>:fields[]=@,
  "}"
}

// Anonymous inline aggregate type used DIRECTLY as a data declaration
// (no typedef): `enum logic [3:0] {…} state;`, `struct packed {…} s;`,
// `union packed {…} u, v = '0;`. Same ENUM_TYPE/STRUCT_TYPE/UNION_TYPE
// the typedef form uses, followed by a variable list. CVA6/Snitch/Ariane
// use these heavily inline instead of a separate typedef.
INLINE_AGG_DECL: sequence dict {
  "":type="inline_agg_decl",
  <INLINE_AGG_TYPE>:agg_type=@ space,
  ?<PACKED_DIMENSIONS>:range=@ space,
  repeat+ <AGG_VAR>:vars[]=@ separator "," space,
  ";"
}
INLINE_AGG_TYPE: choice { <ENUM_TYPE>, <STRUCT_TYPE>, <UNION_TYPE> }
AGG_VAR: sequence dict {
  sv_identifier:name=@,
  ?<UNPACKED_DIMENSIONS>:unpacked=@,
  ?<STRUCT_FIELD_INIT>:init=@
}

// Struct/union field: `<TYPE> [range] <NAME> [unpacked-dim] [= init];`.
// Optional `rand` / `randc` qualifier — used when the struct is a
// class property whose enclosing class invokes `randomize()`, the
// per-field constrained-random qualifier comes through (IEEE
// 1800-2017 §18.4) before the type. Pure parse: captured as text.
// One declared type can name SEVERAL fields: `logic none, load, store;`
// (common in CVA6/Ariane decode structs). The comma-separated names share
// the type/range; each carries its own optional unpacked dim + init
// (AGG_VAR is exactly that name+dim+init shape).
STRUCT_FIELD: sequence dict {
  ?<RAND_QUALIFIER>:rand=@ space,
  <STRUCT_FIELD_TYPE>:type_spec=@ space,
  ?<SIGNING_KW>:signing=@ space,
  ?<PACKED_DIMENSIONS>:range=@ space,
  repeat+ <AGG_VAR>:names[]=@ separator "," space,
  ";"
}

RAND_QUALIFIER: choice {
  'randc':@,
  'rand':@
}

STRUCT_FIELD_TYPE: choice {
  <STRUCT_TYPE>,
  <UNION_TYPE>,
  <TYPE_SPEC>,
  <STRUCT_FIELD_PKG_TYPE>,
  <STRUCT_FIELD_USER_TYPE>
}

// `pkg::type_name` — package-qualified type used as a struct/union
// field type. Captured as a single dict so save reconstructs the
// `pkg::name` form.
STRUCT_FIELD_PKG_TYPE: sequence dict {
  sv_identifier:pkg=@:type="pkg_qual_type",
  "::",
  sv_identifier:name=@
}

STRUCT_FIELD_USER_TYPE: sequence { sv_identifier }

STRUCT_FIELD_INIT: sequence dict { "" space, "=" space, <EXPR>:value=@ }

// User-defined-typed declaration: `<typedef'd_name> [range] <names>;`.
// Tried at module-item position AFTER all the built-in-keyword
// declarations and after MODULE_INSTANTIATION. The order matters:
//
//   * `wire foo;` matches NET_DECL (NET_KIND keyword).
//   * `reg r1;`   matches REG_DECL (REG_KIND keyword).
//   * `byte_t x;` falls through to USER_TYPED_DECL.
//   * `Mod m(.p(s));` matches MODULE_INSTANTIATION (parens).
//   * `Mod m;`     falls through to USER_TYPED_DECL (no parens).
//
// The host distinguishes "synth net/reg" vs "user-defined type" by
// matching the `type_spec` field against the keyword set. Pure parse;
// no symbol-table lookup at parse time.
// User-typed declaration. `sv_qualified_type` handles both bare
// type names (`my_type x;`) and package-qualified ones
// (`pkg::TypeName x;`) in a single match — collapsing what used
// to need two parallel rules.
//
// `!<SV_RESERVED>` guard at the head: `sv_qualified_type` accepts
// any identifier-shape token without consulting SV's reserved
// word table, so without the guard `endfunction <name>;` at the
// tail of a function body would parse as a user-typed decl
// (`type=endfunction, name=<name>;`). The guard lets the surrounding
// `endfunction` keyword claim the token instead.
USER_TYPED_DECL: sequence dict {
  ?<LIFETIME>:lifetime=@ space,
  !<SV_RESERVED>,
  ?'const':is_const=true space,
  ?'var':is_var=true space,
  sv_qualified_type:type_spec=@:type="user_typed_decl" space,
  ?<PARAM_OVERRIDE>:params=@ space,
  ?<NET_SIGNING>:signing=@ space,
  ?<PACKED_DIMENSIONS>:range=@ space,
  repeat+ <NET_NAME>:names[]=@ separator "," space,
  ";"
}

PARAM_DECL_STMT: sequence {
  <PARAM_DECL>,
  ";"
}

// SV-1800 §6.20.4 / §7.4 — localparams may carry unpacked
// dimensions after the name (`logic [31:0] M [4] = '{...};`),
// the same way ordinary variable declarations do. Without the
// `?<UNPACKED_DIMENSIONS>` slot the parser stopped at the `[`
// and failed with "expected literal '='".
LOCALPARAM_DECL_STMT: sequence dict {
  'localparam':@:type="localparam" space,
  ?<TYPE_SPEC>:type_spec=@ space,
  ?<SIGNING_KW>:signing=@ space,
  ?<PACKED_DIMENSIONS>:range=@ space,
  sv_identifier:name=@ space,
  ?<UNPACKED_DIMENSIONS>:unpacked=@,
  "=" space, <EXPR>:value=@,
  repeat <LOCALPARAM_MORE>:more[]=@,
  ";"
}

// `, name = value` — additional names sharing one `localparam`'s type
// (`localparam logic [63:0] a = '0, b = '1;`). Kept as a continuation so
// the common single-name form's AST shape is unchanged.
LOCALPARAM_MORE: sequence dict {
  "" space, ",", "" space,
  sv_identifier:name=@ space,
  ?<UNPACKED_DIMENSIONS>:unpacked=@,
  "=" space, <EXPR>:value=@
}

// `localparam type NAME = <type>;` — type localparam (the `type` keyword).
// Default is a type, including an inline aggregate (`= struct packed {…}`,
// CVA6/Ariane). Mirrors `parameter type` (PARAM_DECL_TYPE). Must precede
// LOCALPARAM_DECL_USERTYPE_STMT in DESCRIPTION so `type` isn't grabbed as
// a user type name.
LOCALPARAM_DECL_TYPE_STMT: sequence dict {
  'localparam':@:type="localparam_type" space,
  'type' space,
  sv_identifier:name=@,
  ?<PARAM_TYPE_DEFAULT>:default=@,
  ";"
}

// `localparam [pkg::]Type NAME = expr;` — user-typed localparam.
// LOCALPARAM_DECL_STMT's optional TYPE_SPEC can't match `pkg::T`
// because TYPE_SPEC is built-in keywords only; this rule picks it up
// via sv_qualified_type. Must be tried BEFORE LOCALPARAM_DECL_STMT
// in the enclosing choice — the STMT form would otherwise consume
// just `localparam` and then trip on `pkg::T`'s `::`.
LOCALPARAM_DECL_USERTYPE_STMT: sequence dict {
  'localparam':@:type="localparam_usertype" space,
  sv_qualified_type:type_spec=@ space,
  ?<PACKED_DIMENSIONS>:range=@ space,
  sv_identifier:name=@ space,
  ?<UNPACKED_DIMENSIONS>:unpacked=@,
  "=" space, <EXPR>:value=@,
  ";"
}

// ─── Continuous assignment ──────────────────────────────────────────────

// Continuous assign — optionally carries a `(drive0, drive1)` /
// `(strong0, weak1)` drive-strength tuple (IEEE 1800-2017 §28).
//   assign (pull0, pull1) pins[i] = expr;
// Body captured as raw text so the parser doesn't need to enumerate
// the strength keyword set.
CONT_ASSIGN: sequence dict {
  'assign':@:type="cont_assign" space,
  ?<DRIVE_STRENGTH>:strength=@ space,
  ?<DELAY>:delay=@ space,
  repeat+ <ASSIGNMENT_PAIR>:assignments[]=@ separator "," space,
  ";"
}

DRIVE_STRENGTH: sequence dict {
  "(", *:text=@, ")"
}

ASSIGNMENT_PAIR: sequence dict {
  <LVALUE>:lhs=@ space, "=" space, <EXPR>:rhs=@
}

// Per IEEE 1800-2017 `variable_lvalue` (also `net_lvalue` and
// `streaming_concatenation` reach here): either a plain hier-selector
// chain (`this.x.field[3:0]`) or a concatenation of lvalues
// (`{a, b[1], c.f}`). The concatenation form is recursive — each
// element is itself an LVALUE, so `{a, {b, c}, d}` works.
//
// Reference: Verilator verilog.y `variable_lvalue` production
// (IEEE: variable_lvalue or net_lvalue).
LVALUE: choice {
  <LVALUE_STREAM>,
  <LVALUE_ASSIGN_PATTERN>,
  <LVALUE_CONCAT>,
  <LVALUE_PLAIN>
}

// `'{ lv, lv, … } = rhs` — an assignment pattern as the LHS of an
// assignment (§10.2.2), unpacking the rhs into several lvalues.
LVALUE_ASSIGN_PATTERN: sequence dict {
  "'{":type="lvalue_pattern",
  repeat <LVALUE>:elements[]=@ separator "," space,
  "}"
}

// `{<<{a, b, c}} = data;` — streaming concatenation on the LHS of
// an assignment (IEEE 1800-2017 §11.4.14.3). The body shape mirrors
// STREAMING_CONCAT but lives here so an ASSIGN_STMT's LHS can hold
// the unpacking form. Body captured raw; host re-parses if it needs
// per-element structure.
LVALUE_STREAM: sequence dict {
  "{":type="lvalue_stream",
  <STREAM_DIR>:direction=@,
  ?<STREAM_SLICE>:slice=@,
  "{",
  repeat+ <LVALUE>:items[]=@ separator ",",
  "}",
  "}"
}

LVALUE_PLAIN: sequence dict {
  <LVALUE_HEAD>:name=@,
  repeat <HIER_PART>:path[]=@,
  ?<RANGE_OR_INDEX>:select=@
}

LVALUE_CONCAT: sequence dict {
  "{":type="lvalue_concat",
  repeat+ <LVALUE>:elements[]=@ separator ",",
  "}"
}

// LVALUE head accepts `this`, `super`, plain identifier, or a
// package-qualified name. Supports `this.x = ...`, `obj.field =
// ...`, `pkg::sym = ...` on the LHS of an assignment.
LVALUE_HEAD: choice {
  <THIS_KW>,
  <SUPER_KW>,
  sv_identifier
}

THIS_KW:  sequence { 'this':@ }
SUPER_KW: sequence { 'super':@ }

// `[N]` (bit-select), `[N:M]` (part-select), or `[base +: width]` /
// `[base -: width]` (indexed part-select, IEEE 1800-2017 §11.5.1).
// RANGE first (msb : lsb), then the indexed forms (+: / -:), then
// the bare bit-select fallback.
RANGE_OR_INDEX: choice {
  <RANGE>,
  <INDEXED_PART_SELECT>,
  <BIT_SELECT>
}

BIT_SELECT: sequence dict {
  "[", <EXPR>:index=@, "]"
}

INDEXED_PART_SELECT: sequence dict {
  "[", <EXPR>:base=@,
  choice { "+:":type="indexed_plus", "-:":type="indexed_minus" },
  <EXPR>:width=@,
  "]"
}

DELAY: sequence dict {
  "#",
  <EXPR>:value=@
}

// ─── Always / initial / final ───────────────────────────────────────────

ALWAYS_BLOCK: sequence dict {
  <ALWAYS_KEYWORD>:kind=@:type="always" space,
  ?<EVENT_CONTROL>:sensitivity=@ space,
  <STATEMENT>:body=@
}

// SV adds `always_ff`, `always_comb`, `always_latch` with intended
// behavior hints that synthesis tools enforce; treat them like
// `always` with a kind discriminator.
ALWAYS_KEYWORD: choice {
  'always_ff':@,    'always_comb':@,
  'always_latch':@, 'always':@
}

INITIAL_BLOCK: sequence dict {
  'initial':@:type="initial" space,
  <STATEMENT>:body=@
}

FINAL_BLOCK: sequence dict {
  'final':@:type="final" space,
  <STATEMENT>:body=@
}

// ─── Event control ──────────────────────────────────────────────────────

// Per IEEE 1800-2017 `event_control` production. Forms:
//   @*                                  — implicit always-comb-style
//   @(*)                                — same, parenthesised
//   @(event_expression)                 — explicit sensitivity list
//   @hierarchical_event_identifier      — clocking-block ref / named event
//                                         (`@cb`, `@my_event`)
//
// The hier-event-identifier form is dispatched on first-byte =
// identifier-start, disjoint from `*`/`(`. Reference: Verilator
// verilog.y `event_control` (line ~3366, `@ senitemVar` alt).
EVENT_CONTROL: sequence dict {
  "@",
  choice {
    sequence { "*":wildcard=true },
    sequence { "(", "*":wildcard=true, ")" },
    sequence { "(", <EVENT_EXPR>:events=@, ")" },
    sequence { sv_identifier:event_id=@, repeat <HIER_PART>:path[]=@ }
  }
}

EVENT_EXPR: sequence array {
  repeat+ <EVENT_PRIMARY> separator <EVENT_SEP>
}

EVENT_PRIMARY: sequence dict {
  ?<EDGE>:edge=@ space,
  <EXPR>:signal=@,
  ?<EVENT_IFF>:iff=@
}

// `iff <expr>` — event-gating predicate. Per SV-1800: the event
// fires only when expr evaluates true.
EVENT_IFF: sequence dict { 'iff':@, <EXPR>:cond=@ }

EDGE: choice { 'posedge':@, 'negedge':@, 'edge':@ }

EVENT_SEP: choice {
  ",":@ space,
  <EVENT_SEP_OR>
}

// `or` event separator wants a space on BOTH sides (`clk_i or rst_n`);
// the leading space comes from the `"" space` empty-key prefix.
EVENT_SEP_OR: sequence { "" space, 'or':@ space }

// ─── Module instantiation ───────────────────────────────────────────────

// Gate-level primitive instantiation — IEEE 1800-2017 §28. The gate type
// is a reserved keyword (so this can't shadow a real module instance), the
// instance name is OPTIONAL (`buf (Y, A);` and `nand g1 (Y, A, B);` are both
// valid), and terminals are positional expressions — output(s) first, then
// inputs; an input may be any expression (e.g. `~POCB`). Tried before
// MODULE_INSTANTIATION, which would otherwise read the gate keyword as a
// module type and then require an instance name. Drive strength / delay
// (`buf (strong1, weak0) #2 (...)`) are not yet handled — rare in practice.
GATE_INSTANTIATION: sequence dict {
  <GATE_TYPE>:gate=@:type="gate" space,
  repeat+ <GATE_INSTANCE>:instances[]=@ separator "," space,
  ";"
}

GATE_TYPE: choice {
  'nand':@, 'nor':@, 'and':@, 'or':@, 'xnor':@, 'xor':@,
  'bufif0':@, 'bufif1':@, 'buf':@, 'notif0':@, 'notif1':@, 'not':@,
  'rnmos':@, 'rpmos':@, 'rcmos':@, 'nmos':@, 'pmos':@, 'cmos':@,
  'rtranif0':@, 'rtranif1':@, 'tranif0':@, 'tranif1':@, 'rtran':@, 'tran':@,
  'pulldown':@, 'pullup':@
}

// `[name] ( terminal {, terminal} )` — the instance name is optional;
// terminals are positional expressions.
GATE_INSTANCE: sequence dict {
  ?sv_identifier:name=@ space,
  "(", repeat+ <EXPR>:terminals[]=@ separator "," space, ")"
}

// Structural keywords that can never be a module name in instantiation
// position. Without this guard, `begin `A(x,clk); end` misparses as an
// instantiation of a module literally named `begin` (with the macro as
// the instance) whenever the block alternative is still in play — seen
// on reparse of saved macro statements inside generate-if blocks.
RESERVED_NOT_INSTANCE: choice {
  'begin', 'end', 'else',
  'endmodule', 'endinterface', 'endpackage', 'endgenerate',
  'endcase', 'endtask', 'endfunction'
}

MODULE_INSTANTIATION: sequence dict {
  !<RESERVED_NOT_INSTANCE>,
  <IDENT_OR_MACRO>:module_name=@:type="instance" space,
  ?<PARAM_OVERRIDE>:params=@ space,
  repeat+ <INSTANCE>:instances[]=@ separator "," space,
  ";"
}

PARAM_OVERRIDE: sequence dict {
  "#", "(",
  repeat+ <PARAM_BINDING>:bindings[]=@ separator ",",
  ")"
}

PARAM_BINDING: choice {
  <PARAM_BINDING_NAMED>,
  <PARAM_BINDING_VIRTUAL>,
  <PARAM_BINDING_TYPE_SIGNED>,
  <PARAM_BINDING_POSITIONAL>
}

// `#(int unsigned)` / `#(bit signed)` — a built-in type WITH a signing
// keyword as a parameter value (UVM `uvm_resource#(int unsigned)`). The
// two-keyword form isn't an EXPR; the required signing keyword keeps it
// from shadowing the plain-type EXPR positional form (`#(int)`).
PARAM_BINDING_TYPE_SIGNED: sequence dict {
  <TYPE_SPEC>:type_spec=@:type="param_type_signed" space,
  <SIGNING_KW>:signing=@,
  ?<PACKED_DIMENSIONS>:range=@
}

// `#(virtual ifc)` / `#(virtual interface ifc)` — a virtual-interface
// type passed as a parameter value (UVM `uvm_config_db#(virtual clk_if)`).
// Not an EXPR, so it needs its own positional alternative ahead of the
// generic EXPR form.
PARAM_BINDING_VIRTUAL: sequence dict {
  'virtual':is_virtual=true space,
  ?'interface':is_interface=true space,
  sv_qualified_type:vtype=@:type="param_virtual_type"
}

PARAM_BINDING_NAMED: sequence dict {
  ".", sv_identifier:name=@:style="named",
  "(", ?<EXPR>:value=@, ")"
}

PARAM_BINDING_POSITIONAL: sequence dict {
  <EXPR>:value=@:style="positional"
}

INSTANCE: sequence dict {
  <IDENT_OR_MACRO>:name=@ space,
  ?<UNPACKED_DIMENSIONS>:array=@,
  "(" newline,
  repeat <PORT_BINDING>:port_bindings[]=@ indent tab separator "," newline,
  "" newline, "" tab, ")"
}

// Order matters: PORT_BINDING_NAMED (`.name(expr)`) tried before
// PORT_BINDING_IMPLICIT (`.name` — same-name shorthand, SV-1800
// §23.3.3.4) because the implicit form is a prefix of the named
// form. PORT_BINDING_WILDCARD handles `.*` (connect-all-by-name).
PORT_BINDING: choice {
  <PORT_BINDING_WILDCARD>,
  <PORT_BINDING_NAMED>,
  <PORT_BINDING_IMPLICIT>,
  <PORT_BINDING_POSITIONAL>
}

PORT_BINDING_NAMED: sequence dict {
  ".", sv_identifier:port=@:style="named",
  "(", ?<EXPR>:signal=@, ")"
}

// `.name` — shorthand for `.name(name)`. Common in testbench
// instantiations where the local wire matches the port name.
PORT_BINDING_IMPLICIT: sequence dict {
  ".", sv_identifier:port=@:style="implicit"
}

// `.*` — connect all remaining ports by name. SV-1800 §23.3.3.5.
PORT_BINDING_WILDCARD: sequence dict {
  ".", "*":style="wildcard"
}

PORT_BINDING_POSITIONAL: sequence dict {
  <EXPR>:signal=@:style="positional"
}

// ─── Generate ───────────────────────────────────────────────────────────

GENERATE_BLOCK: sequence dict {
  'generate':@:type="generate" newline,
  repeat <GENERATE_ITEM>:items[]=@ indent tab newline,
  "" tab, 'endgenerate' space
}

GENERATE_ITEM: choice {
  <GENVAR_DECL>,
  <GEN_FOR>,
  <GEN_IF>,
  <GEN_CASE>,
  <GEN_NAMED_BLOCK>,
  <MODULE_ITEM>
}

GENVAR_DECL: sequence dict {
  'genvar':@:type="genvar" space,
  repeat+ sv_identifier:names[]=@ separator "," space,
  ";"
}

GEN_FOR: sequence dict {
  'for':@:type="gen_for",
  "(",
  <FOR_INIT>:init=@, ";",
  <EXPR>:cond=@, ";",
  <FOR_STEP>:step=@,
  ")",
  <GEN_BLOCK>:body=@
}

GEN_IF: sequence dict {
  'if':@:type="gen_if",
  "(", <EXPR>:cond=@, ")",
  <GEN_BLOCK>:then=@,
  ?<GEN_ELSE>
}

// Non-container sub-rule; its `else` binding flows up to the caller's
// dict (the GEN_IF rule).
GEN_ELSE: sequence { 'else' space, <GEN_BLOCK>:else=@ }

GEN_CASE: sequence dict {
  'case':@:type="gen_case",
  "(", <EXPR>:selector=@, ")",
  repeat+ <GEN_CASE_ITEM>:items[]=@,
  'endcase'
}

GEN_CASE_ITEM: sequence dict {
  choice {
    sequence { 'default':default=true, ?":" },
    sequence {
      repeat+ <EXPR>:labels[]=@ separator ",",
      ":"
    }
  },
  <GEN_BLOCK>:body=@
}

// A generate block — either a labelled begin/end group or a single
// generate item (a single module item, typically an instantiation).
GEN_BLOCK: choice {
  <GEN_NAMED_BLOCK>,
  <MODULE_ITEM>
}

GEN_NAMED_BLOCK: sequence dict {
  'begin':@:type="gen_block" space, ?<BLOCK_LABEL>,
  "" newline,
  repeat <GENERATE_ITEM>:items[]=@ indent tab newline,
  "" tab, 'end':@ space,
  ?<END_LABEL>:end_label=@
}

// ─── Tasks and functions ────────────────────────────────────────────────

TASK_DECL: sequence dict {
  'task':@:type="task" space,
  ?<LIFETIME>:lifetime=@ space,
  sv_qualified_type:name=@,
  ?<TASK_PORT_LIST>:ports=@,
  ";" newline,
  repeat <TASK_ITEM>:items[]=@ indent tab newline,
  "" tab, 'endtask' space,
  ?<END_LABEL>:end_label=@
}

// `function [<LIFETIME>] [<RETURN_TYPE>] NAME (<args>) ; <body>
// endfunction`. The choice between "has return type" and "no return
// type" is what PEG's `?<FUNCTION_RETURN>` couldn't decide: a bare
// `function f()` would have FUNCTION_RETURN_TYPED eagerly consume
// `f` as the return type, leaving no identifier for the name. The
// split FUNCTION_TYPED_HEAD / FUNCTION_UNTYPED_HEAD lets PEG try
// "two identifiers in a row" first, falling back to "one identifier"
// if FUNCTION_TYPED_HEAD fails (sv_qualified_type+name match leaves
// no name remaining).
FUNCTION_DECL: sequence dict {
  'function':@:type="function" space,
  ?<LIFETIME>:lifetime=@ space,
  <FUNCTION_HEAD>,
  ?<TASK_PORT_LIST>:ports=@,
  ";" newline,
  repeat <TASK_ITEM>:items[]=@ indent tab newline,
  "" tab, 'endfunction' space,
  ?<END_LABEL>:end_label=@
}

FUNCTION_HEAD: choice {
  <FUNCTION_TYPED_HEAD>,
  <FUNCTION_UNTYPED_HEAD>
}

// Name slot is `sv_qualified_type` so out-of-class definitions
// like `function int A::foo();` (IEEE 1800-2017 §8.24) accept the
// `Class::method` form. `sv_qualified_type` matches the bare name
// too, so in-class / module-scope functions keep working.
FUNCTION_TYPED_HEAD: sequence {
  <FUNCTION_RETURN>:return_type=@ space,
  sv_qualified_type:name=@
}

FUNCTION_UNTYPED_HEAD: sequence {
  sv_qualified_type:name=@
}

LIFETIME: choice { 'automatic':@, 'static':@ }

// SV LRM allows several function return forms — all captured by
// one sequence dict with each slot optional. At least one of
// type_spec or range must match for FUNCTION_RETURN to commit (the
// caller's `?<FUNCTION_RETURN>` handles the "no return type" case
// like `function NAME();`).
//
//   function int NAME              → type_spec="int"
//   function int unsigned NAME     → type_spec="int", signing="unsigned"
//   function [7:0] NAME            → range
//   function logic [7:0] NAME      → type_spec="logic", range
//   function pkg::Type NAME        → type_spec="pkg::Type" via sv_qualified_type
//
// Order: type_spec tried first (via sv_qualified_type which matches
// bare or `pkg::`-qualified identifiers); if absent, RANGE_ONLY
// catches the range-without-type form.
FUNCTION_RETURN: choice {
  <FUNCTION_RETURN_TYPED>,
  <FUNCTION_RETURN_RANGED>
}

FUNCTION_RETURN_TYPED: sequence dict {
  sv_qualified_type:type_spec=@:type="function_return" space,
  ?<SIGNING_KW>:signing=@ space,
  ?<PACKED_DIMENSIONS>:range=@
}

FUNCTION_RETURN_RANGED: sequence dict {
  <RANGE>:range=@:type="function_return_ranged",
  ?<NET_SIGNING>:signing=@
}

TASK_PORT_LIST: sequence dict {
  "(",
  repeat <TASK_PORT>:ports[]=@ separator ",",
  ")"
}

// Task/function port. SV-1800 §13.4.2 permits ports typed by either
// a built-in keyword (logic, int, …) OR a user-defined type
// (typedef'd name, optionally pkg-qualified). The user-typed form is
// tried first so `sail_bits x` (user type + name) doesn't fall
// through to TASK_PORT's "no type, just name" interpretation that
// then expects `,` or `)` immediately — surfacing as the deepest
// "expected literal ','" error in the cluster analysis.
//
// Reference: Verilator verilog.y `tf_port_item` / `taskRef` rules.
// BUILTIN is tried first so a port like `int unsigned num_cycles`
// commits to TYPE_SPEC=`int` + SIGNING=`unsigned` + name=`num_cycles`.
// Otherwise USERTYPED's `sv_qualified_type:type_spec, sv_identifier:name`
// would greedily eat `int` as the type and `unsigned` as the name,
// leaving `num_cycles` as stray content. Made TYPE_SPEC required
// here so the rule fails on user types and USERTYPED catches them.
// TASK_PORT_IMPLICIT — function/task port with explicit direction
// but no type. IEEE 1800-2017 §13.4.2: when a port omits its type,
// the type defaults to the previous port's type (or `logic` for
// the first port). Pure parse: captured as `direction + name`; the
// host can resolve the implicit type from preceding ports if needed.
//
// Direction REQUIRED so this rule can't claim plain `name = value`
// declarations that would actually be TASK_PORT_USERTYPED with a
// user-defined leading type identifier.
TASK_PORT: choice {
  <TASK_PORT_BUILTIN>,
  <TASK_PORT_USERTYPED>,
  <TASK_PORT_IMPLICIT>,
  <TASK_PORT_RANGE_ONLY>
}

// `[1:0] a` — no direction, no type keyword, just a packed range + name
// (implicit type/direction, §13.4.2). e.g. `function void f([1:0] a);`.
// Range REQUIRED so it can't claim a bare `name`.
TASK_PORT_RANGE_ONLY: sequence dict {
  <PACKED_DIMENSIONS>:range=@:type="task_port" space,
  sv_identifier:name=@,
  ?<UNPACKED_DIMENSIONS>:unpacked=@,
  ?<TASK_PORT_INIT>:init=@
}

// `input name` OR `input [31:0] name` — explicit direction, implicit
// type (defaults per §13.4.2), with an optional packed range. Verilog
// cores write ranged ports without a type keyword: `input [31:0] dummy`.
TASK_PORT_IMPLICIT: sequence dict {
  <PORT_DIRECTION>:direction=@ space,
  ?<PACKED_DIMENSIONS>:range=@ space,
  sv_identifier:name=@,
  ?<UNPACKED_DIMENSIONS>:unpacked=@,
  ?<TASK_PORT_INIT>:init=@
}

TASK_PORT_BUILTIN: sequence dict {
  ?<PORT_DIRECTION>:direction=@ space,
  <TYPE_SPEC>:type_spec=@ space,
  ?<SIGNING_KW>:signing=@ space,
  ?<PACKED_DIMENSIONS>:range=@ space,
  sv_identifier:name=@,
  ?<UNPACKED_DIMENSIONS>:unpacked=@,
  ?<TASK_PORT_INIT>:init=@
}

TASK_PORT_INIT: sequence dict { "=" space, <EXPR>:value=@ }

TASK_PORT_USERTYPED: sequence dict {
  ?<PORT_DIRECTION>:direction=@ space,
  sv_qualified_type:type_spec=@ space,
  ?<PARAM_OVERRIDE>:type_params=@ space,
  ?<PACKED_DIMENSIONS>:range=@ space,
  sv_identifier:name=@,
  ?<UNPACKED_DIMENSIONS>:unpacked=@,
  ?<TASK_PORT_INIT>:init=@
}

// Inside function/task bodies — same as BLOCK_ITEM but adds
// MACRO_STMT and USER_TYPED_DECL so user-typed locals and
// UVM-style macro calls aren't rejected. STATEMENT alternatives
// (assignments, if/case/while) come last so a leading identifier
// has every chance to match a declaration first.
TASK_ITEM: choice {
  <VIRTUAL_INTERFACE_DECL>,
  <TYPEDEF_DECL>,
  <LOCALPARAM_DECL_TYPE_STMT>,
  <LOCALPARAM_DECL_USERTYPE_STMT>,
  <LOCALPARAM_DECL_STMT>,
  <PORT_DECL_STMT>,
  <PORT_DECL_STMT_USERTYPE>,
  <NET_DECL>,
  <NET_DECL_USERTYPE>,
  <REG_DECL>,
  <INTEGER_DECL>,
  <USER_TYPED_DECL>,
  <MACRO_STMT>,
  <STATEMENT>
}

// ─── Statements ─────────────────────────────────────────────────────────

STATEMENT: choice {
  <DEFINE>,
  <UNDEF>,
  <INCLUDE>,
  <IFDEF>,
  <IFNDEF>,
  <ATTRIBUTED_STMT>,
  <MACRO_STMT>,
  <BLOCK_STMT>,
  <FORK_JOIN>,
  <IF_STMT>,
  <CASE_STMT>,
  <FOR_STMT>,
  <FOREACH_STMT>,
  <WHILE_STMT>,
  <DO_WHILE_STMT>,
  <REPEAT_STMT>,
  <FOREVER_STMT>,
  <RANDSEQUENCE_STMT>,
  <WAIT_FORK_STMT>,
  <DISABLE_FORK_STMT>,
  <CONCURRENT_ASSERT>,
  <IMMEDIATE_ASSERT>,
  <RETURN_STMT>,
  <BREAK_STMT>,
  <CONTINUE_STMT>,
  <LOCAL_VAR_DECL>,
  <INC_DEC_STMT>,
  <ASSIGN_STMT>,
  <PROC_CONT_ASSIGN>,
  <FORCE_STMT>,
  <RELEASE_STMT>,
  <PARAM_STATIC_CALL_STMT>,
  <SYSTEM_TASK_CALL>,
  <VOID_CAST_STMT>,
  <METHOD_CALL_STMT>,
  <TASK_CALL>,
  <DISABLE_STMT>,
  <WAIT_STMT>,
  <DELAY_OR_EVENT_STMT>,
  <EVENT_TRIGGER_STMT>,
  <LABELED_STMT>,
  <NULL_STMT>
}

// `label : <statement>` — a statement label prefix (IEEE 1800-2017
// §9.3.5), e.g. `my_blk: begin … end`. Tried LATE so the assert forms
// keep using their own ASSERTION_LABEL and normal statements aren't
// shadowed; only a bare `identifier :` lands here. `!<SV_RESERVED>` keeps
// keywords (`begin`, `end`, …) from being read as labels.
LABELED_STMT: sequence dict {
  !<SV_RESERVED>,
  sv_identifier:label=@:type="labeled_stmt", ":" space,
  <STATEMENT>:stmt=@
}

// `-> event;` / `->> #N event;` — event trigger statement
// (IEEE 1800-2017 §15.5). Blocking (`->`) and non-blocking (`->>`)
// forms; capture the hierarchical reference as opaque text up to
// the terminating `;`.
EVENT_TRIGGER_STMT: sequence dict {
  choice { "->>":type="event_nonblocking", "->":type="event_blocking" },
  <HIER_REF>:event=@,
  ";"
}

// `void'(expr);` — SV idiom for "call expr (typically a function)
// and discard its return value." Pure statement form (the
// expression-context `void'(...)` cast is already handled by
// TYPE_CAST_IDENT). Tried in STATEMENT before METHOD_CALL_STMT /
// TASK_CALL so the leading `void` keyword wins over those eager
// identifier-shaped alternatives.
VOID_CAST_STMT: sequence dict {
  'void':type="void_cast_stmt",
  "'",
  "(", <EXPR>:value=@, ")",
  ";"
}

// Local variable declaration inside a procedural block (begin/end
// block, function body, task body). Supports both built-in types
// (TYPE_SPEC) and user-typed names. Tried BEFORE ASSIGN_STMT so
// `int x = 5;` and `Driver drv;` parse as declarations.
//
// To prevent claiming things that aren't declarations (e.g. plain
// `a = b;` where `a` would be matched as a user-type and `b` as
// the variable), require a `;` (no init) OR `=<EXPR>;` after the
// variable name. Plain `a` followed by `=` is then claimed as
// ASSIGN_STMT instead.
LOCAL_VAR_DECL: choice {
  <LOCAL_VAR_DECL_BUILTIN>,
  <LOCAL_VAR_DECL_USER>
}

LOCAL_VAR_DECL_BUILTIN: sequence dict {
  ?<LIFETIME>:lifetime=@,
  <TYPE_SPEC>:type_spec=@:type="local_var_decl",
  ?<SIGNING_KW>:signing=@,
  ?<PACKED_DIMENSIONS>:range=@,
  sv_identifier:name=@,
  ?<UNPACKED_DIMENSIONS>:unpacked=@,
  ?<LOCAL_VAR_INIT>:init=@,
  ";"
}

// User-typed local: `<typedef'd_name> <var>;` — needs TWO
// identifiers (type + name) and trailing `;`/`=`/`<-`. With the
// engine's Repeat per-iteration mark fix, a Choice alternative
// that consumes one or two identifiers and then fails on the
// trailing `;` rolls back cleanly.
//
// `!<SV_RESERVED>` guard at the head: this rule's `<id> <id>`
// shape happily matches `end p = q;` (with `end` consumed as a
// "user type"), so without the guard a `begin … end` block's
// repeat-over-BLOCK_ITEM would consume the closing `end` instead
// of bailing out. See SV_RESERVED comment above.
LOCAL_VAR_DECL_USER: sequence dict {
  ?<LIFETIME>:lifetime=@,
  !<SV_RESERVED>,
  sv_identifier:type_spec=@:type="local_var_decl_user",
  sv_identifier:name=@,
  ?<RANGE>:unpacked=@,
  ?<LOCAL_VAR_INIT>:init=@,
  ";"
}

LOCAL_VAR_INIT: sequence dict { "" space, "=" space, <EXPR>:value=@ }

// Statement-position macro: `MY_ASSERT(req, gnt);`. Same form as a
// function call but with the `-prefix and an optional trailing `;`
// (some macros include the semicolon in their body, some don't).
MACRO_STMT: sequence dict {
  <MACRO_USE>:macro=@:type="macro_stmt",
  ?";"
}

NULL_STMT: sequence dict { ";":type="null_stmt" }

BLOCK_STMT: sequence dict {
  'begin':@:type="block" space,
  ?<BLOCK_LABEL>,
  "" newline,
  repeat <BLOCK_ITEM>:items[]=@ indent tab newline,
  "" tab, 'end':@ space,
  ?<END_LABEL>:end_label=@
}

// Non-container; the `label` binding flows up to the parent dict.
BLOCK_LABEL: sequence { ":" space, sv_identifier:label=@ }

BLOCK_ITEM: choice {
  <VIRTUAL_INTERFACE_DECL>,
  <TYPEDEF_DECL>,
  <LOCALPARAM_DECL_TYPE_STMT>,
  <LOCALPARAM_DECL_USERTYPE_STMT>,
  <LOCALPARAM_DECL_STMT>,
  <NET_DECL>,
  <NET_DECL_USERTYPE>,
  <REG_DECL>,
  <INTEGER_DECL>,
  <USER_TYPED_DECL>,
  <STATEMENT>
}

IF_STMT: sequence dict {
  ?<UNIQUENESS>:uniqueness=@ space,
  'if':@:type="if" space,
  "(", <EXPR>:cond=@, ")" space,
  <STATEMENT>:then=@ space,
  ?<ELSE_CLAUSE>
}

// SV-1800 `unique` / `unique0` / `priority` modifier on if/case
// statements — enforces that exactly one (or at most one) branch
// matches. Pure parse: captured as a string; host enforces.
UNIQUENESS: choice { 'unique0':@, 'unique':@, 'priority':@ }

// Non-container sub-rule; its `else` binding flows up to the caller's
// dict (the IF_STMT rule).
ELSE_CLAUSE: sequence { 'else' space, <STATEMENT>:else=@ }

CASE_STMT: sequence dict {
  ?<UNIQUENESS>:uniqueness=@ space,
  <CASE_KIND>:kind=@:type="case" space,
  "(", <EXPR>:selector=@, ")" space,
  ?'inside':is_inside=true,
  "" newline,
  repeat+ <CASE_ITEM>:items[]=@ indent tab newline,
  "" tab, 'endcase' space
}

CASE_KIND: choice {
  'casex':@, 'casez':@, 'case':@
}

CASE_ITEM: sequence dict {
  choice {
    sequence { 'default':default=true, ?":" space },
    sequence {
      repeat+ <CASE_LABEL>:labels[]=@ separator ",",
      ":" space
    }
  },
  <STATEMENT>:body=@
}

// Case label: an expression OR a range (for `case ... inside`).
// Range form `[a:b]` is allowed by LRM in inside-case items.
CASE_LABEL: choice {
  <RANGE>,
  <EXPR>
}

FOR_STMT: sequence dict {
  'for':@:type="for" space,
  "(",
  <FOR_INIT_LIST>:init=@, ";" space,
  <EXPR>:cond=@, ";" space,
  <FOR_STEP_LIST>:step=@,
  ")" space,
  <STATEMENT>:body=@
}

// IEEE 1800-2017 §12.7.1 — multiple comma-separated initializers
// (`for (int i = 0, int j = 1; ...; ...)`) and step assignments
// (`for (...; ...; i += 1, j *= 2)`). Common in FSM iteration over
// enum types: `for (int i = 0, StateEnumT t = t.first(); ...; ...)`.
FOR_INIT_LIST: sequence array {
  repeat+ <FOR_INIT> separator ","
}

FOR_STEP_LIST: sequence array {
  repeat+ <FOR_STEP> separator ","
}

// For-loop init can be an assignment OR a declaration with init
// (`int i = 0`, `genvar i = 0`, or `Driver drv = new()`).
// Declaration forms tried first so `int i = 0` and `genvar i = 0`
// aren't mis-claimed as malformed assignments.
FOR_INIT: choice {
  <FOR_INIT_GENVAR>,
  <FOR_INIT_DECL>,
  <FOR_INIT_USERTYPE>,
  <ASSIGNMENT_PAIR>
}

// Second-and-later init clauses with user-type names — the inner
// `t` of `StateEnumT t = t.first()` is the variable, but the
// leading `StateEnumT` is a user-defined enum type. Distinguished
// from ASSIGNMENT_PAIR by requiring two identifiers + `=`.
FOR_INIT_USERTYPE: sequence dict {
  !<TYPE_SPEC>,
  sv_qualified_type:type_spec=@:type="for_init_usertype" space,
  sv_identifier:name=@,
  "=" space, <EXPR>:value=@
}

FOR_INIT_GENVAR: sequence dict {
  'genvar':@:type="for_init_genvar" space,
  sv_identifier:name=@ space,
  "=" space, <EXPR>:value=@
}

FOR_INIT_DECL: sequence dict {
  <TYPE_SPEC>:type_spec=@:type="for_init_decl" space,
  ?<SIGNING_KW>:signing=@ space,
  ?<PACKED_DIMENSIONS>:range=@ space,
  sv_identifier:name=@ space,
  "=" space, <EXPR>:value=@
}

// For-loop step per IEEE 1800-2017 genvar_iteration / for_variable_assignment:
// `i = expr` | `i op= expr` (compound) | `i++` | `++i` | `i--` | `--i`.
// Compound `op=` tried BEFORE plain `=` so `i += 1` doesn't get
// half-parsed by ASSIGNMENT_PAIR which only knows `=`.
//
// Reference: Verilator verilog.y `genvar_iteration` (IEEE: genvar_iteration).
FOR_STEP: choice {
  <FOR_STEP_COMPOUND>,
  <ASSIGNMENT_PAIR>,
  <FOR_STEP_INCDEC>,
  <FOR_STEP_PRE_INCDEC>
}

FOR_STEP_COMPOUND: sequence dict {
  <LVALUE>:lhs=@ space,
  <ASSIGN_OP>:type=@ space,
  <EXPR>:rhs=@
}

FOR_STEP_INCDEC: sequence dict {
  <LVALUE>:lhs=@:type="for_step_incdec",
  <INC_DEC_OP>:op=@
}

FOR_STEP_PRE_INCDEC: sequence dict {
  <INC_DEC_OP>:op=@:type="for_step_pre_incdec",
  <LVALUE>:lhs=@
}

INC_DEC_OP: choice { "++":@, "--":@ }

// `x++;` / `++x;` / `x--;` / `--x;` — increment/decrement as a
// statement (IEEE 1800-2017 §11.4.2). Post-form (lhs then op) tried
// before pre-form so `x++` doesn't fall through to `++x` after the
// LVALUE failed to match a leading `++`. Both forms require `;`.
INC_DEC_STMT: choice {
  <INC_DEC_STMT_POST>,
  <INC_DEC_STMT_PRE>
}

INC_DEC_STMT_POST: sequence dict {
  <LVALUE>:lhs=@:type="inc_dec_stmt_post",
  <INC_DEC_OP>:op=@,
  ";"
}

INC_DEC_STMT_PRE: sequence dict {
  <INC_DEC_OP>:op=@:type="inc_dec_stmt_pre",
  <LVALUE>:lhs=@,
  ";"
}

WHILE_STMT: sequence dict {
  'while':@:type="while" space,
  "(", <EXPR>:cond=@, ")" space,
  <STATEMENT>:body=@
}

REPEAT_STMT: sequence dict {
  'repeat':@:type="repeat",
  "(", <EXPR>:count=@, ")",
  <STATEMENT>:body=@
}

FOREVER_STMT: sequence dict {
  'forever':@:type="forever" space,
  <STATEMENT>:body=@
}

// Single rule covering both blocking (`=`) and non-blocking (`<=`)
// assignments. Combining them avoids re-parsing LVALUE when the
// engine falls through from one alt to the other in the STATEMENT
// Choice (the shared-leading-ref lint catches this).
ASSIGN_STMT: sequence dict {
  <LVALUE>:lhs=@ space,
  <ASSIGN_OP>:type=@ space,
  ?<DELAY_OR_EVENT>:delay=@ space,
  <EXPR>:rhs=@,
  ";"
}

// Longest-first so `<=` wins over `<` and `=` is checked last.
// Compound assignment forms (`+=`, `-=`, `*=`, `/=`, `%=`, `&=`,
// `|=`, `^=`, `<<=`, `>>=`, `<<<=`, `>>>=`) are SV-1800 extensions
// to the original Verilog blocking/nonblocking pair. All emit
// `assign_compound` with the operator preserved in the type slot
// (host can dispatch on the type value).
ASSIGN_OP: choice {
  "<<<=":"assign_shl_arith",
  ">>>=":"assign_shr_arith",
  "<<=":"assign_shl",
  ">>=":"assign_shr",
  "+=":"assign_add",
  "-=":"assign_sub",
  "*=":"assign_mul",
  "/=":"assign_div",
  "%=":"assign_mod",
  "&=":"assign_and",
  "|=":"assign_or",
  "^=":"assign_xor",
  "<=":"nonblocking_assign",
  "=":"blocking_assign"
}

PROC_CONT_ASSIGN: sequence dict {
  'assign':@ space, <LVALUE>:lhs=@ space, "=" space, <EXPR>:rhs=@, ";":type="proc_assign"
}

// `force lhs = rhs;` / `release lhs;` — procedural continuous
// assignment overrides (IEEE 1800-2017 §10.6.2). force takes an
// LVALUE on the left and an expression on the right; release just
// names the signal whose forced value is being relinquished.
FORCE_STMT: sequence dict {
  'force':@:type="force" space,
  <LVALUE>:lhs=@ space, "=" space, <EXPR>:rhs=@, ";"
}

RELEASE_STMT: sequence dict {
  'release':@:type="release" space,
  <LVALUE>:lhs=@, ";"
}

DELAY_OR_EVENT: choice { <DELAY>, <EVENT_CONTROL> }

// `@(<event>) <stmt>` / `#<delay> <stmt>` — procedural timing control.
// Split into two typed alternatives that each reference ONE leaf rule
// directly (not the shared DELAY_OR_EVENT choice). Binding the choice to
// a field made save ambiguous: DELAY and EVENT_CONTROL produce dicts with
// disjoint via-Ref fields (value vs events/wildcard/event_id) and neither
// carries a const discriminator, so the save dispatcher treated each as a
// catch-all for the other and emitted the wrong branch. With a direct
// leaf ref per alt, the control value is emitted by a single rule and the
// outer choice dispatches cleanly on `type`.
DELAY_OR_EVENT_STMT: choice {
  <EVENT_STMT>,
  <DELAY_STMT>
}

EVENT_STMT: sequence dict {
  <EVENT_CONTROL>:control=@:type="event_stmt" space,
  <STATEMENT>:body=@
}

DELAY_STMT: sequence dict {
  <DELAY>:control=@:type="delay_stmt" space,
  <STATEMENT>:body=@
}

// `$display(...)`, `$finish`, `$strobe(...)`, etc. The leading
// identifier always starts with `$` (sv_identifier returns it with
// the `$` retained), so the grammar dispatches on the leading byte
// implicitly via Choice ordering.
SYSTEM_TASK_CALL: sequence dict {
  sv_system_name:name=@:type="system_task",
  ?<TASK_ARG_LIST>:args=@,
  ";"
}

// Regular task call: `[pkg::]task_name(args);` — identifier without
// `$`. Uses `sv_qualified_type` so package-qualified forms
// (`env_dpi::env_initial(...)`) match without a parallel rule.
// Optional arg list — per IEEE 1800-2017 §13.4, calling a task
// with no arguments may omit the parentheses entirely:
//   foo;          equivalent to foo();
TASK_CALL: sequence dict {
  // `!<SV_RESERVED>` so a stray `end;` inside a `begin … end` block
  // doesn't get matched as `task_call("end")` (which would consume
  // the block's closing `end` and break BLOCK_STMT's terminator
  // match). Same shape SV_RESERVED guard used in LOCAL_VAR_DECL_USER.
  !<SV_RESERVED>,
  sv_qualified_type:name=@:type="task_call",
  ?<TASK_ARG_LIST>:args=@,
  ?<WITH_CLAUSE>:with=@,
  repeat <DOT_CALL>:chain[]=@,
  ";"
}

// Per IEEE 1800-2017 §13.5.3, a function/task call accepts both
// positional and named argument bindings:
//   foo(a, b)             // positional
//   foo(.arg1(a), .arg2)  // named (.name(expr) or .name with default)
//   foo(.*)               // wildcard pass-through
// Named form tried first so a leading `.` doesn't fall through into
// the EXPR positional alt.
TASK_ARG_LIST: sequence dict {
  "(",
  repeat <TASK_ARG>:args[]=@ separator ",",
  ")"
}

TASK_ARG: choice {
  <TASK_ARG_NAMED>,
  <TASK_ARG_POSITIONAL>,
  <TASK_ARG_EMPTY>
}

// `f(a, , c)` — an omitted positional argument (IEEE 1800-2017 §13.5.3,
// the default-value slot). Matches the empty span between two commas;
// tried last so it only fires where no real argument is present.
TASK_ARG_EMPTY: sequence dict { "":type="empty_arg" }

TASK_ARG_NAMED: sequence dict {
  ".", sv_identifier:name=@:style="named",
  ?<TASK_ARG_NAMED_VALUE>
}

// Non-container: the `value` binding flows up into TASK_ARG_NAMED's
// dict directly (`{name, style, value}`) instead of nesting a second
// `{value: …}`. The previous `sequence dict` + `:value=@` double-nested
// as `value:{value:expr}`, and on save the inner `?<EXPR>:value=@`
// failed to emit — `.rlist(rlist)` round-tripped to `.rlist()`.
TASK_ARG_NAMED_VALUE: sequence {
  "(", ?<EXPR>:value=@, ")"
}

TASK_ARG_POSITIONAL: sequence dict {
  <EXPR>:value=@:style="positional"
}

DISABLE_STMT: sequence dict {
  'disable':@ space, sv_identifier:target=@, ";":type="disable"
}

WAIT_STMT: sequence dict {
  'wait':@, "(", <EXPR>:cond=@, ")":type="wait",
  <STATEMENT>:body=@
}

// ─── Expressions ────────────────────────────────────────────────────────
//
// 13 precedence levels, low to high:
//
//   EXPR             conditional (ternary)
//   LOR              || logical or
//   LAND             && logical and
//   BOR              |  bitwise or
//   BXOR             ^  bitwise xor (~^, ^~)
//   BAND             &  bitwise and
//   EQUALITY         == != === !== ==? !=?
//   RELATIONAL       <  <= >  >=  inside (out of scope)
//   SHIFT            << >> <<< >>>
//   ADD              +  -
//   MUL              *  /  %
//   POWER            **
//   UNARY            + - ! ~ & | ^ ~& ~| ~^ ^~
//   PRIMARY
//
// For each level, the right-hand alternative is the pass-through (the
// next-higher-precedence level), which is what the engine picks when
// no operator is found at this level.
//
// Math chains (+/-, */// %, shifts) at 3+ operands need parens — see
// the design-choice comment at the top of this file. The grammar
// emits `{op, args:[lhs, rhs]}` only for exactly two operands.

// Each precedence level uses the `choice { CHAIN, NEXT }` always-wrap
// pattern. CHAIN matches an always-wrap
// `{lhs, tail:[…]}` shape with at least one tail entry (`repeat+`);
// a bare atom falls through to <NEXT> with no wrapper. The top of the
// binary chain is tagged `#opchain`, so the engine post-parse compacts
// the nested `{lhs, tail:[…]}` into `{op, args:[…]}` with same-op
// collapse. Save reverses.
//
// Ternary `cond ? then : else` sits ABOVE the binary chain — it's a
// 3-way shape, not a binary op, and `#opchain` only compacts binary
// chains. Top EXPR rule is a choice over TERNARY and the binary chain.

// Top of the EXPR ladder. Implication `->` / equivalence `<->`
// (IEEE 1800-2017 §11.4.7) sit at the LOWEST precedence — below
// ternary `?:`. IMPL_CHAIN absorbs `->` tails; underneath it,
// COND_EXPR picks between the ternary form and the plain binary
// cascade.
//
// The two alternatives at the EXPR level (IMPL_CHAIN and COND_EXPR)
// SHARE COND_EXPR as the leading sub-rule. When IMPL_CHAIN's lhs
// matches a COND_EXPR but no `->` tail follows, the sequence-success
// cache holds the COND_EXPR entry. EXPR's second alt then re-pushes
// COND_EXPR at the same offset and hits the cache directly —
// avoiding a full BIN_EXPR cascade re-run.
//
// Earlier the second/third alts were TERNARY and BIN_EXPR (different
// NodeIds from IMPL_CHAIN's IMPL_OPND lhs) so the cache didn't help.
// Adding parens around a function call (`(s.len())`) blew up because
// each nested EXPR doubled the work. The new structure runs the
// cascade once per offset.
EXPR ignore whitespace line_comment block_comment: choice {
  <IMPL_CHAIN>,
  <COND_EXPR>
}

IMPL_CHAIN: sequence dict {
  <COND_EXPR>:lhs=@,
  repeat+ <IMPL_TAIL>:tail[]=@
}

IMPL_TAIL: sequence dict {
  choice { "<->":op="<->", "->":op="->" },
  <COND_EXPR>:rhs=@
}

COND_EXPR: choice { <TERNARY>, <BIN_EXPR> }

// Spaces around `?`/`:` on save: keep a `<based-number> ? …` ternary from
// gluing to `<based-number>?…`, where in binary/hex `?` is a valid
// don't-care digit and the lexer would greedily eat it (`1'b1?1:2`).
TERNARY: sequence dict {
  <BIN_EXPR>:cond=@ space,
  "?":op="?:" space,
  <EXPR>:then=@ space,
  ":" space,
  <EXPR>:else=@
}

// Top of the binary chain — `#opchain` annotation runs post-parse
// compaction.
BIN_EXPR: <LOR_EXPR>:#opchain

// Each cascade level is `sequence { NEXT:lhs=@, repeat <TAIL>:tail[]=@ }`
// rather than the older `choice { CHAIN, NEXT }`. The flatter shape
// avoids the catastrophic-backtracking blow-up the Choice pattern hit
// when an inner EXPR couldn't match (e.g. inside empty `()`): the
// Choice retries NEXT directly after CHAIN's NEXT failed, so every
// level doubled work on the failure path (10 levels → 2^10 = 1024×).
// The flat shape calls NEXT exactly once per level; the `repeat`
// (zero-or-more) absorbs operator runs but never re-invokes NEXT
// when there are none.
//
// `#opchain` (on BIN_EXPR) drives the post-parse compaction that folds
// these always-wrap `{lhs, tail}` levels into a flat `{op, args}` tree
// (empty no-operator levels collapse to their `lhs`). Save reconstructs
// the per-tier cascade via the cascade-aware expand (Grammar::
// opchain_ladder + rebuild_cascade in save_stack.cpp). Compaction fires
// for SV through has_any_opchain() even though BIN_EXPR sits below the
// source-text start rule.
LOR_EXPR: sequence dict {
  <LAND_EXPR>:lhs=@,
  repeat <LOR_TAIL>:tail[]=@
}
LOR_TAIL:  sequence dict { "" space, "||":op="||" space, <LAND_EXPR>:rhs=@ }

LAND_EXPR: sequence dict {
  <BOR_EXPR>:lhs=@,
  repeat <LAND_TAIL>:tail[]=@
}
LAND_TAIL:  sequence dict { "" space, "&&":op="&&" space, <BOR_EXPR>:rhs=@ }

BOR_EXPR: sequence dict {
  <BXOR_EXPR>:lhs=@,
  repeat <BOR_TAIL>:tail[]=@
}
// `!"||"` (the contiguous two-char literal) before `"|"` rejects only a
// glued `||` (logical-or, looser tier) — NOT a spaced `a | |b` where the
// second `|` is a unary reduction operand. A whitespace-skipping `!"|"`
// would wrongly reject `a | |b`.
BOR_TAIL:  sequence dict { !"||", "" space, "|":op="|" space, <BXOR_EXPR>:rhs=@ }

BXOR_EXPR: sequence dict {
  <BAND_EXPR>:lhs=@,
  repeat <BXOR_TAIL>:tail[]=@
}
BXOR_TAIL:  sequence dict { "" space, <BXOR_OP>:op=@ space, <BAND_EXPR>:rhs=@ }
BXOR_OP:    choice { "^~":@, "~^":@, "^":@ }

BAND_EXPR: sequence dict {
  <EQUALITY_EXPR>:lhs=@,
  repeat <BAND_TAIL>:tail[]=@
}
BAND_TAIL:  sequence dict { !"&&", "" space, "&":op="&" space, <EQUALITY_EXPR>:rhs=@ }

EQUALITY_EXPR: sequence dict {
  <RELATIONAL_EXPR>:lhs=@,
  repeat <EQUALITY_TAIL>:tail[]=@
}
EQUALITY_TAIL:  sequence dict { "" space, <EQUALITY_OP>:op=@ space, <RELATIONAL_EXPR>:rhs=@ }

// Longest-first so `===` wins over `==` and `!==` wins over `!=`.
EQUALITY_OP: choice {
  "===":@, "!==":@, "==?":@, "!=?":@, "==":@, "!=":@
}

RELATIONAL_EXPR: sequence dict {
  <SHIFT_EXPR>:lhs=@,
  repeat <RELATIONAL_OR_INSIDE_TAIL>:tail[]=@
}

RELATIONAL_OR_INSIDE_TAIL: choice {
  <RELATIONAL_TAIL>,
  <INSIDE_TAIL>
}

RELATIONAL_TAIL: sequence dict { "" space, <RELATIONAL_OP>:op=@ space, <SHIFT_EXPR>:rhs=@ }

// `inside { [1:10], 20, 30, ... }` — set membership. Body captured raw.
INSIDE_TAIL: sequence dict {
  "" space,
  'inside':op="inside" space,
  "{",
  repeat+ <INSIDE_ELEM>:elements[]=@ separator ",",
  "}"
}

// A `inside {...}` set element: a `[lo:hi]` range or a plain value
// expression (IEEE 1800-2017 §11.4.13). Range tried first.
INSIDE_ELEM: choice {
  <INSIDE_RANGE>,
  <EXPR>
}

INSIDE_RANGE: sequence dict {
  "[", <EXPR>:lo=@, ":", <EXPR>:hi=@, "]"
}

RELATIONAL_OP: choice {
  "<=":@, ">=":@, "<":@, ">":@
}

SHIFT_EXPR: sequence dict {
  <ADD_EXPR>:lhs=@,
  repeat <SHIFT_TAIL>:tail[]=@
}
SHIFT_TAIL:  sequence dict { "" space, <SHIFT_OP>:op=@ space, <ADD_EXPR>:rhs=@ }

// Arithmetic shifts (<<<, >>>) before logical so longer wins.
SHIFT_OP: choice {
  "<<<":@, ">>>":@, "<<":@, ">>":@
}

ADD_EXPR: sequence dict {
  <MUL_EXPR>:lhs=@,
  repeat <ADD_TAIL>:tail[]=@
}
ADD_TAIL:  sequence dict { "" space, <ADD_OP>:op=@ space, <MUL_EXPR>:rhs=@ }
ADD_OP:    choice { "+":@, "-":@ }

MUL_EXPR: sequence dict {
  <POWER_EXPR>:lhs=@,
  repeat <MUL_TAIL>:tail[]=@
}
MUL_TAIL:  sequence dict { "" space, <MUL_OP>:op=@ space, <POWER_EXPR>:rhs=@ }
MUL_OP:    choice { "*":@, "/":@, "%":@ }

// POWER is right-associative per SV LRM §11.4.4 — chain recurses on
// POWER_EXPR (right side), so `a ** b ** c` → `a ** (b**c)`.
POWER_EXPR:  choice { <POWER_CHAIN>, <UNARY_EXPR> }
POWER_CHAIN: sequence dict {
  <UNARY_EXPR>:lhs=@,
  "" space, "**":op="**" space,
  <POWER_EXPR>:rhs=@
}

UNARY_EXPR:    choice { <UNARY_OP_EXPR>, <PRIMARY> }
UNARY_OP_EXPR: sequence dict {
  <UNARY_OP>:op=@,
  <UNARY_EXPR>:args[]=@
}

UNARY_OP: choice {
  "~&":@, "~|":@, "~^":@, "^~":@,
  "+":@, "-":@, "!":@, "~":@,
  "&":@, "|":@, "^":@
}

// ─── Primaries ──────────────────────────────────────────────────────────

// NUMBER comes BEFORE MACRO_USE so `` `WIDTH'd42 `` is
// recognized as a based number (with `` `WIDTH `` as the size)
// rather than as a bare macro followed by orphan `'d42`. BASED_NUM
// uses INT_OR_MACRO at its size slot, so macros-as-size work.
PRIMARY: choice {
  <TYPE_CAST_PAREN_EXPR>,
  <PAREN_EXPR>,
  <NULL_LIT>,
  <NEW_EXPR>,
  <TYPED_ASSIGNMENT_PATTERN>,
  <TYPE_CAST>,
  <ASSIGNMENT_PATTERN>,
  <DEFAULT_VALUE_PATTERN>,
  <SYSTEM_FUNC_CALL>,
  <LAST_INDEX_REF>,
  <METHOD_CALL>,
  <PARAMETERIZED_TYPE_REF>,
  <FUNC_CALL>,
  <STREAMING_CONCAT>,
  <CONCAT_OR_REPLICATION>,
  <NUMBER>,
  <MACRO_HIER_REF>,
  <STRING_PRIMARY>,
  <THIS_REF>,
  <SUPER_REF>,
  <PKG_QUAL_PRIMARY>,
  <HIER_REF>
}

// `type_name'{<fields>}` — typed assignment pattern (IEEE 1800-2017
// §10.9.2). Same body shape as ASSIGNMENT_PATTERN but with an
// explicit type prefix used for struct/array literals where the
// surrounding context isn't enough to infer the type:
//
//   axi_req_t r = axi_req_t'{addr: 0, len: 3, default: '0};
//
// Tried BEFORE TYPE_CAST so `name '` followed by `{` wins over
// TYPE_CAST_IDENT's expectation of `(`.
TYPED_ASSIGNMENT_PATTERN: sequence dict {
  sv_qualified_type:type=@:type="typed_assignment_pattern",
  "'",
  "{",
  sv_balanced_braces:body=@,
  "}"
}

// `TypeName#(arg1, arg2)` — a parameterized type reference used as
// a value in expression context (e.g. as a class parameter override
// value: `extends Base #(.ITEM_T(my_item#(W, H)))`). Tried before
// FUNC_CALL because both start with an identifier; the trailing `#`
// disambiguates.
// Per IEEE 1800-2017 §6.20.3 / §23.10: parameter_value_assignment for
// a parameterised type ref takes either positional or named bindings,
// same shape as instance-side `MODULE_INSTANTIATION#(.X(v))`. Reuse
// `PARAM_BINDING` so the named (`.NAME(EXPR)`) form is supported.
PARAMETERIZED_TYPE_REF: sequence dict {
  sv_qualified_type:name=@:type="param_type_ref",
  "#", "(",
  repeat <PARAM_BINDING>:params[]=@ separator ",",
  ")",
  ?<PARAM_STATIC_CALL_TAIL>:static_call=@
}

// `::method(args)` chained after a `Class#(params)` parameterised
// type reference — UVM `uvm_config_db#(virtual ifc)::set(...)` idiom
// (IEEE 1800-2017 §23.7 static class method call via `::`). The
// optional tail lets PARAMETERIZED_TYPE_REF absorb the call without
// branching the alt list. Inner param-binding values may carry the
// `virtual` keyword on a type binding — captured by `sv_balanced_arg`
// at the parameter level via PARAM_BINDING's EXPR slot (which
// already includes the wildcard fallback for non-EXPR forms).
PARAM_STATIC_CALL_TAIL: sequence dict {
  "::",
  sv_identifier:method=@,
  repeat <SCOPE_RES_SEG>:scopes[]=@,
  ?<SCOPE_CALL_ARGS>:call=@
}

// SV-1800 default-value patterns: `'0` (all bits 0), `'1` (all
// bits 1), `'x` (all bits x), `'z` (all bits z). Used for full-
// width literal initialization.
DEFAULT_VALUE_PATTERN: sequence dict {
  "'":type="default_value_pattern",
  <DEFAULT_VALUE_CHAR>:value=@
}

DEFAULT_VALUE_CHAR: choice {
  "0":@, "1":@,
  "x":@, "X":@,
  "z":@, "Z":@
}

// `<type>'(expr)` — type cast. Type can be a TYPE_SPEC keyword,
// an identifier (typedef'd), `signed`/`unsigned`, or a width
// expression (`8'(x)`). Multiple forms via Choice.
TYPE_CAST: choice {
  <TYPE_CAST_MEMBER>,
  <TYPE_CAST_IDENT>,
  <TYPE_CAST_NUM>,
  <TYPE_CAST_SIGNED>
}

// `pkg_or_struct.MEMBER'(expr)` — the cast size is a dotted member
// reference (a config-struct/param field), e.g. CVA6's
// `CVA6Cfg.PLEN'(addr)`. sv_qualified_type stops at `.`, so the member
// path needs its own run. Tried first; falls through to TYPE_CAST_IDENT
// for the plain `type'(expr)` form (which has no `.member`).
TYPE_CAST_MEMBER: sequence dict {
  sv_qualified_type:base=@:type="type_cast_member",
  repeat+ <CAST_MEMBER_SEL>:path[]=@,
  "'",
  "(", <EXPR>:value=@, ")"
}
CAST_MEMBER_SEL: sequence dict { ".", sv_identifier:name=@ }

// `(W+3)'(x)` — width-expression cast (IEEE 1800-2017 §6.24.1).
// The cast width is a parenthesized expression rather than an
// integer literal or type name. Common pattern when the target
// width is computed from other parameters: `(DepthW + 3)'(1'b1)`.
// Lives at PRIMARY level (not inside TYPE_CAST) so it can be tried
// BEFORE PAREN_EXPR — otherwise `(DepthW + 3)` would match as a
// regular parenthesized expression and the trailing `'(value)`
// would never get a chance.
TYPE_CAST_PAREN_EXPR: sequence dict {
  "(", <EXPR>:width=@:type="type_cast_paren_expr", ")",
  "'",
  "(", <EXPR>:value=@, ")"
}

TYPE_CAST_IDENT: sequence dict {
  sv_qualified_type:type=@:type="type_cast",
  "'",
  "(",
  <EXPR>:value=@,
  ")"
}

TYPE_CAST_NUM: sequence dict {
  int:width=@:type="type_cast_num",
  "'",
  "(",
  <EXPR>:value=@,
  ")"
}

TYPE_CAST_SIGNED: sequence dict {
  <SIGNED_KW>:type=@:type="type_cast_signed",
  "'",
  "(",
  <EXPR>:value=@,
  ")"
}

SIGNED_KW: choice { 'signed':@, 'unsigned':@ }

// `'{<fields>}` — assignment pattern. Used to initialize struct/
// array/queue literals. Body captured raw because the inner
// content has its own dialect (key-value pairs, default values,
// type-based defaults).
ASSIGNMENT_PATTERN: sequence dict {
  "'":type="assignment_pattern",
  "{",
  sv_balanced_braces:body=@,
  "}"
}

// `obj.method(args)` / `obj.field.method(args)` — method invocation
// via dot notation. At least one `.path` is required so this rule
// doesn't claim plain `foo()` (which is FUNC_CALL). An optional
// trailing `with { <constraints> }` clause (for
// `obj.randomize() with { x > 0; }` and similar) is captured raw.
METHOD_CALL: sequence dict {
  sv_identifier:name=@:type="method_call",
  repeat+ <HIER_PART>:path[]=@,
  "(",
  repeat <TASK_ARG>:args[]=@ separator ",",
  ")",
  ?<WITH_CLAUSE>:with=@,
  ?<CALL_CHAIN>:chain=@
}

// Optional `with { ... }` (constraint block style) OR `with (expr)`
// (array-method predicate style) trailing a method call. Body
// captured raw to handle both forms uniformly; host inspects the
// captured text to decide.
WITH_CLAUSE: choice {
  <WITH_BRACES>,
  <WITH_PARENS>
}

WITH_BRACES: sequence dict {
  'with':@:type="with_braces",
  "{",
  sv_balanced_braces:body=@,
  "}"
}

WITH_PARENS: sequence dict {
  'with':@:type="with_parens",
  "(",
  <EXPR>:expr=@,
  ")"
}

// `this[.field][...]` — class self-reference. Class context only,
// but pure parse doesn't enforce that.
THIS_REF: sequence dict {
  'this':@:type="this_ref",
  repeat <HIER_PART>:path[]=@,
  ?<RANGE_OR_INDEX>:select=@
}

// `super[.field][...]` — class parent-reference.
SUPER_REF: sequence dict {
  'super':@:type="super_ref",
  repeat <HIER_PART>:path[]=@,
  ?<RANGE_OR_INDEX>:select=@
}

// `pkg::name[.field][...]` — package-qualified reference. Tried
// BEFORE HIER_REF so the leading sv_identifier is committed to
// PKG_QUAL_PRIMARY when followed by `::`. PEG handles the
// non-match case by rolling back to HIER_REF.
// `pkg::name`, chained `A::B::C` (IEEE 1800-2017 §23.7 class-scope
// resolution), and a trailing static-method call `T::type_id::create(x)`
// (the UVM factory idiom). `scopes[]` carries the 2nd-and-later `::name`
// segments; `call` the optional `(args)` after the final name.
PKG_QUAL_PRIMARY: sequence dict {
  sv_identifier:pkg=@:type="pkg_qual_ref",
  "::",
  sv_identifier:name=@,
  repeat <SCOPE_RES_SEG>:scopes[]=@,
  ?<SCOPE_CALL_ARGS>:call=@,
  repeat <HIER_PART>:path[]=@,
  ?<RANGE_OR_INDEX>:select=@
}

// `$` as the last-index token in `arr[$]` / `arr[i:$]` (IEEE 1800-2017
// §7.10.1 queue/dynamic-array bound). Guarded by `!sv_identifier` so it
// never steals the `$` of `$display` / `$root` (those are tried earlier
// as SYSTEM_FUNC_CALL anyway).
LAST_INDEX_REF: sequence dict { "$":type="last_index", !sv_identifier }

SCOPE_RES_SEG: sequence dict { "::", sv_identifier:name=@ }

SCOPE_CALL_ARGS: sequence dict {
  "(",
  repeat <TASK_ARG>:args[]=@ separator ",",
  ")",
  ?<WITH_CLAUSE>:with=@
}

// `null` literal — class handle absence.
NULL_LIT: sequence dict { 'null':@:type="null" }

// `new`, `new()`, `new(arg1, arg2, ...)`, `new[N]` — class
// instance creation OR dynamic array sizing. Args captured raw
// to handle the full expression-list inside parens, since the
// argument list may contain commas inside nested parens.
NEW_EXPR: sequence dict {
  'new':@:type="new",
  ?<NEW_ARGS>:args=@
}

NEW_ARGS: choice {
  <NEW_PARENS>,
  <NEW_BRACKETS>
}

NEW_PARENS: sequence dict {
  "(":type="new_call",
  repeat <TASK_ARG>:args[]=@ separator ",",
  ")"
}

NEW_BRACKETS: sequence dict {
  "[":type="new_array", <EXPR>:size=@, "]",
  ?<NEW_PARENS>:init=@
}

// Streaming concatenation: `{<<{...}}` or `{>>{...}}`,
// optionally with slice size: `{<<8{...}}`. LRM:
//   streaming_concatenation ::=
//     '{' stream_operator [slice_size] '{' stream_expressions '}' '}'
//
// We capture the slice and inner stream expressions as raw text;
// host re-parses if needed.
STREAMING_CONCAT: sequence dict {
  "{":type="streaming_concat",
  <STREAM_DIR>:direction=@,
  ?<STREAM_SLICE>:slice=@,
  "{",
  repeat+ <EXPR>:items[]=@ separator ",",
  "}",
  "}"
}

// Optional slice size on a streaming concat: a type (`byte`), a literal
// (`8`/`32`), or a parameter name (`LfsrIdxDw`). Deliberately NOT a full
// EXPR — that would swallow the following concat `{...}`.
STREAM_SLICE: choice {
  <TYPE_SPEC>,
  <NUMBER>,
  sequence dict { sv_qualified_type:name=@:type="stream_slice_ref" }
}

STREAM_DIR: choice { "<<":@, ">>":@ }

// Captured as a scope so the body re-parses through EXPR as its own
// sub-tree — the inner `#opchain` runs at its own frame exit, instead
// of getting threaded through the surrounding chain's compaction.
// Mirrors PP_EXPR's PAREN_EXPR pattern. Self-Ref INNER lets nested
// parens be transparent (`(a (b) c)` → body is `a (b) c`); `std.string`
// INNER keeps embedded `"...(...)..."` literals atomic so a `)` inside
// a string can't close the scope.
// Captured as a scope so the body re-parses through EXPR as its own
// sub-tree. INNER `<PAREN_BALANCED>` recursively swallows nested
// `(…)` runs as atomic chunks so paren depth balances correctly
// even when the inner content (e.g. an empty `()` call-arg list)
// isn't a complete EXPR; `std.string` keeps embedded
// `"…(…)…"` literals atomic so a `)` inside a string can't close
// the scope.
PAREN_EXPR: sequence dict {
  "(":type="paren",
  scope { <PAREN_BALANCED>, std.string }:value=@:#subparse="EXPR",
  ")"
}

// Recursive balanced-paren atomic capture for the PAREN_EXPR scope's
// INNER set. Just `(…)` with the same INNER recursion — no subparse.
// Without this rule the INNER would be PAREN_EXPR itself, which
// triggers a subparse on the inner body; an empty body (`()` of a
// function call) fails EXPR and breaks the outer balance count.
PAREN_BALANCED: sequence {
  "(",
  scope { <PAREN_BALANCED>, std.string },
  ")"
}

// Concatenation `{a, b, c}` OR replication `{N{expr}}`. Distinguished
// by the first item: if it's followed by `{` then it's replication,
// otherwise concatenation.
CONCAT_OR_REPLICATION: choice {
  <REPLICATION>,
  <CONCAT>
}

// Concat: `{ a, b, c }`. Two Choice forms — structured for plain
// expression lists, raw-captured for concat bodies containing
// preprocessor directives that interleave with the elements
// (`` `ifdef ``/`` `endif `` mid-list, common in formal & UVM code).
// PEG tries structured first; if directives break the EXPR
// repeat, the alt rolls back and CONCAT_RAW captures the body
// uniformly. Host re-parses if directive structure is needed.
CONCAT: choice {
  <CONCAT_STRUCTURED>,
  <CONCAT_RAW>
}

CONCAT_STRUCTURED: sequence dict {
  "{":type="concat",
  repeat <EXPR>:elements[]=@ separator ",",
  "}"
}

CONCAT_RAW: sequence dict {
  "{":type="concat_with_directives",
  sv_balanced_braces:body=@,
  "}"
}

REPLICATION: sequence dict {
  "{":type="replication",
  <EXPR>:count=@,
  "{",
  repeat+ <EXPR>:elements[]=@ separator ",",
  "}",
  "}"
}

// Number primary — Choice composition over the four numeric kinds.
// The custom `sv_based_digits` parser handles only the digit run of
// based literals (the genuinely Verilog-specific lexical concern);
// everything else uses std parsers + grammar-level matching.
//
// Order matters in NUMBER's Choice: BASED tried first because `8'hFF`
// shares the leading integer with plain `42`; TIME_LIT before INTEGER
// for the same reason (`42ns` shares its `42` with `42` alone).
// Each NUMBER variant carries its own `type` discriminator — no
// outer wrapper needed. A plain `42` emits `{type:"integer",value:42}`
// directly instead of `{type:"number",number:{kind:"integer",value:42}}`
// — same information without the redundant nesting.
// `'0` / `'1` / `'x` / `'z` — unbased unsized literal (IEEE 1800-2017
// §5.7.1). Expands to a vector with all bits at the indicated value
// to the target's full width. Tried BEFORE BASED_NUM so the base
// char `0`/`1`/`x`/`z` matches here first; BASED_NUM's b/o/d/h base
// chars aren't ambiguous with these because none overlap.
//
// `ignore:` (empty list) — no whitespace allowed between `'` and
// the value char.
NUMBER: choice {
  <UNSIZED_LIT>,
  <BASED_NUM>,
  <TIME_LIT>,
  <REAL_NUM>,
  <INTEGER_NUM>
}

UNSIZED_LIT ignore: sequence dict {
  "'":type="unsized_lit",
  <UNSIZED_LIT_VAL>:value=@
}

UNSIZED_LIT_VAL: choice {
  "0":@, "1":@, "x":@, "X":@, "z":@, "Z":@
}

// `ignore:` (empty list) disables whitespace skipping for this rule's
// body so `8'hFF` parses as a single token — no spaces allowed between
// size, `'`, base, or digit run.
// Per IEEE 1800-2017 §22.5.1, macros expand to text — a sized
// based-number may use a macro for its digit run:
//
//   32'h`DM_ADDR    // <-- `DM_ADDR expands to hex digits
//
// Engine doesn't expand macros; treat `<MACRO_USE>` as a permitted
// stand-in for the `sv_based_digits` literal. Macro form tried first
// (first byte `\``) so the literal-digits form gets a clean miss.
// Split by base: decimal (`'d`) uses the decimal-restricted digit run so
// `8'd12?b:c` stops at the ternary `?`; the other bases keep the
// permissive run where `?`/x/z ARE don't-care digits (`8'h12?`). Same
// `type="based_num"` shape; the base char discriminates on save.
BASED_NUM: choice {
  <BASED_NUM_DEC>,
  <BASED_NUM_GEN>
}
BASED_NUM_DEC ignore: sequence dict {
  ?<INT_OR_MACRO>:size=@,
  "'":type="based_num",
  ?<SIGNED_FLAG>:signed=true,
  <BASE_CHAR_DEC>:base=@,
  <BASED_VALUE_DEC>:value=@
}
BASED_NUM_GEN ignore: sequence dict {
  ?<INT_OR_MACRO>:size=@,
  "'":type="based_num",
  ?<SIGNED_FLAG>:signed=true,
  <BASE_CHAR_GEN>:base=@,
  <BASED_VALUE>:value=@
}
BASE_CHAR_DEC: choice { "d":@, "D":@ }
BASE_CHAR_GEN: choice { "b":@, "B":@, "o":@, "O":@, "h":@, "H":@ }
BASED_VALUE_DEC ignore whitespace: sequence { <BASED_DIGITS_DEC_OR_MACRO> }
BASED_DIGITS_DEC_OR_MACRO: choice { <MACRO_USE>, sv_based_digits_dec }

// Per IEEE 1800-2017 §5.7.1, whitespace is permitted between the
// base character and the digit run: `'h 30`, `8'b 1010_0101`. Push a
// `whitespace` ignore here so the boundary before BASED_DIGITS_OR_MACRO
// eats the optional spaces — BASED_NUM's outer `ignore:` (strict)
// still applies to the size/`'`/base prefix.
BASED_VALUE ignore whitespace: sequence {
  <BASED_DIGITS_OR_MACRO>
}

BASED_DIGITS_OR_MACRO: choice {
  <MACRO_USE>,
  sv_based_digits
}

SIGNED_FLAG: choice { "s":@, "S":@ }

BASE_CHAR: choice {
  "b":@, "B":@, "o":@, "O":@,
  "d":@, "D":@, "h":@, "H":@
}

// Time literal — `42ns`, `1.5us`. Tight matching via `ignore:` so the
// number and unit aren't separable by whitespace.
// LIMITATION: uses std.int so doesn't accept underscores in the
// numeric prefix (`1_000ns` won't match here, but `1000ns` will).
TIME_LIT ignore: sequence dict {
  <INT_OR_MACRO>:value=@:type="time_lit",
  <TIME_UNIT>:unit=@
}

TIME_UNIT: choice {
  'fs':@, 'ps':@, 'ns':@, 'us':@, 'ms':@, 's':@
}

// REAL_NUM and INTEGER_NUM do NOT use the macro-or-X wraps. Their
// CONTENT must be a real terminal (float/int) — a bare `` `MACRO ``
// at expression position should reach MACRO_USE in PRIMARY, NOT be
// classified as a "real number" or "integer" whose value happens
// to be a macro. The macro wraps live in BASED_NUM (size) and
// TIME_LIT (value) because in those rules a *required* follow-up
// token (`'b/'d/'h` or a time unit) disambiguates.
REAL_NUM: sequence dict {
  float:value=@:type="real"
}

INTEGER_NUM: sequence dict {
  sv_int:value=@:type="integer"
}

STRING_PRIMARY: sequence dict {
  string:value=@:type="string"
}

// Function call: `name(arg, ...)`. Distinguished from a plain
// hierarchical reference by the presence of `(` immediately after.
// Optional trailing `with {...}` constraint clause handles the
// `std::randomize(args) with {expr}` form (IEEE 1800-2017 §18.7
// inline randomize) and `array.method() with {expr}` array-method
// constraints (§7.12.4).
FUNC_CALL: sequence dict {
  sv_qualified_type:name=@:type="func_call",
  "(",
  repeat <TASK_ARG>:args[]=@ separator ",",
  ")",
  ?<WITH_CLAUSE>:with=@,
  ?<CALL_CHAIN>:chain=@
}

// Method-call postfix chain in EXPRESSION context: `f().g().h`,
// `obj.get().set(n)`. A dedicated rule (NOT the shared HIER_PART, which
// the statement/lvalue rules consume) so adding `.method(args)` here
// can't disturb METHOD_CALL_STMT's `path then (args)` shape.
CALL_CHAIN: sequence dict {
  repeat+ <CHAIN_LINK>:links[]=@
}
CHAIN_LINK: choice {
  <DOT_CALL>,
  <HIER_DOT>,
  <HIER_PART_RANGE>,
  <HIER_SELECT>
}

// System function call: `$name(arg, ...)` — same shape as task call
// but used in expression context.
// System function calls start with `$` per LRM §20. The `$` is
// part of the lexical form — we match it as a literal then take
// the identifier portion. (`sv_identifier` accepts the system form
// as a single token, but having the literal `$` here is what stops
// SYSTEM_FUNC_CALL from claiming plain identifiers like `clk` —
// the earlier behavior was a bug surfaced by save-direction round-
// tripping.)
// Uses sv_system_name to capture the entire name including any
// multi-segment forms like `$value$plusargs`, `$test$plusargs`.
// The captured string includes the leading `$`. Tight-binding
// between `$` and identifier is enforced by the terminal parser,
// so the rule itself uses the surrounding (whitespace-skipping)
// ignore policy — previously this rule used `ignore:` to prevent
// `$ display`-with-space matches, but the terminal handles that
// now AND the override was breaking SYSTEM_FUNC_ARGS's comma
// separator inside arg lists.
SYSTEM_FUNC_CALL: sequence dict {
  sv_system_name:name=@:type="system_func",
  ?<SYSTEM_FUNC_ARGS>:args=@
}

SYSTEM_FUNC_ARGS: sequence dict {
  "(",
  repeat <EXPR>:args[]=@ separator ",",
  ?<SYSTEM_FUNC_CLOCK>:clocking=@,
  ")"
}

// Trailing `, @(event)` clocking-event argument of the sampled value
// functions `$fell`/`$rose`/`$stable`/`$changed`/`$past` (§16.9.3). Kept
// separate from the expression args (an EVENT_CONTROL isn't an EXPR).
SYSTEM_FUNC_CLOCK: sequence dict {
  "" space, ?",", "" space, <EVENT_CONTROL>:event=@
}

// Hierarchical reference: identifier, optionally with `.subident`
// chains and array-index selects at any point. `mod.inst[i].q[7:0]`
// parses as alternating dot-paths and bracket-selects.
HIER_REF: sequence dict {
  sv_identifier:name=@:type="ref",
  repeat <HIER_PART>:path[]=@,
  repeat <RANGE_OR_INDEX>:selects[]=@
}

// Macro use as primary that supports hierarchical-path continuation:
// `\`MACRO.field`, `\`MACRO[3:0]`, etc. Many UVM-style codebases use
// macros as backdoor hierarchy aliases (`\`WB.rf_we_wb_o`), so allow
// the same `.field` / `[…]` chain HIER_REF has. The actual MACRO_USE
// terminal captures `\`name` (and optional `(args)`); HIER_PARTs and
// selects are accumulated on top.
//
// Reference: SV-1800 §22.5 (macro use is lexically text-substituted)
// — once expanded the expression behaves like any other identifier
// chain, so the same path/selector grammar applies.
MACRO_HIER_REF: sequence dict {
  <MACRO_USE>:macro=@:type="macro_ref",
  repeat <HIER_PART>:path[]=@,
  repeat <RANGE_OR_INDEX>:selects[]=@
}

// Either a `.field` step or a chained bracket-select. Each path
// element captures one step.
HIER_PART: choice {
  <HIER_DOT>,
  <HIER_PART_RANGE>,
  <HIER_SELECT>
}

HIER_DOT: sequence dict { ".", sv_identifier:field=@ }
HIER_SELECT: sequence dict { "[", <EXPR>:index=@, "]" }

// `[msb:lsb]` part-select / range-slice on hierarchical refs. The
// `:` form covers both regular range select (`vec[7:0]`) and
// queue/array slice (`q[1:$]` — `$` is the end-of-queue index from
// IEEE 1800-2017 §10.10). Tried before HIER_SELECT (which matches
// bare `[expr]`) so the longer two-expr form wins.
HIER_PART_RANGE: sequence dict {
  "[", <RANGE_BOUND>:msb=@, ":", <RANGE_BOUND>:lsb=@, "]"
}

RANGE_BOUND: choice {
  "$":@,
  <EXPR>
}

// ─── Preprocessor — recognition only, no expansion ──────────────────────
//
// The grammar recognizes preprocessor SYNTAX and emits AST nodes for
// directives and macro uses. It does NOT expand macros, evaluate
// `ifdef branches, or follow `include paths — those are the
// application's concern. This keeps the grammar stateless (no
// macro table threaded through the parse) and the AST faithful to
// the source.
//
// Limitation: this approach handles macros that appear at SYNTACTIC
// positions (expression, statement, module-item) and at the specific
// token-internal positions wrapped below (size of based-number,
// value of int/real/time literals, certain identifier slots). It
// does NOT handle truly lexical macros — ones whose expansion fuses
// with adjacent characters to form a new token (`define FOO bar`
// followed by `assign x = FOO;` where `FOO` becomes the identifier
// `bar`, not a macro use). For files using lexical macros, run a
// preprocessor pass first.

// Use-site: `IDENT (with optional `(args)` for function-like
// macros). `ignore:` keeps the backtick tight against the name.
// The args list is captured as an array of strings — each arg is
// matched by `sv_balanced_arg` (a depth-tracking parser that scans
// up to the next top-level `,` or `)`, with nested `(...)`
// properly balanced). So `` `FOO(g(a, b), c) `` yields two args:
// `g(a, b)` and ` c`.
// Per IEEE 1800-2017 §22.5.1, whitespace IS permitted between the
// macro name and the opening `(` of its actual-argument list
// (whitespace inside MACRO_CALL_ARGS is also tolerated). The previous
// `ignore:` (empty) policy treated that whitespace as content and
// caused the optional MACRO_CALL_ARGS to be predictively skipped on
// `\`name (args)` (with space) — only `\`name(args)` (no space)
// matched. Permit whitespace between name and call-args so the
// common UVM form `\`uvm_field_int (addr, UVM_DEFAULT)` parses.
//
// The leading `` ` `` and `sv_identifier` are still adjacent (Key
// doesn't run ignore before matching, and `sv_identifier` itself is
// reached without intervening run_ignore because it's the next item
// in the sequence after a Key).
MACRO_USE ignore whitespace line_comment block_comment: sequence dict {
  "`",
  sv_identifier:name=@:type="macro_use",
  ?<MACRO_CALL_ARGS>:args=@
}

// Bare macro use: `IDENT only, no `(args)`. Used where the
// surrounding rule (e.g. MODULE_INSTANTIATION's INSTANCE) takes
// `(...)` as its OWN structural element — the full MACRO_USE
// would gobble those parens as its args, breaking the outer
// parse. This form parses just the backtick + name.
MACRO_USE_BARE ignore: sequence dict {
  "`",
  sv_identifier:name=@:type="macro_use"
}

MACRO_CALL_ARGS: sequence array {
  "(",
  repeat sv_balanced_arg separator ",",
  ")"
}

// Choice wraps. Wherever the grammar previously pinned a specific
// terminal that a macro might substitute for, route through one of
// these so MACRO_USE is an accepted alternative. The terminal's
// emitted value (int/string) and macro_use AST node are both
// passable in the same slot — the host distinguishes by checking
// for `{type: "macro_use"}`.
//
// (No FLOAT_OR_MACRO: real-number literals can't usefully be
// supplanted by a macro; a bare `` `MACRO `` at expression position
// reaches MACRO_USE in PRIMARY, which is the correct classification.)
INT_OR_MACRO:   choice { <INT_VAL>,    <MACRO_USE> }
// IDENT_OR_MACRO uses the BARE form because identifier slots are
// inside rules that have their own `(...)` (port lists, parameter
// lists, etc.); the full MACRO_USE would gobble those.
IDENT_OR_MACRO: choice { <IDENT_VAL>,  <MACRO_USE_BARE> }

// Non-container wrappers — the parser's value flows through the
// Sequence and becomes the Choice alternative's emitted value.
// (rawast's `:@` binding syntax is shorthand for Key alternatives;
//  for Parse terminals in Choice position, this wrapper form is
//  the canonical way to forward the parsed value.)
INT_VAL:   sequence { sv_int }
IDENT_VAL: sequence { sv_identifier }

// Preprocessor directives are inlined directly into the host
// Choice rules (DESCRIPTION, MODULE_ITEM, STATEMENT) rather than
// being collected under a nested DIRECTIVE Choice. The flat-
// Choice form is required for save-side dispatch: save walks each
// host-Choice alt looking for a `:type=` discriminator on the
// resolved rule body, and won't recurse through a nested Choice
// to find one. The cost is the keyword list being repeated in
// three places; the benefit is round-trip save/load works.

// `define NAME [params] body
// Body extends to the next un-escaped newline. We capture as raw
// text via `*` up to the literal `\n` — the host can post-process
// backslash-continued lines if needed.
// `define NAME body — `ignore:` (empty) keeps the rule line-aware
// (the usual whitespace ignore policy would skip newlines too,
// causing the body to swallow the next line). Horizontal whitespace
// between the keyword/name/body is consumed via `linespace` (from
// std). The body extends to the next un-escaped newline, with
// `\` line-continuation handled by sv_line_text. Discriminator
// `:type="define"` lives on the leading keyword so save-side
// dispatch picks it up from the first item.
DEFINE ignore: sequence dict {
  "`define":type="define",
  linespace,
  sv_identifier:name=@,
  linespace,
  sv_line_text:body=@
}

UNDEF: sequence dict {
  "`undef" space, sv_identifier:name=@:type="undef"
}

INCLUDE: sequence dict {
  "`include" space,
  string:file=@:type="include"
}

// `ifdef NAME body `endif (and `ifndef variant). Body captured as
// raw text up to `` `endif ``. Any `` `else `` inside stays in the
// body; the host evaluates the condition and re-parses the active
// branch. Nested `` `ifdef `` is opaque — host's preprocessor
// handles nesting.
IFDEF: sequence dict {
  "`ifdef" space,
  sv_identifier:cond=@:type="ifdef",
  *:body=@,
  "`endif"
}

IFNDEF: sequence dict {
  "`ifndef" space,
  sv_identifier:cond=@:type="ifndef",
  *:body=@,
  "`endif"
}

// ─── Package and interface (parse-only; semantics deferred to host) ────

// `package NAME; <items> endpackage [: NAME]`. The package body uses
// the same MODULE_ITEM Choice — most things (parameters, typedefs,
// user-typed decls, function/task decls) work in both module and
// package position. Imports inside packages also use IMPORT_STMT.
PACKAGE_DECL: sequence dict {
  'package':@:type="package" space,
  ?<LIFETIME>:lifetime=@ space,
  sv_identifier:name=@,
  ";" newline,
  <MODULE_ITEMS>:items=@,
  'endpackage' space,
  ?<END_LABEL>:end_label=@
}

// `interface class NAME [#(params)] [extends I1, I2]; <items> endclass`
// — interface class declaration (IEEE 1800-2017 §8.26). Same body
// shape as a normal class; the leading `interface` is just a marker
// keyword. Tried BEFORE INTERFACE_DECL so the `interface class …`
// path wins over the bare `interface NAME …` form.
INTERFACE_CLASS_DECL: sequence dict {
  'interface':type="interface_class" space,
  'class':@ space,
  ?<LIFETIME>:lifetime=@,
  sv_identifier:name=@,
  ?<PARAM_PORT_LIST>:params=@,
  ?<CLASS_EXTENDS>:extends=@,
  ";",
  <CLASS_ITEMS>:items=@,
  'endclass',
  ?<END_LABEL>:end_label=@
}

// `interface NAME (...); <items> endinterface`. Same body shape as
// MODULE_DECL — interfaces are modules with a different keyword and
// a more permissive item list. For now, share MODULE_ITEMS as the
// body grammar; modport declarations can be added when needed.
INTERFACE_DECL: sequence dict {
  'interface':@:type="interface" space,
  ?<LIFETIME>:lifetime=@ space,
  sv_identifier:name=@,
  repeat <MODULE_HEADER_IMPORT>:header_imports[]=@,
  ?<PARAM_PORT_LIST>:param_ports=@,
  ?<INTERFACE_EXTENDS>:extends=@,
  ?<PORT_LIST>:ports=@,
  ";",
  <MODULE_ITEMS>:items=@,
  'endinterface' space,
  ?<END_LABEL>:end_label=@
}

// `extends parent_if [#(params)] [, parent_if2 ...]` — interface
// inheritance (SV-1800 LRM §25.5.1). Comma-separated list of
// parent interfaces, each optionally parameterized.
INTERFACE_EXTENDS: sequence dict {
  'extends':@,
  repeat+ <INTERFACE_PARENT>:parents[]=@ separator ","
}

INTERFACE_PARENT: sequence dict {
  sv_identifier:name=@,
  ?<PARAM_OVERRIDE>:params=@
}

// `import pkg::*;` or `import pkg::ident;`. One or more comma-
// separated entries per statement; each entry is `<pkg>::<sym>` or
// `<pkg>::*`.
IMPORT_STMT: sequence dict {
  'import':@:type="import" space,
  <IMPORT_ENTRIES>:entries=@,
  ";"
}

IMPORT_ENTRIES: sequence array {
  repeat+ <IMPORT_ENTRY> separator ","
}

IMPORT_ENTRY: sequence dict {
  <IMPORT_PKG>:pkg=@,
  "::",
  <IMPORT_TARGET>:target=@
}

// Package qualifier: an identifier or `*` (wildcard, used by
// `export *::*;`).
IMPORT_PKG: choice {
  "*":@,
  sv_identifier
}

// Either `*` (wildcard) or an identifier.
IMPORT_TARGET: choice {
  "*":@,
  sv_identifier
}

// `export pkg::*;` / `export *::*;` — semantics-equivalent surface form.
EXPORT_STMT: sequence dict {
  'export':@:type="export" space,
  <IMPORT_ENTRIES>:entries=@,
  ";"
}

// Trailing `: NAME` after end-keyword. Used by packages, interfaces,
// blocks, classes — captures the optional label that some users
// write for readability. Pure recognition; host may verify it
// matches the opening name if desired.
//
// Some codebases emit a stray trailing `;` after the label
// (`endtask: name;`), not in the LRM but common in practice — the
// optional `?";"` swallows it here so every consumer of END_LABEL
// gets the lenient form for free.
END_LABEL: sequence dict {
  ":", sv_identifier:label=@,
  ?";"
}

// ─── Class declarations (parse-only, semantics deferred) ──────────────

// Class is split into `virtual class`/plain `class` variants —
// otherwise the optional-leading-keyword (`?'virtual'`) interacts
// badly with the surrounding DESCRIPTION Choice when peek-and-skip
// has to decide whether to enter CLASS_DECL.
CLASS_DECL: choice {
  <CLASS_DECL_VIRTUAL>,
  <CLASS_DECL_PLAIN>
}

CLASS_DECL_VIRTUAL: sequence dict {
  'virtual':virtual=true space,
  'class':@:type="class" space,
  ?<LIFETIME>:lifetime=@ space,
  sv_identifier:name=@,
  ?<PARAM_PORT_LIST>:params=@,
  ?<CLASS_EXTENDS>:extends=@,
  ?<CLASS_IMPLEMENTS>:implements=@,
  ";" newline,
  <CLASS_ITEMS>:items=@,
  'endclass' space,
  ?<END_LABEL>:end_label=@
}

CLASS_DECL_PLAIN: sequence dict {
  'class':@:type="class" space,
  ?<LIFETIME>:lifetime=@ space,
  sv_identifier:name=@,
  ?<PARAM_PORT_LIST>:params=@,
  ?<CLASS_EXTENDS>:extends=@,
  ?<CLASS_IMPLEMENTS>:implements=@,
  ";" newline,
  <CLASS_ITEMS>:items=@,
  'endclass' space,
  ?<END_LABEL>:end_label=@
}

// `extends BASE [#(params)]` — class inheritance. BASE can be a
// plain identifier OR a package-qualified `pkg::Name`. Tried in
// order: pkg-qualified first (would otherwise leave `::Name`
// unconsumed).
CLASS_EXTENDS: sequence dict {
  "" space,
  'extends':@ space,
  <CLASS_BASE>:base=@,
  ?<PARAM_OVERRIDE>:params=@
}

CLASS_BASE: choice {
  <CLASS_BASE_QUALIFIED>,
  <CLASS_BASE_PLAIN>
}

CLASS_BASE_QUALIFIED: sequence dict {
  sv_identifier:pkg=@:type="qualified_base",
  "::",
  sv_identifier:name=@
}

CLASS_BASE_PLAIN: sequence { sv_identifier }

// `implements I1, I2, ...` — class implements one or more
// interfaces (SV-1800 interface classes).
CLASS_IMPLEMENTS: sequence dict {
  "" space,
  'implements':@ space,
  repeat+ sv_identifier:interfaces[]=@ separator "," space
}

CLASS_ITEMS: sequence array {
  repeat <CLASS_ITEM> indent tab newline
}

CLASS_ITEM: choice {
  <DEFINE>,
  <UNDEF>,
  <INCLUDE>,
  <IFDEF>,
  <IFNDEF>,
  <TYPEDEF_FORWARD_CLASS>,
  <TYPEDEF_REGULAR>,
  <INLINE_AGG_DECL>,
  <PARAM_DECL_STMT>,
  <LOCALPARAM_DECL_STMT>,
  <CLASS_PURE_VIRTUAL_FUNCTION>,
  <CLASS_EXTERN_FUNCTION>,
  <CLASS_PURE_VIRTUAL_TASK>,
  <CLASS_EXTERN_TASK>,
  <CLASS_FUNCTION_TYPED>,
  <CLASS_FUNCTION_VOID>,
  <CLASS_TASK>,
  <CLASS_CONSTRAINT_EXTERN>,
  <CONSTRAINT_DECL>,
  <COVERGROUP_DECL>,
  <VIRTUAL_INTERFACE_DECL>,
  <CLASS_DECL_VIRTUAL>,
  <CLASS_DECL_PLAIN>,
  <CLASS_PROPERTY>,
  <CLASS_USER_PROPERTY>,
  <MACRO_STMT>
}

// `[<vis>] [pure virtual | extern] function [<TYPE>] NAME(args);` —
// method PROTOTYPE (no body, ends at first `;`). Tried before
// CLASS_FUNCTION so `pure virtual` and `extern` declarations don't
// match the full-body form and then fail on missing `endfunction`.
CLASS_PROTO_FUNCTION: choice {
  <CLASS_PURE_VIRTUAL_FUNCTION>,
  <CLASS_EXTERN_FUNCTION>
}

CLASS_PURE_VIRTUAL_FUNCTION: sequence dict {
  ?<CLASS_VISIBILITY>:visibility=@ space,
  'pure':@:type="pure_virtual_function" space,
  'virtual' space,
  'function' space,
  ?<LIFETIME>:lifetime=@ space,
  ?<TYPE_SPEC>:return_type=@ space,
  sv_identifier:name=@,
  ?<METHOD_PORT_LIST>:args=@,
  ";"
}

CLASS_EXTERN_FUNCTION: sequence dict {
  ?<CLASS_VISIBILITY>:visibility=@ space,
  'extern':@:type="extern_function" space,
  ?'virtual':is_virtual=true space,
  'function' space,
  ?<LIFETIME>:lifetime=@ space,
  ?<TYPE_SPEC>:return_type=@ space,
  sv_identifier:name=@,
  ?<METHOD_PORT_LIST>:args=@,
  ";"
}

CLASS_PROTO_TASK: choice {
  <CLASS_PURE_VIRTUAL_TASK>,
  <CLASS_EXTERN_TASK>
}

CLASS_PURE_VIRTUAL_TASK: sequence dict {
  ?<CLASS_VISIBILITY>:visibility=@ space,
  'pure':@:type="pure_virtual_task" space,
  'virtual' space,
  'task' space,
  ?<LIFETIME>:lifetime=@ space,
  sv_identifier:name=@,
  ?<METHOD_PORT_LIST>:args=@,
  ";"
}

CLASS_EXTERN_TASK: sequence dict {
  ?<CLASS_VISIBILITY>:visibility=@ space,
  'extern':@:type="extern_task" space,
  ?'virtual':is_virtual=true space,
  'task' space,
  ?<LIFETIME>:lifetime=@ space,
  sv_identifier:name=@,
  ?<METHOD_PORT_LIST>:args=@,
  ";"
}

// `[pure] [virtual] [extern] constraint NAME;` — extern constraint
// declaration (body lives outside the class). Captured by raw
// body up to the `;`.
CLASS_CONSTRAINT_EXTERN: sequence dict {
  ?'pure':is_pure=true space,
  ?'extern':is_extern=true space,
  'constraint':@:type="constraint_extern" space,
  sv_identifier:name=@,
  ";"
}

// `[local|protected] [static|automatic] [const] [var] [rand|randc]
// <TYPE> name [array_kind_suffix] [= expr];`
CLASS_PROPERTY: sequence dict {
  ?<CLASS_VISIBILITY>:visibility=@ space,
  ?<LIFETIME>:lifetime=@,
  ?'const':is_const=true space,
  ?'var':is_var=true space,
  ?<RAND_QUAL>:rand=@ space,
  <TYPE_SPEC>:type_spec=@:type="class_property" space,
  ?<SIGNING_KW>:signing=@ space,
  ?<PACKED_DIMENSIONS>:range=@ space,
  repeat+ sv_identifier:names[]=@ separator ",",
  ?<UNPACKED_DIMENSIONS>:unpacked=@,
  ?<CLASS_PROPERTY_INIT>:init=@,
  ";"
}

// User-typed class property: same shape as CLASS_PROPERTY but the
// type slot is an sv_identifier (typedef'd type) instead of a
// keyword. Engine repeat-iteration marks (added at grammar.cpp's
// Repeat case) ensure a failed match rolls back cleanly so this
// alt doesn't gobble `endclass` from the CLASS_ITEMS repeat.
// Multi-name form (`uvm_event a, b, c;`) supported via the same
// repeat+ pattern used by NET_DECL and friends. SV's per-name init
// quirk (`type a = init_a, b = init_b;`) isn't surfaced here — the
// optional CLASS_PROPERTY_INIT applies to the last name in the
// list, matching how most production code writes these decls.
CLASS_USER_PROPERTY: sequence dict {
  ?<CLASS_VISIBILITY>:visibility=@ space,
  ?<LIFETIME>:lifetime=@,
  ?'const':is_const=true space,
  ?'virtual':is_virtual=true space,
  ?<RAND_QUAL>:rand=@ space,
  sv_qualified_type:type_spec=@:type="class_user_property" space,
  ?<PARAM_OVERRIDE>:params=@ space,
  ?<PACKED_DIMENSIONS>:range=@ space,
  repeat+ sv_identifier:names[]=@ separator ",",
  ?<UNPACKED_DIMENSIONS>:unpacked=@,
  ?<CLASS_PROPERTY_INIT>:init=@,
  ";"
}

CLASS_VISIBILITY: choice { 'local':@, 'protected':@ }

RAND_QUAL: choice { 'randc':@, 'rand':@ }

CLASS_PROPERTY_INIT: sequence dict { "" space, "=" space, <EXPR>:value=@ }

// `[local|protected] function [<TYPE>] NAME(args); body endfunction`
// CLASS_FUNCTION/CLASS_TASK don't use `:@` on the keyword Key
// because a peek-and-skipped leading `?<CLASS_VISIBILITY>` would
// otherwise pair its V-name "visibility" marker with the keyword's
// emitted text ("function" or "task") and corrupt the AST. The
// `:type=` const binding works regardless of which optional was
// skipped because it's an explicit V-name + V-const pair, not a
// "use the parser's emission" binding.
// Split into TYPED (with explicit return type — keyword or
// user-defined) and VOID (no return type, just method name) so
// `function int foo()`, `function M get()`, and `function bar()`
// all parse correctly. TYPED tried first; falls through to VOID
// when there's only one identifier between `function` and `(`.
CLASS_FUNCTION: choice {
  <CLASS_FUNCTION_TYPED>,
  <CLASS_FUNCTION_VOID>
}

CLASS_FUNCTION_TYPED: sequence dict {
  ?'virtual':is_virtual=true space,
  ?<CLASS_VISIBILITY>:visibility=@ space,
  ?'virtual':is_virtual=true space,
  ?'static':is_static=true space,
  'function':type="class_function_typed" space,
  ?<LIFETIME>:lifetime=@ space,
  sv_qualified_type:return_type=@ space,
  ?<SIGNING_KW>:return_signing=@ space,
  ?<RANGE>:return_range=@ space,
  sv_identifier:name=@,
  ?<METHOD_PORT_LIST>:args=@,
  ";" newline,
  repeat <TASK_ITEM>:items[]=@ indent tab newline,
  "" tab, 'endfunction' space,
  ?<END_LABEL>:end_label=@
}

CLASS_FUNCTION_VOID: sequence dict {
  ?'virtual':is_virtual=true space,
  ?<CLASS_VISIBILITY>:visibility=@ space,
  ?'virtual':is_virtual=true space,
  ?'static':is_static=true space,
  'function':type="class_function" space,
  ?<LIFETIME>:lifetime=@ space,
  sv_identifier:name=@,
  ?<METHOD_PORT_LIST>:args=@,
  ";" newline,
  repeat <TASK_ITEM>:items[]=@ indent tab newline,
  "" tab, 'endfunction' space,
  ?<END_LABEL>:end_label=@
}

// SV-1800 §8.4 method_qualifier — any order of `virtual` /
// `protected|local` / `static`. Slot `virtual` in two positions so
// both `protected virtual task` and `virtual protected task` parse;
// the duplicate `?'virtual'` binding harmlessly re-asserts the same
// flag if the keyword shows up in either spot.
CLASS_TASK: sequence dict {
  ?'virtual':is_virtual=true space,
  ?<CLASS_VISIBILITY>:visibility=@ space,
  ?'virtual':is_virtual=true space,
  ?'extern':is_extern=true space,
  ?'static':is_static=true space,
  'task':type="class_task" space,
  ?<LIFETIME>:lifetime=@ space,
  sv_identifier:name=@,
  ?<METHOD_PORT_LIST>:args=@,
  ";" newline,
  repeat <TASK_ITEM>:items[]=@ indent tab newline,
  "" tab, 'endtask' space,
  ?<END_LABEL>:end_label=@
}

// Each port is captured as a balanced-paren text run so a nested
// `#(...)` (parameterised type) or `= (1+2)` (default expr) doesn't
// end the port at the first `)`. Splits on top-level `,` between
// ports. Host re-parses the per-port text into direction/type/name
// when it needs structured access.
METHOD_PORT_LIST: sequence dict {
  "(",
  repeat sv_balanced_arg:ports[]=@ separator ",",
  ")"
}

// `constraint NAME { … }` — body captured as raw text; downstream
// Body uses sv_balanced_braces so nested `{ [a:b], c }` inside-set
// patterns don't terminate the capture at the first `}`.
//
// Note: a subparse=CONSTRAINT_BLOCK would re-parse the body into
// structured per-statement form. Deferred until a proper
// CONSTRAINT_STMT grammar (with dist, solve before, foreach,
// implication, etc.) is defined — splitting on `;` alone loses
// the `{...}` nesting context needed for dist clauses and `if`
// branches inside constraints.
CONSTRAINT_DECL: sequence dict {
  'constraint':@:type="constraint" space,
  sv_identifier:name=@ space,
  <CONSTRAINT_BLOCK>:block=@
}

// `{ <constraint_item>* }` — a constraint block (IEEE 1800-2017 §18.5).
// Shared by CONSTRAINT_DECL, implication/if consequents, and inline
// `randomize() with { ... }` (WITH_BRACES).
CONSTRAINT_BLOCK: sequence dict {
  "{":type="constraint_block" newline,
  repeat <CONSTRAINT_ITEM>:items[]=@ indent tab newline,
  "" tab, "}"
}

CONSTRAINT_ITEM: choice {
  <CONSTRAINT_IF>,
  <CONSTRAINT_FOREACH>,
  <CONSTRAINT_SOLVE>,
  <CONSTRAINT_EXPR_ITEM>
}

// `if (cond) <block-or-item> [else <block-or-item>]`
CONSTRAINT_IF: sequence dict {
  'if':@:type="constraint_if" space,
  "(", <EXPR>:cond=@, ")" space,
  <CONSTRAINT_CONSEQUENT>:then=@,
  ?<CONSTRAINT_ELSE>:else=@
}
CONSTRAINT_ELSE: sequence dict {
  'else' space, <CONSTRAINT_CONSEQUENT>:body=@
}
CONSTRAINT_CONSEQUENT: choice {
  <CONSTRAINT_ITEM>,
  <CONSTRAINT_BLOCK>
}

// `foreach (arr[i]) <block-or-item>`
CONSTRAINT_FOREACH: sequence dict {
  'foreach':@:type="constraint_foreach" space,
  "(", <FOREACH_ITER>:iter=@, ")" space,
  <CONSTRAINT_CONSEQUENT>:body=@
}

// `solve a, b before c, d;`
CONSTRAINT_SOLVE: sequence dict {
  'solve':@:type="constraint_solve" space,
  repeat+ <EXPR>:solve[]=@ separator "," space,
  "" space, 'before' space,
  repeat+ <EXPR>:before[]=@ separator "," space,
  ";"
}

// Expression-based item: `[soft] <expr> [ dist {..} | -> consequent ] ;`
CONSTRAINT_EXPR_ITEM: sequence dict {
  ?'soft':is_soft=true space,
  <EXPR>:expr=@,
  <CONSTRAINT_EXPR_TAIL>:tail=@
}
// `->` implication is already an EXPR operator (so `a -> b` is one
// expression); only `dist` and the plain terminator need a tail here.
CONSTRAINT_EXPR_TAIL: choice {
  <CONSTRAINT_DIST_TAIL>,
  sequence dict { ";":type="constraint_expr" }
}
CONSTRAINT_DIST_TAIL: sequence dict {
  "" space, 'dist':type="constraint_dist" space,
  "{", repeat+ <DIST_ITEM>:weights[]=@ separator "," space, "}",
  ";"
}
DIST_ITEM: sequence dict {
  choice { <INSIDE_RANGE>, <EXPR> }:value=@,
  ?<DIST_WEIGHT>:weight=@
}
DIST_WEIGHT: sequence dict {
  "" space,
  choice { ":/":mode="per_range", ":=":mode="per_value" } space,
  <EXPR>:amount=@
}

// ─── Miscellaneous module-item constructs (parse-only) ──────────────────

// `modport NAME (input a, b, output c, ...);` — interface modport.
//
// Body parsed directly as a list of direction-or-inherit entries.
// Each entry is either `<dir> <name>` (direction-headed) or just
// `<name>` (inheriting direction from the preceding entry). Host
// walks left-to-right to apply inherited directions.
MODPORT_DECL: sequence dict {
  'modport':@:type="modport" space,
  sv_identifier:name=@,
  "(",
  repeat+ <MODPORT_GROUP>:ports[]=@ separator ",",
  ")",
  ";"
}

MODPORT_GROUP: choice {
  <MODPORT_GROUP_DIR>,
  <MODPORT_GROUP_INHERIT>
}

MODPORT_GROUP_DIR: sequence dict {
  <PORT_DIRECTION>:direction=@:type="modport_group" space,
  sv_identifier:name=@
}

MODPORT_GROUP_INHERIT: sequence dict {
  sv_identifier:name=@:type="modport_group_inherit"
}

// `let NAME(args) = expr;` — SV-1800 macro-like substitution. Body
// captured as raw text up to the trailing `;`. Host re-parses if it
// needs to manipulate the body.
LET_DECL: sequence dict {
  'let':@:type="let" space,
  sv_identifier:name=@,
  ?<METHOD_PORT_LIST>:args=@,
  "=",
  *:body=@,
  ";"
}

// `bind <target> <module> <instance> (...);` — out-of-module
// directive. Target is either a module type or an instance path;
// captured as opaque text up to the binding clause.
BIND_STMT: sequence dict {
  'bind':@:type="bind",
  *:body=@,
  ";"
}

// `defparam path.to.param = value;` — overrides a parameter on an
// instance after the fact. Deprecated in SV-1800 but still legal.
DEFPARAM_STMT: sequence dict {
  'defparam':@:type="defparam",
  *:body=@,
  ";"
}

// `specify … endspecify` — timing specifications. Body is highly
// dialect-specific (timing paths, edge specifications); capture as
// raw text and let host re-parse if needed.
SPECIFY_BLOCK: sequence dict {
  'specify':@:type="specify",
  *:body=@,
  'endspecify'
}

// ─── SystemVerilog Assertions (SVA) — parse-only ──────────────────────

// SVA introduces a temporal property language (sequences, properties,
// assert/cover/assume statements) layered on top of expressions. The
// surface forms are well-defined but the temporal operators (`##`,
// `|->`, `|=>`, `s_eventually`, `s_always`, `throughout`, `within`,
// repetition `[*N]`, `[->N]`, `[=N]`, etc.) form an entire sub-
// language. For pure parse, we capture the property body as raw text
// and let the host re-parse it via a dedicated SVA pass.

// `assert property (<expr>) [<action>];`
// `cover property (<expr>) [<action>];`
// `assume property (<expr>) [<action>];`
//
// The `action` is an optional `else <stmt>` or `; <stmt>` clause —
// captured as part of the raw body up to the trailing `;`.
// Either `<kind> property (...)` or `cover sequence (...)`. The
// `sequence` form is only valid for `cover` per SV-1800, but we
// don't enforce that — pure parse, host validates.
//
// Per IEEE 1800-2017 §16.9 / §16.14, the action block IS the
// assertion's terminator — there's no extra `;` after it. The
// action_block is `statement_or_null | [statement] else
// statement_or_null`, where each STATEMENT carries its own `;` (or
// is a `begin … end` block that terminates with `end`). A
// stylistic trailing `;` after `\`ASSERT(…);`-shaped macro uses is
// tolerated via the optional terminator.
// `default disable iff <expr> ;` — IEEE 1800-2017 §16.11, the module-wide
// default disable condition for concurrent assertions. e.g. CVA6/PULP's
// `default disable iff (!rst_ni);` / `default disable iff rst_ni;`.
DEFAULT_DISABLE_IFF: sequence dict {
  'default':@:type="default_disable_iff" space,
  'disable' space, 'iff' space,
  <EXPR>:cond=@,
  ";"
}

CONCURRENT_ASSERT: sequence dict {
  ?<ASSERTION_LABEL>:label=@,
  <ASSERT_KIND>:kind=@:type="assert_concurrent" space,
  <ASSERT_KIND_KW>:kind_kw=@,
  "(",
  <ASSERT_BODY>,
  <ASSERT_ACTION>:action=@,
  ?";"
}

// Structured SVA property-spec first; if the temporal cascade can't
// consume the whole body up to `)`, the choice backtracks to the raw
// balanced-text capture — so no form ever regresses to a parse failure.
// The `)` lives INSIDE each alternative so backtracking covers it.
ASSERT_BODY: choice {
  sequence { <PROPERTY_SPEC>:body=@, ")" },
  sequence { sv_balanced_arg:body=@, ")" }
}

// `action_block`. The `pass else fail` alt is tried first to
// capture the explicit pass-then-fail form; `else fail` matches
// the common `assert (…) else $error(…);` shape; the bare-stmt
// alt covers `assert (…);` (NULL_STMT) and `assert (…) stmt;`.
ASSERT_ACTION: choice {
  <ASSERT_ACTION_PASS_ELSE>,
  <ASSERT_ACTION_ELSE>,
  <ASSERT_ACTION_PASS>
}

ASSERT_ACTION_PASS_ELSE: sequence dict {
  <STATEMENT>:pass=@,
  'else' space,
  <STATEMENT>:fail=@
}

ASSERT_ACTION_ELSE: sequence dict {
  'else' space,
  <STATEMENT>:fail=@
}

ASSERT_ACTION_PASS: sequence dict {
  <STATEMENT>:pass=@
}

// `label_name :` — optional name prefix on a concurrent assertion.
// Common pattern: `a1: assert property (...)`. Captured as a
// separate field so the host can use the label for tooling.
ASSERTION_LABEL: sequence dict { sv_identifier:name=@, ":" space }

ASSERT_KIND: choice {
  'assert':@, 'cover':@, 'assume':@, 'restrict':@
}

// `property` (the LRM-standard) OR `sequence` (only valid for
// `cover`). Captured separately so the host knows which form.
ASSERT_KIND_KW: choice { 'property':@, 'sequence':@ }

// `property NAME([args]); <body> endproperty [: NAME]`
// Structured property-spec, raw fallback (with `endproperty` inside each
// alt so a partial structured match backtracks cleanly — zero regression).
PROPERTY_DECL: sequence dict {
  'property':@:type="property" space,
  sv_identifier:name=@,
  ?<METHOD_PORT_LIST>:args=@,
  ";", "" newline,
  <PROPERTY_DECL_TAIL>
}
PROPERTY_DECL_TAIL: choice {
  sequence {
    "" tab, <PROPERTY_SPEC>:body=@, ?";", "" newline,
    'endproperty', ?<END_LABEL>:end_label=@
  },
  sequence { *:body=@, 'endproperty', ?<END_LABEL>:end_label=@ }
}

// `sequence NAME([args]); <body> endsequence [: NAME]`
SEQUENCE_DECL: sequence dict {
  'sequence':@:type="sequence" space,
  sv_identifier:name=@,
  ?<METHOD_PORT_LIST>:args=@,
  ";", "" newline,
  <SEQUENCE_DECL_TAIL>
}
SEQUENCE_DECL_TAIL: choice {
  sequence {
    "" tab, <SEQUENCE_EXPR>:body=@, ?";", "" newline,
    'endsequence', ?<END_LABEL>:end_label=@
  },
  sequence { *:body=@, 'endsequence' space, ?<END_LABEL>:end_label=@ }
}

// ─── SVA temporal expression cascade (structured; raw fallback above) ──
// IEEE 1800-2017 §16.7-16.12. PEG precedence cascade. Flat operator
// chains use head/ops/operand (NOT lhs/tail/op/rhs — those trigger
// #opchain folding; see project-sv-opchain-compaction).

// property_spec: [clocking_event] [disable iff (expr)] property_expr
PROPERTY_SPEC: sequence dict {
  ?<SVA_CLOCKING>:clocking=@,
  ?<SVA_DISABLE_IFF>:disable_iff=@,
  <PROPERTY_EXPR>:prop=@
}

SVA_CLOCKING: sequence dict { <EVENT_CONTROL>:event=@, "" space }

SVA_DISABLE_IFF: sequence dict {
  'disable' space, 'iff' space, "(", <EXPR>:cond=@, ")", "" space
}

// Top level: a property TERM, then a flat chain of property-level binary
// operators (or / and / until* / implies / iff). NOTE flat chain — for a
// MIXED unparenthesised implication+binary (`a |-> b and c |-> d`) the
// grouping follows parse order, not the full LRM precedence table;
// parenthesised forms (the common style) group correctly. Round-trips
// regardless. head/ops/operand (not lhs/tail — avoids #opchain folding).
PROPERTY_EXPR: sequence dict {
  <PROP_TERM>:head=@,
  repeat <PROP_BIN_LINK>:ops[]=@
}
PROP_BIN_LINK: sequence dict {
  "" space, <PROP_BIN_OP>:prop_op=@ space, <PROP_TERM>:operand=@
}
PROP_BIN_OP: choice {
  'or':@, 'and':@, 'until_with':@, 's_until_with':@,
  'until':@, 's_until':@, 'implies':@, 'iff':@
}

// property term: prefix forms (not / temporal / if / abort) first
// (distinctive leading keywords), then implication, a parenthesised
// property, then a bare sequence.
PROP_TERM: choice {
  <PROP_NOT>,
  <PROP_TEMPORAL>,
  <PROP_IF>,
  <PROP_ABORT>,
  <PROP_IMPL>,
  <PROP_PAREN>,
  <SEQUENCE_EXPR>
}

// `( property_expr )` — a parenthesised PROPERTY (e.g. `(a |-> b)`), as
// distinct from a parenthesised SEQUENCE (SEQ_PAREN_REP). Tried after
// PROP_IMPL so `(seq) |-> prop` still parses as an implication.
PROP_PAREN: sequence dict {
  "(":type="prop_group", <PROPERTY_EXPR>:prop=@, ")"
}

PROP_NOT: sequence dict {
  'not':@:type="prop_not" space, <PROPERTY_EXPR>:prop=@
}

// `s_eventually p` / `eventually [m:n] p` / `always p` / `always [m:n] p`
// / `s_always [m:n] p` / `nexttime p` / `nexttime [n] p` / `s_nexttime …`
PROP_TEMPORAL: sequence dict {
  "":type="prop_temporal",
  <PROP_TEMPORAL_OP>:temporal_op=@ space,
  ?<SVA_BRACKET_RANGE>:range=@,
  <PROPERTY_EXPR>:prop=@
}
PROP_TEMPORAL_OP: choice {
  's_eventually':@, 'eventually':@, 's_always':@, 'always':@,
  's_nexttime':@, 'nexttime':@
}
SVA_BRACKET_RANGE: sequence dict {
  "[", <SVA_REP_AMOUNT>:amount=@, "]", "" space
}

// `if (expr) property_expr [else property_expr]`
PROP_IF: sequence dict {
  'if':@:type="prop_if" space, "(", <EXPR>:cond=@, ")", "" space,
  <PROPERTY_EXPR>:then=@,
  ?<PROP_ELSE>:else_branch=@
}
PROP_ELSE: sequence dict {
  "" space, 'else' space, <PROPERTY_EXPR>:prop=@
}

// `accept_on (expr) p` / `reject_on` / `sync_accept_on` / `sync_reject_on`
PROP_ABORT: sequence dict {
  "":type="prop_abort",
  <PROP_ABORT_OP>:abort_op=@ space, "(", <EXPR>:cond=@, ")", "" space,
  <PROPERTY_EXPR>:prop=@
}
PROP_ABORT_OP: choice {
  'sync_accept_on':@, 'sync_reject_on':@, 'accept_on':@, 'reject_on':@
}

// sequence |-> / |=> property (operator required; the parent choice
// falls back to a bare SEQUENCE_EXPR when absent).
PROP_IMPL: sequence dict {
  "":type="implication",
  <SEQUENCE_EXPR>:antecedent=@ space,
  <SVA_IMPL_OP>:impl_op=@ space,
  <PROPERTY_EXPR>:consequent=@
}
SVA_IMPL_OP: choice { "|->":@, "|=>":@ }

// sequence_expr: a term, then a flat chain of cycle-delay / binary-op
// links (and / or / intersect / within / throughout).
SEQUENCE_EXPR: sequence dict {
  <SEQ_TERM>:head=@,
  repeat <SEQ_CHAIN>:ops[]=@
}
SEQ_CHAIN: choice { <SEQ_DELAY_LINK>, <SEQ_BINOP_LINK> }
SEQ_DELAY_LINK: sequence dict {
  "" space, <CYCLE_DELAY>:delay=@ space, <SEQ_TERM>:operand=@
}
SEQ_BINOP_LINK: sequence dict {
  "" space, <SVA_SEQ_OP>:sva_op=@ space, <SEQ_TERM>:operand=@
}
SVA_SEQ_OP: choice {
  'and':@, 'or':@, 'intersect':@, 'within':@, 'throughout':@
}

// term: leading cycle-delay (`##1 a`), a parenthesised sequence, or a
// boolean expression — each with an optional repetition suffix.
SEQ_TERM: choice {
  <SEQ_DELAY_PREFIX>,
  <SEQ_FIRST_MATCH>,
  <SEQ_PAREN_REP>,
  <SEQ_BOOL_REP>
}
SEQ_FIRST_MATCH: sequence dict {
  'first_match':@:type="first_match", "(", <SEQUENCE_EXPR>:seq=@, ")",
  ?<SVA_REPETITION>:repetition=@
}
SEQ_DELAY_PREFIX: sequence dict {
  <CYCLE_DELAY>:delay=@ space, <SEQ_TERM>:operand=@
}
SEQ_PAREN_REP: sequence dict {
  "(":type="seq_group", <SEQUENCE_EXPR>:seq=@, ")",
  ?<SVA_REPETITION>:repetition=@
}
SEQ_BOOL_REP: sequence dict {
  <EXPR>:expr=@:type="seq_bool",
  ?<SVA_REPETITION>:repetition=@
}

// `## N`, `## [M:N]`, `## [*]`, `## [+]`, `## [M:$]`
CYCLE_DELAY: sequence dict {
  "##":@:type="cycle_delay",
  choice {
    sequence { "[", <SVA_REP_AMOUNT_STAR>:range=@, "]" },
    <SVA_COUNT>:count=@
  }
}

// Each choice alternative is its own dict so the binding has a container
// (a binding placed directly in a bare `choice` is dropped on save).
SVA_REP_AMOUNT_STAR: choice { <SVA_STAR>, <SVA_PLUS>, <SVA_RANGE> }
SVA_STAR: sequence dict { "*":star=true }
SVA_PLUS: sequence dict { "+":plus=true }
SVA_COUNT: sequence dict { <EXPR>:value=@ }
SVA_RANGE: sequence dict {
  <EXPR>:lo=@, ":", <SVA_RANGE_HI>:hi=@
}
SVA_RANGE_HI: choice { <SVA_UNBOUNDED>, <SVA_COUNT> }
SVA_UNBOUNDED: sequence dict { "$":unbounded=true }

// `[*N]` `[*M:N]` `[*]` `[+]` `[->N]` `[->M:N]` `[=N]` `[=M:N]`
SVA_REPETITION: sequence dict {
  "[",
  <SVA_REP_KIND>:rep_kind=@,
  ?<SVA_REP_AMOUNT>:amount=@,
  "]"
}
SVA_REP_KIND: choice { "->":@, "*":@, "+":@, "=":@ }
SVA_REP_AMOUNT: choice { <SVA_RANGE>, <SVA_COUNT> }

// ─── Coverage, clocking, checkers, fork/join, immediate assertions ─────

// `covergroup NAME [(args)] [coverage_event]; <items> endgroup
// [: NAME]`. Coverpoints, crosses, options, types — all live in
// the body which is captured raw. Host has a dedicated covergroup
// pass to extract structure.
COVERGROUP_DECL: sequence dict {
  'covergroup':@:type="covergroup" space,
  sv_identifier:name=@,
  ?<METHOD_PORT_LIST>:args=@,
  ?<COVERGROUP_SAMPLE>:sample=@,
  ?<EVENT_CONTROL>:clocking=@,
  ";" newline,
  repeat <COVERGROUP_ITEM>:items[]=@ indent tab newline,
  "" tab, 'endgroup' space,
  ?<END_LABEL>:end_label=@
}

// `with function sample (args)` — covergroup sample method (IEEE 1800
// §19.8.1). Tried before the clocking-event clause.
COVERGROUP_SAMPLE: sequence dict {
  "" space, 'with' space, 'function' space, 'sample' space,
  <METHOD_PORT_LIST>:args=@
}

COVERGROUP_ITEM: choice {
  <COVERGROUP_OPTION>,
  <COVER_CROSS>,
  <COVERPOINT>
}

// `option.X = v;` / `type_option.X = v;`
COVERGROUP_OPTION: sequence dict {
  choice { 'type_option':kind="type_option", 'option':kind="option" },
  ".", sv_identifier:name=@,
  "=" space, <EXPR>:value=@,
  ";"
}

// `[label :] coverpoint <expr> [iff (cond)] (";" | "{ bins }")`
COVERPOINT: sequence dict {
  ?<COVER_LABEL>:label=@,
  'coverpoint':@:type="coverpoint" space,
  <EXPR>:expr=@,
  ?<COVER_IFF>:iff=@,
  <COVER_BODY>:body=@
}

// `[label :] cross p1, p2, ... (";" | "{ bins }")`
COVER_CROSS: sequence dict {
  ?<COVER_LABEL>:label=@,
  'cross':@:type="cross" space,
  repeat+ <EXPR>:points[]=@ separator "," space,
  ?<COVER_IFF>:iff=@,
  <COVER_BODY>:body=@
}

COVER_LABEL: sequence dict { sv_identifier:name=@, "" space, ":" space }

COVER_IFF: sequence dict {
  "" space, 'iff' space, "(", <EXPR>:cond=@, ")"
}

COVER_BODY: choice {
  sequence dict { "" space, "{":type="cover_bins" newline,
    repeat <BINS_DECL>:bins[]=@ indent tab newline,
    "" tab, "}" },
  sequence dict { ";":type="cover_simple" }
}

BINS_DECL: sequence dict {
  ?'wildcard':is_wildcard=true space,
  <BINS_KIND>:kind=@ space,
  sv_identifier:name=@,
  ?<BINS_ARRAY>:array=@,
  "" space, "=" space,
  <BINS_RHS>:value=@,
  ";"
}
BINS_KIND: choice { 'illegal_bins':@, 'ignore_bins':@, 'bins':@ }
BINS_ARRAY: sequence dict { "[", ?<EXPR>:size=@, "]" }
BINS_RHS: choice {
  sequence dict { 'default':is_default=true, ?<BINS_DEFAULT_SEQ>:default_seq=@ },
  <BINS_SELECT_EXPR>,
  <BINS_TRANS>,
  sequence dict { "{",
    repeat+ <BIN_VALUE>:values[]=@ separator "," space, "}" }
}
BIN_VALUE: choice { <INSIDE_RANGE>, <EXPR> }

// Cross-bin select (IEEE 1800-2017 §19.6.1): `binsof(x) [intersect {s}]`
// optionally combined with `&&`/`||` (e.g. UVM cross filters).
// NB: fields are `head`/`ops`, NOT `lhs`/`tail` — the latter is the
// opchain always-wrap shape, which compact_opchain folds (`&&`/`||` are
// ladder ops), turning this into `{op,args}` the bins save can't rebuild
// (it then saved as an empty `{}`).
BINS_SELECT_EXPR: sequence dict {
  <BINS_SELECT_TERM>:head=@,
  repeat <BINS_SELECT_TAIL>:ops[]=@,
  ?<BINS_SELECT_WITH>:with=@,
  ?<COVER_IFF>:iff=@
}
BINS_SELECT_WITH: sequence dict {
  "" space, 'with' space, "(", <EXPR>:cond=@, ")"
}
BINS_SELECT_TAIL: sequence dict {
  "" space, choice { "&&":bool_op="&&", "||":bool_op="||" } space,
  <BINS_SELECT_TERM>:operand=@
}
BINS_SELECT_TERM: choice {
  sequence dict { "(", <BINS_SELECT_EXPR>:group=@, ")" },
  sequence dict {
    ?"!":negate=true,
    'binsof':@:type="binsof", "(", <EXPR>:arg=@, ")",
    ?<BINS_INTERSECT>:intersect=@
  }
}
BINS_INTERSECT: sequence dict {
  "" space, 'intersect' space,
  "{", repeat+ <BIN_VALUE>:values[]=@ separator "," space, "}"
}

// Transition bin: `( a => b [=> c ...] )` (IEEE 1800-2017 §19.5).
BINS_TRANS: sequence dict {
  "(":type="bins_trans",
  repeat+ <EXPR>:trans[]=@ separator "=>" space,
  ")"
}
BINS_DEFAULT_SEQ: sequence dict { "" space, 'sequence':is_sequence=true }

// `clocking [NAME] @(<event>); <items> endclocking [: NAME]`.
// Used in testbenches to declare a clock domain with timing/skew info
// for signals. Structured (event, default skew, direction decls) with a
// raw-text fallback (the `endclocking` lives inside each alternative so a
// partial structured match backtracks cleanly — zero parse regression).
CLOCKING_BLOCK: sequence dict {
  ?<DEFAULT_KW>:is_default=@ space,
  'clocking':@:type="clocking" space,
  ?<IDENT_OPT>:name=@,
  <CLOCKING_TAIL>
}
CLOCKING_TAIL: choice {
  sequence {
    <EVENT_CONTROL>:event=@, ";", "" newline,
    repeat <CLOCKING_ITEM>:items[]=@ indent tab newline,
    "" tab, 'endclocking' space, ?<END_LABEL>:end_label=@
  },
  sequence {
    *:body=@, 'endclocking' space, ?<END_LABEL>:end_label=@
  }
}

CLOCKING_ITEM: choice {
  <CLOCKING_DEFAULT_SKEW>,
  <CLOCKING_DIR_DECL>
}

// `default [input <skew>] [output <skew>];`
CLOCKING_DEFAULT_SKEW: sequence dict {
  'default':@:type="clocking_default" space,
  ?<CLOCKING_IN_SKEW>:input_skew=@,
  ?<CLOCKING_OUT_SKEW>:output_skew=@,
  ";"
}
CLOCKING_IN_SKEW: sequence dict { 'input':@ space, <CLOCKING_SKEW>:skew=@ }
CLOCKING_OUT_SKEW: sequence dict { 'output':@ space, <CLOCKING_SKEW>:skew=@ }

// `<input|output|inout> [skew] signal[ = expr][, ...];`
CLOCKING_DIR_DECL: sequence dict {
  <CLOCKING_DIR>:direction=@:type="clocking_dir" space,
  ?<CLOCKING_SKEW>:skew=@,
  repeat <CLOCKING_SIGNAL>:signals[]=@ separator ",",
  ";"
}
CLOCKING_DIR: choice { 'input':@, 'output':@, 'inout':@ }
CLOCKING_SIGNAL: sequence dict {
  sv_identifier:name=@, ?<CLOCKING_SIGNAL_INIT>:init=@
}
CLOCKING_SIGNAL_INIT: sequence dict { "" space, "=" space, <EXPR>:value=@ }

// skew: an edge (`posedge`/`negedge`/`edge`) and/or a `#delay`
// (`#1step`, `#0`, `#(expr)`).
CLOCKING_SKEW: choice {
  <CLOCKING_SKEW_EDGE>,
  <CLOCKING_SKEW_DELAY>
}
CLOCKING_SKEW_EDGE: sequence dict {
  <CLOCK_EDGE_KW>:edge=@, ?<CLOCKING_SKEW_DELAY_TAIL>:delay=@, "" space
}
CLOCKING_SKEW_DELAY_TAIL: sequence dict {
  "" space, <CLOCKING_DELAY_VALUE>:value=@
}
CLOCK_EDGE_KW: choice { 'posedge':@, 'negedge':@, 'edge':@ }
CLOCKING_SKEW_DELAY: sequence dict {
  <CLOCKING_DELAY_VALUE>:value=@, "" space
}
CLOCKING_DELAY_VALUE: sequence dict {
  "#",
  choice {
    sequence { "(", <EXPR>:expr=@, ")" },
    sequence { "1step":is_1step=true },
    sequence { <NUMBER>:amount=@ }
  }
}

// Single-key rules wrapped in Choice (rawast doesn't allow bare
// keys as rule bodies).
// `default` or `global` prefix on a clocking block. Both forms
// (per SV-1800) tag the block as a module-wide default or a
// system-wide global. Pure parse: host distinguishes via the
// captured keyword string.
DEFAULT_KW: choice { 'default':@, 'global':@ }
IDENT_OPT: sequence { sv_identifier:name=@ }

// `checker NAME(args); <items> endchecker [: NAME]`. SV-1800
// construct for reusable verification IP. Body captured raw.
CHECKER_DECL: sequence dict {
  'checker':@:type="checker" space,
  sv_identifier:name=@,
  ?<METHOD_PORT_LIST>:args=@,
  ";",
  *:body=@,
  'endchecker' space,
  ?<END_LABEL>:end_label=@
}

// `fork <stmts> join` / `join_any` / `join_none` — concurrent block.
// Body is `repeat <BLOCK_ITEM>` so nested `fork ... join_any` inside
// an outer `fork ... join` parses with proper depth (no greedy
// wildcard scan claiming the inner terminator). Unified into a
// single rule with the trailing join keyword as a choice so the
// engine doesn't re-parse the body three times (which scaled
// exponentially with fork nesting).
FORK_JOIN: sequence dict {
  'fork':@:type="fork_join" space,
  ?<BLOCK_LABEL>,
  "" newline,
  repeat <BLOCK_ITEM>:items[]=@ indent tab newline,
  "" tab, <FORK_JOIN_KIND>:kind=@ space,
  ?<END_LABEL>:end_label=@
}

// Tried most-specific suffix first so `join_none` and `join_any`
// aren't claimed as plain `join` followed by garbage.
FORK_JOIN_KIND: choice {
  'join_none':@,
  'join_any':@,
  'join':@
}

// Immediate assertion inside procedural code:
// `assert(expr) [else <stmt>];` or `assert(expr);` or
// `cover(expr);` or `assume(expr);`. Body and optional action
// captured raw to the next `;`.
//
// Distinguished from CONCURRENT_ASSERT by the lack of `property`
// keyword after the kind — that lookahead would need negative
// peek, so we use Choice ordering: CONCURRENT_ASSERT (which
// requires `property`) lives in MODULE_ITEM; IMMEDIATE_ASSERT
// lives in STATEMENT (procedural context).
IMMEDIATE_ASSERT: sequence dict {
  ?<ASSERTION_LABEL>:label=@,
  <ASSERT_KIND>:kind=@:type="assert_immediate",
  ?<ASSERT_DEFER>:defer=@,
  "(",
  sv_balanced_arg:body=@,
  ")",
  <ASSERT_ACTION>:action=@,
  ?";"
}

// Optional qualifier between the kind and `(`: `final` (final-deferred,
// §16.4) — `assert final ($onehot0(x)) else …` — or a `#delay`
// (observed-deferred, `assert #0 (…)`).
ASSERT_DEFER: choice {
  sequence dict { "" space, 'final':is_final=true space },
  sequence dict { "" space, <DELAY>:delay=@ space }
}

// ─── Extern, UDP, config, program (parse-only) ─────────────────────────

// `extern module NAME (...);` / `extern task NAME;` /
// `extern function ... NAME;` — forward declarations. Captured as
// raw text up to `;` for host to re-parse.
EXTERN_DECL: sequence dict {
  'extern':@:type="extern",
  *:body=@,
  ";"
}

// `primitive NAME (...); <body> endprimitive [: NAME]` — UDP
// (user-defined primitive). Body is a small DSL of input/output
// declarations + a truth table. Captured raw.
UDP_DECL: sequence dict {
  'primitive':@:type="primitive" space,
  sv_identifier:name=@,
  ?<METHOD_PORT_LIST>:args=@,
  ";",
  *:body=@,
  'endprimitive',
  ?<END_LABEL>:end_label=@
}

// `config NAME; <items> endconfig [: NAME]` — design configuration.
CONFIG_DECL: sequence dict {
  'config':@:type="config" space,
  sv_identifier:name=@,
  ";",
  *:body=@,
  'endconfig',
  ?<END_LABEL>:end_label=@
}

// `program NAME (...); <items> endprogram [: NAME]` — program
// blocks for testbench code. Body is essentially the same as a
// module body so we reuse MODULE_ITEMS.
//
// Conflict note: MODULE_KEYWORD already accepts 'program' (a
// long-standing alias for 'module' in this grammar). Real LRM
// SV makes them distinct — `endprogram` ends a program, not
// `endmodule`. We've kept the alias for back-compat with
// existing tests; PROGRAM_DECL here adds the LRM-correct form
// alongside, with explicit `program`/`endprogram` matching.
// MODULE_KEYWORD's `program` alt would only fire as a fallback
// when PROGRAM_DECL fails (e.g. when `endmodule` is used).
PROGRAM_DECL: sequence dict {
  'program':@:type="program" space,
  sv_identifier:name=@,
  ?<PARAM_PORT_LIST>:param_ports=@,
  ?<PORT_LIST>:ports=@,
  ";",
  <MODULE_ITEMS>:items=@,
  'endprogram',
  ?<END_LABEL>:end_label=@
}

// ─── Small remaining gaps (genvar, nettype, randsequence, fork-ctrl) ───

// `genvar i, j, k;` — generate-loop variable declarations. Standalone
// form (not inside a `for` header). Multiple names per declaration
// supported via the `:[]=@` list-append pattern.
GENVAR_DECL: sequence dict {
  'genvar':@:type="genvar" space,
  repeat+ sv_identifier:names[]=@ separator "," space,
  ";"
}

// `nettype <type> <name> [with <function>];` — SV-1800-2012
// user-defined nettypes. Body captured raw up to `;`.
NETTYPE_DECL: sequence dict {
  'nettype':@:type="nettype",
  *:body=@,
  ";"
}

// `randsequence (<id>) <productions> endsequence` — class
// randomization construct. Body captured raw.
RANDSEQUENCE_STMT: sequence dict {
  'randsequence':@:type="randsequence",
  *:body=@,
  'endsequence'
}

// `wait fork ;` — wait for all forked threads to terminate.
WAIT_FORK_STMT: sequence dict {
  'wait':@:type="wait_fork" space,
  'fork',
  ";"
}

// `disable fork ;` — terminate all forked threads.
DISABLE_FORK_STMT: sequence dict {
  'disable':@:type="disable_fork" space,
  'fork',
  ";"
}

// ─── Global clocking (top-level / module-item) ────────────────────────

// `global clocking [NAME] @(<event>); endclocking [: NAME];`
// SV-1800 top-level clocking domain. Module-item position.
//
// Note: tried via the regular CLOCKING_BLOCK path with `default`
// or `global` as the prefix keyword. CLOCKING_BLOCK's `?<DEFAULT_KW>`
// handles `default`; add `global` to that Choice in the DEFAULT_KW
// rule definition. Keeps the body shape identical.

// ─── Control-flow statements (return / break / continue / do-while / foreach) ─

// `return [<expr>];` — function return.
RETURN_STMT: sequence dict {
  'return':@:type="return" space,
  ?<EXPR>:value=@,
  ";"
}

// `break;` and `continue;` — loop control.
BREAK_STMT: sequence dict {
  'break':@:type="break",
  ";"
}

CONTINUE_STMT: sequence dict {
  'continue':@:type="continue",
  ";"
}

// `do <stmt> while (<expr>);` — post-test loop.
DO_WHILE_STMT: sequence dict {
  'do':@:type="do_while" space,
  <STATEMENT>:body=@ space,
  'while' space,
  "(", <EXPR>:cond=@, ")",
  ";"
}

// `foreach (array[i, j, ...]) <stmt>` — array iteration.
// The bracket-section captures iteration variables as raw text;
// host re-parses the comma-separated index list.
FOREACH_STMT: sequence dict {
  'foreach':@:type="foreach" space,
  "(", <FOREACH_ITER>:iter=@, ")",
  <STATEMENT>:body=@
}

// `arr[i]`, `arr[i][j]`, `arr[i, j]` — the loop-array reference plus its
// per-dimension loop variables (IEEE 1800-2017 §12.7.3).
FOREACH_ITER: sequence dict {
  sv_qualified_type:array=@,
  repeat+ <FOREACH_DIM>:dims[]=@
}

FOREACH_DIM: sequence dict {
  "[",
  repeat <sv_identifier>:vars[]=@ separator ",",
  "]"
}

// `obj.method(args);` / `obj.field.method(args);` — method call
// as a statement. Distinct from TASK_CALL which is just
// `name(args);`. The trailing `with { ... }` clause is supported
// via the same METHOD_CALL primary rule's optional with-clause.
METHOD_CALL_STMT: sequence dict {
  sv_identifier:name=@:type="method_call_stmt",
  repeat+ <HIER_PART>:path[]=@,
  "(",
  repeat <TASK_ARG>:args[]=@ separator ",",
  ")",
  ?<WITH_CLAUSE>:with=@,
  repeat <DOT_CALL>:chain[]=@,
  ";"
}

// `.method(args)` link in a method-call chain — `obj.get().set(n)`,
// `pkg::factory().build()`. Appended after a base call in the
// statement-call rules (kept out of the shared HIER_PART, which the
// declaration/lvalue rules also consume).
DOT_CALL: sequence dict {
  ".", sv_identifier:method=@:type="method_chain",
  "(",
  repeat <TASK_ARG>:args[]=@ separator ",",
  ")",
  ?<WITH_CLAUSE>:with=@
}

// `Class#(params)::static_method(args);` — UVM idiom
// `uvm_config_db#(virtual ifc)::set(...)`. IEEE 1800-2017 §23.7
// permits a static method call qualified by a parameterised class
// expression. Tried as a statement-level alt; the matching PRIMARY
// form (when the call's return value is consumed) is handled by
// PARAMETERIZED_TYPE_REF's optional `?<PARAM_STATIC_CALL_TAIL>`.
PARAM_STATIC_CALL_STMT: sequence dict {
  sv_identifier:class=@:type="param_static_call_stmt",
  "#", "(",
  repeat sv_balanced_arg:type_params[]=@ separator ",",
  ")",
  "::",
  sv_identifier:method=@,
  "(",
  repeat <TASK_ARG>:args[]=@ separator ",",
  ")",
  ";"
}

// `virtual [interface] <type_name> [#(params)] name [, name2, ...];` —
// virtual-interface reference declaration. SV-1800 LRM allows the
// `interface` keyword to be omitted when followed by a typedef'd
// interface name. Used in testbench classes to hold a handle to
// an interface instance.
//
// Body captured raw between `virtual [interface]` and the trailing
// `;` so the optional `#(...)` parameter override and the
// comma-separated identifier list are both handled by the host.
// `virtual interface IFC name;` / `virtual NAME name;` — a virtual
// interface handle. The leading negative lookahead for `class`
// prevents this rule from swallowing `virtual class …` (which is
// CLASS_DECL_VIRTUAL); without it, the wildcard body would consume
// `class Inner` up to the `;` and the enclosing class-body repeat
// would see only `endclass int x; endclass` as stray content.
VIRTUAL_INTERFACE_DECL: sequence dict {
  'virtual':@:type="virtual_interface" space,
  !'class',
  ?'interface':is_interface=true space,
  *:body=@,
  ";"
}




// ═══════════════════════════════════════════════════════════════
// Preprocessor rules (merged from sv_preprocessor.rawast).
// Reachable via parse_from(g, "PP_FILE"); the SV start rule is
// unchanged. `if/`elsif conditions subparse to the SV COND_EXPR, so
// no separate expression ladder. Rules clashing with SV carry a PP_
// prefix (PP_DEFINE/PP_IFDEF/PP_IFNDEF/PP_INCLUDE/PP_MACRO_USE/PP_UNDEF).
// ═══════════════════════════════════════════════════════════════

// `linespace` + `line_comment` — horizontal whitespace AND
// trailing `//` comments at every rule-frame boundary, so
// `\`endif // INC_ASSERT` parses the same as a bare `\`endif`.
// TEXT_LINE overrides with `ignore:` empty so a `// comment` on
// its own line stays captured as line content.
PP_FILE ignore linespace line_comment: sequence array {
  repeat <PP_ITEM>
}

PP_ITEM: choice {
  <PP_DEFINE>,
  <PP_UNDEF>,
  <PP_INCLUDE>,
  <PP_IFDEF>,
  <PP_IFNDEF>,
  <IF>,
  <TEXT_LINE>
}

PP_IFDEF: sequence dict {
  "`ifdef":type="ifdef" space,
  identifier:cond=@,
  "\n",
  <BODY>:body=@,
  repeat <IFDEF_ELSIF>:elsif_branches[]=@,
  ?<ELSE_BRANCH>:else_branch=@,
  "`endif",
  "\n"
}

PP_IFNDEF: sequence dict {
  "`ifndef":type="ifndef" space,
  identifier:cond=@,
  "\n",
  <BODY>:body=@,
  repeat <IFDEF_ELSIF>:elsif_branches[]=@,
  ?<ELSE_BRANCH>:else_branch=@,
  "`endif",
  "\n"
}

BODY: sequence array {
  repeat <PP_ITEM>
}

ELSE_BRANCH: sequence dict {
  "`else",
  "\n",
  <BODY>:body=@
}

IF: sequence dict {
  <IF_HEAD>:branches[]=@,
  repeat <ELSIF>:branches[]=@,
  ?<ELSE_BRANCH>:else_branch=@,
  "`endif":type="if",
  "\n"
}

// IF_HEAD/ELSIF capture the condition as the rest of the line (raw
// text) — robust: ANY `\`if` preprocesses, even conditions outside the
// PP_EXPR subset (sized literals, shifts, ternary, macro calls). The
// evaluator parses the captured text through the PP_EXPR rule below
// (Grammar::parse_from start="PP_EXPR") on demand; a cond it can't parse
// is undecidable, never a hard parse failure. The walker trims the
// leading space (Raw bypasses `ignore`) before evaluating.
// `if/`elsif conditions subparse to the SV expression grammar via PP_COND.
// COND_EXPR can't be the subparse target directly: the SV whitespace policy
// is declared on the SOURCE_TEXT start rule, so COND_EXPR doesn't inherit it
// in a parse_from entry — and the raw `*` cond capture keeps a leading space.
// PP_COND declares the ignore (skips that space + inter-token whitespace,
// which propagates into COND_EXPR's children since none override) and is
// transparent, so the cond AST is exactly COND_EXPR's.
PP_COND ignore whitespace line_comment block_comment: choice { <COND_EXPR> }

IF_HEAD: sequence dict {
  "`if" space,
  *:cond=@:#subparse="PP_COND",
  "\n",
  <BODY>:body=@
}

ELSIF: sequence dict {
  "`elsif" space,
  *:cond=@:#subparse="PP_COND",
  "\n",
  <BODY>:body=@
}

// `\`elsif` in an `\`ifdef`/`\`ifndef` chain tests DEFINEDNESS, so its
// condition is a macro name. Using `identifier` (not the raw `*` of the
// expression ELSIF) keeps cond clean — no leading space to trim — and the
// `space` provides the separator on save.
IFDEF_ELSIF: sequence dict {
  "`elsif" space,
  identifier:cond=@,
  "\n",
  <BODY>:body=@
}

PP_UNDEF: sequence dict {
  "`undef":type="undef" space,
  identifier:name=@,
  "\n"
}

PP_INCLUDE: sequence dict {
  "`include":type="include" space,
  std.string:path=@,
  "\n"
}

// A single line of arbitrary text. Line content captured as
// `scope array { <PP_MACRO_USE> }` so embedded `\`NAME` calls surface
// as macro_use dicts in segments; everything else stays as bare
// StringValue text runs. The walker iterates segments.
//
// `ignore:` overrides the inherited policy — line whitespace is
// content. Leading negative-lookaheads keep TEXT_LINE from claiming
// structural close tokens.
TEXT_LINE ignore: sequence dict {
  !"`endif",
  !"`else",
  !"`elsif",
  scope array { <PP_MACRO_USE> }:segments=@,
  "\n":type="text_line"
}

// `\`define NAME [(p1, …)] body`. The name + optional params sits
// inside DECL with empty ignore so the LRM adjacency rule survives:
//
//   `\`define FOO(x) bar`    → parameterised: params=["x"], body=[bar]
//   `\`define FOO (x) bar`   → object-like:   no params,   body=[(x) bar]
// `\`define NAME [(p1, …)] body` — per SV-1800 §22.5.1, `body` ends
// at the next UNESCAPED newline. A backslash immediately before a
// newline (`\<newline>`) is a line continuation: both bytes belong
// to the body, and the body keeps going. Add `LINE_CONT` as an
// explicit INNER so scope's byte-scanner consumes it instead of
// treating the trailing `\n` as the body's terminator.
PP_DEFINE: sequence dict {
  "`define":type="define" space,
  <DECL>:decl=@ space,
  <DEFINE_BODY>:body=@,
  "\n"
}

// Override PP_FILE's inherited `ignore linespace line_comment`,
// keeping ONLY `linespace`. line_comment must NOT strip `// ...`
// inside the macro body — if it did, the `//` would be consumed
// but the trailing comment identifiers (`// init` → `init`) would
// survive as PARAM_REF INNER matches, leaking the comment WORDS
// into the body without their `//` marker. With line_comment
// dropped from the ignore set here, the `//` and the rest of the
// comment text are captured as raw bytes in a literal segment,
// and handle_define strips them with full segment-aware skip
// (find `//` in a literal segment, then drop subsequent typed
// segments up to the next LINE_CONT boundary).
//
// `linespace` is kept so MACRO_USE inside a body still matches
// `\`OTHER (x)` (LRM §22.5.1 allows whitespace between macro name
// and the opening `(` at the use site).
DEFINE_BODY ignore linespace: scope array {
  <STRINGIFY>, <TOKEN_PASTE>, <PP_MACRO_USE>, <STRING>, <PARAM_REF>, <LINE_CONT>
}

// `\`\`` — token paste operator (IEEE 1800-2017 §22.5.1). Adjacent
// to a parameter or identifier on either side; substituted text on
// the two sides fuses because the operator is dropped at expansion
// time. Tried BEFORE MACRO_USE so the second backtick of `\`\`X`
// can't be misread as the start of a `\`X` macro use.
TOKEN_PASTE: sequence dict {
  "``":type="token_paste"
}

// `\`"..\`"` — stringification (IEEE 1800-2017 §22.5.1). Opens
// and closes a string literal in the expanded text; parameters
// referenced inside undergo substitution before the literal is
// formed. Tried BEFORE STRING so the leading `\`"` doesn't get
// half-parsed as text-`\`` plus a regular `"…"` string.
STRINGIFY: sequence dict {
  "`\"":type="stringify",
  scope array { <PP_MACRO_USE>, <PARAM_REF>, <TOKEN_PASTE> }:segments=@,
  "`\""
}

// `\<newline>` — line continuation inside a macro body. Engine
// consumes both bytes as one INNER match so the surrounding scope's
// terminator check (looking for an UNESCAPED `\n`) doesn't fire.
// The captured text still contains the literal `\` + `\n`;
// Preprocessor::handle_define strips them at store time so the
// expanded body is the joined form.
LINE_CONT ignore: sequence { "\\", "\n" }

// `ignore:` empty — the engine runs the OUTER PP_FILE's `ignore
// linespace` at DECL's boundary (eats the space after `\`define`),
// then DECL's empty policy takes effect for its internal items.
// `?<PARAMS>` predictive uses DECL's empty: peek raw cursor — `(`
// takes PARAMS, space skips it.
DECL ignore: sequence dict {
  identifier:name=@,
  ?<PARAMS>:params=@
}

// PARAMS overrides with its own `ignore linespace` so internal
// whitespace works — DECL above has empty ignore which would
// otherwise propagate into PARAMS via inheritance.
//
// Per IEEE 1800-2017 §22.5.1, each formal accepts an optional
// `= default_text` clause. `default_text` is balanced text up to
// the next top-level `,` or `)` — `sv_balanced_arg` is exactly
// this scanner, so the default value captures cleanly even when
// it itself contains balanced parens (`ARGS_ = ()`, `X = (a+b)`).
PARAMS ignore linespace: sequence array {
  "(",
  repeat <PARAM_FORMAL> separator ",",
  ")"
}

PARAM_FORMAL: sequence dict {
  identifier:name=@,
  ?<PARAM_FORMAL_DEFAULT>:default=@
}

PARAM_FORMAL_DEFAULT: sequence dict {
  "=", sv_balanced_arg:value=@
}

// `\`NAME[(args)]` use site. No explicit ignore — inherit from
// caller. LRM §22.5.1 allows whitespace between macro name and the
// opening `(` of args at the use site (asymmetric to `\`define`,
// where no whitespace is allowed). Inside a macro body MACRO_USE
// inherits PP_FILE's `ignore linespace`, so `\`INC (Y)` captures
// (Y) as args. Inside TEXT_LINE (empty ignore), line content stays
// verbatim — `\`FOO (5)` at the top level treats `(5)` as text.
PP_MACRO_USE: sequence dict {
  "`":type="macro_use",
  identifier:name=@,
  ?<MACRO_ARGS>:args=@
}

// Args at the use site. LRM §22.5.1: each arg is a balanced-paren
// token run terminating at the top-level `,` or `)`. `sv_balanced_arg`
// is the depth-tracking scanner that captures exactly one such arg
// as raw bytes — it follows `()`/`{}`/`[]` nesting and skips over
// string literals, so embedded commas / closing parens inside nested
// structures or strings don't end the arg. Same scanner used for
// PARAM_FORMAL_DEFAULT, so macro-call args and define-default values
// share one balanced-text implementation.
//
// Result shape: ArrayValue<StringValue> — each StringValue holds one
// arg's raw bytes, the flat-text shape the substitution pipeline
// consumes.
//
// `ignore linespace` applies between structural items (around `,`,
// before `)`); whitespace INSIDE an arg is preserved by the scanner.
MACRO_ARGS ignore linespace: sequence array {
  "(",
  repeat sv_balanced_arg separator ",",
  ")"
}

STRING: sequence dict {
  std.string:type="string":value=@
}

PARAM_REF: sequence dict {
  identifier:type="ref":value=@
}
