{
  "start": {
    "type": "GRAMMAR"
  },
  "use": [
    "std"
  ],
  "BINDING": {
    "container": "dict",
    "type": "sequence",
    "value": [
      {
        "key": ":",
        "type": "key"
      },
      {
        "type": "BIND_EXPR"
      }
    ]
  },
  "BINDINGS": {
    "container": "array",
    "type": "sequence",
    "value": [
      {
        "min": 1,
        "type": "repeat",
        "value": {
          "type": "BINDING"
        }
      }
    ]
  },
  "BIND_EXPR": {
    "type": "choice",
    "value": [
      {
        "type": "NAME_BIND"
      },
      {
        "type": "RESERVED_VALUE_BIND"
      },
      {
        "type": "VALUE_BIND"
      }
    ]
  },
  "BIND_VAL": {
    "type": "choice",
    "value": [
      {
        "emit": true,
        "key": "@",
        "type": "key"
      },
      {
        "type": "CONSTANT"
      }
    ]
  },
  "CHOICE_EXPR": {
    "type": "sequence",
    "value": [
      {
        "bindings": [
          {
            "name": "type",
            "value": "choice"
          }
        ],
        "key": "choice",
        "space": true,
        "type": "key"
      },
      {
        "key": "{",
        "newline": true,
        "type": "key"
      },
      {
        "bindings": [
          {
            "name": "value",
            "value": "@"
          }
        ],
        "type": "ITEMS"
      },
      {
        "key": "",
        "newline": true,
        "type": "key"
      },
      {
        "key": "}",
        "tab": true,
        "type": "key"
      }
    ]
  },
  "CONSTANT": {
    "type": "choice",
    "value": [
      {
        "type": "string"
      },
      {
        "type": "float"
      },
      {
        "type": "int"
      },
      {
        "key": "null",
        "type": "key",
        "value": null
      },
      {
        "key": "true",
        "type": "key",
        "value": true
      },
      {
        "key": "false",
        "type": "key",
        "value": false
      }
    ]
  },
  "CONTAINER_KIND": {
    "type": "choice",
    "value": [
      {
        "emit": true,
        "key": "array",
        "type": "key"
      },
      {
        "emit": true,
        "key": "dict",
        "type": "key"
      }
    ]
  },
  "EXPR": {
    "type": "choice",
    "value": [
      {
        "type": "SEQUENCE_EXPR"
      },
      {
        "type": "CHOICE_EXPR"
      },
      {
        "type": "REPEAT_EXPR"
      },
      {
        "type": "SCOPE_EXPR"
      },
      {
        "type": "RAW_EXPR"
      },
      {
        "type": "KEY_EXPR"
      },
      {
        "type": "KEY_STRICT_EXPR"
      },
      {
        "type": "REF"
      },
      {
        "type": "PARSE_EXPR"
      }
    ]
  },
  "GRAMMAR": {
    "container": "dict",
    "rule_ignore": [
      "whitespace",
      "line_comment",
      "block_comment"
    ],
    "type": "sequence",
    "value": [
      {
        "type": "repeat",
        "value": {
          "newline": true,
          "type": "GRAMMAR_ENTRY"
        }
      }
    ]
  },
  "GRAMMAR_ENTRY": {
    "type": "choice",
    "value": [
      {
        "type": "USE_DECL"
      },
      {
        "type": "START_DECL"
      },
      {
        "type": "RULE_DEF"
      }
    ]
  },
  "IDENT_LIST": {
    "container": "array",
    "type": "sequence",
    "value": [
      {
        "separator": {
          "key": ",",
          "space": true,
          "type": "key"
        },
        "type": "repeat",
        "value": {
          "type": "qualified_identifier"
        }
      }
    ]
  },
  "IGNORE_LIST": {
    "container": "array",
    "type": "sequence",
    "value": [
      {
        "type": "repeat",
        "value": {
          "space": true,
          "type": "qualified_identifier"
        }
      }
    ]
  },
  "ITEM": {
    "container": "dict",
    "type": "sequence",
    "value": [
      {
        "bindings": [
          {
            "name": "optional",
            "value": true
          }
        ],
        "key": "?",
        "optional": true,
        "type": "key"
      },
      {
        "bindings": [
          {
            "name": "negative",
            "value": true
          }
        ],
        "key": "!",
        "optional": true,
        "type": "key"
      },
      {
        "type": "EXPR"
      },
      {
        "bindings": [
          {
            "name": "bindings",
            "value": "@"
          }
        ],
        "optional": true,
        "type": "BINDINGS"
      },
      {
        "type": "repeat",
        "value": {
          "type": "POSTFIX_ATTR"
        }
      }
    ]
  },
  "ITEMS": {
    "container": "array",
    "type": "sequence",
    "value": [
      {
        "separator": {
          "key": ",",
          "newline": true,
          "type": "key"
        },
        "type": "repeat",
        "value": {
          "indent": true,
          "tab": true,
          "type": "ITEM"
        }
      }
    ]
  },
  "KEY_EXPR": {
    "type": "sequence",
    "value": [
      {
        "bindings": [
          {
            "name": "key",
            "value": "@"
          },
          {
            "name": "type",
            "value": "key"
          }
        ],
        "type": "string"
      },
      {
        "optional": true,
        "type": "KEY_VALUE"
      }
    ]
  },
  "KEY_STRICT_EXPR": {
    "type": "sequence",
    "value": [
      {
        "bindings": [
          {
            "name": "key",
            "value": "@"
          },
          {
            "name": "type",
            "value": "strict_key"
          }
        ],
        "type": "single_quote_string"
      },
      {
        "optional": true,
        "type": "KEY_VALUE"
      }
    ]
  },
  "KEY_VALUE": {
    "type": "sequence",
    "value": [
      {
        "key": ":",
        "type": "key"
      },
      {
        "type": "choice",
        "value": [
          {
            "bindings": [
              {
                "name": "emit",
                "value": true
              }
            ],
            "key": "@",
            "type": "key"
          },
          {
            "bindings": [
              {
                "name": "value",
                "value": "@"
              }
            ],
            "type": "CONSTANT"
          }
        ]
      }
    ]
  },
  "NAME_BIND": {
    "type": "sequence",
    "value": [
      {
        "bindings": [
          {
            "name": "var",
            "value": true
          }
        ],
        "key": "=",
        "type": "key"
      },
      {
        "bindings": [
          {
            "name": "value",
            "value": "@"
          }
        ],
        "type": "BIND_VAL"
      }
    ]
  },
  "PARSE_EXPR": {
    "type": "sequence",
    "value": [
      {
        "bindings": [
          {
            "name": "type",
            "value": "@"
          }
        ],
        "type": "qualified_identifier"
      }
    ]
  },
  "POSTFIX_ATTR": {
    "type": "sequence",
    "value": [
      {
        "key": "",
        "space": true,
        "type": "key"
      },
      {
        "type": "POSTFIX_ATTR_KIND"
      }
    ]
  },
  "POSTFIX_ATTR_KIND": {
    "type": "choice",
    "value": [
      {
        "bindings": [
          {
            "name": "indent",
            "value": true
          }
        ],
        "key": "indent",
        "type": "key"
      },
      {
        "bindings": [
          {
            "name": "tab",
            "value": true
          }
        ],
        "key": "tab",
        "type": "key"
      },
      {
        "bindings": [
          {
            "name": "space",
            "value": true
          }
        ],
        "key": "space",
        "type": "key"
      },
      {
        "bindings": [
          {
            "name": "newline",
            "value": true
          }
        ],
        "key": "newline",
        "type": "key"
      },
      {
        "type": "TAIL_ATTR"
      }
    ]
  },
  "RAW_EXPR": {
    "type": "sequence",
    "value": [
      {
        "bindings": [
          {
            "name": "type",
            "value": "raw"
          }
        ],
        "key": "*",
        "type": "key"
      }
    ]
  },
  "REF": {
    "type": "sequence",
    "value": [
      {
        "key": "<",
        "type": "key"
      },
      {
        "bindings": [
          {
            "name": "type",
            "value": "@"
          }
        ],
        "type": "identifier"
      },
      {
        "key": ">",
        "type": "key"
      }
    ]
  },
  "REPEAT_EXPR": {
    "type": "sequence",
    "value": [
      {
        "bindings": [
          {
            "name": "type",
            "value": "repeat"
          }
        ],
        "key": "repeat",
        "space": true,
        "type": "key"
      },
      {
        "optional": true,
        "type": "REPEAT_PLUS_FORM"
      },
      {
        "bindings": [
          {
            "name": "value",
            "value": "@"
          }
        ],
        "space": true,
        "type": "ITEM"
      },
      {
        "optional": true,
        "type": "SEPARATOR"
      }
    ]
  },
  "REPEAT_PLUS_FORM": {
    "type": "choice",
    "value": [
      {
        "type": "REPEAT_PLUS_N"
      },
      {
        "type": "REPEAT_PLUS_ONE"
      }
    ]
  },
  "REPEAT_PLUS_N": {
    "type": "sequence",
    "value": [
      {
        "key": "+",
        "type": "key"
      },
      {
        "bindings": [
          {
            "name": "min",
            "value": "@"
          }
        ],
        "space": true,
        "type": "int"
      }
    ]
  },
  "REPEAT_PLUS_ONE": {
    "type": "sequence",
    "value": [
      {
        "bindings": [
          {
            "name": "min",
            "value": 1
          }
        ],
        "key": "+",
        "space": true,
        "type": "key"
      }
    ]
  },
  "RESERVED_VALUE_BIND": {
    "type": "sequence",
    "value": [
      {
        "key": "#",
        "type": "key"
      },
      {
        "bindings": [
          {
            "name": "name",
            "value": "@"
          },
          {
            "name": "reserved",
            "value": true
          }
        ],
        "type": "identifier"
      },
      {
        "optional": true,
        "type": "RESERVED_VALUE_TAIL"
      }
    ]
  },
  "RESERVED_VALUE_TAIL": {
    "type": "sequence",
    "value": [
      {
        "key": "=",
        "type": "key"
      },
      {
        "bindings": [
          {
            "name": "value",
            "value": "@"
          }
        ],
        "type": "BIND_VAL"
      }
    ]
  },
  "RULE_BODY": {
    "container": "dict",
    "type": "sequence",
    "value": [
      {
        "optional": true,
        "type": "RULE_IGNORE_ATTR"
      },
      {
        "key": ":",
        "space": true,
        "type": "key"
      },
      {
        "bindings": [
          {
            "name": "optional",
            "value": true
          }
        ],
        "key": "?",
        "optional": true,
        "type": "key"
      },
      {
        "bindings": [
          {
            "name": "negative",
            "value": true
          }
        ],
        "key": "!",
        "optional": true,
        "type": "key"
      },
      {
        "type": "EXPR"
      },
      {
        "bindings": [
          {
            "name": "bindings",
            "value": "@"
          }
        ],
        "optional": true,
        "type": "BINDINGS"
      },
      {
        "type": "repeat",
        "value": {
          "type": "POSTFIX_ATTR"
        }
      }
    ]
  },
  "RULE_DEF": {
    "type": "sequence",
    "value": [
      {
        "bindings": [
          {
            "value": "@",
            "var": true
          }
        ],
        "type": "identifier"
      },
      {
        "type": "RULE_BODY"
      }
    ]
  },
  "RULE_IGNORE_ATTR": {
    "type": "sequence",
    "value": [
      {
        "key": "",
        "space": true,
        "type": "key"
      },
      {
        "key": "ignore",
        "space": true,
        "type": "key"
      },
      {
        "bindings": [
          {
            "name": "rule_ignore",
            "value": "@"
          }
        ],
        "type": "IGNORE_LIST"
      }
    ]
  },
  "SCOPE_EXPR": {
    "type": "sequence",
    "value": [
      {
        "bindings": [
          {
            "name": "type",
            "value": "scope"
          }
        ],
        "key": "scope",
        "space": true,
        "type": "key"
      },
      {
        "bindings": [
          {
            "name": "container",
            "value": "@"
          }
        ],
        "optional": true,
        "space": true,
        "type": "CONTAINER_KIND"
      },
      {
        "key": "{",
        "newline": true,
        "type": "key"
      },
      {
        "bindings": [
          {
            "name": "value",
            "value": "@"
          }
        ],
        "type": "ITEMS"
      },
      {
        "key": "",
        "newline": true,
        "type": "key"
      },
      {
        "key": "}",
        "tab": true,
        "type": "key"
      }
    ]
  },
  "SEPARATOR": {
    "type": "sequence",
    "value": [
      {
        "key": "separator",
        "space": true,
        "type": "key"
      },
      {
        "bindings": [
          {
            "name": "separator",
            "value": "@"
          }
        ],
        "type": "ITEM"
      }
    ]
  },
  "SEQUENCE_EXPR": {
    "type": "sequence",
    "value": [
      {
        "bindings": [
          {
            "name": "type",
            "value": "sequence"
          }
        ],
        "key": "sequence",
        "space": true,
        "type": "key"
      },
      {
        "bindings": [
          {
            "name": "container",
            "value": "@"
          }
        ],
        "optional": true,
        "space": true,
        "type": "CONTAINER_KIND"
      },
      {
        "key": "{",
        "newline": true,
        "type": "key"
      },
      {
        "bindings": [
          {
            "name": "value",
            "value": "@"
          }
        ],
        "type": "ITEMS"
      },
      {
        "key": "",
        "newline": true,
        "type": "key"
      },
      {
        "key": "}",
        "tab": true,
        "type": "key"
      }
    ]
  },
  "START_DECL": {
    "type": "sequence",
    "value": [
      {
        "key": "start",
        "type": "key"
      },
      {
        "key": ":",
        "space": true,
        "type": "key"
      },
      {
        "bindings": [
          {
            "name": "start",
            "value": "@"
          }
        ],
        "type": "START_VAL"
      }
    ]
  },
  "START_VAL": {
    "container": "dict",
    "type": "sequence",
    "value": [
      {
        "type": "REF"
      }
    ]
  },
  "TAIL_ATTR": {
    "type": "sequence",
    "value": [
      {
        "key": "tail",
        "type": "key"
      },
      {
        "key": "=",
        "type": "key"
      },
      {
        "bindings": [
          {
            "name": "tail",
            "value": "@"
          }
        ],
        "type": "string"
      }
    ]
  },
  "USE_DECL": {
    "type": "sequence",
    "value": [
      {
        "key": "use",
        "type": "key"
      },
      {
        "key": ":",
        "space": true,
        "type": "key"
      },
      {
        "bindings": [
          {
            "name": "use",
            "value": "@"
          }
        ],
        "type": "IDENT_LIST"
      }
    ]
  },
  "VALUE_BIND": {
    "type": "sequence",
    "value": [
      {
        "bindings": [
          {
            "name": "name",
            "value": "@"
          }
        ],
        "type": "identifier"
      },
      {
        "bindings": [
          {
            "name": "list_append",
            "value": true
          }
        ],
        "key": "[]",
        "optional": true,
        "type": "key"
      },
      {
        "key": "=",
        "type": "key"
      },
      {
        "bindings": [
          {
            "name": "value",
            "value": "@"
          }
        ],
        "type": "BIND_VAL"
      }
    ]
  }
}
