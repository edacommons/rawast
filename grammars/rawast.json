{
  "start": "FILE",
  "use": [
    "std"
  ],
  "ignore": [
    "whitespace",
    "line_comment",
    "block_comment"
  ],
  "FILE": {
    "type": "sequence",
    "container": "dict",
    "items": [
      {
        "type": "repeat",
        "item": {
          "type": "FILE_ENTRY"
        }
      }
    ]
  },
  "FILE_ENTRY": {
    "type": "choice",
    "newline": true,
    "items": [
      {
        "type": "USE_DECL"
      },
      {
        "type": "IGNORE_DECL"
      },
      {
        "type": "START_DECL"
      },
      {
        "type": "RULE_DEF"
      }
    ]
  },
  "USE_DECL": {
    "type": "sequence",
    "items": [
      {
        "type": "key",
        "key": "use"
      },
      {
        "type": "key",
        "key": ":"
      },
      {
        "type": "IDENT_LIST",
        "bindings": [
          {
            "name": "use",
            "value": "@"
          }
        ]
      }
    ]
  },
  "IGNORE_DECL": {
    "type": "sequence",
    "items": [
      {
        "type": "key",
        "key": "ignore"
      },
      {
        "type": "key",
        "key": ":"
      },
      {
        "type": "IDENT_LIST",
        "bindings": [
          {
            "name": "ignore",
            "value": "@"
          }
        ]
      }
    ]
  },
  "IDENT_LIST": {
    "type": "sequence",
    "container": "array",
    "items": [
      {
        "type": "repeat",
        "separator": {
          "type": "key",
          "key": ","
        },
        "item": {
          "type": "identifier"
        }
      }
    ]
  },
  "RULE_DEF": {
    "type": "sequence",
    "items": [
      {
        "type": "identifier",
        "bindings": [
          {
            "var": true,
            "value": "@"
          }
        ]
      },
      {
        "type": "key",
        "key": ":"
      },
      {
        "type": "ITEM"
      }
    ]
  },
  "EXPR": {
    "type": "choice",
    "items": [
      {
        "type": "SEQUENCE_EXPR"
      },
      {
        "type": "CHOICE_EXPR"
      },
      {
        "type": "REPEAT_EXPR"
      },
      {
        "type": "KEY_EXPR"
      },
      {
        "type": "REF"
      },
      {
        "type": "PARSE_EXPR"
      }
    ]
  },
  "REF": {
    "type": "sequence",
    "items": [
      {
        "type": "key",
        "key": "<"
      },
      {
        "type": "identifier",
        "bindings": [
          {
            "name": "type",
            "value": "@"
          }
        ]
      },
      {
        "type": "key",
        "key": ">"
      }
    ]
  },
  "SEQUENCE_EXPR": {
    "type": "sequence",
    "items": [
      {
        "type": "key",
        "key": "sequence",
        "bindings": [
          {
            "name": "type",
            "value": "sequence"
          }
        ]
      },
      {
        "type": "CONTAINER_OPT"
      },
      {
        "type": "key",
        "key": "{"
      },
      {
        "type": "ITEMS",
        "bindings": [
          {
            "name": "items",
            "value": "@"
          }
        ]
      },
      {
        "type": "key",
        "key": "}"
      }
    ]
  },
  "CONTAINER_OPT": {
    "type": "sequence",
    "optional": true,
    "items": [
      {
        "type": "CONTAINER_KIND",
        "bindings": [
          {
            "name": "container",
            "value": "@"
          }
        ]
      }
    ]
  },
  "CONTAINER_KIND": {
    "type": "choice",
    "items": [
      {
        "type": "key",
        "key": "array",
        "emit": true
      },
      {
        "type": "key",
        "key": "dict",
        "emit": true
      }
    ]
  },
  "CHOICE_EXPR": {
    "type": "sequence",
    "items": [
      {
        "type": "key",
        "key": "choice",
        "bindings": [
          {
            "name": "type",
            "value": "choice"
          }
        ]
      },
      {
        "type": "key",
        "key": "{"
      },
      {
        "type": "ITEMS",
        "bindings": [
          {
            "name": "items",
            "value": "@"
          }
        ]
      },
      {
        "type": "key",
        "key": "}"
      }
    ]
  },
  "REPEAT_EXPR": {
    "type": "sequence",
    "items": [
      {
        "type": "key",
        "key": "repeat",
        "bindings": [
          {
            "name": "type",
            "value": "repeat"
          }
        ]
      },
      {
        "type": "ITEM",
        "bindings": [
          {
            "name": "item",
            "value": "@"
          }
        ]
      },
      {
        "type": "SEPARATOR_OPT"
      }
    ]
  },
  "SEPARATOR_OPT": {
    "type": "sequence",
    "optional": true,
    "items": [
      {
        "type": "key",
        "key": "separator"
      },
      {
        "type": "ITEM",
        "bindings": [
          {
            "name": "separator",
            "value": "@"
          }
        ]
      }
    ]
  },
  "KEY_EXPR": {
    "type": "sequence",
    "items": [
      {
        "type": "string",
        "bindings": [
          {
            "name": "type",
            "value": "key"
          },
          {
            "name": "key",
            "value": "@"
          }
        ]
      },
      {
        "type": "KEY_VALUE",
        "optional": true
      }
    ]
  },
  "CONSTANT": {
    "type": "choice",
    "items": [
      {
        "type": "string"
      },
      {
        "type": "float"
      },
      {
        "type": "int"
      },
      {
        "type": "key",
        "key": "null",
        "value": null
      },
      {
        "type": "key",
        "key": "true",
        "value": true
      },
      {
        "type": "key",
        "key": "false",
        "value": false
      }
    ]
  },
  "PARSE_EXPR": {
    "type": "sequence",
    "items": [
      {
        "type": "identifier",
        "bindings": [
          {
            "name": "type",
            "value": "@"
          }
        ]
      }
    ]
  },
  "ITEMS": {
    "type": "sequence",
    "container": "array",
    "items": [
      {
        "type": "repeat",
        "separator": {
          "type": "key",
          "key": ","
        },
        "item": {
          "type": "ITEM"
        }
      }
    ]
  },
  "ITEM": {
    "type": "sequence",
    "container": "dict",
    "items": [
      {
        "expr": {
          "type": "optional",
          "expr": {
            "type": "key",
            "key": "?"
          }
        },
        "bindings": [
          {
            "name": "optional",
            "value": true
          }
        ]
      },
      {
        "type": "EXPR"
      },
      {
        "type": "BINDINGS",
        "bindings": [
          {
            "name": "bindings",
            "value": "@"
          }
        ]
      },
      {
        "type": "repeat",
        "item": {
          "type": "POSTFIX_ATTR"
        }
      }
    ]
  },
  "POSTFIX_ATTR": {
    "type": "choice",
    "items": [
      {
        "type": "INDENT_ATTR"
      },
      {
        "type": "TAB_ATTR"
      },
      {
        "type": "SPACE_ATTR"
      },
      {
        "type": "NEWLINE_ATTR"
      },
      {
        "type": "TAIL_ATTR"
      }
    ]
  },
  "INDENT_ATTR": {
    "type": "sequence",
    "items": [
      {
        "type": "key",
        "key": "indent",
        "bindings": [
          {
            "name": "indent",
            "value": true
          }
        ]
      }
    ]
  },
  "TAB_ATTR": {
    "type": "sequence",
    "items": [
      {
        "type": "key",
        "key": "tab",
        "bindings": [
          {
            "name": "tab",
            "value": true
          }
        ]
      }
    ]
  },
  "SPACE_ATTR": {
    "type": "sequence",
    "items": [
      {
        "type": "key",
        "key": "space",
        "bindings": [
          {
            "name": "space",
            "value": true
          }
        ]
      }
    ]
  },
  "NEWLINE_ATTR": {
    "type": "sequence",
    "items": [
      {
        "type": "key",
        "key": "newline",
        "bindings": [
          {
            "name": "newline",
            "value": true
          }
        ]
      }
    ]
  },
  "TAIL_ATTR": {
    "type": "sequence",
    "items": [
      {
        "type": "key",
        "key": "tail"
      },
      {
        "type": "key",
        "key": "="
      },
      {
        "type": "string",
        "bindings": [
          {
            "name": "tail",
            "value": "@"
          }
        ]
      }
    ]
  },
  "BINDINGS": {
    "type": "sequence",
    "optional": true,
    "items": [
      {
        "type": "BINDINGS_NONEMPTY"
      }
    ]
  },
  "BINDINGS_NONEMPTY": {
    "type": "sequence",
    "container": "array",
    "items": [
      {
        "type": "BIND_ENTRY"
      },
      {
        "type": "repeat",
        "item": {
          "type": "BIND_ENTRY"
        }
      }
    ]
  },
  "BIND_ENTRY": {
    "type": "sequence",
    "container": "dict",
    "items": [
      {
        "type": "key",
        "key": ":"
      },
      {
        "type": "BIND_EXPR"
      }
    ]
  },
  "BIND_EXPR": {
    "type": "choice",
    "items": [
      {
        "type": "NAME_BIND"
      },
      {
        "type": "VALUE_BIND"
      }
    ]
  },
  "NAME_BIND": {
    "type": "sequence",
    "items": [
      {
        "type": "key",
        "key": "=",
        "bindings": [
          {
            "name": "var",
            "value": true
          }
        ]
      },
      {
        "type": "BIND_RHS",
        "bindings": [
          {
            "name": "value",
            "value": "@"
          }
        ]
      }
    ]
  },
  "VALUE_BIND": {
    "type": "sequence",
    "items": [
      {
        "type": "identifier",
        "bindings": [
          {
            "name": "name",
            "value": "@"
          }
        ]
      },
      {
        "type": "key",
        "key": "="
      },
      {
        "type": "BIND_RHS",
        "bindings": [
          {
            "name": "value",
            "value": "@"
          }
        ]
      }
    ]
  },
  "BIND_RHS": {
    "type": "choice",
    "items": [
      {
        "type": "key",
        "key": "@",
        "emit": true
      },
      {
        "type": "BIND_LITERAL"
      }
    ]
  },
  "BIND_LITERAL": {
    "type": "choice",
    "items": [
      {
        "type": "string"
      },
      {
        "type": "float"
      },
      {
        "type": "int"
      },
      {
        "type": "key",
        "key": "true",
        "value": true
      },
      {
        "type": "key",
        "key": "false",
        "value": false
      },
      {
        "type": "key",
        "key": "null",
        "value": null
      }
    ]
  },
  "START_DECL": {
    "type": "sequence",
    "items": [
      {
        "type": "key",
        "key": "start"
      },
      {
        "type": "key",
        "key": ":"
      },
      {
        "type": "START_VAL",
        "bindings": [
          {
            "name": "start",
            "value": "@"
          }
        ]
      }
    ]
  },
  "START_VAL": {
    "type": "sequence",
    "container": "dict",
    "items": [
      {
        "type": "REF"
      }
    ]
  },
  "KEY_VALUE": {
    "type": "sequence",
    "items": [
      {
        "type": "key",
        "key": ":"
      },
      {
        "type": "choice",
        "items": [
          {
            "type": "key",
            "key": "@",
            "bindings": [
              {
                "name": "emit",
                "value": true
              }
            ]
          },
          {
            "type": "CONSTANT",
            "bindings": [
              {
                "name": "value",
                "value": "@"
              }
            ]
          }
        ]
      }
    ]
  }
}
