{
  "start": {
    "type": "GRAMMAR"
  },
  "use": [
    "std"
  ],
  "GRAMMAR": {
    "type": "sequence",
    "container": "dict",
    "rule_ignore": ["whitespace", "line_comment", "block_comment"],
    "value": [
      {
        "type": "repeat",
        "value": {
          "type": "GRAMMAR_ENTRY",
          "newline": true
        }
      }
    ]
  },
  "GRAMMAR_ENTRY": {
    "type": "choice",
    "value": [
      {
        "type": "USE_DECL"
      },
      {
        "type": "START_DECL"
      },
      {
        "type": "RULE_DEF"
      }
    ]
  },
  "USE_DECL": {
    "type": "sequence",
    "value": [
      {
        "type": "key",
        "key": "use"
      },
      {
        "type": "key",
        "key": ":"
      },
      {
        "type": "IDENT_LIST",
        "bindings": [
          {
            "name": "use",
            "value": "@"
          }
        ]
      }
    ]
  },
  "IDENT_LIST": {
    "type": "sequence",
    "container": "array",
    "value": [
      {
        "type": "repeat",
        "separator": {
          "type": "key",
          "key": ","
        },
        "value": {
          "type": "qualified_identifier"
        }
      }
    ]
  },
  "RULE_DEF": {
    "type": "sequence",
    "value": [
      {
        "type": "identifier",
        "bindings": [
          {
            "var": true,
            "value": "@"
          }
        ]
      },
      {
        "type": "RULE_BODY"
      }
    ]
  },
  "RULE_BODY": {
    "type": "sequence",
    "container": "dict",
    "value": [
      {
        "type": "RULE_IGNORE_ATTR",
        "optional": true
      },
      {
        "type": "key",
        "key": ":"
      },
      {
        "type": "key",
        "key": "?",
        "optional": true,
        "bindings": [
          {
            "name": "optional",
            "value": true
          }
        ]
      },
      {
        "type": "EXPR"
      },
      {
        "type": "BINDINGS",
        "bindings": [
          {
            "name": "bindings",
            "value": "@"
          }
        ],
        "optional": true
      },
      {
        "type": "repeat",
        "value": {
          "type": "POSTFIX_ATTR"
        }
      }
    ]
  },
  "RULE_IGNORE_ATTR": {
    "type": "sequence",
    "value": [
      {
        "type": "key",
        "key": "ignore"
      },
      {
        "type": "IGNORE_LIST",
        "bindings": [
          {
            "name": "rule_ignore",
            "value": "@"
          }
        ]
      }
    ]
  },
  "IGNORE_LIST": {
    "type": "sequence",
    "container": "array",
    "value": [
      {
        "type": "repeat",
        "value": {
          "type": "qualified_identifier"
        }
      }
    ]
  },
  "EXPR": {
    "type": "choice",
    "value": [
      {
        "type": "SEQUENCE_EXPR"
      },
      {
        "type": "CHOICE_EXPR"
      },
      {
        "type": "REPEAT_EXPR"
      },
      {
        "type": "RAW_EXPR"
      },
      {
        "type": "KEY_EXPR"
      },
      {
        "type": "REF"
      },
      {
        "type": "PARSE_EXPR"
      }
    ]
  },
  "RAW_EXPR": {
    "type": "sequence",
    "value": [
      {
        "type": "key",
        "key": "*",
        "bindings": [
          {"name": "type", "value": "raw"}
        ]
      }
    ]
  },
  "REF": {
    "type": "sequence",
    "value": [
      {
        "type": "key",
        "key": "<"
      },
      {
        "type": "identifier",
        "bindings": [
          {
            "name": "type",
            "value": "@"
          }
        ]
      },
      {
        "type": "key",
        "key": ">"
      }
    ]
  },
  "SEQUENCE_EXPR": {
    "type": "sequence",
    "value": [
      {
        "type": "key",
        "key": "sequence",
        "bindings": [
          {
            "name": "type",
            "value": "sequence"
          }
        ]
      },
      {
        "type": "CONTAINER_KIND",
        "optional": true,
        "bindings": [
          {
            "name": "container",
            "value": "@"
          }
        ]
      },
      {
        "type": "key",
        "key": "{"
      },
      {
        "type": "ITEMS",
        "bindings": [
          {
            "name": "value",
            "value": "@"
          }
        ]
      },
      {
        "type": "key",
        "key": "}"
      }
    ]
  },
  "CONTAINER_KIND": {
    "type": "choice",
    "value": [
      {
        "type": "key",
        "key": "array",
        "emit": true
      },
      {
        "type": "key",
        "key": "dict",
        "emit": true
      }
    ]
  },
  "CHOICE_EXPR": {
    "type": "sequence",
    "value": [
      {
        "type": "key",
        "key": "choice",
        "bindings": [
          {
            "name": "type",
            "value": "choice"
          }
        ]
      },
      {
        "type": "key",
        "key": "{"
      },
      {
        "type": "ITEMS",
        "bindings": [
          {
            "name": "value",
            "value": "@"
          }
        ]
      },
      {
        "type": "key",
        "key": "}"
      }
    ]
  },
  "REPEAT_EXPR": {
    "type": "sequence",
    "value": [
      {
        "type": "key",
        "key": "repeat",
        "bindings": [
          {
            "name": "type",
            "value": "repeat"
          }
        ]
      },
      {
        "type": "key",
        "key": "+",
        "optional": true,
        "bindings": [
          {
            "name": "min",
            "value": 1
          }
        ]
      },
      {
        "type": "ITEM",
        "bindings": [
          {
            "name": "value",
            "value": "@"
          }
        ]
      },
      {
        "type": "SEPARATOR",
        "optional": true
      }
    ]
  },
  "KEY_EXPR": {
    "type": "sequence",
    "value": [
      {
        "type": "string",
        "bindings": [
          {
            "name": "key",
            "value": "@"
          },
          {
            "name": "type",
            "value": "key"
          }
        ]
      },
      {
        "type": "KEY_VALUE",
        "optional": true
      }
    ]
  },
  "CONSTANT": {
    "type": "choice",
    "value": [
      {
        "type": "string"
      },
      {
        "type": "float"
      },
      {
        "type": "int"
      },
      {
        "type": "key",
        "key": "null",
        "value": null
      },
      {
        "type": "key",
        "key": "true",
        "value": true
      },
      {
        "type": "key",
        "key": "false",
        "value": false
      }
    ]
  },
  "PARSE_EXPR": {
    "type": "sequence",
    "value": [
      {
        "type": "qualified_identifier",
        "bindings": [
          {
            "name": "type",
            "value": "@"
          }
        ]
      }
    ]
  },
  "ITEMS": {
    "type": "sequence",
    "container": "array",
    "value": [
      {
        "type": "repeat",
        "separator": {
          "type": "key",
          "key": ","
        },
        "value": {
          "type": "ITEM"
        }
      }
    ]
  },
  "ITEM": {
    "type": "sequence",
    "container": "dict",
    "value": [
      {
        "type": "key",
        "key": "?",
        "optional": true,
        "bindings": [
          {
            "name": "optional",
            "value": true
          }
        ]
      },
      {
        "type": "EXPR"
      },
      {
        "type": "BINDINGS",
        "bindings": [
          {
            "name": "bindings",
            "value": "@"
          }
        ],
        "optional": true
      },
      {
        "type": "repeat",
        "value": {
          "type": "POSTFIX_ATTR"
        }
      }
    ]
  },
  "POSTFIX_ATTR": {
    "type": "choice",
    "value": [
      {
        "type": "key",
        "key": "indent",
        "bindings": [
          {
            "name": "indent",
            "value": true
          }
        ]
      },
      {
        "type": "key",
        "key": "tab",
        "bindings": [
          {
            "name": "tab",
            "value": true
          }
        ]
      },
      {
        "type": "key",
        "key": "space",
        "bindings": [
          {
            "name": "space",
            "value": true
          }
        ]
      },
      {
        "type": "key",
        "key": "newline",
        "bindings": [
          {
            "name": "newline",
            "value": true
          }
        ]
      },
      {
        "type": "TAIL_ATTR"
      }
    ]
  },
  "TAIL_ATTR": {
    "type": "sequence",
    "value": [
      {
        "type": "key",
        "key": "tail"
      },
      {
        "type": "key",
        "key": "="
      },
      {
        "type": "string",
        "bindings": [
          {
            "name": "tail",
            "value": "@"
          }
        ]
      }
    ]
  },
  "BINDINGS": {
    "type": "sequence",
    "container": "array",
    "value": [
      {
        "type": "repeat",
        "min": 1,
        "value": {
          "type": "BINDING"
        }
      }
    ]
  },
  "BINDING": {
    "type": "sequence",
    "container": "dict",
    "value": [
      {
        "type": "key",
        "key": ":"
      },
      {
        "type": "BIND_EXPR"
      }
    ]
  },
  "BIND_EXPR": {
    "type": "choice",
    "value": [
      {
        "type": "NAME_BIND"
      },
      {
        "type": "VALUE_BIND"
      }
    ]
  },
  "NAME_BIND": {
    "type": "sequence",
    "value": [
      {
        "type": "key",
        "key": "=",
        "bindings": [
          {
            "name": "var",
            "value": true
          }
        ]
      },
      {
        "type": "BIND_VAL",
        "bindings": [
          {
            "name": "value",
            "value": "@"
          }
        ]
      }
    ]
  },
  "VALUE_BIND": {
    "type": "sequence",
    "value": [
      {
        "type": "identifier",
        "bindings": [
          {
            "name": "name",
            "value": "@"
          }
        ]
      },
      {
        "type": "key",
        "key": "[]",
        "optional": true,
        "bindings": [
          {
            "name": "list_append",
            "value": true
          }
        ]
      },
      {
        "type": "key",
        "key": "="
      },
      {
        "type": "BIND_VAL",
        "bindings": [
          {
            "name": "value",
            "value": "@"
          }
        ]
      }
    ]
  },
  "BIND_VAL": {
    "type": "choice",
    "value": [
      {
        "type": "key",
        "key": "@",
        "emit": true
      },
      {
        "type": "CONSTANT"
      }
    ]
  },
  "START_DECL": {
    "type": "sequence",
    "value": [
      {
        "type": "key",
        "key": "start"
      },
      {
        "type": "key",
        "key": ":"
      },
      {
        "type": "START_VAL",
        "bindings": [
          {
            "name": "start",
            "value": "@"
          }
        ]
      }
    ]
  },
  "START_VAL": {
    "type": "sequence",
    "container": "dict",
    "value": [
      {
        "type": "REF"
      }
    ]
  },
  "KEY_VALUE": {
    "type": "sequence",
    "value": [
      {
        "type": "key",
        "key": ":"
      },
      {
        "type": "choice",
        "value": [
          {
            "type": "key",
            "key": "@",
            "bindings": [
              {
                "name": "emit",
                "value": true
              }
            ]
          },
          {
            "type": "CONSTANT",
            "bindings": [
              {
                "name": "value",
                "value": "@"
              }
            ]
          }
        ]
      }
    ]
  },
  "SEPARATOR": {
    "type": "sequence",
    "value": [
      {
        "type": "key",
        "key": "separator"
      },
      {
        "type": "ITEM",
        "bindings": [
          {
            "name": "separator",
            "value": "@"
          }
        ]
      }
    ]
  }
}
