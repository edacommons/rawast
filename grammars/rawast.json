{
  "start": "FILE",
  "use": [
    "std"
  ],
  "ignore": [
    "whitespace",
    "line_comment",
    "block_comment"
  ],
  "FILE": {
    "type": "sequence",
    "container": "dict",
    "items": [
      {
        "expr": {
          "type": "repeat",
          "item": {
            "expr": "FILE_ENTRY"
          }
        }
      }
    ]
  },
  "FILE_ENTRY": {
    "type": "choice",
    "newline": true,
    "items": [
      {
        "expr": "USE_DECL"
      },
      {
        "expr": "IGNORE_DECL"
      },
      {
        "expr": "RULE_DEF"
      }
    ]
  },
  "USE_DECL": {
    "type": "sequence",
    "items": [
      {
        "expr": {
          "type": "key",
          "key": "use"
        }
      },
      {
        "expr": {
          "type": "key",
          "key": ":"
        }
      },
      {
        "expr": "IDENT_LIST",
        "bindings": [
          {
            "name": "use",
            "value": "@"
          }
        ]
      }
    ]
  },
  "IGNORE_DECL": {
    "type": "sequence",
    "items": [
      {
        "expr": {
          "type": "key",
          "key": "ignore"
        }
      },
      {
        "expr": {
          "type": "key",
          "key": ":"
        }
      },
      {
        "expr": "IDENT_LIST",
        "bindings": [
          {
            "name": "ignore",
            "value": "@"
          }
        ]
      }
    ]
  },
  "IDENT_LIST": {
    "type": "sequence",
    "container": "array",
    "items": [
      {
        "expr": {
          "type": "repeat",
          "separator": {
            "expr": {
              "type": "key",
              "key": ","
            }
          },
          "item": {
            "expr": {
              "type": "identifier"
            }
          }
        }
      }
    ]
  },
  "RULE_DEF": {
    "type": "sequence",
    "items": [
      {
        "expr": {
          "type": "identifier"
        },
        "bindings": [
          {
            "var": true,
            "value": "@"
          }
        ]
      },
      {
        "expr": {
          "type": "key",
          "key": ":"
        }
      },
      {
        "expr": "EXPR"
      }
    ]
  },
  "EXPR": {
    "type": "choice",
    "items": [
      {
        "expr": "REF"
      },
      {
        "expr": "OPTIONAL_EXPR"
      },
      {
        "expr": "SEQUENCE_EXPR"
      },
      {
        "expr": "CHOICE_EXPR"
      },
      {
        "expr": "REPEAT_EXPR"
      },
      {
        "expr": "KEY_EXPR"
      },
      {
        "expr": "PARSE_EXPR"
      }
    ]
  },
  "REF": {
    "type": "sequence",
    "items": [
      {
        "expr": {
          "type": "key",
          "key": "<"
        }
      },
      {
        "expr": {
          "type": "identifier"
        }
      },
      {
        "expr": {
          "type": "key",
          "key": ">"
        }
      }
    ]
  },
  "OPTIONAL_EXPR": {
    "type": "sequence",
    "container": "dict",
    "items": [
      {
        "expr": {
          "type": "key",
          "key": "?"
        },
        "bindings": [
          {
            "name": "type",
            "value": "optional"
          }
        ]
      },
      {
        "expr": "EXPR",
        "bindings": [
          {
            "name": "expr",
            "value": "@"
          }
        ]
      }
    ]
  },
  "SEQUENCE_EXPR": {
    "type": "sequence",
    "container": "dict",
    "items": [
      {
        "expr": {
          "type": "key",
          "key": "sequence"
        },
        "bindings": [
          {
            "name": "type",
            "value": "sequence"
          }
        ]
      },
      {
        "expr": "CONTAINER_OPT"
      },
      {
        "expr": {
          "type": "key",
          "key": "{"
        }
      },
      {
        "expr": "ITEMS",
        "bindings": [
          {
            "name": "items",
            "value": "@"
          }
        ]
      },
      {
        "expr": {
          "type": "key",
          "key": "}"
        }
      }
    ]
  },
  "CONTAINER_OPT": {
    "type": "sequence",
    "optional": true,
    "items": [
      {
        "expr": "CONTAINER_KIND",
        "bindings": [
          {
            "name": "container",
            "value": "@"
          }
        ]
      }
    ]
  },
  "CONTAINER_KIND": {
    "type": "choice",
    "items": [
      {
        "expr": {
          "type": "key",
          "key": "array",
          "value": "array"
        }
      },
      {
        "expr": {
          "type": "key",
          "key": "dict",
          "value": "dict"
        }
      }
    ]
  },
  "CHOICE_EXPR": {
    "type": "sequence",
    "container": "dict",
    "items": [
      {
        "expr": {
          "type": "key",
          "key": "choice"
        },
        "bindings": [
          {
            "name": "type",
            "value": "choice"
          }
        ]
      },
      {
        "expr": {
          "type": "key",
          "key": "{"
        }
      },
      {
        "expr": "ITEMS",
        "bindings": [
          {
            "name": "items",
            "value": "@"
          }
        ]
      },
      {
        "expr": {
          "type": "key",
          "key": "}"
        }
      }
    ]
  },
  "REPEAT_EXPR": {
    "type": "sequence",
    "container": "dict",
    "items": [
      {
        "expr": {
          "type": "key",
          "key": "repeat"
        },
        "bindings": [
          {
            "name": "type",
            "value": "repeat"
          }
        ]
      },
      {
        "expr": "ITEM",
        "bindings": [
          {
            "name": "item",
            "value": "@"
          }
        ]
      },
      {
        "expr": "SEPARATOR_OPT"
      }
    ]
  },
  "SEPARATOR_OPT": {
    "type": "sequence",
    "optional": true,
    "items": [
      {
        "expr": {
          "type": "key",
          "key": "separator"
        }
      },
      {
        "expr": "ITEM",
        "bindings": [
          {
            "name": "separator",
            "value": "@"
          }
        ]
      }
    ]
  },
  "KEY_EXPR": {
    "type": "sequence",
    "container": "dict",
    "items": [
      {
        "expr": {
          "type": "string"
        },
        "bindings": [
          {
            "name": "type",
            "value": "key"
          },
          {
            "name": "key",
            "value": "@"
          }
        ]
      },
      {
        "expr": "KEY_VALUE_SUFFIX"
      }
    ]
  },
  "KEY_VALUE_SUFFIX": {
    "type": "sequence",
    "optional": true,
    "items": [
      {
        "expr": {
          "type": "key",
          "key": ":"
        }
      },
      {
        "expr": "CONSTANT",
        "bindings": [
          {
            "name": "value",
            "value": "@"
          }
        ]
      }
    ]
  },
  "CONSTANT": {
    "type": "choice",
    "items": [
      {
        "expr": {
          "type": "string"
        }
      },
      {
        "expr": {
          "type": "float"
        }
      },
      {
        "expr": {
          "type": "int"
        }
      },
      {
        "expr": {
          "type": "key",
          "key": "null",
          "value": null
        }
      },
      {
        "expr": {
          "type": "key",
          "key": "true",
          "value": true
        }
      },
      {
        "expr": {
          "type": "key",
          "key": "false",
          "value": false
        }
      }
    ]
  },
  "PARSE_EXPR": {
    "type": "sequence",
    "container": "dict",
    "items": [
      {
        "expr": {
          "type": "identifier"
        },
        "bindings": [
          {
            "name": "type",
            "value": "@"
          }
        ]
      }
    ]
  },
  "ITEMS": {
    "type": "sequence",
    "container": "array",
    "items": [
      {
        "expr": {
          "type": "repeat",
          "separator": {
            "expr": {
              "type": "key",
              "key": ","
            }
          },
          "item": {
            "expr": "ITEM"
          }
        }
      }
    ]
  },
  "ITEM": {
    "type": "sequence",
    "container": "dict",
    "items": [
      {
        "expr": "EXPR",
        "bindings": [
          {
            "name": "expr",
            "value": "@"
          }
        ]
      },
      {
        "expr": "BINDINGS",
        "bindings": [
          {
            "name": "bindings",
            "value": "@"
          }
        ]
      },
      {
        "expr": {
          "type": "repeat",
          "item": {
            "expr": "POSTFIX_ATTR"
          }
        }
      }
    ]
  },
  "POSTFIX_ATTR": {
    "type": "choice",
    "items": [
      {
        "expr": "INDENT_ATTR"
      },
      {
        "expr": "TAB_ATTR"
      },
      {
        "expr": "SPACE_ATTR"
      },
      {
        "expr": "NEWLINE_ATTR"
      },
      {
        "expr": "TAIL_ATTR"
      }
    ]
  },
  "INDENT_ATTR": {
    "type": "sequence",
    "items": [
      {
        "expr": {
          "type": "key",
          "key": "indent"
        },
        "bindings": [
          {
            "name": "indent",
            "value": true
          }
        ]
      }
    ]
  },
  "TAB_ATTR": {
    "type": "sequence",
    "items": [
      {
        "expr": {
          "type": "key",
          "key": "tab"
        },
        "bindings": [
          {
            "name": "tab",
            "value": true
          }
        ]
      }
    ]
  },
  "SPACE_ATTR": {
    "type": "sequence",
    "items": [
      {
        "expr": {
          "type": "key",
          "key": "space"
        },
        "bindings": [
          {
            "name": "space",
            "value": true
          }
        ]
      }
    ]
  },
  "NEWLINE_ATTR": {
    "type": "sequence",
    "items": [
      {
        "expr": {
          "type": "key",
          "key": "newline"
        },
        "bindings": [
          {
            "name": "newline",
            "value": true
          }
        ]
      }
    ]
  },
  "TAIL_ATTR": {
    "type": "sequence",
    "items": [
      {
        "expr": {
          "type": "key",
          "key": "tail"
        }
      },
      {
        "expr": {
          "type": "key",
          "key": "="
        }
      },
      {
        "expr": {
          "type": "string"
        },
        "bindings": [
          {
            "name": "tail",
            "value": "@"
          }
        ]
      }
    ]
  },
  "BINDINGS": {
    "type": "sequence",
    "optional": true,
    "items": [
      {
        "expr": "BINDINGS_NONEMPTY"
      }
    ]
  },
  "BINDINGS_NONEMPTY": {
    "type": "sequence",
    "container": "array",
    "items": [
      {
        "expr": "BIND_ENTRY"
      },
      {
        "expr": {
          "type": "repeat",
          "item": {
            "expr": "BIND_ENTRY"
          }
        }
      }
    ]
  },
  "BIND_ENTRY": {
    "type": "sequence",
    "container": "dict",
    "fixed_schema": true,
    "items": [
      {
        "expr": {
          "type": "key",
          "key": ":"
        }
      },
      {
        "expr": "BIND_EXPR"
      }
    ]
  },
  "BIND_EXPR": {
    "type": "choice",
    "items": [
      {
        "expr": "NAME_BIND"
      },
      {
        "expr": "VALUE_BIND"
      }
    ]
  },
  "NAME_BIND": {
    "type": "sequence",
    "items": [
      {
        "expr": {
          "type": "key",
          "key": "="
        },
        "bindings": [
          {
            "name": "var",
            "value": true
          }
        ]
      },
      {
        "expr": "BIND_RHS",
        "bindings": [
          {
            "name": "value",
            "value": "@"
          }
        ]
      }
    ]
  },
  "VALUE_BIND": {
    "type": "sequence",
    "items": [
      {
        "expr": {
          "type": "identifier"
        },
        "bindings": [
          {
            "name": "name",
            "value": "@"
          }
        ]
      },
      {
        "expr": {
          "type": "key",
          "key": "="
        }
      },
      {
        "expr": "BIND_RHS",
        "bindings": [
          {
            "name": "value",
            "value": "@"
          }
        ]
      }
    ]
  },
  "BIND_RHS": {
    "type": "choice",
    "items": [
      {
        "expr": {
          "type": "key",
          "key": "@",
          "value": "@"
        }
      },
      {
        "expr": "BIND_LITERAL"
      }
    ]
  },
  "BIND_LITERAL": {
    "type": "choice",
    "items": [
      {
        "expr": {
          "type": "string"
        }
      },
      {
        "expr": {
          "type": "float"
        }
      },
      {
        "expr": {
          "type": "int"
        }
      },
      {
        "expr": {
          "type": "key",
          "key": "true",
          "value": true
        }
      },
      {
        "expr": {
          "type": "key",
          "key": "false",
          "value": false
        }
      },
      {
        "expr": {
          "type": "key",
          "key": "null",
          "value": null
        }
      }
    ]
  }
}
