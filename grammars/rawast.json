// =========================================================================
// grammars/rawast.json
// JSON-form grammar definition for parsing .rawast source files.
//
// STATUS: design draft. The engine has the required prerequisites in
// place (IdentifierParser, Value+is_name flag honoured in the catcher,
// {"type":"value"} in the JSON-grammar format), but this file does not
// yet produce a JSON-grammar-format tree directly. The structural shape
// of the produced tree must be such that the JSON-grammar loader can
// consume it; the open issue is that the catcher absorbs all Value-kind
// constants at construction time, which puts name markers before any
// values when interleaved at the same Sequence level.
//
// Two ways to close the gap (planned, see docs/rawast-format.md §8):
//   (a) refactor the Frame absorber so Value-kind frames are iterated
//       rather than absorbed at construction, restoring positional
//       interleaving with other children;
//   (b) wrap each (name, value) pair in its own sub-Sequence so the
//       absorption order matches the desired emission order.
//
// Until one of those lands, this file documents the intended structure
// and serves as the loader's reference target.
// =========================================================================

{
  "start": "FILE",

  // A file is a top-level dict: rule_name -> rule_body.
  // The bare repeat of RULE_DEF accumulates name/value pairs into the
  // outer dict catcher.
  "FILE": {
    "type": "sequence",
    "container": "dict",
    "items": [
      {"type": "repeat", "item": "RULE_DEF"}
    ]
  },

  // A rule definition: identifier ":" body.
  // The identifier is var=true so the dict catcher uses it as the name.
  "RULE_DEF": {
    "type": "sequence",
    "items": [
      {"type": "identifier", "var": true},  // TODO: identifier parser
      ":",
      "EXPR"
    ]
  },

  // Top-level expression. Ordered for predictive PEG: the alternatives
  // with distinctive initial terminals come first; the catch-all bare
  // identifier (PARSE) comes last.
  "EXPR": {
    "type": "choice",
    "items": [
      "OPTIONAL_EXPR",
      "REF",
      "SEQUENCE_EXPR",
      "CHOICE_EXPR",
      "REPEAT_EXPR",
      "KEY_EXPR",
      "PARSE_EXPR"
    ]
  },

  // <NAME> — reference to a named rule.
  "REF": {
    "type": "sequence",
    "items": [
      "<",
      {"type": "identifier", "var": true},
      ">"
    ]
  },

  // "text" — literal token. Optionally followed by ":CONSTANT" to attach
  // a Value-child constant emission (the null/true/false/@-as-self
  // discriminator pattern).
  // TODO: when KEY_VALUE_SUFFIX matches, emit a Value-kind child carrying
  // the constant.
  "KEY_EXPR": {
    "type": "sequence",
    "items": [
      {"type": "string"},
      "?KEY_VALUE_SUFFIX"  // TODO: this isn't valid syntax in JSON grammar
                           // form yet — represents an optional sub-rule
    ]
  },

  // ":" CONSTANT
  // CONSTANT can be the keyword null/true/false (the constants), or @
  // (meaning "the matched literal string itself as a value").
  "KEY_VALUE_SUFFIX": {
    "type": "sequence",
    "items": [
      ":",
      "CONSTANT"
    ]
  },

  "CONSTANT": {
    "type": "choice",
    "items": [
      {"type": "key", "key": "null",  "value": null},
      {"type": "key", "key": "true",  "value": true},
      {"type": "key", "key": "false", "value": false},
      {"type": "key", "key": "@"}   // emit-matched-literal sugar
    ]
  },

  // bare identifier — invokes a terminal parser by name.
  "PARSE_EXPR": {
    "type": "sequence",
    "items": [
      {"type": "identifier"}
    ]
  },

  // sequence [array|dict] { items }
  "SEQUENCE_EXPR": {
    "type": "sequence",
    "items": [
      "sequence",
      // TODO: optional container annotation
      "{",
      "ITEMS",
      "}"
    ]
  },

  // choice { items }
  "CHOICE_EXPR": {
    "type": "sequence",
    "items": [
      "choice",
      "{",
      "ITEMS",
      "}"
    ]
  },

  // repeat EXPR [separator EXPR]
  "REPEAT_EXPR": {
    "type": "sequence",
    "items": [
      "repeat",
      "EXPR"
      // TODO: optional separator clause
    ]
  },

  // ?EXPR — optional
  "OPTIONAL_EXPR": {
    "type": "sequence",
    "items": [
      "?",
      "EXPR"
    ]
  },

  // Comma-separated list of expressions (with optional binding suffix).
  // TODO: bindings (":@", ":@=", ":name=@") attached to items.
  "ITEMS": {
    "type": "repeat",
    "separator": ",",
    "item": "EXPR"
  }
}
