// rawast.rawast — meta-grammar for the .rawast format, written in .rawast.
//
// Conventions used here:
//   - A rule body is an ITEM. EXPR's fields flatten into the ITEM's dict
//     (no separate `expr` field) — the ITEM dict carries `type`, `value`,
//     `container`, etc., plus the optional flag, bindings, and postfix attrs.
//   - A rule is just a named ITEM: `identifier:=@` sets the rule name as
//     pending in GRAMMAR's dict; <ITEM>'s value pairs with it.
//   - Optional is an ITEM-level prefix: `?` before an item sets `optional: true`.
//   - Bindings are an ordered array of {name, value} entries. A var
//     binding has no `name` field — the loader's `extract_bindings`
//     reads missing `name` as the empty-string sentinel and applies
//     the rule-name var to the captured value.

use: std

start: <GRAMMAR>

// ─── Top level ──────────────────────────────────────────────────────────
//
// The grammar-level "default ignore" is expressed by attaching an ignore
// attribute to the start rule (here, GRAMMAR). Rule-local overrides live
// on individual rule definitions. There is no separate top-level
// `ignore:` directive.

GRAMMAR ignore whitespace line_comment block_comment: sequence dict {
  repeat <GRAMMAR_ENTRY> newline
}

GRAMMAR_ENTRY: choice { <USE_DECL>, <START_DECL>, <RULE_DEF>}

USE_DECL:   sequence { "use", ":", <IDENT_LIST>:use=@ }
IDENT_LIST: sequence array { repeat qualified_identifier separator "," }

START_DECL: sequence {"start", ":", <START_VAL>:start=@}

START_VAL: sequence dict { <REF> }

// A rule definition: name, optional ignore attribute, colon, body. The
// ignore attribute (`ignore PARSER1 PARSER2 …`) sits between the rule
// name and the colon — its parser names become the rule-local ignore
// override for that rule's subtree. The body is otherwise an ITEM (same
// shape as items inside a sequence/choice).
RULE_DEF: sequence {
  identifier:=@,
  <RULE_BODY>
}

// RULE_BODY is the rule's value (paired with the rule-name var binding).
// Same fields as ITEM, plus an optional leading rule_ignore attr.
RULE_BODY: sequence dict {
  ?<RULE_IGNORE_ATTR>,
  ":",
  ?"?":optional=true,
  ?"!":negative=true,
  <EXPR>,
  ?<BINDINGS>:bindings=@,
  repeat <POSTFIX_ATTR>
}

// `ignore PARSER1 PARSER2 …` — space-separated parser names, terminated
// by the next `:` (since `:` isn't a valid identifier char, the
// repeat naturally stops). Empty list means "ignore nothing".
RULE_IGNORE_ATTR: sequence {
  "ignore",
  <IGNORE_LIST>:rule_ignore=@
}
IGNORE_LIST: sequence array { repeat qualified_identifier }

// ─── Items ──────────────────────────────────────────────────────────────

// An item carries an expression, optional bindings, and postfix attrs.
// Prefix `?` makes the item optional; prefix `!` is a negative
// lookahead — the engine succeeds (consuming nothing) iff the inner
// FAILS at the current cursor, and fails iff the inner matches.
ITEM: sequence dict {
  ?"?":optional=true,
  ?"!":negative=true,
  <EXPR>,
  ?<BINDINGS>:bindings=@,
  repeat <POSTFIX_ATTR>
}

ITEMS: sequence array { repeat <ITEM> separator "," }

// ─── Expressions ────────────────────────────────────────────────────────

EXPR: choice {
  <SEQUENCE_EXPR>,
  <CHOICE_EXPR>,
  <REPEAT_EXPR>,
  <SCOPE_EXPR>,
  <RAW_EXPR>,
  <KEY_EXPR>,
  <KEY_STRICT_EXPR>,
  <REF>,
  <PARSE_EXPR>
}

// `*` in a sequence body — consume raw bytes until the next sibling
// (which must be a Key literal) matches at the cursor. See §4.5a of
// docs/rawast-format.md.
RAW_EXPR: sequence { "*":type="raw" }

REF: sequence {"<", identifier:type=@, ">" }

SEQUENCE_EXPR: sequence {
  "sequence":type="sequence",
  ?<CONTAINER_KIND>:container=@,
  "{", <ITEMS>:value=@, "}"
}

CONTAINER_KIND: choice { "array":@, "dict":@ }

CHOICE_EXPR: sequence {
  "choice":type="choice",
  "{", <ITEMS>:value=@, "}"
}

// `scope { INNER... }` — string-aware byte scanner. Scope has no
// delimiters of its own; siblings in the surrounding sequence supply
// the start and stop literals (same shape as `*`/Raw). INNERs are
// atomic spans (embedded strings, comments, sub-rules can't trigger
// a false stop). Returns body bytes between the previous sibling
// and the next sibling Key (exclusive) as a StringValue by default;
// `scope array { ... }` instead returns an ArrayValue of segments —
// each INNER match becomes one entry (the INNER's own typed value),
// and raw text gaps between INNERs become StringValue entries. See
// §4.5b of docs/rawast-format.md.
//
// Strict (word-bounded) delimiter matching comes from the sibling
// Key's own strict flag — write `'begin'` instead of `"begin"` on
// the surrounding sequence sibling, no scope-level attribute needed.
SCOPE_EXPR: sequence {
  "scope":type="scope",
  ?<CONTAINER_KIND>:container=@,
  "{", <ITEMS>:value=@, "}"
}

// `repeat` quantifier syntax:
//   repeat <X>       → min=0 (zero-or-more, classic PEG `*`)
//   repeat+ <X>      → min=1 (one-or-more, classic PEG `+`)
//   repeat+N <X>     → min=N (at least N occurrences, N ≥ 2)
//
// The two `+`-prefixed forms are a Choice. Save dispatch picks
// `REPEAT_PLUS_ONE` for dict.min == 1 (specific const matches) and
// falls through to `REPEAT_PLUS_N` for higher values. Parse tries
// `REPEAT_PLUS_N` first so `+2` greedy-matches the digit; the engine
// falls back to `REPEAT_PLUS_ONE` for bare `+` via Choice-frame
// alt-failure recovery.
REPEAT_EXPR: sequence {
  "repeat":type="repeat",
  ?<REPEAT_PLUS_FORM>,
  <ITEM>:value=@,
  ?<SEPARATOR>
}

REPEAT_PLUS_FORM: choice {
  <REPEAT_PLUS_N>,
  <REPEAT_PLUS_ONE>
}

REPEAT_PLUS_N: sequence { "+", int:min=@ }
REPEAT_PLUS_ONE: sequence { "+":min=1 }

SEPARATOR: sequence { "separator", <ITEM>:separator=@ }

// Key literal. Two surface forms with distinct `type` values so save
// dispatch can route them cleanly through EXPR's Choice:
//
//   "END"       — byte-prefix match. `type: "key"` in the dict.
//                 (current default; consumes "END" even inside "ENDFOO")
//   'END'       — strict, word-bounded. `type: "strict_key"` in the dict.
//                 (only matches "END" when the following byte is non-word
//                 or EOF; correctly rejects the prefix of "ENDFOO")
//
// The loader translates both surface types into a `NodeKind::Key` node;
// the `strict_key` type additionally sets `Node.strict = true`. See
// `include/rawast/node.hpp` and `src/loader.cpp`.

KEY_EXPR: sequence {
  string:key=@:type="key",
  ?<KEY_VALUE>
}

KEY_STRICT_EXPR: sequence {
  single_quote_string:key=@:type="strict_key",
  ?<KEY_VALUE>
}

KEY_VALUE: sequence { ":", choice { "@":emit=true, <CONSTANT>:value=@ } }

// Parser reference. Bare form `int` resolves through the bare-name
// alias the parser registry registers for every group member.
// Dotted form `gdsii.header` references the same parser via the
// group-qualified alias the registry also registers. `qualified_identifier`
// parses both forms as a single token, so the stored shape is
// `{type: "gdsii.header"}` (flat) and the dotted-alias lookup resolves
// it directly.
PARSE_EXPR: sequence { qualified_identifier:type=@ }

// ─── Bindings ───────────────────────────────────────────────────────────
//
// Surface:   expr:name=val:other=@:=@:#engine=val
// Encodes:   bindings is an ordered array of {name, value} entries. The
//            BIND_EXPR choice dispatches on first token: `=` → NAME_BIND
//            (var binding — emits `{var: true, value: <X>}` with no
//            `name` field, which the loader reads as the var sentinel),
//            `#` → RESERVED_VALUE_BIND (engine annotation — emits
//            `{name: <X>, value: <Y>, reserved: true}`), otherwise
//            VALUE_BIND for plain user fields.
//
// The `#name` namespace is reserved for engine directives. Currently
// recognized: `#subparse` (re-parse hook), `#role` (preprocessor
// semantic role), `#field` (override conventional field name).
// Unknown `#name` annotations are rejected by the loader.

BINDINGS: sequence array { repeat+ <BINDING> }

BINDING: sequence dict {
  ":",
  <BIND_EXPR>
}

BIND_EXPR: choice { <NAME_BIND>, <RESERVED_VALUE_BIND>, <VALUE_BIND>}

NAME_BIND: sequence {
  "=":var=true,
  <BIND_VAL>:value=@
}

RESERVED_VALUE_BIND: sequence {
  "#",
  identifier:name=@:reserved=true,
  ?<RESERVED_VALUE_TAIL>
}

// Optional value tail. Bare `:#name` (no `=value`) is a flag-style
// annotation; the loader's per-annotation dispatch decides whether
// each particular name requires a value (`#subparse`, `#role`,
// `#field`) or is a pure flag (`#opchain`).
RESERVED_VALUE_TAIL: sequence {
  "=",
  <BIND_VAL>:value=@
}

VALUE_BIND: sequence {
  identifier:name=@,
  ?"[]":list_append=true,
  "=",
  <BIND_VAL>:value=@
}

BIND_VAL: choice { "@":@, <CONSTANT> }

// ─── Constants ──────────────────────────────────────────────────────────

CONSTANT: choice {
  string, float, int,
  "null":null, "true":true, "false":false
}

// ─── Postfix attrs ──────────────────────────────────────────────────────

POSTFIX_ATTR: choice {
  "indent" :indent=true,
  "tab"    :tab=true,
  "space"  :space=true,
  "newline":newline=true,
  <TAIL_ATTR>
}

TAIL_ATTR: sequence { "tail", "=", string:tail=@ }
