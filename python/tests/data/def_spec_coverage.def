# Synthetic LEF/DEF 5.8 DEF spec-coverage fixture.
#
# Purpose: exercise every clause documented in the LEF/DEF 5.8 Language
# Reference for the DEF file format, not just whatever a particular
# place-and-route tool happens to emit. Mirrors the role that
# `lef_spec_coverage.lef` plays for LEF — real production DEFs catch
# regressions in common patterns; this file is the spec-completeness
# counterpart.
#
# DEF coverage in lef.rawast grows commit by commit. The fixture is
# *the spec we are implementing to*; each new section landing in
# grammars/lef.rawast appends the corresponding spec clauses here and
# extends the test accordingly. Order matches LEF/DEF 5.8 §"DEF File".
#
# Phase coverage (each phase = one commit, test extended pass by pass):
#
#   1. Header (VERSION / DIVIDERCHAR / BUSBITCHARS / optional
#      NAMESCASESENSITIVE) + DESIGN name ;
#      UNITS DISTANCE MICRONS dbu ;
#      DIEAREA ( x y ) ( x y ) ; (rectangular form)
#      ROW with DO/BY/STEP for every spec orientation
#      (N / S / E / W / FN / FS / FE / FW).
#      END DESIGN.
#
# Pending (each in its own commit):
#
#   2. TECHNOLOGY ;
#      HISTORY anyText ; (repeatable)
#      PROPERTYDEFINITIONS ... END PROPERTYDEFINITIONS — same shape
#      as the LEF preamble, scoped to DESIGN / COMPONENT / NET /
#      SPECIALNET / GROUP / REGION / NONDEFAULTRULE / ROW.
#   3. TRACKS X|Y origin DO numTracks STEP space [MASK n [SAMEMASK]]
#      LAYER layerName ... ;
#      GCELLGRID X|Y origin DO numGCells+1 STEP space ;
#      VIAS num ; - viaName ... + RECT layer ( pt pt ) + POLYGON
#      ... ; END VIAS — geometry + VIARULE forms.
#   4. NONDEFAULTRULES num ;
#        - ruleName + HARDSPACING + LAYER lyr WIDTH x [DIAGWIDTH y]
#          [SPACING z] [WIREEXT w] + VIA via + VIARULE vr +
#          MINCUTS lyr n + PROPERTY name value ; END NONDEFAULTRULES
#      REGIONS num ; - regionName ( x y ) ( x y ) + TYPE FENCE|GUIDE
#        + PROPERTY ; END REGIONS
#      COMPONENTMASKSHIFT layer-list ;
#   5. COMPONENTS num ; (the big one)
#        - compName modelName
#          [+ EEQMASTER macroName]
#          [+ SOURCE NETLIST|DIST|USER|TIMING]
#          [+ FIXED|COVER|PLACED|UNPLACED ( x y ) orient]
#          [+ HALO [SOFT] left bottom right top]
#          [+ ROUTEHALO haloDist layer1 layer2]
#          [+ WEIGHT weight]
#          [+ REGION regionName]
#          [+ MASKSHIFT shift1 ...]
#          [+ PROPERTY name value ...] ;
#        END COMPONENTS
#   6. PINS num ;
#        - pinName + NET netName
#          [+ SPECIAL]
#          [+ DIRECTION INPUT|OUTPUT|INOUT|FEEDTHRU]
#          [+ USE SIGNAL|POWER|GROUND|CLOCK|TIEOFF|ANALOG|SCAN|RESET]
#          [+ NETEXPR "expr"]
#          [+ SUPPLYSENSITIVITY | GROUNDSENSITIVITY pinName]
#          [+ ANTENNAPINPARTIALMETALAREA ...] (every ANTENNA*)
#          [+ LAYER layerName [MASK n] [SPACING x | DESIGNRULEWIDTH x]
#               ( pt pt ) [+ ITERATE …]] (repeatable)
#          [+ POLYGON layerName ... ( pt pt )+] (repeatable)
#          [+ VIA viaName [MASK n] ( pt )] (repeatable)
#          [+ PORT … (multiple physical placements per pin)]
#          [+ PLACED|FIXED|COVER ( x y ) orient] ;
#        END PINS
#   7. PINPROPERTIES num ; - {COMPONENT name | PIN name} + PROPERTY
#        name value ... ; END PINPROPERTIES
#      BLOCKAGES num ;
#        - LAYER layerName [+ SLOTS | + FILLS | + PUSHDOWN |
#            + EXCEPTPGNET | + COMPONENT compName | + SPACING x |
#            + DESIGNRULEWIDTH x | + MASK n] ( pt pt )+ ;
#        - PLACEMENT [+ SOFT | + PARTIAL maxDensity | + PUSHDOWN |
#            + COMPONENT compName] ( pt pt ) ;
#        END BLOCKAGES
#      SLOTS num ; ... END SLOTS
#   8. FILLS num ;
#        - LAYER layerName [+ MASK n] [+ OPC] ( pt pt )+ ;
#        - VIA viaName [+ MASK shifts] [+ OPC] ( pt )+ ;
#        END FILLS
#   9. SPECIALNETS num ;
#        - netName ( {compName pinName | PIN pinName} [+ SYNTHESIZED])+
#          [+ VOLTAGE voltage]
#          [+ SPACING layerName x [RANGE min max]]
#          [+ SOURCE NETLIST|DIST|USER|TIMING]
#          [+ FIXEDBUMP]
#          [+ ORIGINAL netName]
#          [+ USE SIGNAL|POWER|GROUND|CLOCK|TIEOFF|ANALOG|SCAN|RESET]
#          [+ PATTERN BALANCED|STEINER|TRUNK|WIREDLOGIC]
#          [+ ESTCAP cap]
#          [+ WEIGHT weight]
#          [+ PROPERTY name value]
#          [+ ROUTED|FIXED|COVER|SHIELD layerName routeWidth
#            [+ SHAPE STRIPE|FOLLOWPIN|IOWIRE|COREWIRE|BLOCKWIRE|
#                FILLWIRE|FILLWIREOPC|DRCFILL]
#            [+ MASK ...] ( x y [extValue] ) | VIA via [orient]
#            [DO ITERATE …]] ; END SPECIALNETS
#      NETS num ; (similar shape, distinct sub-grammar — see spec
#        §"Nets"; covers PINS / FIXEDBUMP / FREQUENCY / SOURCE /
#        ORIGINAL / TYPE / PATTERN / ESTCAP / WEIGHT / SHIELDNET /
#        SUBNET / XTALK / NONDEFAULTRULE / PROPERTY plus the
#        ROUTED/FIXED/COVER physical paths). END NETS
#  10. SCANCHAINS num ; - chainName + START / + STOP / + COMMONSCANPINS
#        + PARTITION / + FLOATING / + ORDERED ; END SCANCHAINS
#      GROUPS num ; - groupName compNamePatterns + REGION rgn
#        + SOFT MAXHALFPERIMETER / + PROPERTY ; END GROUPS
#      BEGINEXT "extension-text" ... ENDEXT (free-form vendor
#        extension; same `*` raw-consume mechanism as LEF's
#        BEGINEXT — pending the engine work that wires DEF's
#        BEGINEXT into the existing `*` primitive).

# ----- Phase 1: header + DESIGN + UNITS + DIEAREA + ROW + END -----

VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;

DESIGN spec_design ;

# ----- Phase 2: TECHNOLOGY + HISTORY + PROPERTYDEFINITIONS -----

# Optional reference to a companion LEF library.
TECHNOLOGY my_tech ;

# Free-form historical-comment lines per LEF/DEF 5.8 §"DEF File".
# Repeatable; each lands in `items[]` as a typed `History` dict in
# source order. The `*` raw-consume primitive captures everything
# up to the trailing `;` verbatim, including embedded spaces.
HISTORY Created on 2026-06-08 by toolchain v1.0 ;
HISTORY Modified by router pass 1 ;
HISTORY Final placement verified ;

# PROPERTYDEFINITIONS shape is shared with LEF — same rule reused.
# DEF-context scopes (DESIGN / NET / SPECIALNET / COMPONENT /
# COMPONENTPIN / REGION / ROW / GROUP / NONDEFAULTRULE) plus
# RANGE and explicit default values per spec.
PROPERTYDEFINITIONS
  DESIGN         prop_design_i  INTEGER ;
  DESIGN         prop_design_s  STRING ;
  NET            prop_net_r     REAL ;
  SPECIALNET     prop_sn_i      INTEGER ;
  COMPONENTPIN   prop_cp_s      STRING ;
  REGION         prop_reg_s     STRING ;
  ROW            prop_row_i     INTEGER ;
  GROUP          prop_grp_s     STRING ;
  NONDEFAULTRULE prop_ndr_r     REAL RANGE 0.0 10.0 ;
  DESIGN         prop_d_def_i   INTEGER 7 ;
  NET            prop_n_def_s   STRING "default-net-attr" ;
END PROPERTYDEFINITIONS

UNITS DISTANCE MICRONS 2000 ;

DIEAREA ( -100 -100 ) ( 100100 100100 ) ;

# All eight spec-defined orientations (N S E W FN FS FE FW), one
# ROW per orientation, with non-trivial DO/BY/STEP so the parsed
# integer fields don't all collapse to zero or one.
ROW ROW_N  spec_site 0     0     N  DO 10 BY 1 STEP 2540 0    ;
ROW ROW_S  spec_site 1000  0     S  DO 10 BY 1 STEP 2540 0    ;
ROW ROW_E  spec_site 2000  0     E  DO  1 BY 8 STEP 0    1900 ;
ROW ROW_W  spec_site 3000  0     W  DO  1 BY 8 STEP 0    1900 ;
ROW ROW_FN spec_site 0     5000  FN DO 10 BY 1 STEP 2540 0    ;
ROW ROW_FS spec_site 1000  5000  FS DO 10 BY 1 STEP 2540 0    ;
ROW ROW_FE spec_site 2000  5000  FE DO  1 BY 8 STEP 0    1900 ;
ROW ROW_FW spec_site 3000  5000  FW DO  1 BY 8 STEP 0    1900 ;

# ----- Phase 3: TRACKS + GCELLGRID + VIAS -----

# `TRACKS dir start DO num STEP space [MASK n [SAMEMASK]]
#  LAYER name+ ;`. Both X and Y directions, with the MASK +
# SAMEMASK qualifier on one to exercise the optional path.
TRACKS X    100   DO 50  STEP 200   LAYER met1 ;
TRACKS Y    100   DO 50  STEP 200   MASK 2 LAYER met2 met3 ;
TRACKS X    100   DO 50  STEP 200   MASK 3 SAMEMASK LAYER met4 ;

# `GCELLGRID dir start DO num STEP space ;`.
GCELLGRID X 0     DO 11  STEP 1000 ;
GCELLGRID Y 0     DO  6  STEP 2000 ;

# `VIAS num ;` block. Two entries — one geometry-form (RECT
# clauses, with the optional + MASK qualifier on one), one
# VIARULE-form (every typed `+`-clause: VIARULE / CUTSIZE /
# LAYERS / CUTSPACING / ENCLOSURE / ROWCOL / ORIGIN / OFFSET /
# PATTERN). Plus a POLYGON-shape entry covering the geometry
# form's polygon variant.
VIAS 3 ;
  - spec_via_geom
      + RECT met1 ( -100 -100 ) ( 100 100 )
      + RECT met2 + MASK 2 ( -50 -50 ) ( 50 50 ) ;
  - spec_via_rule
      + VIARULE myViaRule
      + CUTSIZE 100 100
      + LAYERS met1 cut1 met2
      + CUTSPACING 200 200
      + ENCLOSURE 50 50 50 50
      + ROWCOL 2 3
      + ORIGIN 5 5
      + OFFSET 1 2 3 4
      + PATTERN myCutPattern ;
  - spec_via_polygon
      + POLYGON met3 ( 0 0 ) ( 100 0 ) ( 100 100 ) ( 0 100 )
      + POLYGON met4 + MASK 1 ( 200 200 ) ( 300 200 ) ( 300 300 ) ;
END VIAS

# ----- Phase 4: NONDEFAULTRULES + REGIONS + COMPONENTMASKSHIFT -----

# `COMPONENTMASKSHIFT layerList ;` — declares the mask layers
# any downstream COMPONENT's MASKSHIFT property may reference.
COMPONENTMASKSHIFT met1 met2 met3 ;

# NONDEFAULTRULES — two entries exercising every typed `+`-clause:
# HARDSPACING flag, LAYER (with optional DIAGWIDTH / SPACING /
# WIREEXT qualifiers — see DEF_NDR_LAYER_CLAUSE), VIA reference,
# VIARULE reference, MINCUTS per-layer, PROPERTY trailer.
NONDEFAULTRULES 2 ;
  - spec_ndr_full
      + HARDSPACING
      + LAYER met1 WIDTH 0.2 SPACING 0.2 WIREEXT 0.05
      + LAYER met2 WIDTH 0.3 DIAGWIDTH 0.4 SPACING 0.3
      + VIA spec_via_geom
      + VIARULE spec_via_rule
      + MINCUTS met1 2
      + PROPERTY prop_ndr_r 1.5 ;
  - spec_ndr_minimal
      + LAYER met3 WIDTH 0.1 ;
END NONDEFAULTRULES

# REGIONS — two entries: a rectangular FENCE region with a
# PROPERTY trailer, and a multi-box GUIDE region.
REGIONS 2 ;
  - spec_region_fence
      ( 0 0 ) ( 100 100 )
      + TYPE FENCE
      + PROPERTY prop_reg_s "fence-metadata" ;
  - spec_region_guide
      ( 200 0 ) ( 300 100 ) ( 200 200 ) ( 300 300 )
      + TYPE GUIDE ;
END REGIONS

# ----- Phase 5: COMPONENTS -----

# Per LEF/DEF 5.8 §"Components". Four entries cover every spec-
# permitted clause type:
#   spec_comp_fixed   — FIXED placement only (minimal entry)
#   spec_comp_full    — every typed clause (the kitchen sink)
#   spec_comp_cover   — COVER placement + HALO SOFT (optional flag)
#   spec_comp_unplaced — UNPLACED (no positional args)
COMPONENTS 4 ;
  - spec_comp_fixed cellModelA
      + FIXED ( 100 200 ) N ;
  - spec_comp_full cellModelB
      + EEQMASTER cellModelB_eq
      + SOURCE NETLIST
      + PLACED ( 300 400 ) FS
      + HALO 10 20 30 40
      + ROUTEHALO 50 met1 met3
      + WEIGHT 5
      + REGION spec_region_fence
      + MASKSHIFT 0xA5
      + PROPERTY prop_comp_i 42 ;
  - spec_comp_cover cellModelC
      + COVER ( 0 0 ) W
      + HALO SOFT 1 2 3 4 ;
  - spec_comp_unplaced cellModelD
      + UNPLACED ;
END COMPONENTS

# ----- Phase 6: PINS -----

# Per LEF/DEF 5.8 §"Pins". Each entry is `- pinName + clause+ ;`.
# Three entries exercise the full clause vocabulary:
#   spec_pin_clk  — DIRECTION/USE/NETEXPR + 2 ANTENNAPIN
#                   variants + ANTENNAMODEL + LAYER + PLACED
#   spec_pin_vdd  — SPECIAL flag + power-class + 9 antenna
#                   keywords + MASK/SPACING/DRW qualifiers on
#                   LAYER/POLYGON/VIA shapes + FIXED placement
#   spec_pin_free — minimal entry + UNPLACED
PINS 3 ;
  - spec_pin_clk
      + NET clk_net
      + DIRECTION INPUT
      + USE SIGNAL
      + NETEXPR "(net_expr clk_net)"
      + ANTENNAPINGATEAREA 0.5 LAYER met1
      + ANTENNAPINPARTIALMETALAREA 0.3 LAYER met1
      + ANTENNAMODEL OXIDE1
      + LAYER met1 ( -250 -250 ) ( 250 250 )
      + PLACED ( 0 5000 ) N ;
  - spec_pin_vdd
      + NET VDD
      + SPECIAL
      + DIRECTION INOUT
      + USE POWER
      + SUPPLYSENSITIVITY vdd_sense
      + GROUNDSENSITIVITY vss_sense
      + ANTENNAPINDIFFAREA 0.6 LAYER met1
      + ANTENNAPINPARTIALMETALSIDEAREA 0.4 LAYER met1
      + ANTENNAPINPARTIALCUTAREA 0.7 LAYER mcon
      + ANTENNAPINMAXAREACAR 1.0 LAYER met1
      + ANTENNAPINMAXSIDEAREACAR 0.8 LAYER met1
      + ANTENNAPINMAXCUTCAR 1.2 LAYER mcon
      + LAYER met2 + MASK 1 SPACING 0.05 ( 100 100 ) ( 200 200 )
      + POLYGON met3 + MASK 2 DESIGNRULEWIDTH 0.1 ( 0 0 ) ( 100 0 ) ( 100 100 ) ( 0 100 )
      + VIA spec_via_geom + MASK 1 ( 150 150 )
      + FIXED ( 0 0 ) N ;
  - spec_pin_free
      + NET sig
      + DIRECTION OUTPUT
      + UNPLACED ;
END PINS

# ----- Phase 7: PINPROPERTIES + BLOCKAGES + SLOTS -----

# Per LEF/DEF 5.8 §"Pin Properties". Two entry forms: COMPONENT
# (component instance + pin name) and PIN (pin name only). Each
# entry carries `+ PROPERTY` trailers; bound as `properties[]`.
PINPROPERTIES 3 ;
  - COMPONENT spec_comp_full in1
      + PROPERTY prop_d_def_i 100
      + PROPERTY prop_n_def_s "comp-pin-attr" ;
  - PIN spec_pin_clk
      + PROPERTY prop_design_i 7 ;
  - COMPONENT spec_comp_full out1
      + PROPERTY prop_design_s "another-attr" ;
END PINPROPERTIES

# Per LEF/DEF 5.8 §"Blockages". Two entry types: LAYER blockages
# (per-routing-layer with qualifier flags + RECT/POLYGON shapes)
# and PLACEMENT blockages (cell-placement exclusion zones with a
# narrower qualifier set; RECT shapes only).
BLOCKAGES 3 ;
  - LAYER met1
      + SLOTS
      + PUSHDOWN
      + COMPONENT spec_comp_full
      RECT ( 0 0 ) ( 100 100 )
      POLYGON ( 0 0 ) ( 100 0 ) ( 100 100 ) ( 0 100 ) ;
  - LAYER met2
      + FILLS
      + EXCEPTPGNET
      + SPACING 0.05
      + DESIGNRULEWIDTH 0.10
      + MASK 2
      RECT ( 200 0 ) ( 300 100 ) ;
  - PLACEMENT
      + SOFT
      + PARTIAL 0.5
      + PUSHDOWN
      RECT ( 500 500 ) ( 1500 1500 ) ;
END BLOCKAGES

# Per LEF/DEF 5.8 §"Slots". Simpler than BLOCKAGES — just
# LAYER entries with RECT/POLYGON shapes, no `+` qualifier
# clauses.
SLOTS 2 ;
  - LAYER met1
      RECT ( 0 0 ) ( 10 10 )
      RECT ( 20 0 ) ( 30 10 ) ;
  - LAYER met2
      POLYGON ( 0 0 ) ( 50 0 ) ( 50 50 ) ( 0 50 ) ;
END SLOTS

# ----- Phase 8: FILLS -----

# Per LEF/DEF 5.8 §"Fills". Two entry types:
#   LAYER fills — metal-density filler shapes (RECT / POLYGON
#   per layer, with optional + MASK n and + OPC flags).
#   VIA fills  — via-array fills as point placements (with
#   optional + MASK shiftLayerMasks string and + OPC flag).
# Both entry types share the OPC qualifier; LAYER MASK is an
# integer (single layer index), VIA MASK is a shift bitmask
# string covering multiple layers.
FILLS 3 ;
  - LAYER met1 + MASK 2 + OPC
      RECT ( 0 0 ) ( 100 100 )
      POLYGON ( 0 0 ) ( 100 0 ) ( 100 100 ) ( 0 100 ) ;
  - LAYER met2
      RECT ( 200 200 ) ( 300 300 ) ;
  - VIA spec_via_geom + MASK 0xA5 + OPC
      ( 100 100 ) ( 200 200 ) ( 300 300 ) ;
END FILLS

# ----- Phase 9: SPECIALNETS + NETS -----

# Per LEF/DEF 5.8 §"Special Nets". Power/ground/clock nets with
# explicit stripe-style routing, voltage, spacing constraints,
# and SHIELD wires. Three entries cover every typed clause and
# every connection-list form (compName pinName / PIN pinName /
# * pinName).
SPECIALNETS 2 ;
  - VDD ( PIN VDD ) ( * VDD ) ( spec_comp_full VDD )
      + USE POWER
      + SYNTHESIZED
      + VOLTAGE 1.8
      + SPACING met1 0.5 RANGE 0.0 10.0
      + SOURCE NETLIST
      + ORIGINAL VDD_pre_synth
      + PATTERN BALANCED
      + ESTCAP 1.5
      + WEIGHT 10
      + PROPERTY prop_sn_i 1
      + ROUTED met1 100 + SHAPE STRIPE + MASK 2
        ( 0 0 ) ( 1000 0 ) VIA spec_via_geom
      + SHIELD shield_net met2 50 ( 0 100 ) ( 1000 100 ) ;
  - VSS ( PIN VSS )
      + USE GROUND
      + FIXEDBUMP
      + FIXED met1 100 ( 0 200 ) ( 1000 200 )
      + COVER met2 50 ( 0 300 ) ( 1000 300 ) ;
END SPECIALNETS

# Per LEF/DEF 5.8 §"Nets". Signal nets with looser routing
# semantics. Three entries cover the NETS-specific clauses
# (FREQUENCY / NONDEFAULTRULE / SHIELDNET / SUBNET / XTALK /
# NOSHIELD) plus the shared ones.
NETS 3 ;
  - sig_data ( spec_comp_full A ) ( spec_comp_full B )
      + USE SIGNAL
      + SOURCE TIMING
      + NONDEFAULTRULE spec_ndr_full
      + FREQUENCY 1000
      + ORIGINAL sig_data_pre
      + PATTERN STEINER
      + ESTCAP 0.5
      + WEIGHT 2
      + SHIELDNET shield_a
      + SUBNET sub_a
      + XTALK 3
      + PROPERTY prop_n_def_s "net-prop"
      + ROUTED met1 + SHAPE STRIPE + MASK 1
        + NONDEFAULTRULE spec_ndr_full
        ( 100 100 ) ( 200 100 ) VIA spec_via_geom ;
  - sig_clk ( PIN spec_pin_clk )
      + USE CLOCK
      + FIXEDBUMP
      + NOSHIELD met1 ( 0 0 ) ( 100 0 ) ;
  - sig_test ( spec_comp_full out1 )
      + USE SIGNAL
      + FIXED met2 ( 0 200 ) ( 100 200 )
      + COVER met3 ( 0 300 ) ( 100 300 ) ;
END NETS

END DESIGN
