# Synthetic LEF/DEF 5.8 spec-coverage fixture.
#
# Purpose: exercise every clause documented in the LEF/DEF 5.8 Language
# Reference, not just whatever a particular vendor tool happens to
# emit. Real fixtures (Sky130 tech/SRAM/IO) catch regressions in
# common patterns; this file is the spec-completeness counterpart.
#
# Phase coverage (each phase = one commit, test extended pass by pass):
#   1. Header (VERSION / NAMESCASESENSITIVE / NOWIREEXTENSIONATPIN /
#      BUSBITCHARS / DIVIDERCHAR), UNITS (all 8 sub-statements),
#      MANUFACTURINGGRID, USEMINSPACING ×2, CLEARANCEMEASURE,
#      FIXEDMASK, PROPERTYDEFINITIONS (every object × type × RANGE),
#      SITE with ROWPATTERN.
#   2. LAYER blocks for every TYPE the spec discriminates: ROUTING /
#      CUT / MASTERSLICE / OVERLAP / IMPLANT, each with its property
#      set, plus LEF58_TYPE PROPERTY clauses.
#   3. VIA (geometry form with DEFAULT), VIARULE (LAYER-pair +
#      GENERATE), NONDEFAULTRULE (HARDSPACING / per-LAYER props /
#      VIA / VIARULE references / MINCUTS).
#   4. MACRO with every body sub-statement: CLASS / FIXEDMASK /
#      FOREIGN / EEQ / ORIGIN / SOURCE / SIZE / SYMMETRY / SITE /
#      PIN / OBS / DENSITY / PROPERTY (trailing).
#   5. PIN sub-statements: DIRECTION OUTPUT TRISTATE / USE / SHAPE /
#      TAPERRULE / NETEXPR / SUPPLYSENSITIVITY / GROUNDSENSITIVITY /
#      MUSTJOIN / PIN-level PROPERTY / single ANTENNA clause.
#   6. PORT/OBS layerGeometries: PORT CLASS / LAYER with
#      EXCEPTPGNET/SPACING/DESIGNRULEWIDTH/MASK / per-LAYER WIDTH /
#      RECT with MASK / RECT with ITERATE + stepPattern / POLYGON /
#      PATH / VIA placement.
#   7. MAXVIASTACK (with RANGE), BEGINEXT/ENDEXT (syntactic frame).
#
# Known limitations (documented at the grammar sites):
#   - Multiple ANTENNA / PROPERTY clauses per PIN collapse via the
#     catcher (last-write-wins).
#   - BEGINEXT inner content is not captured (no raw-text primitive
#     in the engine yet).
#   - SITE_BLOCK accepts CLASS / SIZE in any order (spec mandates
#     them required and ordered; NSEQ work pending).

VERSION 5.8 ;
NAMESCASESENSITIVE ON ;
NOWIREEXTENSIONATPIN ON ;
BUSBITCHARS "[]" ;
DIVIDERCHAR "/" ;

UNITS
  TIME NANOSECONDS 1 ;
  CAPACITANCE PICOFARADS 10 ;
  RESISTANCE OHMS 1 ;
  POWER MILLIWATTS 1 ;
  CURRENT MILLIAMPS 1 ;
  VOLTAGE VOLTS 1.8 ;
  DATABASE MICRONS 1000 ;
  FREQUENCY MEGAHERTZ 1 ;
END UNITS

MANUFACTURINGGRID 0.005 ;
CLEARANCEMEASURE EUCLIDEAN ;
USEMINSPACING OBS ON ;
USEMINSPACING PIN OFF ;
FIXEDMASK ;
MAXVIASTACK 4 RANGE met1 met5 ;

# Top-level SPACING block — SAMENET inter-layer spacing rules.
SPACING
  SAMENET met1 met2 0.14 ;
  SAMENET met2 met3 0.14 STACK ;
END SPACING

PROPERTYDEFINITIONS
  LAYER          prop_layer_i  INTEGER ;
  LAYER          prop_layer_r  REAL ;
  LAYER          prop_layer_s  STRING ;
  LIBRARY        prop_lib_i    INTEGER ;
  LIBRARY        prop_lib_r    REAL ;
  LIBRARY        prop_lib_s    STRING ;
  MACRO          prop_macro_i  INTEGER ;
  MACRO          prop_macro_r  REAL ;
  MACRO          prop_macro_s  STRING ;
  VIA            prop_via_i    INTEGER ;
  VIA            prop_via_r    REAL ;
  VIA            prop_via_s    STRING ;
  VIARULE        prop_vr_i     INTEGER ;
  VIARULE        prop_vr_r     REAL ;
  VIARULE        prop_vr_s     STRING ;
  NONDEFAULTRULE prop_ndr_i    INTEGER ;
  NONDEFAULTRULE prop_ndr_r    REAL ;
  NONDEFAULTRULE prop_ndr_s    STRING ;
  PIN            prop_pin_i    INTEGER ;
  PIN            prop_pin_r    REAL ;
  PIN            prop_pin_s    STRING ;
  # LEF/DEF 5.8 §"Property Definitions" — DEF-context scopes
  # (COMPONENTPIN / REGION / DESIGN / NET / SPECIALNET / ROW /
  # GROUP) accepted in PROPERTYDEFINITIONS too. LEF and DEF share
  # the PROPERTYDEFINITIONS shape and toolchains routinely declare
  # all spec scopes here for symmetry with the companion DEF.
  COMPONENTPIN   prop_cp_s     STRING ;
  REGION         prop_reg_s    STRING ;
  DESIGN         prop_des_i    INTEGER ;
  NET            prop_net_s    STRING ;
  SPECIALNET     prop_sn_r     REAL ;
  ROW            prop_row_s    STRING ;
  GROUP          prop_grp_i    INTEGER ;
  LAYER          prop_ranged   REAL RANGE 0.0 1.0 ;
  # PROPERTYDEFINITIONS with explicit default value per spec —
  # the optional trailing value after the data-type keyword.
  # STRING / INTEGER / REAL defaults all supported; the Pydantic
  # generator now emits `default_value: Number | str | None` for
  # PROPDEF_DEFAULT's `choice { string, NUMBER }` body so all
  # three forms validate.
  LAYER          prop_def_i    INTEGER 42 ;
  MACRO          prop_def_s    STRING  "default-val" ;
  PIN            prop_def_r    REAL    3.14 ;
END PROPERTYDEFINITIONS

SITE spec_site
  CLASS CORE ;
  SYMMETRY X Y R90 ;
  ROWPATTERN sub_a N sub_b FN ;
  SIZE 1.0 BY 2.5 ;
  # LEF/DEF 5.8 §"Site" permits trailing PROPERTY clauses; landed
  # in `properties[]` via the engine's list-append binding.
  PROPERTY prop_site_i 3 ;
  PROPERTY prop_site_s "site-string" ;
END spec_site

# === Phase 2: LAYER blocks — one per TYPE the spec discriminates. ===
# Each TYPE has its own canonical property set; the grammar's flat
# LAYER_KEYWORD list captures the union, so a downstream consumer
# branches on `kind` to interpret per TYPE. LEF58_* clauses ride on
# the generic PROPERTY pass-through.

LAYER spec_routing
  TYPE ROUTING ;
  DIRECTION HORIZONTAL ;
  PITCH 0.2 0.2 ;
  OFFSET 0.1 0.1 ;
  WIDTH 0.1 ;
  AREA 0.05 ;
  THICKNESS 0.1 ;
  HEIGHT 0.35 ;
  MINWIDTH 0.08 ;
  MAXWIDTH 5.0 ;
  MINENCLOSEDAREA 0.14 ;
  MINSTEP 0.02 ;
  MINIMUMCUT 2 WIDTH 0.5 ;
  WIREEXTENSION 0.05 ;
  RESISTANCE RPERSQ 0.5 ;
  CAPACITANCE CPERSQDIST 36.9E-6 ;
  EDGECAPACITANCE 40.7E-6 ;
  # ANTENNA family — every per-LAYER property defined by LEF/DEF
  # 5.8 §"Layer (Routing)". Surfaced two missing entries in
  # LAYER_KEYWORD (ANTENNACUMSIDEAREARATIO,
  # ANTENNACUMDIFFSIDEAREARATIO) plus three more rare ones
  # (ANTENNACUMROUTINGPLUSCUT, ANTENNAAREAMINUSDIFF,
  # ANTENNAAREADIFFREDUCEPWL).
  ANTENNAAREARATIO 25 ;
  ANTENNADIFFAREARATIO 50 ;
  ANTENNACUMAREARATIO 75 ;
  ANTENNACUMDIFFAREARATIO 100 ;
  ANTENNASIDEAREARATIO 30 ;
  ANTENNADIFFSIDEAREARATIO 60 ;
  ANTENNACUMSIDEAREARATIO 90 ;
  ANTENNACUMDIFFSIDEAREARATIO 120 ;
  ANTENNAAREAFACTOR 1.0 ;
  ANTENNASIDEAREAFACTOR 1.2 ;
  ANTENNAGATEPLUSDIFF 0.05 ;
  ANTENNAAREAMINUSDIFF 0.02 ;
  ANTENNACUMROUTINGPLUSCUT 1 ;
  ANTENNAAREADIFFREDUCEPWL ( ( 0 1 ) ( 1 0.5 ) ) ;
  ANTENNAMODEL OXIDE1 ;
  # SPACING family — bare value form plus the SPACINGTABLE
  # multi-line variant (PARALLELRUNLENGTH header, WIDTH rows).
  # The audit surfaced a prefix collision: KeyParser doesn't
  # word-boundary-check, so SPACINGTABLE must come before SPACING
  # in LAYER_KEYWORD for the longer keyword to win.
  # SPACING — bare plus the advanced qualifier forms per LEF/DEF
  # 5.8 §"Layer (Routing)". Each lands in `properties` with the
  # qualifier preserved in `values`.
  SPACING 0.1 ;
  SPACING 0.15 RANGE 0.5 2.0 ;
  SPACING 0.08 ENDOFLINE 0.18 WITHIN 0.05 ;
  SPACING 0.12 SAMENET ;
  SPACING 0.08 NOTCHLENGTH 0.5 ;
  # SPACINGTABLE — PARALLELRUNLENGTH (the common one), TWOWIDTHS
  # variant (newer-process), and INFLUENCE (parallel-run override).
  SPACINGTABLE
    PARALLELRUNLENGTH 0    1    10
    WIDTH 0    0.10 0.10 0.20
    WIDTH 0.5  0.10 0.15 0.20
    WIDTH 1.0  0.10 0.15 0.25 ;
  SPACINGTABLE
    TWOWIDTHS 0    0.10
    TWOWIDTHS 0.5  0.15 ;
  SPACINGTABLE
    INFLUENCE WIDTH 1.0 WITHIN 2.0 SPACING 0.3 ;
  # MINIMUMCUT — bare + full LEF/DEF 5.8 advanced forms.
  MINIMUMCUT 2 WIDTH 0.5 WITHIN 1.0 ;
  MINIMUMCUT 2 WIDTH 0.5 FROMABOVE ;
  MINIMUMCUT 2 WIDTH 0.5 LENGTH 1.0 WITHIN 0.3 ;
  # DCCURRENTDENSITY / ACCURRENTDENSITY — basic AVERAGE/PEAK
  # forms and the table form with FREQUENCY axis (used for
  # IR-drop / electromigration analysis in modern PDKs).
  DCCURRENTDENSITY AVERAGE 0.36 ;
  ACCURRENTDENSITY PEAK FREQUENCY 1 100 1000 TABLEENTRIES 0.1 0.2 0.3 ;
  PROPERTY LEF58_TYPE "TYPE ROUTING ;" ;
END spec_routing

LAYER spec_cut
  TYPE CUT ;
  WIDTH 0.17 ;
  # SPACING family per LEF/DEF 5.8 §"Layer (Cut)" — bare value
  # plus all four advanced qualifiers (LAYER name, ADJACENTCUTS
  # WITHIN, PARALLELOVERLAP, AREA). All fall through to the
  # generic LAYER_PROPERTY pass-through as kind="SPACING" with
  # the qualifier embedded in the values list, which preserves
  # the source order on save.
  SPACING 0.17 ;
  SPACING 0.18 LAYER met1 ;
  SPACING 0.20 ADJACENTCUTS 4 WITHIN 0.5 ;
  SPACING 0.22 PARALLELOVERLAP ;
  SPACING 0.24 AREA 0.5 ;
  # ENCLOSURE — bare and ABOVE/BELOW qualifier forms.
  ENCLOSURE 0.06 0.06 ;
  ENCLOSURE ABOVE 0.05 0.07 ;
  ENCLOSURE BELOW 0.04 0.05 ;
  # CUT-array placement and minimum-cut rules.
  ARRAYSPACING LONGARRAY WIDTH 0.5 CUTSPACING 0.3 ARRAYCUTS 4 SPACING 0.5 ;
  MINIMUMCUT 2 WIDTH 0.5 ;
  ANTENNAAREARATIO 10 ;
  ANTENNAMODEL OXIDE1 ;
  PROPERTY LEF58_TYPE "TYPE CUT ;" ;
END spec_cut

LAYER spec_masterslice
  TYPE MASTERSLICE ;
  PROPERTY LEF58_TYPE "TYPE NWELL ;" ;
END spec_masterslice

LAYER spec_overlap
  TYPE OVERLAP ;
END spec_overlap

LAYER spec_implant
  TYPE IMPLANT ;
  WIDTH 0.18 ;
  SPACING 0.18 ;
END spec_implant

# === Phase 3: VIA, VIARULE, NONDEFAULTRULE ===

VIA spec_via_geom DEFAULT
   RESISTANCE 50 ;
   LAYER li1 ;
     RECT -0.085 -0.085 0.085 0.085 ;
   LAYER mcon ;
     RECT -0.085 -0.085 0.085 0.085 ;
   LAYER met1 ;
     RECT -0.145 -0.115 0.145 0.115 ;
   # LEF/DEF 5.8 §"Via" allows trailing PROPERTY clauses inside
   # the geometry-form VIA body — same shape as MACRO/PIN/NDR
   # PROPERTY trailers.
   PROPERTY prop_via_i 42 ;
END spec_via_geom

VIA spec_via_viarule_form VIARULE spec_viarule_gen ;
   CUTSIZE 0.17 0.17 ;
   LAYERS li1 mcon met1 ;
   CUTSPACING 0.19 0.19 ;
   ENCLOSURE 0.04 0.06 0.06 0.06 ;
   ROWCOL 2 3 ;
   ORIGIN 0.005 0.005 ;
   OFFSET 0.01 0.02 0.03 0.04 ;
   PATTERN myCutPattern ;
END spec_via_viarule_form

# Geometry-form VIA with POLYGON shape — LEF/DEF 5.8 allows
# POLYGON shapes alongside RECT in the VIA body.
VIA spec_via_polygon
  LAYER met1 ;
    POLYGON 0 0 0.2 0 0.2 0.2 0 0.2 ;
  LAYER met2 ;
    RECT -0.1 -0.1 0.1 0.1 ;
END spec_via_polygon

VIARULE spec_viarule_pair
   LAYER li1 ;
   ENCLOSURE 0 0 ;
   LAYER met1 ;
   ENCLOSURE 0.06 0.03 ;
   LAYER mcon ;
   RECT -0.085 -0.085 0.085 0.085 ;
   SPACING 0.36 BY 0.36 ;
   # Trailing `VIA viaName ;` references per LEF/DEF 5.8 §"Via
   # Rule" non-GENERATE form — list the specific VIAs the rule
   # produces.
   VIA spec_via_geom ;
   VIA spec_via_viarule_form ;
END spec_viarule_pair

VIARULE spec_viarule_gen GENERATE
   LAYER li1 ;
   ENCLOSURE 0 0 ;
   LAYER met1 ;
   ENCLOSURE 0.06 0.03 ;
   LAYER mcon ;
   RECT -0.085 -0.085 0.085 0.085 ;
END spec_viarule_gen

NONDEFAULTRULE spec_ndr
   HARDSPACING ;
   LAYER li1 WIDTH 0.34 SPACING 0.34 ;
   LAYER met1 WIDTH 0.28 SPACING 0.28 DIAGSPACING 0.5 WIREEXT 0.05 ;
   VIA spec_via_geom ;
   VIARULE spec_viarule_gen ;
   # LEF/DEF 5.8 §"Non-Default Rule" — USEVIA / USEVIARULE
   # reference VIAs / VIARULEs defined elsewhere that the rule
   # may use; distinct from `VIA name ;` which names the VIAs
   # the rule itself selects from.
   USEVIA spec_via_geom ;
   USEVIARULE spec_viarule_gen ;
   MINCUTS mcon 2 ;
   # Trailing PROPERTY clauses inside NDR — same shape as MACRO/
   # PIN trailing properties.
   PROPERTY prop_ndr_i 7 ;
   PROPERTY prop_ndr_r 1.5 ;
   PROPERTY prop_ndr_s "ndr-string-value" ;
   # Inline VIA definition inside NDR — LEF/DEF 5.8 §"Non-Default
   # Rule" permits full `VIA viaName body END viaName` blocks
   # inside the NDR (distinct from the `VIA name ;` reference
   # form). Captured as type="ViaInline" via NDR_VIA_INLINE.
   VIA spec_ndr_inline_via
     LAYER met1 ;
       RECT -0.12 -0.12 0.12 0.12 ;
     LAYER met2 ;
       RECT -0.12 -0.12 0.12 0.12 ;
   END spec_ndr_inline_via
END spec_ndr

# === Phase 4: MACRO with every body sub-statement ===

MACRO spec_macro
  CLASS BLOCK ;
  FIXEDMASK ;
  # Two FOREIGN clauses — `cell xy` and `cell xy orient` forms
  # per LEF/DEF 5.8 §"Macro"; the spec also defines `cell` alone
  # but real PDKs always emit xy. List captured via the engine's
  # `[]` list-append binding so all variants round-trip in order.
  FOREIGN spec_macro 0 0 ;
  FOREIGN spec_macro_mirrored 0 0 FN ;
  EEQ spec_macro_eq ;
  ORIGIN 0 0 ;
  SOURCE USER ;
  SIZE 5.0 BY 10.0 ;
  SYMMETRY X Y R90 ;
  SITE spec_site ;
  PIN VDD
    DIRECTION INOUT ;
    USE POWER ;
    SHAPE ABUTMENT ;
    PORT
      LAYER met1 ;
        RECT 0 0 1 1 ;
    END
  END VDD
  PIN SIG_IN
    DIRECTION OUTPUT TRISTATE ;
    USE SIGNAL ;
    SHAPE FEEDTHRU ;
    TAPERRULE tapered ;
    NETEXPR "net_expr_prop net_default" ;
    SUPPLYSENSITIVITY VDD ;
    GROUNDSENSITIVITY VSS ;
    MUSTJOIN OTHER_PIN ;
    PROPERTY prop_pin_i 7 ;
    # PIN-scope LEF58_* PROPERTY clauses — typed Lef58Property
    # shape via PIN_LEF58_PROPERTY rule, identical pattern to
    # LAYER and MACRO scopes.
    PROPERTY LEF58_VOLTAGE "VDD" ;
    PROPERTY LEF58_DRIVE "STRONG" ;
    # Every PIN ANTENNA property defined by LEF/DEF 5.8 §"Pin".
    # The closed-list discriminator PIN_ANTENNA_KIND is ordered
    # longest-prefix-first to avoid KeyParser prefix collisions
    # (PARTIALMETALSIDEAREA must come before PARTIALMETALAREA,
    # MAXSIDEAREACAR before MAXAREACAR, ANYDIFFAREA before
    # DIFFAREA). Mix of `[VALUE [LAYER name] ;]` and the bare-
    # value forms — both shapes covered by PIN_ANTENNA_PROP.
    ANTENNAGATEAREA              0.01 ;
    ANTENNADIFFAREA              0.02 LAYER met1 ;
    ANTENNAPARTIALMETALAREA      0.05 LAYER met1 ;
    ANTENNAPARTIALMETALSIDEAREA  0.04 LAYER met1 ;
    ANTENNAPARTIALCUTAREA        0.06 LAYER mcon ;
    ANTENNAMAXAREACAR            0.10 LAYER met1 ;
    ANTENNAMAXSIDEAREACAR        0.08 LAYER met1 ;
    ANTENNAMAXCUTCAR             0.12 LAYER mcon ;
    ANTENNAANYDIFFAREA           0.03 LAYER met1 ;
    # Deprecated LEF 5.4-era PIN ANTENNA forms (per LEF/DEF 5.8
    # §"Pin" — listed as DEPRECATED, replaced by ANTENNAGATEAREA
    # / ANTENNADIFFAREA, but still appear in older PDK LEFs that
    # were never re-emitted by a modern tool). Distinct
    # InputGateAreaLegacy / InputDiffAreaLegacy /
    # OutputDiffAreaLegacy / InOutDiffAreaLegacy discriminators
    # so downstream consumers can distinguish from current forms.
    ANTENNAINPUTGATEAREA         0.05 ;
    ANTENNAINPUTDIFFAREA         0.06 LAYER met1 ;
    ANTENNAOUTPUTDIFFAREA        0.07 LAYER met1 ;
    ANTENNAINOUTDIFFAREA         0.08 LAYER met1 ;
    ANTENNAMODEL                 OXIDE1 ;
    PORT
      CLASS CORE ;
      LAYER met1 EXCEPTPGNET SPACING 0.05 DESIGNRULEWIDTH 0.1 MASK 2 ;
        WIDTH 0.12 ;
        RECT MASK 1 2 0 3 1 ;
        RECT ITERATE 0 0 1 1 2 3 0.5 0.5 ;
        POLYGON 5 0 6 0 6 1 5.5 1.2 5 1 ;
        POLYGON MASK 2 12 0 13 0 13 1 12.5 1.2 12 1 ;
        POLYGON ITERATE 14 0 15 0 15 1 14.5 1.2 14 1 2 1 0.5 0.5 ;
        PATH 7 0 7 1 8 1 8 0 ;
        PATH MASK 1 16 0 16 1 17 1 17 0 ;
        PATH ITERATE 18 0 18 1 19 1 19 0 2 1 0.5 0.5 ;
        VIA 9 0 spec_via_geom ;
        VIA MASK 1 ITERATE 20 0 spec_via_geom 2 1 0.5 0.5 ;
      LAYER met2 ;
        RECT 10 0 11 1 ;
    END
  END SIG_IN
  # PIN with multiple PORT clauses — LEF/DEF 5.8 §"Pin" allows
  # one or more PORTs per pin (each is a physical placement). The
  # engine's `[]` list-append on `:ports[]=@` captures them in
  # source order.
  PIN MULTI_PORT_PIN
    DIRECTION INPUT ;
    USE SIGNAL ;
    PORT
      CLASS CORE ;
      LAYER met1 ;
        RECT 0 0 0.1 0.1 ;
    END
    PORT
      CLASS BUMP ;
      LAYER met2 ;
        RECT 0.2 0 0.3 0.1 ;
    END
  END MULTI_PORT_PIN
  OBS
    LAYER met2 ;
      RECT 0 0 5 0.05 ;
  END
  DENSITY
    LAYER met1 ;
      RECT 0 0 1 1 0.4 ;
      RECT 1 1 2 2 0.5 ;
    LAYER met2 ;
      RECT 0 0 1 1 0.45 ;
  END
  PROPERTY prop_macro_i 42 ;
  PROPERTY prop_macro_r 3.14 ;
  PROPERTY prop_macro_s "hello" ;
  # MACRO-scope LEF58_* PROPERTY clauses — also typed via
  # MACRO_LEF58_PROPERTY rule. Source order preserved by the
  # engine's list-append binding into `lef58`.
  PROPERTY LEF58_PWRPLUS "VDD" ;
  PROPERTY LEF58_LIBRARYTYPE "STDCELL" ;
END spec_macro

# === Phase 4b: MACRO CLASS variants ===
#
# LEF/DEF 5.8 §"Macro" defines CLASS with rich sub-type vocabulary:
#   COVER [BUMP]
#   RING
#   BLOCK [BLACKBOX | SOFT]
#   PAD [INPUT | OUTPUT | INOUT | POWER | SPACER | AREAIO]
#   CORE [FEEDTHRU | TIEHIGH | TIELOW | SPACER | ANTENNACELL | WELLTAP]
#   ENDCAP [PRE | POST | TOPLEFT | TOPRIGHT | BOTTOMLEFT | BOTTOMRIGHT]
# Each subtype is a separate identifier token in the CLASS list,
# captured via CLASS_LIST's `repeat identifier space`. One tiny
# MACRO per variant — minimal body so the asserts focus on
# `class` only.

MACRO spec_class_pad_input    CLASS PAD INPUT ;     SIZE 1 BY 1 ; END spec_class_pad_input
MACRO spec_class_pad_power    CLASS PAD POWER ;     SIZE 1 BY 1 ; END spec_class_pad_power
MACRO spec_class_pad_spacer   CLASS PAD SPACER ;    SIZE 1 BY 1 ; END spec_class_pad_spacer
MACRO spec_class_pad_areaio   CLASS PAD AREAIO ;    SIZE 1 BY 1 ; END spec_class_pad_areaio
MACRO spec_class_core_feed    CLASS CORE FEEDTHRU ; SIZE 1 BY 1 ; END spec_class_core_feed
MACRO spec_class_core_th      CLASS CORE TIEHIGH ;  SIZE 1 BY 1 ; END spec_class_core_th
MACRO spec_class_core_tl      CLASS CORE TIELOW ;   SIZE 1 BY 1 ; END spec_class_core_tl
MACRO spec_class_core_ac      CLASS CORE ANTENNACELL ; SIZE 1 BY 1 ; END spec_class_core_ac
MACRO spec_class_core_wt      CLASS CORE WELLTAP ;  SIZE 1 BY 1 ; END spec_class_core_wt
MACRO spec_class_endcap_pre   CLASS ENDCAP PRE ;    SIZE 1 BY 1 ; END spec_class_endcap_pre
MACRO spec_class_endcap_tl    CLASS ENDCAP TOPLEFT ;  SIZE 1 BY 1 ; END spec_class_endcap_tl
MACRO spec_class_block_bb     CLASS BLOCK BLACKBOX ; SIZE 1 BY 1 ; END spec_class_block_bb
MACRO spec_class_block_soft   CLASS BLOCK SOFT ;    SIZE 1 BY 1 ; END spec_class_block_soft
MACRO spec_class_cover        CLASS COVER ;         SIZE 1 BY 1 ; END spec_class_cover
MACRO spec_class_cover_bump   CLASS COVER BUMP ;    SIZE 1 BY 1 ; END spec_class_cover_bump
MACRO spec_class_ring         CLASS RING ;          SIZE 1 BY 1 ; END spec_class_ring

# === Phase 7: vendor-extension wrapper ===
#
# Inner content captured opaquely by the lefdef.until_endext primitive.
# Vendors typically use their own DSL here; rawast preserves it
# verbatim for round-trip without trying to interpret.

BEGINEXT "spec_vendor_ext"
  vendor_directive option_a = 42 ;
  another_vendor_thing "string value" ;
ENDEXT

END LIBRARY
